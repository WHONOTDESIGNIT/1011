                  </a>
                  <a class="mega-component-card" href="/components/power-supply">
                    <img class="mega-component-img" src="/images/components/power-supply.jpg" alt="Power Supply" loading="lazy" onerror="this.onerror=null;this.src='/images/components/cooling-system.jpg'" />

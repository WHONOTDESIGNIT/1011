---
// iShine 全站统一头部 — 最新版 trust-bar + site-header（源自 index.astro 内联实现）
// 保留 lang 传参（getLocalizedPath API 契约），导航结构与内容与首页最新版完全一致
import { getLocalizedPath } from '../lib/breadcrumbs';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { t } from '../lib/i18n';

interface Props {
  lang?: string;
}

const { lang: langProp } = Astro.props as Props;
// 未显式传 lang 时，从 URL 自动推导当前语言（兼容直接内联组件且不传参的 develo-* 等页面）
const locale = langProp || Astro.currentLocale || (Astro.url.pathname.startsWith('/tr') ? 'tr' : Astro.url.pathname.startsWith('/ar') ? 'ar' : Astro.url.pathname.startsWith('/es') ? 'es-ES' : Astro.url.pathname.startsWith('/fr') ? 'fr' : Astro.url.pathname.startsWith('/ru') ? 'ru' : Astro.url.pathname.startsWith('/he') ? 'he' : Astro.url.pathname.startsWith('/pt-BR') ? 'pt-BR' : Astro.url.pathname.startsWith('/pt-PT') ? 'pt-PT' : Astro.url.pathname.startsWith('/ro') ? 'ro' : Astro.url.pathname.startsWith('/ko') ? 'ko' : Astro.url.pathname.startsWith('/ja') ? 'ja' : Astro.url.pathname.startsWith('/pl') ? 'pl' : Astro.url.pathname.startsWith('/nl') ? 'nl' : Astro.url.pathname.startsWith('/id') ? 'id' : Astro.url.pathname.startsWith('/fa') ? 'fa' : Astro.url.pathname.startsWith('/el') ? 'el' : Astro.url.pathname.startsWith('/th') ? 'th' : Astro.url.pathname.startsWith('/vi') ? 'vi' : Astro.url.pathname.startsWith('/it') ? 'it' : 'en');
const lang = locale;
const homeHref = getLocalizedPath(lang);
const contactHref = getLocalizedPath(lang, '/contact');
// 按当前语言为站内链接加前缀（en 无前缀，tr 自动带 /tr/）
const loc = (p: string) => getLocalizedPath(lang, p);
---

<!-- ═══ 1. TRUST BAR ═══ -->
<div class="trust-bar" id="trust-bar" role="region" aria-label="Site trust badges">
  <div class="trust-bar-inner">
    <div class="trust-slide" data-slide="shipping">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
      <span class="trust-text">{t(locale, 'homepage.trustBar.shipping')}</span>
    </div>
    <div class="trust-slide" data-slide="private-label" aria-hidden="true">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2H2v10l9.29 9.29a1 1 0 0 0 1.42 0l8.58-8.58a1 1 0 0 0 0-1.42z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
      <span class="trust-text">{t(locale, 'homepage.trustBar.privateLabel')}</span>
    </div>
    <div class="trust-slide" data-slide="chatgpt" aria-hidden="true">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l1.9 5.7a2 2 0 0 0 1.3 1.3L21 12l-5.8 1.9a2 2 0 0 0-1.3 1.3L12 21l-1.9-5.8a2 2 0 0 0-1.3-1.3L3 12l5.8-1.9a2 2 0 0 0 1.3-1.3z"/></svg>
      <span class="trust-text">{t(locale, 'homepage.trustBar.chatgpt')}</span>
    </div>
  </div>
</div>

<!-- ═══ 2. HEADER ═══ -->

.btn-cta{display:inline-flex;align-items:center;justify-content:center;gap:6px;padding:12px 20px;background:var(--blue);color:#fff;font-family:Manrope,sans-serif;font-size:16px;font-weight:400;line-height:1;border-radius:100px;border:none;cursor:pointer;white-space:nowrap;transition:all .25s}
.btn-cta:hover{gap:12px;background:#374151}
.btn-cta svg{width:16px;height:16px;display:block;flex-shrink:0}

/* Nav collapse button */
.nav-collapse-btn{position:absolute;top:50%;right:24px;transform:translateY(-50%);display:flex;align-items:center;justify-content:center;width:40px;height:40px;min-width:40px;min-height:40px;max-width:40px;max-height:40px;border-radius:100px;background:var(--blue);border:none;cursor:pointer;opacity:0;visibility:hidden;pointer-events:none;transition:opacity .2s ease,visibility 0s .2s,background .2s ease}
.nav-collapse-btn svg{width:20px;height:20px}
.site-header.header-menu-only .header-main-nav{opacity:0;visibility:hidden;pointer-events:none;transition:opacity .18s ease,visibility 0s .18s}
.site-header.header-menu-only .nav-collapse-btn{opacity:1;visibility:visible;pointer-events:auto;transition:opacity .2s ease,visibility 0s 0s,background .2s ease}


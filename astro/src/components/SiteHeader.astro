<!-- Trust carousel + top bar auto-hide on scroll -->
<script>
(function () {
  var slides = document.querySelectorAll('.trust-slide');
  var current = 0;
  var total = slides.length;
  function showSlide(index) {
    slides.forEach(function (s, i) {
      s.setAttribute('aria-hidden', i === index ? 'false' : 'true');
    });
  }
  if (total > 0) {
    setInterval(function () {
      current = (current + 1) % total;
      showSlide(current);
    }, 3000);
  }

  // Top bar auto-hide on scroll: shown only when the page is scrolled back to the top.
  var trustBar = document.getElementById('trust-bar');
  var topBarHeader = document.getElementById('site-header');
  var topBarVisible = true;
  var scrollDebounceTimer = null;
  var lastScrollY = window.scrollY || window.pageYOffset || document.documentElement.scrollTop || 0;

  function setTopBarVisible(visible) {
    if (visible === topBarVisible) return;
    topBarVisible = visible;
    if (trustBar) trustBar.classList.toggle('trust-bar-hidden', !visible);
    if (topBarHeader) topBarHeader.classList.toggle('site-header-top-hidden', !visible);
  }

  function handleTopBarScroll() {
    var y = window.scrollY || window.pageYOffset || document.documentElement.scrollTop || 0;
    if (y === 0) {
      setTopBarVisible(true);
    } else if (lastScrollY === 0) {
      setTopBarVisible(false);
    }
    lastScrollY = y;
  }

  if (trustBar && topBarHeader) {
    window.addEventListener('scroll', function () {
      clearTimeout(scrollDebounceTimer);
      scrollDebounceTimer = setTimeout(handleTopBarScroll, 100);
    }, { passive: true });
  }
})();
</script>

<!-- Header nav mode (desktop <-> hamburger) + mobile menu open/close/accordion -->
<script>
(function () {
  var siteHeader = document.getElementById('site-header');
  var headerInner = siteHeader ? siteHeader.querySelector('.header-inner') : null;
  var headerLogo = siteHeader ? siteHeader.querySelector('.header-logo') : null;
  var headerMainNav = siteHeader ? siteHeader.querySelector('.header-main-nav') : null;
  var desktopNav = siteHeader ? siteHeader.querySelector('.desktop-nav') : null;
  var headerCta = siteHeader ? siteHeader.querySelector('.header-cta') : null;
  var navBtn = document.getElementById('nav-collapse-btn');
  var overlay = document.getElementById('mobile-menu-overlay');
  var panel = document.getElementById('mobile-menu-panel');
  if (!siteHeader || !headerInner || !headerLogo || !headerMainNav || !desktopNav || !headerCta || !navBtn || !overlay || !panel) return;

  var groups = panel.querySelectorAll('.mobile-menu-group');
  var hamburger = '<svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M3 5h14M3 10h14M3 15h14" stroke="#fff" stroke-width="1.5" stroke-linecap="round"/></svg>';
  var close = '<svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M5 5L15 15M15 5L5 15" stroke="#fff" stroke-width="1.5" stroke-linecap="round"/></svg>';

  function closeGroups() {
    groups.forEach(function (group) {
      group.classList.remove('open');
      var toggle = group.querySelector('.mobile-menu-toggle');
      if (toggle) toggle.setAttribute('aria-expanded', 'false');
    });
  }

  function closeMenu() {
    panel.classList.remove('open');
    overlay.classList.remove('open');
    navBtn.classList.remove('open');
    navBtn.setAttribute('aria-expanded', 'false');
    panel.setAttribute('aria-hidden', 'true');
    navBtn.innerHTML = hamburger;
    document.body.style.overflow = '';
    closeGroups();
  }

  function getNumericStyleValue(style, prop) {
    var value = parseFloat(style.getPropertyValue(prop));
    return Number.isFinite(value) ? value : 0;
  }

  function updateHeaderNavMode() {
    var wasMenuOnly = siteHeader.classList.contains('header-menu-only');
    if (wasMenuOnly) siteHeader.classList.remove('header-menu-only');

    var innerStyle = window.getComputedStyle(headerInner);
    var navStyle = window.getComputedStyle(desktopNav);
    var requiredWidth =
      getNumericStyleValue(innerStyle, 'padding-left') +
      getNumericStyleValue(innerStyle, 'padding-right') +
      headerLogo.getBoundingClientRect().width +
      getNumericStyleValue(navStyle, 'gap') +
      headerMainNav.getBoundingClientRect().width;
    var currentGap = headerMainNav.getBoundingClientRect().left - headerLogo.getBoundingClientRect().right;
    var safeGap = getNumericStyleValue(navStyle, 'gap') || 8;
    var availableWidth = headerInner.getBoundingClientRect().width;
    var shouldCollapse = currentGap <= safeGap || availableWidth <= requiredWidth;

    siteHeader.style.setProperty('--header-nav-min-width', Math.ceil(requiredWidth) + 'px');
    siteHeader.style.setProperty('--header-nav-safe-gap', safeGap + 'px');
    siteHeader.classList.toggle('header-menu-only', shouldCollapse);
    navBtn.setAttribute('aria-hidden', shouldCollapse ? 'false' : 'true');
    window.dispatchEvent(new CustomEvent('layout:header-metrics'));

    if (!shouldCollapse) closeMenu();
  }

  function openMenu() {
    panel.classList.add('open');
    overlay.classList.add('open');
    navBtn.classList.add('open');
    navBtn.setAttribute('aria-expanded', 'true');
    panel.setAttribute('aria-hidden', 'false');
    navBtn.innerHTML = close;
    document.body.style.overflow = 'hidden';
  }

  navBtn.setAttribute('aria-expanded', 'false');
  navBtn.setAttribute('aria-controls', 'mobile-menu-panel');
  navBtn.innerHTML = hamburger;
  navBtn.setAttribute('aria-hidden', 'true');

  updateHeaderNavMode();

  navBtn.addEventListener('click', function () {
    if (!siteHeader.classList.contains('header-menu-only')) return;
    if (panel.classList.contains('open')) closeMenu();
    else openMenu();
  });

  overlay.addEventListener('click', closeMenu);

  groups.forEach(function (group) {
    var toggle = group.querySelector('.mobile-menu-toggle');
    if (!toggle) return;
    toggle.addEventListener('click', function () {
      var willOpen = !group.classList.contains('open');
      closeGroups();
      if (willOpen) {
        group.classList.add('open');
        toggle.setAttribute('aria-expanded', 'true');
      }
    });
  });

  panel.querySelectorAll('a').forEach(function (link) {
    link.addEventListener('click', closeMenu);
  });

  window.addEventListener('resize', updateHeaderNavMode);

  if (typeof ResizeObserver !== 'undefined') {
    var resizeObserver = new ResizeObserver(function () {
      updateHeaderNavMode();
    });
    resizeObserver.observe(headerInner);
    resizeObserver.observe(headerLogo);
    resizeObserver.observe(headerMainNav);
  }

  document.addEventListener('keydown', function (event) {
    if (event.key === 'Escape') closeMenu();
  });
})();
</script>

<!-- 弹窗展开时显示 30% 天蓝背景图层（隐藏延迟与 mega-dropdown 的 2s 匹配，避免闪烁） -->
<script>
(function () {
  var skyOverlay = document.getElementById('nav-sky-overlay');
  var wrappers = document.querySelectorAll('.nav-dropdown-wrapper');
  if (!skyOverlay || !wrappers.length) return;
  var hideTimer = null;
  function closeAll() {
    clearTimeout(hideTimer);
    skyOverlay.classList.remove('open');
    skyOverlay.setAttribute('aria-hidden', 'true');
    wrappers.forEach(function (w) {
      var p = w.querySelector('.mega-dropdown');
      if (p) p.classList.remove('open');
    });
  }
  function openFor(wrapper) {
    clearTimeout(hideTimer);
    wrappers.forEach(function (w) {
      var p = w.querySelector('.mega-dropdown');
      if (p) p.classList.toggle('open', w === wrapper);
    });
    skyOverlay.classList.add('open');
    skyOverlay.setAttribute('aria-hidden', 'false');
  }
  function hideLater() {
    clearTimeout(hideTimer);
    hideTimer = setTimeout(closeAll, 2000);
  }
  wrappers.forEach(function (wrapper) {
    var panel = wrapper.querySelector('.mega-dropdown');
    wrapper.addEventListener('mouseenter', function () { openFor(wrapper); });
    wrapper.addEventListener('mouseleave', hideLater);
    if (panel) {
      panel.addEventListener('mouseenter', function () { clearTimeout(hideTimer); });
      panel.addEventListener('mouseleave', function (e) {
        if (wrapper.contains(e.relatedTarget)) return;
        closeAll();
      });
    }
  });
})();
</script>

<style is:global>

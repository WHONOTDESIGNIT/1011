---
// iShine 全站统一头部 — 最新版 trust-bar + site-header（源自 index.astro 内联实现）
// 保留 lang 传参（getLocalizedPath API 契约），导航结构与内容与首页最新版完全一致
import { getLocalizedPath } from '../lib/breadcrumbs';

interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props as Props;
const homeHref = getLocalizedPath(lang);
const contactHref = getLocalizedPath(lang, '/contact');
---

<!-- ═══ 1. TRUST BAR ═══ -->
<div class="trust-bar" id="trust-bar">
  <div class="trust-bar-inner">
    <div class="trust-slide" data-slide="shipping">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
      <span class="trust-text">Global Shipping</span>
    </div>
    <div class="trust-slide" data-slide="private-label" aria-hidden="true">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2H2v10l9.29 9.29a1 1 0 0 0 1.42 0l8.58-8.58a1 1 0 0 0 0-1.42z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
      <span class="trust-text">Private Label</span>
    </div>
    <div class="trust-slide" data-slide="chatgpt" aria-hidden="true">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l1.9 5.7a2 2 0 0 0 1.3 1.3L21 12l-5.8 1.9a2 2 0 0 0-1.3 1.3L12 21l-1.9-5.8a2 2 0 0 0-1.3-1.3L3 12l5.8-1.9a2 2 0 0 0 1.3-1.3z"/></svg>
      <span class="trust-text">ChatGPT Top Collection</span>
    </div>
  </div>
</div>

<!-- ═══ 2. HEADER ═══ -->
<header class="site-header" id="site-header">
  <div class="header-inner">
    <a class="header-logo" href={homeHref} aria-label="iShine Laser Epilator Supplier">
      <img src="/images/logos/ishine-logo.png" alt="iShine Laser Epilator Supplier" />
    </a>
    <div class="header-main-nav">
    <nav class="header-nav desktop-nav">
      <div class="nav-dropdown-wrapper">
        <a class="nav-item nav-has-dropdown" href="/products" data-dropdown="products">Products <svg class="nav-dropdown-chevron" width="12" height="7" viewBox="0 0 12 7" fill="none"><path d="M1 1L6 6L11 1" stroke="#020303" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
        <div class="mega-dropdown mega-dropdown--wide" id="mega-products">
          <div class="mega-inner mega-inner--products">
            <div class="mega-left mega-left--products">
              <div class="mega-products-grid">
                <a class="mega-product-card" href="/products/lumi-2">
                  <span class="mega-product-info">
                    <span class="mega-product-model">Lumi 2</span>
                    <span class="mega-product-tagline">Smart Skin Sensor, cooling to 10°C</span>
                  </span>
                  <img class="mega-product-img" src="/images/products/lumi-2/lumi-2-images%20(1).jpg" alt="Lumi 2" loading="lazy" onerror="this.onerror=null;this.src='/images/products/lumi-2/lumi-2-images%20(2).webp'" />
                </a>
                <a class="mega-product-card" href="/products/lumi">
                  <span class="mega-product-info">
                    <span class="mega-product-model">Lumi</span>
                    <span class="mega-product-tagline">Smart App Control</span>
                  </span>
                  <img class="mega-product-img" src="/images/products/lumi/RoseSkinCo-Lumi-IPL-Hair-Removal-Handset-white-Gold_jpg.webp" alt="Lumi" loading="lazy" onerror="this.onerror=null;this.src='/images/products/lumi-2/lumi-2-images%20(1).jpg'" />
                </a>
                <a class="mega-product-card" href="/products/venus">
                  <span class="mega-product-info">
                    <span class="mega-product-model">Venus</span>
                    <span class="mega-product-tagline">Premium Ice Cooling</span>
                  </span>
                  <img class="mega-product-img" src="/images/products/Venus/purple-venus-sapphire-ipl.webp" alt="Venus" loading="lazy" onerror="this.onerror=null;this.src='/images/products/lumi-2/lumi-2-images%20(1).jpg'" />
                </a>
                <a class="mega-product-card" href="/products/themis">
                  <span class="mega-product-info">
                    <span class="mega-product-model">Themis</span>
                    <span class="mega-product-tagline">Dual Lamp System</span>
                  </span>
                  <img class="mega-product-img" src="/images/products/Themis/golden-luxury-front-view.jpg" alt="Themis" loading="lazy" onerror="this.onerror=null;this.src='/images/products/Themis/golden-luxury-2.jpg'" />
                </a>
                <a class="mega-product-card" href="/products/emerald">
                  <span class="mega-product-info">
                    <span class="mega-product-model">Emerald</span>
                    <span class="mega-product-tagline">Sensitive-Skin Cooling</span>
                  </span>
                  <img class="mega-product-img" src="/images/products/Emerald/emerald%20ipl%20white%20color.webp" alt="Emerald" loading="lazy" onerror="this.onerror=null;this.src='/images/products/Emerald/emerald%20ipl%20packaging.jpg'" />
                </a>
                <a class="mega-product-card" href="/products/eirene">
                  <span class="mega-product-info">
                    <span class="mega-product-model">Eirene</span>
                    <span class="mega-product-tagline">Professional Grade</span>
                  </span>
                  <img class="mega-product-img" src="/images/products/Eirene/battery-built-in%20ipl%20device%20front%20view.jpg" alt="Eirene" loading="lazy" onerror="this.onerror=null;this.src='/images/products/Eirene/battery-built-in%20ipl%20device%20back.jpg'" />
                </a>
                <a class="mega-product-card" href="/products/wooden">
                  <span class="mega-product-info">
                    <span class="mega-product-model">Golden</span>
                    <span class="mega-product-tagline">Luxury Edition</span>
                  </span>
                  <img class="mega-product-img" src="/images/products/Wooden/wooden%20ipl%20white%20color%20front%20view.webp" alt="Golden" loading="lazy" onerror="this.onerror=null;this.src='/images/products/Wooden/wooden%20ipl%20holding.jpg'" />
                </a>
                <a class="mega-product-card" href="/products/hebe">
                  <span class="mega-product-info">
                    <span class="mega-product-model">Hebe</span>
                    <span class="mega-product-tagline">AI Skin Sensor</span>
                  </span>
                  <img class="mega-product-img" src="/images/products/Hebe/hebe%20ipl%20hair%20removal%20white%20color.webp" alt="Hebe" loading="lazy" onerror="this.onerror=null;this.src='/images/products/lumi-2/lumi-2-images%20(1).jpg'" />
                </a>
              </div>
              <div class="mega-divider-h" role="separator"></div>
              <div class="mega-components">
                <h4 class="mega-components-heading">ipl components</h4>
                <div class="mega-components-grid">
                  <a class="mega-component-card" href="/components/lamp-cartridges">
                    <img class="mega-component-img" src="/images/components/lamp-cartridge.jpg" alt="Lamp Cartridges" loading="lazy" onerror="this.onerror=null;this.src='/images/components/lamp-cartridge-closeup.jpg'" />
                    <span class="mega-component-name">Lamp Cartridges</span>
                  </a>
                  <a class="mega-component-card" href="/components/optical-filters">
                    <img class="mega-component-img" src="/images/components/optical-filters.jpg" alt="Optical Filters" loading="lazy" onerror="this.onerror=null;this.src='/images/components/component-quality-determines-device-performance.webp'" />
                    <span class="mega-component-name">Optical Filters</span>
                  </a>
                  <a class="mega-component-card" href="/components/cooling-system">
                    <img class="mega-component-img" src="/images/components/cooling-system.jpg" alt="Cooling System" loading="lazy" onerror="this.onerror=null;this.src='/images/components/cooling-system-closeup.jpg'" />

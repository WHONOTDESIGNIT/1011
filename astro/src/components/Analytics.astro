---
/**
 * Google Analytics 4（gtag.js，衡量 ID G-94BDNGHHJH）+ Consent Mode v2。
 *
 * 单一来源：BaseLayout 与「自建 <head>」的页面（/、/marketplace、/meet-the-team、/services/*）
 * 都引用本组件。此前这段脚本只写在 BaseLayout 里，那 7 个自建 head 的路由（× 22 语种）
 * 完全没有 GA4 —— 2026-09-14 线上逐路由实测发现后收敛到本组件，避免多份副本各自漂移。
 *
 * 顺序是硬要求：consent default 必须在 gtag.js 加载之前下发，否则首次访问会在用户做出选择前
 * 就写入 _ga cookie（欧盟/英国合规问题）。同意状态由 CookieConsent 组件驱动 —— 它在每次页面
 * 加载都会向 dataLayer 推送 {event:'consent-updated', consent:[levels]}，下面的桥接把 levels
 * 映射成 GA4 的 consent update，因此不需要改动那个组件。
 * wait_for_update 给这次推送 500ms 窗口，避免首屏过早按 denied 处理。
 */
---

<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('consent', 'default', {
    ad_storage: 'denied',
    ad_user_data: 'denied',
    ad_personalization: 'denied',
    analytics_storage: 'denied',
    wait_for_update: 500
  });
  // 同意状态 → GA4 consent update（拦截 dataLayer.push，不改动 CookieConsent 组件）
  (function () {
    var dl = window.dataLayer;
    var push = dl.push.bind(dl);
    dl.push = function () {
      var e = arguments[0];
      if (e && e.event === 'consent-updated') {
        var lv = e.consent || [];
        var s = Array.isArray(lv) ? lv.join(',') : String(lv);
        var analytics = s.indexOf('analytics') > -1 || s.indexOf('accept') > -1;
        var ads = s.indexOf('targeting') > -1;
        gtag('consent', 'update', {
          analytics_storage: analytics ? 'granted' : 'denied',
          ad_storage: ads ? 'granted' : 'denied',
          ad_user_data: ads ? 'granted' : 'denied',
          ad_personalization: ads ? 'granted' : 'denied'
        });
      }
      return push.apply(dl, arguments);
    };
  })();
  gtag('js', new Date());
  gtag('config', 'G-94BDNGHHJH');
</script>
<script async src="https://www.googletagmanager.com/gtag/js?id=G-94BDNGHHJH"></script>

---
import type { DropdownLink } from '../lib/types';
import { getLocalizedPath } from '../lib/breadcrumbs';
import { HamburgerIcon, CloseIcon, ChevronRight } from './icons';

interface Props {
  navItems: Array<{
    href: string;
    label: string;
    dropdown?: DropdownLink[];
  }>;
  lang: string;
  stickyNav?: boolean;
}

const { navItems, lang, stickyNav = true } = Astro.props as Props;
---

<header class:list={['develo-header top-0 z-110', stickyNav ? 'sticky' : '']}>
  <div class="develo-header-container">
    <!-- Logo -->
    <a class="develo-logo-link" href={getLocalizedPath(lang)} aria-label="iShine IPL Manufacturing – Home">
      <span class="develo-logo-mark">IS</span>
      <span class="develo-logo-text">
        <span class="develo-logo-title">iShine</span>
        <span class="develo-logo-subtitle">IPL Manufacturing</span>
      </span>
    </a>

    <!-- Desktop nav: lg (1024px) and above -->
    <div class="develo-desktop-nav">
      <nav class="develo-nav-links">
        {navItems.map((item) =>
          item.dropdown ? (
            <div class="develo-dropdown-container" data-dropdown>
              <a class="develo-nav-link develo-nav-link--dropdown" href={item.href} data-dropdown-trigger>
                {item.label}
                <svg class="develo-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 9l-7 7-7-7" /></svg>
              </a>
              <div class="develo-dropdown-panel" data-dropdown-panel>
                <div class="develo-dropdown-grid">
                  {item.dropdown.map((sub) => (
                    <a class="develo-dropdown-link" href={sub.href}>{sub.label}</a>
                  ))}
                </div>
              </div>
            </div>
          ) : (
            <a class="develo-nav-link" href={item.href}>
              {item.label}
            </a>
          )
        )}
      </nav>
      <a class="develo-cta-link" href={getLocalizedPath(lang, '/contact')}>Get in touch</a>
    </div>

    <!-- Hamburger button: below lg -->
    <button id="develo-mobile-toggle" class="develo-mobile-toggle" aria-label="Open menu">
      <span class="develo-hamburger-line"></span>
      <span class="develo-hamburger-line"></span>
      <span class="develo-hamburger-line"></span>
    </button>
  </div>

  <!-- Mobile menu overlay: below lg -->
  <div id="develo-mobile-panel" class="develo-mobile-panel">
    <div class="develo-mobile-header">
      <a class="develo-logo-link" href={getLocalizedPath(lang)} aria-label="iShine IPL Manufacturing – Home">
        <span class="develo-logo-mark">IS</span>
        <span class="develo-logo-text">
          <span class="develo-logo-title">iShine</span>
          <span class="develo-logo-subtitle">IPL Manufacturing</span>
        </span>
      </a>
      <button id="develo-mobile-close" class="develo-mobile-close" aria-label="Close menu">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
      </button>
    </div>
    <nav class="develo-mobile-nav">
      {navItems.map((item) => (
        <div class="develo-mobile-item">
          {item.dropdown ? (
            <>
              <button class="develo-mobile-trigger" data-mobile-dropdown-trigger>
                {item.label}
                <svg class="develo-mobile-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 9l-7 7-7-7" /></svg>
              </button>
              <div class="develo-mobile-sub hidden">
                {item.dropdown.map((sub) => (
                  <a class="develo-mobile-sublink" href={sub.href}>{sub.label}</a>
                ))}
              </div>
            </>
          ) : (
            <a class="develo-mobile-link" href={item.href}>{item.label}</a>
          )}
        </div>
      ))}
    </nav>
    <div class="develo-mobile-footer">
      <a class="develo-cta-link" href={getLocalizedPath(lang, '/contact')}>Get in touch</a>
    </div>
  </div>
</header>

<!-- Dropdown hover JS -->
<script is:inline>
;(function initDropdowns() {
  const containers = document.querySelectorAll('[data-dropdown]')
  for (const container of containers) {
    const trigger = container.querySelector('[data-dropdown-trigger]')
    const panel = container.querySelector('[data-dropdown-panel]')
    if (!trigger || !panel) continue

    let hideTimer = null

    function show() {
      if (hideTimer) { clearTimeout(hideTimer); hideTimer = null }
      panel.classList.remove('develo-dropdown-hidden')
      trigger.classList.add('develo-nav-link--active')
    }

    function hide() {
      hideTimer = setTimeout(function () {
        panel.classList.add('develo-dropdown-hidden')
        trigger.classList.remove('develo-nav-link--active')
      }, 80)
    }

    container.addEventListener('mouseenter', function () {
      if (hideTimer) { clearTimeout(hideTimer); hideTimer = null }
      show()
    })
    container.addEventListener('mouseleave', hide)
    panel.addEventListener('mouseenter', function () {
      if (hideTimer) { clearTimeout(hideTimer); hideTimer = null }
    })
    panel.addEventListener('mouseleave', hide)
  }
})()
</script>

<!-- Mobile menu JS -->
<script is:inline>
document.addEventListener('DOMContentLoaded', function() {
  const btn = document.getElementById('develo-mobile-toggle')
  const panel = document.getElementById('develo-mobile-panel')
  const close = document.getElementById('develo-mobile-close')
  if (!btn || !panel) return

  function openMenu() {
    panel.classList.add('develo-mobile-panel--open')
    document.body.style.overflow = 'hidden'
  }

  function closeMenu() {
    panel.classList.remove('develo-mobile-panel--open')
    document.body.style.overflow = ''
  }

  btn.addEventListener('click', openMenu)
  if (close) close.addEventListener('click', closeMenu)
  panel.addEventListener('click', function(e) {
    if (e.target === panel) closeMenu()
  })
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') closeMenu()
  })

  // Mobile accordion
  panel.querySelectorAll('[data-mobile-dropdown-trigger]').forEach(function(trigger) {
    trigger.addEventListener('click', function() {
      const parent = trigger.closest('.develo-mobile-item')
      const content = parent.querySelector('.develo-mobile-sub')
      const chevron = trigger.querySelector('.develo-mobile-chevron')
      if (!content) return
      content.classList.toggle('hidden')
      if (chevron) chevron.classList.toggle('rotate-180')
    })
  })
})
</script>

<style is:global>
/* ──────────────────────────────────────────────
   Develo-style Header for iShine
   ────────────────────────────────────────────── */

.develo-header {
  position: sticky;
  top: 0;
  z-index: 110;
  background-color: transparent;
  transition: background-color 0.3s, box-shadow 0.3s;
}

.develo-header-container {
  display: flex;
  align-items: center;
  justify-content: space-between;
  max-width: 1280px;
  margin: 0 auto;
  padding: 0 24px 0 40px;
  height: 70px;
  gap: 40px;
}

/* Logo */
.develo-logo-link {
  display: flex;
  align-items: center;
  gap: 14px;
  text-decoration: none;
  flex-shrink: 0;
}

.develo-logo-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40px;
  height: 40px;
  background-color: #020303;
  color: #fff;
  font-family: Syne, sans-serif;
  font-weight: 700;
  font-size: 14px;
  border-radius: 12px;
}

.develo-logo-text {
  display: flex;
  flex-direction: column;
}

.develo-logo-title {
  font-family: Syne, sans-serif;
  font-weight: 600;
  font-size: 13px;
  text-transform: uppercase;
  letter-spacing: 0.24em;
  color: #020303;
  line-height: 1.2;
}

.develo-logo-subtitle {
  font-family: Manrope, sans-serif;
  font-size: 12px;
  color: #6b7380;
  line-height: 1.3;
}

/* Desktop nav container */
.develo-desktop-nav {
  display: none;
  flex: 1;
  align-items: center;
  justify-content: flex-end;
  gap: 32px;
}

@media (min-width: 1024px) {
  .develo-desktop-nav {
    display: flex;
  }
}

.develo-nav-links {
  display: flex;
  align-items: center;
  gap: 4px;
}

.develo-nav-link {
  font-family: Manrope, sans-serif;
  font-size: 16px;
  font-weight: 400;
  color: #020303;
  padding: 16px;
  text-decoration: none;
  transition: color 0.2s, text-decoration-color 0.2s;
  white-space: nowrap;
  border-radius: 0;
}

.develo-nav-link:hover,
.develo-nav-link--active {
  color: #563cfa;
}

.develo-nav-link--dropdown {
  display: inline-flex;
  align-items: center;
  gap: 4px;
}

.develo-chevron {
  color: #9ca3af;
  transition: transform 0.2s, opacity 0.2s;
  opacity: 0;
}

.develo-nav-link--active .develo-chevron {
  opacity: 1;
  transform: rotate(180deg);
  color: #563cfa;
}

/* CTA link (Develo style: text link, not button) */
.develo-cta-link {
  font-family: Manrope, sans-serif;
  font-size: 16px;
  font-weight: 400;
  color: #563cfa;
  text-decoration: none;
  transition: color 0.2s, text-decoration-color 0.2s;
  white-space: nowrap;
  padding: 8px 0;
}

.develo-cta-link:hover {
  color: #3a28c9;
  text-decoration: underline;
}

/* Desktop dropdown panel */
.develo-dropdown-container {
  position: relative;
}

.develo-dropdown-panel {
  position: absolute;
  left: 50%;
  top: calc(100% + 8px);
  z-index: 50;
  transform: translateX(-50%);
  background: #fff;
  border: 1px solid #e5e7eb;
  border-radius: 16px;
  padding: 8px;
  box-shadow: 0 10px 30px rgba(0,0,0,0.08);
  opacity: 1;
  visibility: visible;
  transition: opacity 0.2s, transform 0.2s, visibility 0.2s;
}

.develo-dropdown-panel::before {
  content: '';
  position: absolute;
  top: -6px;
  left: 50%;
  transform: translateX(-50%) rotate(45deg);
  width: 12px;
  height: 12px;
  background: #fff;
  border-left: 1px solid #e5e7eb;
  border-top: 1px solid #e5e7eb;
}

.develo-dropdown-hidden {
  opacity: 0;
  visibility: hidden;
  transform: translateX(-50%) scale(0.95);
  pointer-events: none;
}

.develo-dropdown-grid {
  display: grid;
  gap: 2px;
  min-width: 180px;
}

.develo-dropdown-link {
  display: block;
  padding: 10px 16px;
  font-family: Manrope, sans-serif;
  font-size: 14px;
  color: #374151;
  text-decoration: none;
  border-radius: 10px;
  transition: background-color 0.15s, color 0.15s;
  white-space: nowrap;
}

.develo-dropdown-link:hover {
  background-color: #f3f4f6;
  color: #563cfa;
}

/* Hamburger toggle */
.develo-mobile-toggle {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4px;
  width: 44px;
  height: 44px;
  background: transparent;
  border: none;
  cursor: pointer;
  padding: 12px;
}

@media (min-width: 1024px) {
  .develo-mobile-toggle {
    display: none;
  }
}

.develo-hamburger-line {
  display: block;
  width: 20px;
  height: 2px;
  background-color: #020303;
  border-radius: 2px;
}

/* Mobile panel */
.develo-mobile-panel {
  display: none;
}

.develo-mobile-panel--open {
  display: flex;
  flex-direction: column;
  position: fixed;
  inset: 0;
  z-index: 200;
  background: #fff;
}

.develo-mobile-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24px 0 40px;
  height: 70px;
  border-bottom: 1px solid #e5e7eb;
}

.develo-mobile-close {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  background: transparent;
  border: none;
  cursor: pointer;
  color: #020303;
}

.develo-mobile-nav {
  flex: 1;
  overflow-y: auto;
  padding: 16px 24px;
}

.develo-mobile-item {
  border-bottom: 1px solid #f3f4f6;
}

.develo-mobile-link,
.develo-mobile-trigger {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  padding: 16px 0;
  font-family: Manrope, sans-serif;
  font-size: 16px;
  font-weight: 500;
  color: #020303;
  text-decoration: none;
  background: transparent;
  border: none;
  cursor: pointer;
  text-align: left;
}

.develo-mobile-trigger:hover,
.develo-mobile-link:hover {
  color: #563cfa;
}

.develo-mobile-chevron {
  transition: transform 0.2s;
  color: #9ca3af;
}

.develo-mobile-sub {
  padding-bottom: 8px;
}

.develo-mobile-sublink {
  display: block;
  padding: 12px 16px;
  font-family: Manrope, sans-serif;
  font-size: 15px;
  color: #374151;
  text-decoration: none;
  border-radius: 10px;
  transition: background-color 0.15s;
}

.develo-mobile-sublink:hover {
  background-color: #f3f4f6;
  color: #563cfa;
}

.develo-mobile-footer {
  padding: 16px 24px 32px;
  border-top: 1px solid #e5e7eb;
  text-align: center;
}
</style>

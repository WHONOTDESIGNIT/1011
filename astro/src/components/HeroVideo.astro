---
// 首屏视频（首页 + 4 个服务页 + 团队页共用）。
//
// 之前是 `<video autoplay>`：这个 505KB 的 mp4 一进 HTML 就按高优先级下载，
// 在移动端就是 LCP 元素，还占满带宽约 6s（2026-10-24 实测，Fast 3G 模拟：
// 视频 1572ms 起下、5890ms 下完，整页 load 被拖到 7.2s，下面的字体/图片全排在它后面）。
//
// 现在默认只渲染 poster（17KB），等 window.load 之后、且网络不是 2G/3G、用户没开省流量、
// 没设"减少动效"时才去拉视频。慢网下永远只留 poster，不浪费一次 505KB 的下载。
//
// shortcut: 只按"首屏可见"假设做 load 后加载，没有做滚动观察器 —— 视频本来就总在第一屏；
// 若以后把它挪到折叠线以下，需要换成 IntersectionObserver。
interface Props {
  /** 首页带播放/暂停按钮；服务页只有画面。 */
  withControls?: boolean;
}
const { withControls = false } = Astro.props;
---

<div class="video-section">
  <div class="video-placeholder">
    <video
      class="hero-video"
      muted
      loop
      playsinline
      preload="none"
      width="360"
      height="641"
      poster="/images/home/head-video-poster.webp"
    >
      <source src="/videos/head-video.mp4" type="video/mp4" />
    </video>
    <button class="hero-video-toggle" type="button" aria-label="Play video" hidden>
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
        <path d="M8 5v14l11-7z" fill="currentColor" />
      </svg>
    </button>
    <script is:inline>
      (function () {
        var wrap = document.querySelector('.video-placeholder');
        if (!wrap) return;
        var video = wrap.querySelector('video');
        var btn = wrap.querySelector('.hero-video-toggle');
        if (!video) return;
        var started = false;

        function showButton() { if (btn) btn.hidden = false; }
        function hideButton() { if (btn) btn.hidden = true; }

        function play() {
          if (started) return;
          started = true;
          video.preload = 'auto';
          // iOS/Safari：play() 之前 muted 必须为 true，光有 attribute 有时不生效
          video.muted = true;
          var p = video.play();
          if (p && p.catch) p.catch(function () { started = false; showButton(); });
        }

        // 网络差 / 省流量 / 减少动效：不自动拉这 505KB，但必须留下播放入口
        function auto() {
          if (matchMedia('(prefers-reduced-motion: reduce)').matches) { showButton(); return; }
          var c = navigator.connection || {};
          if (c.saveData || /(^|-)2g$/.test(c.effectiveType || '')) { showButton(); return; }
          play();
        }

        if (btn) btn.addEventListener('click', function () { hideButton(); play(); });
        video.addEventListener('playing', hideButton);
        video.addEventListener('error', showButton);
        video.addEventListener('click', function () {
          if (video.paused) { started = false; play(); }
          else { video.pause(); started = false; showButton(); }
        });

        function later() {
          if (window.requestIdleCallback) requestIdleCallback(auto, { timeout: 2000 });
          else setTimeout(auto, 300);
        }
        if (document.readyState === 'complete') later();
        else addEventListener('load', later, { once: true });
        // 兜底：第三方脚本挂住导致 load 迟迟不来时，6s 后仍然尝试
        setTimeout(function () { if (!started) auto(); }, 6000);
      })();
    </script>
  </div>
</div>

<style is:global>
  /* 视频源是 360x641 竖版。video 和 img 不同：它不会用 width/height 属性推导宽高比，
     preload="none" 时元数据到达前高度算不出来，poster/元数据一到就往下推 600 多像素。
     线上移动端 Lighthouse 的 CLS 0.448 有 99.8% 来自这一个元素。
     aspect-ratio 在首帧就锁死比例，属性保留作旧浏览器兜底。
     比例与素材一致，所以 object-fit: cover 不会裁掉任何画面。 */
  .video-placeholder video {
    aspect-ratio: 360 / 641;
    width: 100%;
    height: auto;
    object-fit: cover;
  }

  /* Desktop/tablet: the section used to size itself from the video's intrinsic width
     once the poster arrived, so it jumped 570px -> 360px at ~5s (0.1158 layout shift,
     desktop CLS 0.1184). Pin the width it settles at, from the first frame.
     It has to live here: the element renders from this component and carries no
     data-astro-cid, so the .video-section rules in index.astro never match it. */
  @media (min-width: 768px) {
    .video-section { width: 360px; }
  }
</style>

<style is:global>
  .video-placeholder { position: relative; }
  .hero-video-toggle {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 56px;
    height: 56px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    border: 1px solid rgba(255, 255, 255, 0.5);
    background: rgba(17, 24, 39, 0.55);
    color: #fff;
    cursor: pointer;
    backdrop-filter: blur(2px);
  }
  .hero-video-toggle[hidden] { display: none; }
  .hero-video-toggle:hover { background: rgba(17, 24, 39, 0.75); }
</style>

---
import { getRelativeLocaleUrl, pathHasLocale, getPathByLocale } from 'astro:i18n';
import { LANGUAGE_CONFIG } from '../config/i18n';
import { t } from '../lib/i18n';

interface Props {
  lang?: string;
  variant?: 'header' | 'mobile';
}

const { lang: langProp, variant = 'header' } = Astro.props;
// 未显式传 lang 时，从 URL 自动推导当前语言
const lang = langProp || Astro.currentLocale || (Astro.url.pathname.startsWith('/tr') ? 'tr' : Astro.url.pathname.startsWith('/ar') ? 'ar' : Astro.url.pathname.startsWith('/es') ? 'es-ES' : Astro.url.pathname.startsWith('/fr') ? 'fr' : Astro.url.pathname.startsWith('/ru') ? 'ru' : Astro.url.pathname.startsWith('/he') ? 'he' : Astro.url.pathname.startsWith('/pt-br') ? 'pt-BR' : Astro.url.pathname.startsWith('/pt-pt') ? 'pt-PT' : Astro.url.pathname.startsWith('/ro') ? 'ro' : Astro.url.pathname.startsWith('/ko') ? 'ko' : Astro.url.pathname.startsWith('/ja') ? 'ja' : Astro.url.pathname.startsWith('/pl') ? 'pl' : Astro.url.pathname.startsWith('/nl') ? 'nl' : Astro.url.pathname.startsWith('/id') ? 'id' : Astro.url.pathname.startsWith('/fa') ? 'fa' : Astro.url.pathname.startsWith('/el') ? 'el' : Astro.url.pathname.startsWith('/th') ? 'th' : Astro.url.pathname.startsWith('/vi') ? 'vi' : Astro.url.pathname.startsWith('/it') ? 'it' : 'en');

// 剥离当前 URL 的语言前缀，得到「无前缀路径」再交给 getRelativeLocaleUrl，
// 保证 EN/TR 互切链接不叠加前缀（en 无前缀，tr 带 /tr/）。
// 用 getPathByLocale(code) 还原 URL path（es-ES→es），
// 并加 (?=/|$) 防止误匹配。
const currentPath = Astro.url.pathname;
const pathWithoutLocale = pathHasLocale(currentPath)
  ? currentPath.replace(new RegExp(`^/${getPathByLocale(lang)}(?=/|$)`), '') || '/'
  : currentPath || '/';

const current = LANGUAGE_CONFIG.find((l) => l.code === lang) ?? LANGUAGE_CONFIG[0];

// 国旗改由 CSS 伪元素承载（2026-09-22）：本组件每页渲染 2 个实例（header + 移动菜单），
// 每个实例 1 个 trigger + 22 个选项 —— 原来的 <img> 写法等于每页 46 个图片节点，
// 既计入 Lighthouse 的 DOM 规模，也让 a11y 审计把它当成"46 个空 alt 图片"反复提示。
// 伪元素不产生 DOM 节点、不产生 <img>、也不进入可访问性树（装饰图本就该如此），
// 而 <a>/<button> 上原有的 aria-label / 可见语言名语义完全不变。
// 下面这张表必须与 <style> 里的国旗规则表一一对应：新增语种若换了国旗国家代码，
// 这里会直接让构建失败，避免出现"语种加了、旗子不显示"的静默缺口。
const FLAG_CCS = ['us', 'tr', 'il', 'ru', 'ro', 'pl', 'gr', 'it', 'kr', 'jp', 'cz', 'de', 'sa', 'nl', 'es', 'fr', 'br', 'pt', 'id', 'th', 'vn', 'ir'];
const missingFlag = LANGUAGE_CONFIG.filter((l) => !FLAG_CCS.includes(l.countryCode));
if (missingFlag.length) {
  throw new Error(
    `LanguageSwitcher: 缺少国旗 CSS 规则 —— ${missingFlag.map((l) => `${l.code}(${l.countryCode})`).join(', ')}；` +
      `请在 <style> 的国旗规则表里补上 .ls-flag[data-flag='${missingFlag[0].countryCode}'] 这一行。`
  );
}

// 链接规范：所有语种链接统一不带末尾斜杠（根路径除外），如 /tr/products/lumi
// normalizeLocale:false 保留 locale 原始大小写（pt-BR），与构建目录一致，
// 避免在 Linux（Netlify）上因大小写不敏感差异导致 /pt-pt/ 404
const localeHref = (l: string, p: string) => {
  const url = getRelativeLocaleUrl(l, p, { normalizeLocale: false });
  return url.length > 1 ? url.replace(/\/+$/, '') : url;
};
---

<div class:list={['ls', variant === 'mobile' && 'ls--mobile']} data-lang-switcher>
  <button
    type="button"
    class="ls-trigger ls-flag"
    data-ls-trigger
    data-flag={current.countryCode}
    aria-haspopup="dialog"
    aria-expanded="false"
    aria-label={t(lang, 'languageSwitcher.switchLanguage')}
  >
    <span class="ls-trigger-label">{current.nativeName}</span>
    <svg class="ls-chevron" width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true"><path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </button>

  <div class="ls-backdrop" data-ls-backdrop></div>

  <div class="ls-panel" role="dialog" aria-modal="true" aria-label={t(lang, 'languageSwitcher.chooseLanguage')} data-ls-panel>
    <div class="ls-panel-header">
      <h3 class="ls-title">{t(lang, 'languageSwitcher.chooseLanguage')}</h3>
      <button type="button" class="ls-close" data-ls-close aria-label={t(lang, 'languageSwitcher.close')}>
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4 4L12 12M12 4L4 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
      </button>
    </div>
    <div class="ls-grid">
      {LANGUAGE_CONFIG.map((l) =>
        l.enabled ? (
          <a
            class:list={['ls-option', 'ls-flag', { active: l.code === lang }]}
            href={localeHref(l.code, pathWithoutLocale)}
            hreflang={l.code}
            lang={l.code}
            aria-label={l.label}
            aria-current={l.code === lang ? 'true' : undefined}
            data-ls-option
            data-flag={l.countryCode}
          >
            <span class="ls-option-name">{l.nativeName}</span>
          </a>
        ) : (
          <div class="ls-option ls-option--disabled ls-flag" data-flag={l.countryCode} title={`${l.label} — ${t(lang, 'languageSwitcher.comingSoon')}`}>
            <span class="ls-option-name">{l.nativeName}</span>
            <span class="ls-option-badge">{t(lang, 'languageSwitcher.comingSoon')}</span>
          </div>
        )
      )}
    </div>
  </div>
</div>

<script>
  (function () {
    // 语言偏好持久化 key（与各页面 <head> 内的重定向脚本共用）
    const LS_KEY = 'ishine_lang';

    document.querySelectorAll('[data-lang-switcher]').forEach((root) => {
      const trigger = root.querySelector('[data-ls-trigger]');
      const backdrop = root.querySelector('[data-ls-backdrop]');
      const panel = root.querySelector('[data-ls-panel]');
      const closeBtn = root.querySelector('[data-ls-close]');
      if (!trigger || !backdrop || !panel) return;

      const open = () => {
        // .site-header 的 transform 会改变 fixed 定位上下文，
        // 将遮罩与弹窗挂到 body 下，确保相对视口居中
        if (backdrop.parentElement !== document.body) document.body.appendChild(backdrop);
        if (panel.parentElement !== document.body) document.body.appendChild(panel);
        root.classList.add('open');
        backdrop.classList.add('ls--visible');
        panel.classList.add('ls--visible');
        trigger.setAttribute('aria-expanded', 'true');
        // 记录原锁定状态，关闭时恢复，避免覆盖移动菜单自身的滚动锁
        if (document.body.dataset.lsPrevOverflow === undefined) {
          document.body.dataset.lsPrevOverflow = document.body.style.overflow || '';
        }
        if (document.documentElement.dataset.lsPrevOverflow === undefined) {
          document.documentElement.dataset.lsPrevOverflow = document.documentElement.style.overflow || '';
        }
        // 同时锁定 html/body：滚动条彻底消失后，fixed + inset:0 + margin:auto
        // 才能让弹窗几何中心与视口几何中心精确重合
        document.body.style.overflow = 'hidden';
        document.documentElement.style.overflow = 'hidden';
      };
      const close = () => {
        root.classList.remove('open');
        backdrop.classList.remove('ls--visible');
        panel.classList.remove('ls--visible');
        trigger.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = document.body.dataset.lsPrevOverflow ?? '';
        delete document.body.dataset.lsPrevOverflow;
        document.documentElement.style.overflow = document.documentElement.dataset.lsPrevOverflow ?? '';
        delete document.documentElement.dataset.lsPrevOverflow;
      };

      trigger.addEventListener('click', (e) => {
        e.stopPropagation();
        root.classList.contains('open') ? close() : open();
      });
      backdrop.addEventListener('click', close);
      if (closeBtn) closeBtn.addEventListener('click', close);
      // 点击弹窗内部不冒泡到 backdrop
      panel.addEventListener('click', (e) => e.stopPropagation());

      // 点击任意可切换语言链接时，先把选择持久化到 localStorage，
      // 保证跳转后其它页面仍按该语言加载（点击已选语言仅收起，同样记录无副作用）
      panel.querySelectorAll('[data-ls-option]').forEach((el) => {
        el.addEventListener('click', () => {
          const code = el.getAttribute('hreflang');
          if (code) {
            try { localStorage.setItem(LS_KEY, code); } catch (e) { /* 隐私模式忽略 */ }
          }
        });
      });

      // 点击「已选语言」仅收起弹窗（不跳转刷新当前页）
      panel.querySelectorAll('[data-ls-option].active').forEach((el) => {
        el.addEventListener('click', (e) => {
          e.preventDefault();
          close();
        });
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && root.classList.contains('open')) close();
      });
    });
  })();
</script>

<style is:global>
/* ═══ 多语言切换器 ═══ */
.ls {
  position: relative;
  flex: 0 0 auto;
}
.ls-trigger {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 7px 12px 7px 8px;
  border: 1px solid var(--color-gray-300);
  border-radius: 100px;
  background: var(--color-white);
  cursor: pointer;
  font-family: Manrope, system-ui, sans-serif;
  transition: border-color 0.2s, box-shadow 0.2s;
}
.ls-trigger:hover { border-color: var(--color-primary); }
.ls-trigger-label {
  font-size: 13px;
  font-weight: 600;
  line-height: 1;
  color: var(--color-ink);
  white-space: nowrap;
}
.ls-chevron {
  flex-shrink: 0;
  color: var(--color-gray-500);
  transition: transform 0.25s ease;
}
.ls.open .ls-chevron { transform: rotate(180deg); }

/* 国旗：由 CSS 伪元素承载（2026-09-22 改造）
   每页原本有 46 个 <img class="ls-flag">（2 个切换器实例 × (1 trigger + 22 选项)），
   既占 Lighthouse 的 DOM 规模，又被 a11y 审计当成 46 个空 alt 图片反复提示。
   现在旗标是 anchor/button 上的 ::before：不产生 DOM 节点、不产生 <img>、也不进可访问性树
   （装饰图本该如此），而语言名的可见文本与 aria-label 语义完全不变。
   配色/圆角/描边在此统一；URL 由下面每行的 data-flag 规则提供。
   ⚠ 新增语种时：先确认 LANGUAGE_CONFIG 的国家代码已在本表里，否则构建会报错提示补哪一行。 */
.ls-flag::before {
  content: '';
  flex-shrink: 0;
  width: 28px;
  height: 21px;
  background-color: #e5e7eb; /* 图片未就绪/被拦截时的灰色占位（替代原 JS 兜底 <img>） */
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  border-radius: 3px;
  box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.08);
}
/* 各语种国旗（data-flag = 国家代码，来自 LANGUAGE_CONFIG.countryCode）
   ⚠ 图标在此以 data URI 内联（2026-10-14，第三轮修复）。
   第一轮：来源曾是第三方 flagcdn.com，该域名在部分网络下不可达，22 面旗静默退化成
   上面那层灰色占位块 —— 改为自持 PNG 文件。
   第二轮：去掉 `--ls-flag-url` 变量与 `.ls--ready` 延迟加载门槛。该门槛只在
   pointerenter/focusin 之后才启用背景图，于是"从未悬停过切换器"的用户打开面板时
   看到的仍是 22 个灰块。
   第三轮（本次）：线上仍被报"国旗全灰"，而服务端逐项验证全部正常 —— PNG 是有效字节、
   CSS 规则正确、新 CSS 已发布、旧 CSS 已 404、CSP 为 Report-Only 不拦截、
   DOM 中 46 个 ls-flag 齐备。为彻底消除"图片需第二次请求才能显示"这一类故障，
   改为把 22 面旗直接内联进 CSS：约 12 KB 随样式一次性下发，零额外请求、
   不存在取不到的情况，也不受任何客户端缓存或拦截影响。
   格式 80x60 PNG（显示 28x21 CSS px，约 2.9x 密度）。选 PNG 而非 SVG 是因为矢量版
   仅西班牙/沙特两面就接近 180 KB（国徽与书法细节），而 PNG 全量仅 7.6 KB。
   public/images/flags/ 下的独立 PNG 已随之删除，避免同一资源两处维护。 */
.ls-flag[data-flag='us']::before { background-image: url('data:image/png;base64,'); }
.ls-flag[data-flag='tr']::before { background-image: url('data:image/png;base64,'); }
.ls-flag[data-flag='il']::before { background-image: url('data:image/png;base64,'); }
.ls-flag[data-flag='ru']::before { background-image: url('data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAFAAAAA1BAMAAAAkBnF3AAAAD1BMVEXVKx4AOab///+OMEuqveHhfiP9AAAAKUlEQVRIx2NUYiAOMDGMKhxVOHgUshCbcBkFR8NxVOFwTuGjYBQMSQAASsMAwmh8IyAAAAAASUVORK5CYII='); }
.ls-flag[data-flag='ro']::before { background-image: url('data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAFAAAAA1BAMAAAAkBnF3AAAAD1BMVEXOESYAK3/80RZUYlvdUCC+xjniAAAAJklEQVRIx2MQRAZGSkhAhQEFjCocVTiqcFThqMJRhaMKRxVSQSEA6aGUCJuKIGMAAAAASUVORK5CYII='); }
.ls-flag[data-flag='pl']::before { background-image: url('data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAFAAAAAyAQMAAADx486/AAAABlBMVEXcFDz////vuDXSAAAAE0lEQVQoz2P4DwcMo0wIcxSgAwBb0PkHxoHwIwAAAABJRU5ErkJggg=='); }
.ls-flag[data-flag='gr']::before { background-image: url('data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAFAAAAA1BAMAAAAkBnF3AAAAIVBMVEX///8NXq9Kh8PD1+uGr9fL3e4xdrtnms2lw+GXut11pNKU2lP+AAAAaklEQVRIx2MQBAExBgZWQfyAYRgrFGfACYaCQiUQUAcqBDO0jHEBNG0cuINnKCgEe8kUqAbMsFTCBeDhyDwc4hpVoZgLLjC8sivYS55AhS74AcOwAkpEAgZBIsGQUGhMJBhecT2sopBYhQBrinTBHs9DVgAAAABJRU5ErkJggg=='); }
.ls-flag[data-flag='it']::before { background-image: url('data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAFAAAAA1BAMAAAAkBnF3AAAAD1BMVEXOKzcAkkb///9VtoPecHj7ZEZ0AAAAJklEQVRIx2MQRAZGSkhAhQEFjCocVTiqcFThqMJRhaMKRxVSQSEA6aGUCJuKIGMAAAAASUVORK5CYII='); }
.ls-flag[data-flag='kr']::before { background-image: url('data:image/png;base64,'); }
.ls-flag[data-flag='jp']::before { background-image: url('data:image/png;base64,'); }
.ls-flag[data-flag='cz']::before { background-image: url('data:image/png;base64,'); }
.ls-flag[data-flag='de']::before { background-image: url('data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAFAAAAAwAgMAAAD7ixVkAAAACVBMVEUAAADdAAD/zgDGIigcAAAAG0lEQVQoz2NgGAVUBaFYwKgg+YKrsIBRQbIFAbpUPtBQ8ZOVAAAAAElFTkSuQmCC'); }
.ls-flag[data-flag='sa']::before { background-image: url('data:image/png;base64,'); }
.ls-flag[data-flag='nl']::before { background-image: url('data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAFAAAAA1BAMAAAAkBnF3AAAAD1BMVEWuHCj///8hRovIZm5rhLLyO+d3AAAAK0lEQVRIx2NgGAWjYCgCYyIBgyCRYFThqMJBpdCFSMCgRCQYVTiqcDApBADNaJoRWwlNAgAAAABJRU5ErkJggg=='); }
.ls-flag[data-flag='es']::before { background-image: url('data:image/png;base64,'); }
.ls-flag[data-flag='fr']::before { background-image: url('data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAFAAAAA1BAMAAAAkBnF3AAAAD1BMVEX///8AJlTOESbeYG5Wb42QNrxKAAAAJ0lEQVRIx2MQRAYODEiAWQkZMIwqHFU4qnBU4ajCUYWjCkcVUkEhAIQklyN0REMMAAAAAElFTkSuQmCC'); }
.ls-flag[data-flag='br']::before { background-image: url('data:image/png;base64,'); }
.ls-flag[data-flag='pt']::before { background-image: url('data:image/png;base64,'); }
.ls-flag[data-flag='id']::before { background-image: url('data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAFAAAAA1AgMAAACrRoTXAAAACVBMVEX/AAD/////f3/sDLJDAAAAG0lEQVQ4y2NgGAWjAC9YhQUwhGIBo4KjgnAAAA8AufGM9Lq4AAAAAElFTkSuQmCC'); }
.ls-flag[data-flag='th']::before { background-image: url('data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAFAAAAA1BAMAAAAkBnF3AAAAD1BMVEWlGTEtKkr09fiyP1Oysr55zkMlAAAANUlEQVRIx2NgGAVUAcZEAgYlIsGoQvwKXYgEDIJEglGFowoHlUKiU/hoSUEdhUSX4aOAKgAAbROnWeiw6CoAAAAASUVORK5CYII='); }
.ls-flag[data-flag='vn']::before { background-image: url('data:image/png;base64,'); }
.ls-flag[data-flag='ir']::before { background-image: url('data:image/png;base64,'); }

/* trigger 上的国旗立即加载（它是可见的当前语言标识）；面板内 44 面延迟到悬停/聚焦/展开 */
/* 每条规则自带 background-image：面板 / trigger / 移动端一律直接生效 */

/* 弹窗遮罩：浅灰色、不透明度固定 30% */
.ls-backdrop {
  position: fixed;
  inset: 0;
  background: rgba(156, 163, 175, 0.3);
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  z-index: 300;
  transition: opacity 0.25s ease, visibility 0s 0.25s;
}
.ls-backdrop.ls--visible {
  opacity: 1;
  visibility: visible;
  pointer-events: auto;
  transition: opacity 0.25s ease, visibility 0s 0s;
}

/* 弹窗面板：接近全屏、视口居中（fixed + inset:0 + margin:auto 无平移依赖） */
.ls-panel {
  position: fixed;
  inset: 0;
  margin: auto;
  width: min(680px, 92vw);
  height: min(580px, 82vh);
  background: var(--color-white);
  border-radius: 24px;
  box-shadow: 0 24px 60px rgba(2, 3, 3, 0.28);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  z-index: 301;
  transform: scale(0.96);
  transition: opacity 0.25s ease, transform 0.25s ease, visibility 0s 0.25s;
}
.ls-panel.ls--visible {
  opacity: 1;
  visibility: visible;
  pointer-events: auto;
  transform: scale(1);
  transition: opacity 0.25s ease, transform 0.25s ease, visibility 0s 0s;
}

.ls-panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 20px 24px 14px;
  border-bottom: 1px solid var(--color-gray-200);
  flex-shrink: 0;
}
/* 标题：固定 Manrope 字体栈 + 显式常规渲染参数，杜绝跨设备字体压扁变形 */
.ls-title {
  margin: 0;
  min-width: 0;
  font-family: Manrope, system-ui, -apple-system, 'Segoe UI', sans-serif;
  font-size: 20px;
  font-weight: 700;
  line-height: 1.35;
  letter-spacing: normal;
  font-stretch: normal;
  font-style: normal;
  font-variant: normal;
  text-rendering: optimizeLegibility;
  color: var(--color-ink);
}
.ls-close {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 34px;
  height: 34px;
  flex-shrink: 0;
  border: 1px solid var(--color-gray-200);
  border-radius: 100px;
  background: var(--color-white);
  color: var(--color-gray-500);
  cursor: pointer;
  transition: border-color 0.2s, color 0.2s, background 0.2s;
}
.ls-close:hover { border-color: var(--color-primary); color: var(--color-primary); }

/* 两列自适应网格：完全隐藏自带滚动条（滚动仍可用，桌面端内容可完整容纳） */
.ls-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 4px;
  padding: 16px 24px 24px;
  overflow-y: auto;
  overscroll-behavior: contain;
  scrollbar-width: none;
  -ms-overflow-style: none;
}
.ls-grid::-webkit-scrollbar { display: none; }
.ls-option {
  display: flex;
  align-items: center;
  gap: 12px;
  min-width: 0;
  padding: 10px 14px;
  border-radius: 12px;
  text-decoration: none;
  cursor: pointer;
  transition: background 0.15s;
}
.ls-option:hover { background: rgba(0, 0, 0, 0.04); }
.ls-option.active {
  background: #eef2ff;
  box-shadow: inset 0 0 0 1px #c7d2fe;

---
// iShine 全站统一 Footer —— 与首页 (src/pages/index.astro) 完全一致
// 用户要求"原样照抄"首页实现，含 CTA 列描述句现有配色
import { getLocalizedPath } from '../lib/breadcrumbs';
import { t } from '../lib/i18n';

interface Props {
  lang?: string;
}

const { lang: langProp } = Astro.props as Props;
// 未显式传 lang 时，从 URL 自动推导当前语言（兼容直接内联组件且不传参的 develo-* 等页面）
const locale = langProp || Astro.currentLocale || (Astro.url.pathname.startsWith('/tr') ? 'tr' : Astro.url.pathname.startsWith('/ar') ? 'ar' : Astro.url.pathname.startsWith('/es') ? 'es' : Astro.url.pathname.startsWith('/fr') ? 'fr' : Astro.url.pathname.startsWith('/ru') ? 'ru' : Astro.url.pathname.startsWith('/he') ? 'he' : Astro.url.pathname.startsWith('/pt-BR') ? 'pt-BR' : Astro.url.pathname.startsWith('/nl') ? 'nl' : 'en');
const lang = locale;
// 按当前语言为站内链接加前缀（en 无前缀，tr 自动带 /tr/）
const loc = (p: string) => getLocalizedPath(lang, p);
---

<style>
  .site-footer {
    background: #020303;
    color: #fff;
    width: 100vw;
    position: relative;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
    padding: 120px 0;
  }
  .footer-container {
    padding: 0 100px;
    max-width: 1536px;
    margin: 0 auto;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr 1fr 1.2fr;
    gap: 60px;
  }
  .footer-col h4 {
    font-family: Manrope, sans-serif;
    font-size: 18px;
    font-weight: 600;
    color: #fff;
    line-height: 27px;
    margin-bottom: 16px;
  }
  .footer-col a {
    display: block;
    font-family: Manrope, sans-serif;
    font-size: 16px;
    font-weight: 400;
    color: #fff;
    line-height: 25px;
    padding: 6px 0;
    transition: color 0.2s;
  }
  .footer-col a:hover {
    color: #b4b4b4;
  }
  .footer-col-cta h4 {
    font-size: 42px;
    line-height: 50px;
    font-weight: 600;
    margin-bottom: 12px;
  }
  .footer-col-cta p {
    font-family: Manrope, sans-serif;
    font-size: 16px;
    font-weight: 400;
    line-height: 25px;
    color: #020303;
  }
  .our-work-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: Manrope, sans-serif;
    font-size: 16px;
    font-weight: 400;
    color: #563cfa;
    background: transparent;
    padding: 12px 20px;
    border: 1px solid #563cfa;
    border-radius: 100px;
    transition: all 0.2s;
    white-space: nowrap;
  }
  .our-work-link:hover {
    background: #563cfa;
    color: #fff;
    gap: 12px;
  }
  .footer-contact-link {
    display: block;
    font-family: Manrope, sans-serif;
    font-size: 16px;
    font-weight: 400;
    color: #fff;
    line-height: 25px;
    padding: 6px 0;
    text-decoration: underline;
    text-decoration-color: #563cfa;
    text-underline-offset: 4px;
    transition: text-decoration-color 0.2s;
  }
  .footer-contact-link:hover {
    text-decoration-color: transparent;
  }
  .footer-contact-text {
    display: block;
    font-family: Manrope, sans-serif;
    font-size: 16px;
    font-weight: 400;
    color: #fff;
    line-height: 25px;
    padding: 6px 0;
  }
  .footer-company-info {
    font-family: Manrope, sans-serif;
    font-size: 14px;
    font-weight: 400;
    line-height: 21px;
    color: #fff;
    margin-bottom: 8px;
  }
  .footer-col-info a {
    font-size: 14px;
    line-height: 21px;
    padding: 2px 0;
    color: #fff;
    text-decoration: underline;
    text-decoration-color: #563cfa;
    text-underline-offset: 3px;
  }
  .footer-col-info a:hover {
    text-decoration-color: transparent;
  }
  @media (max-width: 959px) {
    .site-footer {
      padding: 60px 0;
    }
    .footer-container {
      padding: 0 40px;
    }
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 40px;
    }
    .footer-col-cta h4 {
      font-size: 30px;
      line-height: 38px;
    }
  }
  @media (max-width: 767px) {
    .footer-container {
      padding: 0 24px;
    }
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .footer-col-cta h4 {
      font-size: 26px;
      line-height: 34px;
    }
  }
</style>

<footer class="site-footer">
  <div class="footer-container">
    <div class="footer-grid">
      <div class="footer-col footer-col-cta">
        <h4>{t(locale, 'homepage.footer.heading')}</h4>
        <p>{t(locale, 'homepage.footer.sub')}</p>
        <a class="our-work-link" href={loc("/contact")} style="margin-top:12px">{t(locale, 'homepage.nav.getInTouch')} <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M4 12L12 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M5.5 4H12V10.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
      </div>
      <div class="footer-col">
        <a class="footer-contact-link" href="mailto:service@ishineco.com">service@ishineco.com</a>
        <a class="footer-contact-link" href="tel:+8615012891148">+86 150 1289 1148</a>
        <span class="footer-contact-text">{t(locale, 'homepage.footer.address')}</span>
        <span class="footer-contact-text" style="font-size:12px;color:#b4b4b4">{t(locale, 'homepage.footer.companyName')}</span>
      </div>
      <div class="footer-col">
        <a href={loc("/products")}>{t(locale, 'footer.products')}</a>
        <a href={loc("/services")}>{t(locale, 'nav.services')}</a>
        <a href={loc("/clients")}>{t(locale, 'nav.clients')}</a>
        <a href={loc("/about")}>{t(locale, 'nav.about')}</a>
        <a href={loc("/blog")}>{t(locale, 'nav.blog')}</a>
        <a href={loc("/components")}>{t(locale, 'nav.components')}</a>
        <a href={loc("/contact")}>{t(locale, 'nav.contact')}</a>
      </div>
      <div class="footer-col footer-col-info">
        <p class="footer-company-info">{t(locale, 'homepage.footer.companyIntro')}</p>
        <p class="footer-company-info">{t(locale, 'home.qualitySection.items.2.title')} · {t(locale, 'home.qualitySection.items.3.title')}<br/>{t(locale, 'homepage.footer.fdaSupport')}</p>
        <p class="footer-company-info" style="margin-top:12px">{t(locale, 'footer.copyright')} <a href={loc("/privacy-policy")} style="display:inline;text-decoration:underline;text-decoration-color:#563cfa;text-underline-offset:3px">{t(locale, 'footer.privacyPolicy')}</a>. <a href={loc("/faq")} style="display:inline;text-decoration:underline;text-decoration-color:#563cfa;text-underline-offset:3px">{t(locale, 'nav.faq')}</a>.</p>
      </div>
    </div>
  </div>
</footer>

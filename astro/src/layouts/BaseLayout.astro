---
import StickyContact from '../components/StickyContact.astro';
import CornerMarker from '../components/CornerMarker.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { getAbsoluteLocaleUrl, pathHasLocale } from 'astro:i18n';
// TODO: iShine AI Chat 尚未构建完成，暂时隐藏，完成后恢复
// import Chat from '../components/react/Chat';
import criticalCss from '../styles/critical.css?raw';
import globalCssUrl from '../styles/global.css?url';

const SITE_NAME = 'iShine - Professional IPL Hair Removal Device Manufacturer';
const SITE_DESCRIPTION = 'iShine is an OEM and ODM IPL hair removal device manufacturer providing custom design, compliant production, packaging, and global delivery for beauty brands and retailers.';

function organizationJsonLd(lang: string) {
  return {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': 'https://iplmanufacturer.com/#organization',
    name: 'iShine Technology Ltd',
    url: 'https://iplmanufacturer.com',
    logo: {
      '@type': 'ImageObject',
      url: 'https://iplmanufacturer.com/images/logos/ishine-logo.png',
      width: 1280,
      height: 461,
    },
    description: SITE_DESCRIPTION,
    foundingDate: '2008',
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Shenzhen',
      addressCountry: 'CN',
    },
    contactPoint: {
      '@type': 'ContactPoint',
      telephone: '+86-150-1289-1148',
      contactType: 'sales',
      email: 'service@ishineco.com',
      availableLanguage: ['English', 'Chinese'],
    },
    areaServed: ['US', 'CA', 'DE', 'TR', 'AE', 'SA', 'GB', 'FR', 'ES', 'JP', 'KR'],
    sameAs: [
      'https://www.linkedin.com/company/ishine-technology',
      'https://www.youtube.com/@ishinetech',
      'https://www.facebook.com/ishinetech',
      'https://twitter.com/ishinetech',
      'https://www.instagram.com/ishinetech',
    ],
    knowsAbout: [
      'IPL hair removal device manufacturing',
      'OEM and ODM manufacturing services',
      'Sapphire cooling technology',
      'Beauty device design and production',
    ],
  };
}

type Props = {
  title: string;
  lang?: string;
  description?: string;
  canonical?: string;
  image?: string;
  type?: 'website' | 'article';
  showCornerMarkers?: boolean;
  stickyNav?: boolean;
  /** 显式指定三语 hreflang（用于博客文章/列表等跨语言 slug 不同的页面）；未提供时按当前路径自动生成 en/tr/ar */
  hreflangs?: { locale: string; href: string }[];
};

const { title, lang = 'en', description, canonical, image, type = 'website', showCornerMarkers = true, stickyNav = true, hreflangs } = Astro.props as Props;
const siteBaseUrl = (
  Astro.site?.toString()
  ?? process.env.URL
  ?? process.env.DEPLOY_PRIME_URL
  ?? process.env.SITE_URL
  ?? 'https://iplmanufacturer.com'
).replace(/\/$/, '');
// 站点链接规范：除根路径外一律去掉末尾斜杠（如 /tr/contact 而非 /tr/contact/），
// 兼容相对路径（hreflang）与绝对路径（canonical/og:url）
const stripTrailingSlash = (u: string) => {
  if (u && u !== '/' && u.length > 1 && u.endsWith('/')) {
    const cleaned = u.replace(/\/+$/, '');
    return cleaned.length > 0 ? cleaned : u;
  }
  return u;
};
const canonicalUrl = stripTrailingSlash(canonical || new URL(`${Astro.url.pathname}${Astro.url.search}`, `${siteBaseUrl}/`).href);
// 语言化 hreflang：剥离当前路径前缀后为 en/tr/ar 各生成语言版本 URL
const basePath = pathHasLocale(Astro.url.pathname)
  ? Astro.url.pathname.replace(new RegExp(`^/${lang}`), '') || '/'
  : Astro.url.pathname || '/';
const hreflangEn = stripTrailingSlash(getAbsoluteLocaleUrl('en', basePath, siteBaseUrl));
const hreflangTr = stripTrailingSlash(getAbsoluteLocaleUrl('tr', basePath, siteBaseUrl));
const hreflangAr = stripTrailingSlash(getAbsoluteLocaleUrl('ar', basePath, siteBaseUrl));
const hreflangEs = stripTrailingSlash(getAbsoluteLocaleUrl('es', basePath, siteBaseUrl));
const hreflangFr = stripTrailingSlash(getAbsoluteLocaleUrl('fr', basePath, siteBaseUrl));
const hreflangRu = stripTrailingSlash(getAbsoluteLocaleUrl('ru', basePath, siteBaseUrl));
const hreflangHe = stripTrailingSlash(getAbsoluteLocaleUrl('he', basePath, siteBaseUrl));
const hreflangFa = stripTrailingSlash(getAbsoluteLocaleUrl('fa', basePath, siteBaseUrl));
const hreflangEl = stripTrailingSlash(getAbsoluteLocaleUrl('el', basePath, siteBaseUrl));
const hreflangPt = stripTrailingSlash(getAbsoluteLocaleUrl('pt-BR', basePath, { normalizeLocale: false }));
const hreflangNl = stripTrailingSlash(getAbsoluteLocaleUrl('nl', basePath, siteBaseUrl));
const hreflangPl = stripTrailingSlash(getAbsoluteLocaleUrl('pl', basePath, siteBaseUrl));
const hreflangJa = stripTrailingSlash(getAbsoluteLocaleUrl('ja', basePath, siteBaseUrl));
const hreflangKo = stripTrailingSlash(getAbsoluteLocaleUrl('ko', basePath, siteBaseUrl));
const hreflangId = stripTrailingSlash(getAbsoluteLocaleUrl('id', basePath, siteBaseUrl));
const hreflangTh = stripTrailingSlash(getAbsoluteLocaleUrl('th', basePath, siteBaseUrl));
// 显式 hreflang（页面级覆盖）；未提供时回退到自动生成的 en/tr/ar/es/fr/ru
const pageHreflangs = hreflangs?.length
  ? hreflangs
  : [
      { locale: 'en', href: hreflangEn },
      { locale: 'tr', href: hreflangTr },
      { locale: 'ar', href: hreflangAr },
      { locale: 'es', href: hreflangEs },
      { locale: 'fr', href: hreflangFr },
      { locale: 'ru', href: hreflangRu },
      { locale: 'he', href: hreflangHe },
      { locale: 'fa', href: hreflangFa },
      { locale: 'el', href: hreflangEl },
      { locale: 'pt-BR', href: hreflangPt },
      { locale: 'nl', href: hreflangNl },
      { locale: 'pl', href: hreflangPl },
      { locale: 'ja', href: hreflangJa },
      { locale: 'ko', href: hreflangKo },
      { locale: 'id', href: hreflangId },
      { locale: 'th', href: hreflangTh },
    ];
const defaultHreflang = pageHreflangs.find((h) => h.locale === 'en')?.href ?? pageHreflangs[0]?.href ?? hreflangEn;
const GOOGLE_SITE_VERIFICATION = 'Eyfk5Ty3dOOX_BJzvMRSlYcQZrToJVLY-J1yLRfPkA8';
const fontStylesheetUrl = 'https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700&family=Manrope:wght@400;500;600;700&display=swap';
---

<!doctype html>
<html lang={lang} dir={lang === 'ar' || lang === 'he' || lang === 'fa' ? 'rtl' : 'ltr'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // 语言偏好持久化：读取用户选定的语言（localStorage），
      // 若当前 URL 语言与偏好不一致，立即重定向到偏好语言对应页面（支持 en/tr/ar/es）
      (function () {
        var KEY = 'ishine_lang';
        try {
          var stored = localStorage.getItem(KEY);
          if (!stored) return;
          var LANGS = ['tr', 'ro', 'ar', 'es', 'fr', 'ru', 'he', 'fa', 'el', 'pt-BR', 'nl', 'id', 'th', 'pl', 'ja', 'ko'];
          var path = window.location.pathname;
          var cur = 'en';
          for (var i = 0; i < LANGS.length; i++) {
            if (path === '/' + LANGS[i] || path.indexOf('/' + LANGS[i] + '/') === 0) {
              cur = LANGS[i];
              break;
            }
          }
          if (stored === cur) return;
          var stripped = path;
          for (var j = 0; j < LANGS.length; j++) {
            stripped = stripped.replace(new RegExp('^/' + LANGS[j] + '/?'), '');
          }
          if (stored === 'en') {
            stripped = stripped.replace(/\/+$/, '');
            if (stripped === '' || stripped === '/') stripped = '/';
            if (stripped !== path) window.location.replace(stripped);
          } else {
            var target = '/' + stored + (stripped === '' || stripped === '/' ? '' : stripped);
            target = target.replace(/\/+$/, '');
            if (target === '') target = '/' + stored;
            if (target !== path) window.location.replace(target);
          }
        } catch (e) { /* 隐私模式等场景忽略 */ }
      })();
    </script>
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta name="google-site-verification" content={GOOGLE_SITE_VERIFICATION} />
    <link rel="canonical" href={canonicalUrl} />
    {pageHreflangs.map((h) => (
      <link rel="alternate" hreflang={h.locale} href={h.href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={defaultHreflang} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description || SITE_DESCRIPTION} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description || SITE_DESCRIPTION} />
    <script type="application/ld+json" set:html={JSON.stringify(organizationJsonLd(lang))}></script>
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      '@id': 'https://iplmanufacturer.com/#website',
      url: 'https://iplmanufacturer.com',
      name: SITE_NAME,
      description: SITE_DESCRIPTION,
      inLanguage: lang,
      publisher: { '@id': 'https://iplmanufacturer.com/#organization' },
    })}></script>
    <meta property="og:image" content={new URL(image || '/.netlify/images?url=/images/home/hero-section-sapphire-ipl-device-white-color.webp&w=1200&h=630&fit=cover&fm=png', canonicalUrl).href} />
    <meta name="twitter:image" content={new URL(image || '/.netlify/images?url=/images/home/hero-section-sapphire-ipl-device-white-color.webp&w=1200&h=630&fit=cover&fm=png', canonicalUrl).href} />
    <link rel="icon" type="image/png" href="/images/logos/ishine%20favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link rel="preload" href={fontStylesheetUrl} as="style" />
    <link rel="stylesheet" href={fontStylesheetUrl} media="print" onload="this.media='all'" />
    <style is:inline set:html={criticalCss} />
    <link rel="stylesheet" href={globalCssUrl} media="print" onload="this.media='all'" />
    <noscript>
      <link rel="stylesheet" href={fontStylesheetUrl} />
      <link rel="stylesheet" href={globalCssUrl} />
    </noscript>
    <slot name="head" />
  </head>
  <body class="min-h-screen bg-slate-50 text-slate-900">
    <SiteHeader lang={lang} />
    <div class="content-area mx-auto max-w-6xl px-6 pb-10">
    <slot />
    {showCornerMarkers && <CornerMarker />}
    </div>
    <SiteFooter lang={lang} />
    <StickyContact />
    <!-- TODO: iShine AI Chat 尚未构建完成，暂时隐藏，完成后恢复
    <Chat client:idle />
    -->

    <button id="back-to-top" aria-label="Back to top">
      <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M8 6L12 2L16 6"/>
        <path d="M12 2V22"/>
      </svg>
    </button>

    <script>
      const initBackToTop = () => {
        const btn = document.getElementById('back-to-top');
        if (!btn) return;

        let isVisible = false;

        window.addEventListener('scroll', function () {
          const scrollY = window.scrollY || window.pageYOffset;
          if (scrollY > 400 && !isVisible) {
            btn.classList.add('visible');
            isVisible = true;
          } else if (scrollY <= 400 && isVisible) {
            btn.classList.remove('visible');
            isVisible = false;
          }
        });

        btn.addEventListener('click', function () {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      };

      const scheduleBackToTop =
        'requestIdleCallback' in window
          ? window.requestIdleCallback.bind(window)
          : (callback) => window.setTimeout(callback, 1);

      scheduleBackToTop(initBackToTop);
    </script>

    <style>
      #back-to-top {
        position: fixed;
        bottom: 60px;
        right: calc(39% - 400px);
        width: 42px;
        height: 42px;
        border-radius: 9px;
        background: var(--section-bg, #F9FAFB);
        color: var(--text-color, #333333);
        border: 1px solid var(--border-color, #E5E5E5);
        cursor: pointer;
        z-index: 998;
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0;
        transform: translateY(20px);
        transition: opacity 0.3s ease, transform 0.3s ease;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
      }

      #back-to-top.visible {
        opacity: 1;
        transform: translateY(0);
      }

      #back-to-top:hover {
        background: var(--primary-color, #563cfa);
        color: var(--color-white, #FFFFFF);
        border-color: var(--primary-color, #563cfa);
      }

      @media (max-width: 1024px) {
        #back-to-top {
          right: 20px;
        }
      }
    </style>
    <style is:global>
      /* 与首页最新版头部一致：隐藏的桌面导航仍占布局空间，需裁剪横向溢出，避免滚动抖动 */
      html,
      body {
        overflow-x: hidden;
      }
      /* 适配固定头部（trust-bar 60px + site-header 胶囊）占据的顶部空间 */
      .content-area {
        padding-top: 141px;
      }
      @media (max-width: 698px) {
        .content-area {
          padding-top: 130px;
        }
      }
    </style>
    <script defer src="https://scripts.simpleanalyticscdn.com/latest.js"></script>
  </body>
</html>

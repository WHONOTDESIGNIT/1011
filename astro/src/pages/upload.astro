---
// 【方案A · 2026-08-21】移除 prerender = false：站点已改纯静态（无 adapter），
// 页面静态化后表单仍由客户端 fetch 调用 /.netlify/functions/upload-image，功能不变。
import BaseLayout from '../layouts/BaseLayout.astro';
import UploadForm from '../components/react/UploadForm';

const locale = 'en';
---

<BaseLayout title="Upload Image" lang={locale}>
  <div class="space-y-8">
    <div class="space-y-2">
      <h1 class="text-3xl font-bold text-ink-900">Upload Image</h1>
      <p class="text-neutral-600">Upload images to the media library.</p>
    </div>
    <UploadForm client:load />
  </div>
</BaseLayout>

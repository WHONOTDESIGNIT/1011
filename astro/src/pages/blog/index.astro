---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllPosts, categoryHref } from '../../lib/blog';
import { t } from '../../lib/i18n';
import { getLocalizedPath, buildBreadcrumbs } from '../../lib/breadcrumbs';

const locale = Astro.currentLocale ?? 'en';
function resolveBaseUrl() {
  return (process.env.URL ?? process.env.DEPLOY_PRIME_URL ?? process.env.SITE_URL ?? 'https://iplmanufacturer.com').replace(/\/$/, '');
}

const pageTitle = t(locale, 'blog.meta.title');
const pageDescription = t(locale, 'blog.meta.description');
const canonical = `${resolveBaseUrl()}${getLocalizedPath(locale, '/blog')}`;
const breadcrumbs = buildBreadcrumbs(locale, [
  { label: t(locale, 'common.home'), path: '/' },
  { label: t(locale, 'nav.about'), path: '/about' },
  { label: t(locale, 'nav.blog') },
]);

const posts = await getAllPosts(locale);
const categories = Array.from(new Set(posts.map((post) => post.category).filter(Boolean))).sort((a, b) => a.localeCompare(b));
const initialVisibleCount = 6;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbs.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.label,
    item: item.href ? `${resolveBaseUrl()}${item.href}` : canonical,
  })),
};

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: pageTitle,
  description: pageDescription,
  url: canonical,
  inLanguage: locale,
};

const uiText = {
  searchClear: t(locale, 'blog.search.clear'),
  searchPlaceholder: t(locale, 'blog.search.placeholder'),
  filterAll: t(locale, 'blog.filters.all'),
  filtersLabel: t(locale, 'blog.filters.label'),
  clearFilters: t(locale, 'blog.filters.clear'),
  resetFilters: t(locale, 'blog.filters.reset'),
  emptyTitle: t(locale, 'blog.filters.emptyTitle'),
  emptyDescription: t(locale, 'blog.filters.emptyDescription'),
  featuredLabel: t(locale, 'blog.featured.label'),
  featuredTitle: t(locale, 'blog.featured.title'),
  featuredCta: t(locale, 'blog.featured.cta'),
  gridLabel: t(locale, 'blog.grid.label'),
  gridTitle: t(locale, 'blog.grid.title'),
  gridCta: t(locale, 'blog.grid.cta'),
  loadMore: t(locale, 'blog.loadMore'),
  resultsTemplate: t(locale, 'blog.results.template'),
  resultSingular: t(locale, 'blog.results.resultSingular'),
  resultPlural: t(locale, 'blog.results.resultPlural'),
  resultsFor: t(locale, 'blog.results.for'),
  resultsIn: t(locale, 'blog.results.in'),
  postAuthorLabel: t(locale, 'blog.post.authorLabel'),
  noImage: t(locale, 'blog.common.noImage'),
  heroKicker: t(locale, 'blog.hero.kicker'),
  heroTitle: t(locale, 'blog.hero.title'),
  heroDescription: t(locale, 'blog.hero.description'),
  emptyArchiveKicker: t(locale, 'blog.emptyArchive.kicker'),
  emptyArchiveTitle: t(locale, 'blog.emptyArchive.title'),
  emptyArchiveDescription: t(locale, 'blog.emptyArchive.description'),
};

/* ═══════════════════════════════════════════════════════════════════════════
   SSR 数据切片 —— 与原客户端渲染器 applyFilters() 的首帧（无筛选）逐条对应：
     const filtered = posts;
     const featured = filtered[0];
     const latest   = filtered.slice(1, 5);
     const visibleRegular = filtered.slice(0, visibleCount);   // 从索引 0 开始
   即：常规网格 = posts 全集，前 initialVisibleCount 篇可见，其余交给 JS 分页。
   ═══════════════════════════════════════════════════════════════════════════ */
const featuredPost = posts[0];
const latestPosts = posts.slice(1, 5);
const gridPosts = posts;

/** 图片路径可能已是 %20 形态；先解码再编码，避免二次编码产生 %2520 */
const decodePath = (value: string) => {
  try {
    return decodeURIComponent(value);
  } catch {
    return value;
  }
};

/** 与旧渲染器 netlifyImage() 一致：/.netlify/images?url=<encoded>&w=<w>&fm=<fm>&q=80 */
const netlifyImage = (path: string, width: number, format = 'webp') =>
  `/.netlify/images?url=${encodeURIComponent(decodePath(path))}&w=${width}&fm=${format}&q=80`;

/** 与旧渲染器 buildSrcSet() 一致：srcset 宽度 256/512（精选 400/800） */
const buildSrcSet = (path: string, format: string, widths: number[]) =>
  widths.map((width) => `${netlifyImage(path, width, format)} ${width}w`).join(', ');

/** 与旧渲染器 readTimeLabel() / author 回退一致 */
const readTimeLabel = (post: { readTime: string }) => post.readTime || '5 min read';
const authorLabel = (post: { author: string }) => post.author || 'iShine Team';

/** 首帧结果计数文案：与旧渲染器 applyFilters() 首次执行时写入的文本完全一致 */
const initialResultsSummary = (uiText.resultsTemplate || 'Showing {shown} of {total} articles')
  .replace('{shown}', String(Math.min(posts.length, initialVisibleCount)))
  .replace('{total}', String(posts.length));
---

<BaseLayout title={pageTitle} lang={locale} description={pageDescription} canonical={canonical}>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(webPageSchema)} />
    <!--
      渐进增强的「降级闸门」：超出首屏数量的卡片在 SSR 阶段带 .blog-deferred，
      正文样式表把它隐藏（仅 JS 运行时需要）。禁用 JS 时 <noscript> 内的覆盖样式生效，
      这些卡片全部放行 —— 因此「禁用 JS 也能看到全部文章链接」。
      条件用 html 前缀提高特异性，确保不受样式表先后顺序影响。
    -->
    <noscript><style is:inline>html .blog-deferred{display:flex !important}</style></noscript>
  </Fragment>

  <style is:inline>
    /* ═══ iShine Blog — Develo Design 风格（对齐 develo-blog.astro） ═══ */
    .blog-page{background:var(--color-white);color:var(--color-ink);font-family:Manrope,-apple-system,Roboto,Helvetica,sans-serif;-webkit-font-smoothing:antialiased}
    .blog-page a{text-decoration:none;color:inherit}
    .content-area{max-width:var(--max-w-page,1843px);padding-left:0;padding-right:0}
    @media(max-width:1279px){.content-area{max-width:100%}}
    .hidden{display:none !important}
    /* 渐进增强：首屏之外的文章卡片（SSR 直接带类，JS 分页/筛选时切这个类）。
       禁用 JS 时由 <head> 的 <noscript> 覆盖样式放行，不依赖 JS 也能看到全部链接。
       display:flex 与 .browse-card 自身的 display 一致，避免降级后布局偏移。 */
    .blog-deferred{display:none !important}

    /* Hero */
    .blog-hero{width:100%;max-width:var(--max-w-page,1843px);margin:0 auto 24px;padding:0 100px}
    .blog-hero-inner{display:flex;flex-direction:column;gap:8px}
    .blog-hero-label{display:flex;align-items:center;gap:12px;padding:3px 12px;margin-bottom:16px}
    .blog-hero-label svg{flex-shrink:0}
    .blog-hero-label span{font-family:Manrope,sans-serif;font-size:18px;font-weight:400;color:var(--color-ink);line-height:26px}
    .blog-hero h1{font-family:Syne,sans-serif;font-size:62px;font-weight:400;line-height:68px;letter-spacing:-.61px;color:var(--color-ink);margin:0}
    .blog-hero-desc{font-family:Manrope,sans-serif;font-size:20px;font-weight:400;line-height:30px;color:var(--color-gray-600);max-width:600px}

    /* Citable Summary */
    .blog-summary{width:100%;max-width:var(--max-w-page,1843px);margin:0 auto;padding:0 100px 48px}
    .blog-summary-kicker{font-family:Manrope,sans-serif;font-size:12px;font-weight:600;color:var(--color-primary);text-transform:uppercase;letter-spacing:.5px}
    .blog-summary-title{font-family:Syne,sans-serif;font-size:24px;font-weight:400;line-height:31px;color:var(--color-ink);margin:8px 0 0}
    .blog-summary-desc{font-family:Manrope,sans-serif;font-size:15px;font-weight:400;line-height:23px;color:var(--color-gray-600);max-width:900px;margin:12px 0 0}

    /* Featured + Latest */
    .featured-latest-section{background:var(--color-white);padding:0 0 100px}
    .featured-latest-container{width:100%;max-width:var(--max-w-page,1843px);margin:0 auto;padding:0 100px;display:flex;gap:60px;align-items:flex-start}
    .featured-col{flex:1;display:flex;flex-direction:column;gap:8px}
    .featured-card{display:flex;flex-direction:column;gap:16px}
    .blog-card-img{width:100%;overflow:hidden;background:var(--color-gray-200)}
    .blog-card-img img{width:100%;height:100%;object-fit:cover}
    .blog-card-img-featured{border-radius:20px;aspect-ratio:16/10}
    .blog-read-time{display:inline-block;font-family:Manrope,sans-serif;font-size:12px;font-weight:600;color:var(--color-gray-600);text-transform:uppercase;letter-spacing:.5px;padding:2px 8px;border-radius:4px;background:#f3f4f6;width:fit-content}
    .blog-cat-tag{display:inline-block;font-family:Manrope,sans-serif;font-size:12px;font-weight:600;color:var(--color-gray-600);text-transform:uppercase;letter-spacing:.5px;padding:4px 12px;border:1px solid var(--color-gray-400);border-radius:100px;width:fit-content}
    .blog-no-image{display:inline-block;padding:4px 12px;border-radius:100px;background:rgba(255,255,255,.85);font-family:Manrope,sans-serif;font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.5px;color:var(--color-gray-500)}
    .featured-card h2{font-family:Syne,sans-serif;font-size:21px;font-weight:400;line-height:27px;color:var(--color-ink);margin:0;transition:color .2s}
    .featured-card:hover h2{color:var(--color-primary)}
    .featured-card-desc{font-family:Manrope,sans-serif;font-size:15px;font-weight:400;line-height:23px;color:var(--color-gray-600);margin:0}
    .blog-meta{display:flex;align-items:center;gap:12px;font-family:Manrope,sans-serif;font-size:14px;color:var(--color-gray-500);line-height:21px}
    .blog-meta-author{color:var(--color-ink)}
    .blog-meta-date{color:var(--color-gray-500)}

    /* Latest list */
    .latest-col{width:590px;flex-shrink:0}
    .latest-col h2{font-family:Syne,sans-serif;font-size:32px;font-weight:400;line-height:38px;color:var(--color-ink);margin:0 0 24px}
    .latest-list{display:flex;flex-direction:column;gap:24px;width:100%}
    .latest-item{display:flex;flex-direction:column;gap:12px;padding:0 0 24px;border-bottom:1px solid var(--color-gray-200);width:100%}
    .latest-item:last-child{border-bottom:none}
    .latest-item h3{font-family:Syne,sans-serif;font-size:17px;font-weight:400;line-height:22px;color:var(--color-ink);margin:0;display:flex;align-items:center;gap:8px;transition:color .2s}
    .latest-item:hover h3{color:var(--color-primary)}
    .latest-item h3 .title-arrow{flex-shrink:0;opacity:0;transition:opacity .2s,transform .2s;transform:translateX(-4px)}
    .latest-item:hover h3 .title-arrow{opacity:1;transform:translateX(0)}

    /* Browse all */
    .browse-all-section{background:var(--color-gray-50);padding:60px 0 80px}
    .browse-all-container{width:100%;max-width:var(--max-w-page,1843px);margin:0 auto;padding:0 100px}
    .browse-all-header{display:flex;align-items:flex-end;justify-content:space-between;margin-bottom:32px;gap:24px}
    .browse-all-header h2{font-family:Syne,sans-serif;font-size:32px;font-weight:400;line-height:38px;color:var(--color-ink);margin:0}
    .browse-categories{display:flex;gap:8px;flex-wrap:wrap}
    .browse-cat-btn{padding:8px 16px;border-radius:100px;border:1px solid var(--color-ink);background:transparent;font-family:Manrope,sans-serif;font-size:14px;font-weight:400;color:var(--color-ink);cursor:pointer;transition:all .2s;white-space:nowrap}
    .browse-cat-btn.cat-chip-link{display:inline-flex;align-items:center;justify-content:center;text-decoration:none}
    .browse-cat-btn.active,.browse-cat-btn:hover{background:var(--color-ink);color:var(--color-white)}

    /* Search */
    .blog-search-panel{display:flex;flex-direction:column;gap:8px;margin:24px 0 0}
    .blog-search-label{font-family:Manrope,sans-serif;font-size:12px;font-weight:600;color:var(--color-gray-600);text-transform:uppercase;letter-spacing:.5px}
    .blog-search-row{position:relative;display:flex;align-items:center}
    #blog-search{width:100%;padding:14px 140px 14px 20px;border:1px solid var(--color-gray-400);border-radius:100px;background:var(--color-white);font-family:Manrope,sans-serif;font-size:16px;color:var(--color-ink);outline:none;transition:border-color .2s}
    #blog-search:focus{border-color:var(--color-ink)}
    #blog-search::placeholder{color:var(--color-gray-400)}
    #blog-search-clear{position:absolute;right:10px;padding:6px 14px;border:1px solid var(--color-ink);border-radius:100px;background:transparent;font-family:Manrope,sans-serif;font-size:14px;color:var(--color-ink);cursor:pointer;transition:all .2s}
    #blog-search-clear:hover{background:var(--color-ink);color:var(--color-white)}

    /* Active summary */
    .blog-active-summary{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:12px 20px;border:1px solid var(--color-gray-200);border-radius:16px;background:var(--color-white);margin-bottom:32px;font-family:Manrope,sans-serif;font-size:14px;color:var(--color-gray-600)}
    #blog-clear-filters{font-family:Manrope,sans-serif;font-size:14px;font-weight:600;color:var(--color-primary);background:none;border:none;cursor:pointer;transition:color .2s}
    #blog-clear-filters:hover{color:var(--color-ink)}

    /* Grid */
    .browse-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
    .blog-card-img-grid{border-radius:16px;aspect-ratio:16/9;margin-bottom:12px}
    .browse-card{display:flex;flex-direction:column;transition:transform .2s}
    .browse-card:hover{transform:translateY(-4px)}
    .browse-card h3{font-family:Manrope,sans-serif;font-size:18px;font-weight:400;line-height:26px;color:var(--color-ink);margin:0;transition:color .2s}
    .browse-card:hover h3{color:var(--color-primary)}
    .browse-card .blog-cat-tag{margin-bottom:8px}
    .browse-card .blog-read-time{margin-bottom:4px}
    .browse-card-meta{display:flex;align-items:center;gap:12px;font-family:Manrope,sans-serif;font-size:14px;color:var(--color-gray-500);line-height:21px;margin-top:8px}

    /* Empty state */
    .blog-empty-state{border:1px dashed var(--color-gray-400);border-radius:20px;background:var(--color-white);padding:60px 24px;text-align:center}
    .blog-empty-state h3{font-family:Syne,sans-serif;font-size:28px;font-weight:400;line-height:34px;color:var(--color-ink);margin:0}
    .blog-empty-state p{font-family:Manrope,sans-serif;font-size:16px;line-height:25px;color:var(--color-gray-600);max-width:560px;margin:12px auto 0}

    /* Load more + results */
    .blog-load-more-wrap{display:flex;justify-content:center;margin-top:60px}
    .pagination-btn{display:flex;align-items:center;justify-content:center;padding:10px 24px;border-radius:100px;border:1px solid var(--color-ink);background:transparent;font-family:Manrope,sans-serif;font-size:14px;font-weight:400;color:var(--color-ink);cursor:pointer;transition:all .2s;white-space:nowrap}
    .pagination-btn:hover{background:var(--color-ink);color:var(--color-white)}
    .blog-results-summary{text-align:center;margin-top:20px;font-family:Manrope,sans-serif;font-size:14px;color:var(--color-gray-500)}

    /* Responsive — 与 develo-blog.astro 断点一致 */
    @media(max-width:1279px){
      .blog-hero{padding:0 40px}
      .blog-summary{padding:0 40px 40px}
      .featured-latest-container{padding:0 40px;flex-direction:column;gap:40px}
      .latest-col{width:100%}
      .browse-all-container{padding:0 40px}
      .browse-grid{grid-template-columns:repeat(2,1fr)}
    }
    @media(max-width:767px){
      .blog-hero{padding:0 24px}
      .blog-hero h1{font-size:38px;line-height:44px;letter-spacing:-.37px}
      .blog-hero-desc{font-size:16px;line-height:25px}
      .blog-hero-inner .blog-summary{margin:20px 0 0;padding:28px 0 0}
      .blog-summary-title{font-size:20px;line-height:27px}
      .featured-latest-container{padding:0 24px}
      .featured-latest-section{padding:0 0 60px}
      .browse-all-container{padding:0 24px}
      .browse-grid{grid-template-columns:1fr}
      .browse-all-header{flex-direction:column;align-items:flex-start;gap:16px}
      .browse-all-section{padding:40px 0 60px}
      #blog-search{padding:14px 20px}
      #blog-search-clear{position:static;width:100%}
      .blog-search-row{flex-direction:column;align-items:stretch;gap:8px}
    }
  </style>

  <div
    class="blog-page"
    id="blog-discovery"
    data-initial-visible-count={initialVisibleCount}
    data-ui={JSON.stringify(uiText)}
  >
    <!-- ═══ HERO（含搜索框 + Citable Summary 合并） ═══ -->
    <section class="blog-hero">
      <div class="blog-hero-inner">
        <div class="blog-hero-label">
          <svg width="16" height="17" viewBox="0 0 16 17" fill="none"><g clip-path="url(#blogHeroShape)"><path d="M2.16 16.4999C0.7733 14.3158 0 11.465 0 8.49995C0 5.53493 0.7733 2.68405 2.16 0.5V16.4999Z" fill="#020303"/><path d="M16 16.5C13.8783 16.5 11.8434 15.6572 10.3431 14.1569C8.84286 12.6566 8 10.6217 8 8.50001C8 6.37827 8.84285 4.34344 10.3431 2.84314C11.8434 1.34284 13.8783 0.5 16 0.5V16.5Z" fill="#020303"/></g><defs><clipPath id="blogHeroShape"><rect fill="#fff" width="16" height="17"/></clipPath></defs></svg>
          <span>{uiText.heroKicker}</span>
        </div>
        <h1>{uiText.heroTitle}</h1>
        <p class="blog-hero-desc">{uiText.heroDescription}</p>

        <!-- 搜索框 -->
        <div class="blog-search-panel">
          <label class="blog-search-label" for="blog-search">{t(locale, 'blog.search.label')}</label>
          <div class="blog-search-row">
            <input id="blog-search" type="search" placeholder={uiText.searchPlaceholder} />
            <button id="blog-search-clear" type="button" class="hidden" aria-label="Clear search">{uiText.searchClear}</button>
          </div>
        </div>

        <!-- Citable Summary（与原 hero 合并） -->
        <div class="blog-summary">
          <div class="blog-summary-kicker">Citable Summary</div>
          <h2 class="blog-summary-title">What topics does the iShine blog cover?</h2>
          <p class="blog-summary-desc">
            The iShine blog shares practical guidance for brands and sourcing teams building private-label IPL hair removal products. Articles typically cover OEM/ODM workflows, product positioning, manufacturing considerations, and how component choices like cooling systems, optical filters, or lamp cartridges affect user comfort and performance. The blog also discusses launch fundamentals such as packaging strategy, compliance planning for target markets, and what information to prepare for RFQs and sampling. The goal is to provide clear, self-contained explanations that help readers evaluate options and reduce risk when moving from concept to scalable production. For teams comparing manufacturers or planning new device lines, these posts are written to be referenced during internal decision-making and vendor discussions.
          </p>
        </div>
      </div>
    </section>

    <!-- ═══ FEATURED + LATEST（构建期渲染：精选 1 篇 + 最新 4 篇） ═══ -->
    <section class="featured-latest-section">
      <div class="featured-latest-container">
        <div class="featured-col" id="blog-featured-section">
          <div id="blog-featured-container">
            {featuredPost ? (
              <a class="featured-card" href={featuredPost.href} data-category={featuredPost.category}>
                {featuredPost.image ? (
                  <div class="blog-card-img blog-card-img-featured">
                    <picture>
                      <source srcset={buildSrcSet(featuredPost.image, 'avif', [400, 800])} sizes="(min-width: 1024px) 50vw, 100vw" type="image/avif" />
                      <source srcset={buildSrcSet(featuredPost.image, 'webp', [400, 800])} sizes="(min-width: 1024px) 50vw, 100vw" type="image/webp" />
                      <img src={netlifyImage(featuredPost.image, 800, 'webp')} srcset={buildSrcSet(featuredPost.image, 'webp', [400, 800])} sizes="(min-width: 1024px) 50vw, 100vw" alt={featuredPost.title} loading="eager" decoding="async" width="1200" height="750" class="h-full w-full object-cover" />
                    </picture>
                  </div>
                ) : (
                  <div class="flex items-end blog-card-img blog-card-img-featured" style="background:linear-gradient(135deg,#f3f4f6,#e5e7eb)">
                    <span class="blog-no-image">{uiText.noImage || 'No Image'}</span>
                  </div>
                )}
                <span class="blog-read-time">{readTimeLabel(featuredPost)}</span>
                {featuredPost.category ? <span class="blog-cat-tag">{featuredPost.category}</span> : null}
                <h2>{featuredPost.title}</h2>
                {featuredPost.excerpt ? <p class="featured-card-desc">{featuredPost.excerpt}</p> : null}
                <div class="blog-meta">
                  <span class="blog-meta-author">{authorLabel(featuredPost)}</span>
                  <span class="blog-meta-date">{featuredPost.date}</span>
                </div>
              </a>
            ) : null}
          </div>
        </div>
        <div class="latest-col">
          <h2>{uiText.gridLabel}</h2>
          <div class="latest-list" id="blog-latest-list">
            {latestPosts.map((post) => (
              <a class="latest-item" href={post.href} data-category={post.category}>
                {post.category ? <span class="blog-cat-tag">{post.category}</span> : null}
                <h3>{post.title}<svg class="title-arrow" width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M7 17L17 7M17 7H7M17 7V17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></h3>
                <div class="blog-meta">
                  <span class="blog-meta-author">{authorLabel(post)}</span>
                  <span class="blog-meta-date">{post.date}</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ BROWSE ALL ═══ -->
    <section class="browse-all-section">
      <div class="browse-all-container">
        <div class="browse-all-header">
          <h2>Browse all</h2>
          <div class="browse-categories" id="blog-category-filters">
            <button type="button" data-category="All" class="browse-cat-btn active">{uiText.filterAll}</button>
            {categories.map((category) => (
              <a href={categoryHref(locale, category)} class="browse-cat-btn cat-chip-link">{category}</a>
            ))}
          </div>
        </div>

        <div id="blog-active-summary" class="blog-active-summary hidden">
          <div id="blog-active-summary-text"></div>
          <button id="blog-clear-filters" type="button">{uiText.clearFilters}</button>
        </div>

        <!--
          常规网格：构建期渲染全部文章；前 initialVisibleCount 篇直接可见，
          其余带 .blog-deferred（JS 分页时撤销；禁用 JS 时由 <head> 的 <noscript> 放行）。
        -->
        <div id="blog-regular-grid" class="browse-grid">
          {gridPosts.map((post, index) => (
            <a
              class:list={['browse-card', index >= initialVisibleCount && 'blog-deferred']}
              href={post.href}
              data-category={post.category}
              data-search={[post.title, post.category, post.excerpt, post.author].filter(Boolean).join(' ').toLowerCase()}
            >
              {post.image ? (
                <div class="blog-card-img blog-card-img-grid">
                  <picture>
                    <source srcset={buildSrcSet(post.image, 'avif', [256, 512])} sizes="(min-width: 1280px) 33vw, (min-width: 768px) 50vw, 100vw" type="image/avif" />
                    <source srcset={buildSrcSet(post.image, 'webp', [256, 512])} sizes="(min-width: 1280px) 33vw, (min-width: 768px) 50vw, 100vw" type="image/webp" />
                    <img src={netlifyImage(post.image, 512, 'webp')} srcset={buildSrcSet(post.image, 'webp', [256, 512])} sizes="(min-width: 1280px) 33vw, (min-width: 768px) 50vw, 100vw" alt={post.title} loading="lazy" decoding="async" width="1200" height="675" class="h-full w-full object-cover" />
                  </picture>
                </div>
              ) : (
                <div class="flex items-end blog-card-img blog-card-img-grid" style="background:linear-gradient(135deg,#f3f4f6,#e5e7eb)">
                  <span class="blog-no-image">{uiText.noImage || 'No Image'}</span>
                </div>
              )}
              <span class="blog-read-time">{readTimeLabel(post)}</span>
              {post.category ? <span class="blog-cat-tag">{post.category}</span> : null}
              <h3>{post.title}</h3>
              <div class="browse-card-meta">
                <span class="blog-meta-author">{authorLabel(post)}</span>
                <span class="blog-meta-date">{post.date}</span>
              </div>
            </a>
          ))}
        </div>

        <section id="blog-empty-state" class="blog-empty-state hidden">
          <h3>{uiText.emptyTitle}</h3>
          <p>{uiText.emptyDescription}</p>
          <button id="blog-reset-empty" type="button" class="pagination-btn">{uiText.resetFilters}</button>
        </section>

        <!-- 分页按钮由 JS 控制显隐：SSR 先隐藏，禁用 JS 时不会出现无效按钮 -->
        <div class="blog-load-more-wrap hidden" id="blog-load-more-wrap">
          <button id="blog-load-more" type="button" class="pagination-btn">{uiText.loadMore}</button>
        </div>

        <div id="blog-results-summary" class="blog-results-summary">{initialResultsSummary}</div>
      </div>
    </section>
  </div>

  <!--
    ═══ 渐进增强脚本 ═══
    只操作上面已经渲染好的 DOM：不注入任何 HTML 字符串、不读取任何 JSON 数据块，
    仅仅切换 .blog-deferred / .hidden 两个类并更新文本节点。
    功能：分类筛选 / 清除筛选 / 搜索 / 清空搜索 / 加载更多（每点一次 +6）/
          空态 / 复位 / 结果计数 / 分类 chip 高亮
  -->
  <script is:inline>
    (() => {
      const $ = (id) => document.getElementById(id);
      const root = $('blog-discovery');
      const grid = $('blog-regular-grid');
      if (!root || !grid) return;
      const ui = JSON.parse(root.dataset.ui || '{}');
      const cards = Array.from(grid.querySelectorAll('.browse-card'));
      const latest = Array.from(document.querySelectorAll('#blog-latest-list .latest-item'));
      const search = $('blog-search');
      const clearSearch = $('blog-search-clear');
      const chips = $('blog-category-filters');
      const summary = $('blog-active-summary');
      const summaryText = $('blog-active-summary-text');
      const clearFilters = $('blog-clear-filters');
      const featured = $('blog-featured-section');
      const empty = $('blog-empty-state');
      const emptyReset = $('blog-reset-empty');
      const moreWrap = $('blog-load-more-wrap');
      const moreBtn = $('blog-load-more');
      const count = $('blog-results-summary');
      const step = Number(root.dataset.initialVisibleCount || '6');
      let term = '';
      let cat = 'All';
      let limit = step;

      const apply = () => {
        const q = term.trim().toLowerCase();
        // 搜索范围必须与改造前完全一致：title + category + excerpt + author（旧渲染器里那串
        // searchBlob 就是这四个字段）。不能直接用 textContent —— 卡片上不显示 excerpt，
        // 用它会导致「按摘要搜索」失效（实测 cooling 6→1、australian 1→0），
        // 同时把日期与阅读时长也纳入匹配（"2026" 5→52、"5 min" 0→43）产生噪音。
        // data-search 由构建期写入这四个字段；缺失时回退 textContent。
        const haystack = (c) => (c.dataset.search || c.textContent).toLowerCase();
        const hit = cards.map((c) => (cat === 'All' || c.dataset.category === cat) && (!q || haystack(c).includes(q)));
        const total = hit.filter(Boolean).length;
        let shown = 0;
        cards.forEach((c, i) => {
          const on = hit[i] && shown < limit;
          if (on) shown++;
          c.classList.toggle('blog-deferred', !on);
        });

        const active = (q ? 1 : 0) + (cat === 'All' ? 0 : 1);
        search.value = term;
        clearSearch.classList.toggle('hidden', !q);
        summary.classList.toggle('hidden', !active);
        if (active) {
          const word = total === 1 ? (ui.resultSingular || 'result') : (ui.resultPlural || 'results');
          const parts = [total + ' ' + word];
          if (q) parts.push((ui.resultsFor || 'for') + ' "' + term.trim() + '"');
          if (cat !== 'All') parts.push((ui.resultsIn || 'in') + ' ' + cat);
          summaryText.textContent = parts.join(' ');
        }

        chips.querySelectorAll('[data-category]').forEach((chip) => {
          chip.className = chip.dataset.category === cat ? 'browse-cat-btn active' : 'browse-cat-btn';
        });

        empty.classList.toggle('hidden', total > 0);
        featured.classList.toggle('hidden', !total);
        grid.classList.toggle('hidden', !total);
        latest.forEach((item) => item.classList.toggle('hidden', !total));
        moreWrap.classList.toggle('hidden', !total || shown >= total);

        const tpl = ui.resultsTemplate || 'Showing {shown} of {total} articles';
        count.textContent = tpl.replace('{shown}', String(shown)).replace('{total}', String(total));
      };

      const reset = () => {
        term = '';
        cat = 'All';
        limit = step;
        apply();
      };

      search.addEventListener('input', (e) => {
        term = e.currentTarget.value;
        limit = step;
        apply();
      });
      clearSearch.addEventListener('click', () => {
        term = '';
        limit = step;
        apply();
        search.focus();
      });
      chips.addEventListener('click', (e) => {
        const chip = e.target instanceof HTMLElement ? e.target.closest('[data-category]') : null;
        if (!chip) return;
        cat = chip.dataset.category || 'All';
        limit = step;
        apply();
      });
      clearFilters.addEventListener('click', reset);
      emptyReset.addEventListener('click', reset);
      moreBtn.addEventListener('click', () => {
        limit += step;
        apply();
      });

      apply();
    })();
  </script>
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ArticleVote from '../../components/ArticleVote.astro';
import MdxImage from '../../components/MdxImage.astro';
import { getAllArticleVersions, getPostBySlug, getPostTranslations, getRelatedPosts, postHref } from '../../lib/blog';
import { t } from '../../lib/i18n';
import { getLocalizedPath, buildBreadcrumbs } from '../../lib/breadcrumbs';

// 注意：i18n fallback 路由（/vi/blog/x 等）渲染时 Astro.url 会被重写为无前缀路径
// （Astro.url.pathname === '/blog/x'），而 Astro.currentLocale 才是该 URL 的实际语言。
// 因此「当前 URL」必须用 postHref(urlLocale, slug) 重建，不能读 Astro.url.pathname。
const urlLocale = Astro.currentLocale ?? 'en';
const { slug } = Astro.params;

export async function getStaticPaths() {
  // 聚合全站（所有语言）全部文章 slug，每个 slug 至多一次。
  // Astro i18n fallback 会为主路由 /blog/[slug] 按语言克隆出 /<locale>/blog/[slug]，
  // 因此每个 slug 会同时生成 en 与全部语言前缀下的页面；
  // 页面内再按 (urlLocale, slug) 决定渲染哪种语言，或 301 到该语言正确地址。
  const versions = await getAllArticleVersions();
  const seen = new Set<string>();
  const paths: { params: { slug: string } }[] = [];
  for (const v of versions) {
    if (seen.has(v.slug)) continue;
    seen.add(v.slug);
    paths.push({ params: { slug: v.slug } });
  }
  return paths;
}

// 文章的多语言 URL 映射（用于定位正确语言版本 + hreflang）
const translations = await getPostTranslations(slug);
if (!translations.length) {
  return new Response('Not found', { status: 404 });
}

// 跨语言解析：以「URL 语言 + URL slug」为唯一依据（不再依赖 Astro.props，
// 因为 i18n fallback 路由下 props 按 params 去重后不可靠）。
const urlTarget = translations.find((x) => x.locale === urlLocale);
let locale: string;
let postSlug: string;
if (urlTarget) {
  // 该语言存在此文章：URL 已是该语言正确地址则直接渲染；否则 301 到正确地址
  if (urlTarget.href !== postHref(urlLocale, slug)) {
    return Astro.redirect(urlTarget.href, 301);
  }
  locale = urlTarget.locale;
  postSlug = urlTarget.slug;
} else {
  // 该语言无此文章翻译：按 i18n fallback（rewrite）语义渲染英文原文，URL 保持不变
  const enTarget = translations.find((x) => x.locale === 'en');
  if (!enTarget) {
    return new Response('Not found', { status: 404 });
  }
  locale = 'en';
  postSlug = enTarget.slug;
}

const post = await getPostBySlug(locale, postSlug);
if (!post) {
  return new Response('Not found', { status: 404 });
}

function resolveBaseUrl() {
  return (process.env.URL ?? process.env.DEPLOY_PRIME_URL ?? process.env.SITE_URL ?? 'https://iplmanufacturer.com').replace(/\/$/, '');
}

function netlifyImage(path: string, width: number, format: 'avif' | 'webp', quality = 80) {
  return `/.netlify/images?url=${encodeURIComponent(path)}&w=${width}&fm=${format}&q=${quality}`;
}

function buildSrcSet(path: string, widths: number[], format: 'avif' | 'webp', quality = 80) {
  return widths.map((width) => `${netlifyImage(path, width, format, quality)} ${width}w`).join(', ');
}

const Content = post.Content as any;
const related = await getRelatedPosts(locale, post.meta.slug, post.meta.category, 3);
const breadcrumbs = buildBreadcrumbs(locale, [
  { label: t(locale, 'common.home'), path: '/' },
  { label: t(locale, 'nav.about'), path: '/about' },
  { label: t(locale, 'nav.blog'), path: '/blog' },
  { label: post.meta.title },
]);

const pageTitle = post.meta.title;
const pageDescription = post.meta.excerpt || t(locale, 'blog.meta.description');
const canonical = `${resolveBaseUrl()}${post.meta.href}`;
const hreflangEntries = translations.map((x) => ({ locale: x.locale, href: `${resolveBaseUrl()}${x.href}` }));
const blogImageWidths = [400, 800, 1200];
const articleHeroImage = post.meta.image
  ? {
      src: netlifyImage(post.meta.image, 800, 'webp'),
      webpSrcSet: buildSrcSet(post.meta.image, blogImageWidths, 'webp'),
      avifSrcSet: buildSrcSet(post.meta.image, blogImageWidths, 'avif'),
    }
  : null;
// Article 主图（3.3 补齐）：始终输出绝对 URL。
// 有 frontmatter 图 → 走 Netlify Image CDN 规范 1200w（满足 Google Article 富媒体 ≥1200px 要求）；
// 无图 → 回退全站默认 OG 图（1200×630，16:9）。与 SeoHead 的 og:image 兜底保持一致。
const DEFAULT_OG_IMAGE_PATH = '/images/home/hero-section-sapphire-ipl-device-white-color.webp';
const articleImageUrl = post.meta.image
  ? new URL(netlifyImage(post.meta.image, 1200, 'webp'), `${resolveBaseUrl()}/`).href
  : new URL(`/.netlify/images?url=${encodeURIComponent(DEFAULT_OG_IMAGE_PATH)}&w=1200&h=630&fit=cover&fm=png`, `${resolveBaseUrl()}/`).href;

// 3.3 修复：Google Article 要求 ISO 8601 日期时间（带时区）。纯日期（YYYY-MM-DD）
// 会触发「日期时间值无效」+「缺少时区信息」两条非严重警告，统一补全为 UTC 午夜。
const toIsoDateTime = (value: string | undefined) => {
  if (!value) return undefined;
  return /^\d{4}-\d{2}-\d{2}$/.test(value) ? `${value}T00:00:00Z` : value;
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbs.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.label,
    item: item.href ? `${resolveBaseUrl()}${item.href}` : canonical,
  })),
};

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': canonical,
  name: pageTitle,
  description: pageDescription,
  url: canonical,
  inLanguage: locale,
  isPartOf: {
    '@id': 'https://iplmanufacturer.com/#website',
  },
};

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': canonical + '#article',
  identifier: post.meta.translationKey,
  headline: post.meta.title,
  description: pageDescription,
  url: canonical,
  datePublished: toIsoDateTime(post.meta.date),
  dateModified: toIsoDateTime(post.meta.updatedDate || post.meta.date),
  author: {
    '@type': 'Person',
    name: post.meta.author || 'iShine Team',
    // 3.3 补齐：作者链接指向团队/关于页（站内无独立作者页，统一指向 /about）
    url: `${resolveBaseUrl()}/about`,
    ...(post.meta.authorAvatar ? { image: post.meta.authorAvatar } : {}),
  },
  publisher: {
    '@type': 'Organization',
    '@id': 'https://iplmanufacturer.com/#organization',
    name: 'iShine Technology Ltd',
    logo: {
      '@type': 'ImageObject',
      url: `${resolveBaseUrl()}/images/logos/ishine-logo.webp`,
      width: 444,
      height: 160,
    },
  },
  image: articleImageUrl,
  ...(post.meta.category ? { articleSection: post.meta.category } : {}),
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonical,
  },
  inLanguage: locale,
  isPartOf: {
    '@id': 'https://iplmanufacturer.com/#website',
  },
};

const faqSchema = post.faqs.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      '@id': canonical + '#faq',
      inLanguage: locale,
      mainEntity: post.faqs.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: item.answer,
        },
      })),
    }
  : null;
---

<BaseLayout title={pageTitle} lang={locale} description={pageDescription} canonical={canonical} type="article" stickyNav={false} image={post.meta.image} hreflangs={hreflangEntries}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(webPageSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    {faqSchema ? <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} /> : null}
  </Fragment>

  <article class="mx-auto max-w-5xl space-y-42">
    <header class="space-y-6">
      <Breadcrumb items={breadcrumbs} variant="dark" locale={locale} />

      <div class="space-y-2">
        <div class="flex flex-wrap items-center gap-3 text-sm text-neutral-600">
          {post.meta.category
            ? <span class="rounded-2xl border border-neutral-200 bg-white px-3 py-1 font-medium text-neutral-700">{post.meta.category}</span>
            : null}
        </div>
        <h1 class="text-4xl font-bold text-slate-950 md:text-5xl lg:text-6xl">{post.meta.title}</h1>
        {pageDescription
          ? <p class="max-w-3xl text-lg leading-relaxed text-neutral-600">{pageDescription}</p>
          : null}
      </div>

      <div class="flex flex-wrap items-center gap-4 border-b border-neutral-200 pb-6 text-sm text-slate-500">
        <div class="flex items-center gap-3">
          {post.meta.authorAvatar
            ? (
              <img
                src={post.meta.authorAvatar}
                alt={post.meta.author}
                class="h-10 w-10 rounded-2xl object-cover"
                loading="lazy"
              />
            )
            : (
              <span class="inline-flex h-10 w-10 items-center justify-center rounded-2xl bg-neutral-100 text-sm font-semibold text-slate-500">
                {(post.meta.author || 'I').slice(0, 1)}
              </span>
            )}
          <div class="leading-tight">
            <span class="block text-xs uppercase tracking-[0.18em] text-neutral-400">{t(locale, 'blog.post.authorLabel')}</span>
            <span class="block font-semibold text-neutral-800">{post.meta.author}</span>
          </div>
        </div>
        {post.meta.date ? <time class="ml-auto">{post.meta.date}</time> : null}
      </div>
    </header>

    <section class="rounded-2xl border border-neutral-200 bg-white p-6 shadow-sm">
      <h2 class="text-sm font-semibold uppercase tracking-[0.22em] text-neutral-600">{t(locale, 'blog.post.citableEyebrow')}</h2>
      <h3 class="mt-2 text-2xl font-bold text-ink-900">{t(locale, 'blog.post.citableQuestion')}</h3>
      <p class="mt-4 text-lg leading-relaxed text-neutral-700">
        {t(locale, 'blog.post.citableBody').replace('{title}', post.meta.title)}
      </p>
    </section>

    {post.meta.image
      ? (
        <figure class="-mx-4 overflow-hidden rounded-2xl border border-neutral-200 bg-neutral-50 shadow-sm sm:mx-0">
          <div class="aspect-[16/9]">
            <picture>
              <source srcset={articleHeroImage.avifSrcSet} sizes="(max-width: 1024px) 100vw, 1200px" type="image/avif" />
              <source srcset={articleHeroImage.webpSrcSet} sizes="(max-width: 1024px) 100vw, 1200px" type="image/webp" />
              <img
                src={articleHeroImage.src}
                srcset={articleHeroImage.webpSrcSet}
                sizes="(max-width: 1024px) 100vw, 1200px"
                alt={post.meta.title}
                loading="eager"
                fetchpriority="high"
                decoding="async"
                width="1200"
                height="675"
                class="h-full w-full object-cover"
              />
            </picture>
          </div>
        </figure>
      )
      : null}

    <div class="mx-auto max-w-3xl">
      <div class="blog-content">
        <Content components={{ img: MdxImage }} />
      </div>

      {post.faqs.length
        ? (
          <section class="mt-12">
            <h2 class="text-2xl font-bold text-ink-900">{t(locale, 'blog.post.faqTitle')}</h2>
            <div class="mt-6 space-y-3">
              {post.faqs.map((item) => (
                <details class="group overflow-hidden rounded-2xl border border-neutral-200 bg-white shadow-sm transition open:border-neutral-300">
                  <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 text-left font-semibold text-neutral-800">
                    <span>{item.question}</span>
                    <svg class="h-5 w-5 flex-shrink-0 text-neutral-400 transition-transform duration-200 group-open:rotate-45" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                      <path d="M10 4v12M4 10h12" />
                    </svg>
                  </summary>
                  <p class="border-t border-neutral-100 px-5 py-4 leading-relaxed text-neutral-600">{item.answer}</p>
                </details>
              ))}
            </div>
          </section>
        )
        : null}

      <div class="mt-14 rounded-2xl bg-slate-950 px-8 py-10 text-white">
        <div class="mx-auto max-w-xl text-center">
          <p class="text-xs font-semibold uppercase tracking-[0.22em] text-sky-300">{t(locale, 'blog.post.ctaTitle')}</p>
          <h2 class="mt-3 text-2xl font-bold">{t(locale, 'blog.post.ctaHeading')}</h2>
          <p class="mt-4 text-sm leading-relaxed text-neutral-300">{t(locale, 'blog.post.ctaDescription')}</p>
          <div class="mt-6 flex flex-wrap justify-center gap-3">
            <a
              class="rounded-2xl bg-white px-6 py-3 text-sm font-semibold text-ink-900 transition hover:bg-neutral-100"
              href={getLocalizedPath(locale, '/contact')}
            >
              {t(locale, 'blog.post.ctaPrimary')}
            </a>
            <a
              class="rounded-2xl border border-white/20 px-6 py-3 text-sm font-semibold text-white transition hover:bg-white/10"
              href={getLocalizedPath(locale, '/products')}
            >
              {t(locale, 'blog.post.ctaSecondary')}
            </a>
          </div>
        </div>
      </div>

      <ArticleVote slug={post.meta.translationKey} lang={locale} />
    </div>

    {related.length
      ? (
        <section class="space-y-8">
          <div class="flex items-end justify-between gap-4 border-b border-neutral-200 pb-6">
            <div>
              <p class="text-xs font-semibold uppercase tracking-[0.22em] text-sky-700">{t(locale, 'blog.post.relatedTitle')}</p>
              <h2 class="mt-1 text-2xl font-bold text-ink-900">{t(locale, 'blog.post.continueReadingTitle')}</h2>
            </div>
            <a
              class="hidden flex-shrink-0 rounded-2xl border border-neutral-200 bg-white px-5 py-2.5 text-sm font-semibold text-neutral-700 transition hover:border-neutral-300 hover:bg-neutral-50 md:inline-flex"
              href={getLocalizedPath(locale, '/blog#blog-archive')}
            >
              {t(locale, 'blog.post.viewAllArticles')}
            </a>
          </div>
          <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
            {related.map((p) => (
              <a
                class="group overflow-hidden rounded-2xl border border-neutral-200 bg-white shadow-sm transition hover:-translate-y-0.5 hover:shadow-md"
                href={p.href}
              >
                {p.image
                  ? (
                    <div class="aspect-[16/10] overflow-hidden bg-neutral-100">
                      <picture>
                        <source srcset={buildSrcSet(p.image, blogImageWidths, 'avif')} sizes="(min-width: 1280px) 33vw, (min-width: 768px) 50vw, 100vw" type="image/avif" />
                        <source srcset={buildSrcSet(p.image, blogImageWidths, 'webp')} sizes="(min-width: 1280px) 33vw, (min-width: 768px) 50vw, 100vw" type="image/webp" />
                        <img
                          src={netlifyImage(p.image, 800, 'webp')}
                          srcset={buildSrcSet(p.image, blogImageWidths, 'webp')}
                          sizes="(min-width: 1280px) 33vw, (min-width: 768px) 50vw, 100vw"
                          alt={p.title}
                          loading="lazy"
                          decoding="async"
                          width="1200"
                          height="750"
                          class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
                        />
                      </picture>
                    </div>
                  )
                  : (
                    <div class="flex aspect-[16/10] items-end bg-gradient-to-br from-neutral-50 to-neutral-100 p-6">
                      <span class="rounded-2xl bg-white/80 px-3 py-1 text-xs font-medium uppercase tracking-[0.18em] text-neutral-400">
                        {t(locale, 'blog.common.noImage')}
                      </span>
                    </div>
                  )}
                <div class="space-y-3 p-5">
                  <div class="flex flex-wrap items-center gap-2 text-xs text-slate-500">
                    {p.category
                      ? <span class="rounded-2xl bg-neutral-100 px-2.5 py-0.5 font-medium text-neutral-600">{p.category}</span>
                      : null}
                  </div>
                  <h3 class="text-lg font-semibold leading-snug text-ink-900">{p.title}</h3>
                  <p class="text-sm leading-relaxed text-neutral-600">{p.excerpt}</p>
                  <span class="inline-flex items-center gap-1 text-sm font-medium text-sky-700 transition group-hover:gap-2">
                    {t(locale, 'blog.post.relatedCta')}
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
                  </span>
                </div>
              </a>
            ))}
          </div>
        </section>
      )
      : null}
  </article>
</BaseLayout>

<style is:global>
  .blog-content {
    font-size: 1.0625rem;
    line-height: 1.8;
    color: var(--text-color, #333333);
  }
  .blog-content > :first-child {
    margin-top: 0;
  }
  .blog-content h1 {
    margin-top: 2.75rem;
    margin-bottom: 1.25rem;
    font-size: 1.875rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--color-black, #000000);
  }
  .blog-content h1:first-child {
    margin-top: 0;
  }
  .blog-content h2 {
    margin-top: 2.75rem;
    margin-bottom: 1rem;
    font-size: 1.625rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--color-black, #000000);
  }
  .blog-content h2:first-child {
    margin-top: 0;
  }
  .blog-content h3 {
    margin-top: 2.25rem;
    margin-bottom: 0.75rem;
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--color-black, #000000);
  }
  .blog-content h3:first-child {
    margin-top: 0;
  }
  .blog-content h4 {
    margin-top: 1.75rem;
    margin-bottom: 0.5rem;
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--color-black, #000000);
  }
  .blog-content h4:first-child {
    margin-top: 0;
  }
  .blog-content p {
    margin-top: 1.25rem;
    margin-bottom: 0;
  }
  .blog-content p:first-child {
    margin-top: 0;
  }
  .blog-content a {
    color: var(--color-black, #000000);
    text-decoration: underline;
    text-decoration-color: var(--border-color, #E5E5E5);
    text-underline-offset: 3px;
    transition: text-decoration-color 0.15s;
  }
  .blog-content a:hover {
    text-decoration-color: var(--primary-color, #563cfa);
  }
  .blog-content strong {
    font-weight: 600;
    color: var(--color-black, #000000);
  }
  .blog-content ul,
  .blog-content ol {
    margin-top: 1.25rem;
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
  }
  [dir="rtl"] .blog-content ul,
  [dir="rtl"] .blog-content ol {
    padding-left: 0;
    padding-right: 1.5rem;
  }
  .blog-content p + ul,
  .blog-content p + ol {
    margin-top: 0.75rem;
  }
  .blog-content li {
    margin-top: 0.5rem;
    margin-bottom: 0;
    line-height: 1.7;
  }
  .blog-content li > p {
    margin-top: 0.75rem;
  }
  .blog-content li > p:first-child {
    margin-top: 0;
  }
  .blog-content li::marker {
    color: var(--blog-nav-link-color, #9ca3af);
  }
  .blog-content ul ul,
  .blog-content ol ol,
  .blog-content ul ol,
  .blog-content ol ul {
    margin-top: 0.25rem;
    margin-bottom: 0.25rem;
  }
  .blog-content blockquote {
    margin-top: 1.75rem;
    margin-bottom: 1.75rem;
    padding-left: 1.25rem;
    border-left: 3px solid var(--border-color, #E5E5E5);
    font-style: italic;
    color: var(--blog-author-body-color, #374151);
  }
  .blog-content hr {
    margin-top: 2.5rem;
    margin-bottom: 2.5rem;
    border: 0;
    height: 1px;
    background: var(--divider-color, #eeeeee);
  }
  .blog-content img {
    margin-top: 1.5rem;
    margin-bottom: 1.5rem;
    border-radius: 0.75rem;
    width: 100%;
    height: auto;
  }
  .blog-content figure {
    margin-top: 1.5rem;
    margin-bottom: 1.5rem;
  }
  .blog-content figcaption {
    margin-top: 0.5rem;
    font-size: 0.875rem;
    color: var(--lighter-text-color, #7B7B7B);
    text-align: center;
  }
  .blog-content table {
    margin-top: 1.5rem;
    margin-bottom: 1.5rem;
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9375rem;
    display: block;
    overflow-x: auto;
  }
  .blog-content th {
    padding: 0.625rem 0.75rem;
    text-align: left;
    font-weight: 600;
    color: var(--blog-author-name-color, #111827);
    border-bottom: 2px solid var(--border-color, #E5E5E5);
  }
  .blog-content td {
    padding: 0.625rem 0.75rem;
    border-bottom: 1px solid var(--divider-color, #eeeeee);
    color: var(--blog-all-articles-text-color, #334155);
  }
  .blog-content code {
    font-size: 0.875rem;
    padding: 0.125rem 0.375rem;
    background: var(--section-bg, #F9FAFB);
    border-radius: 0.25rem;
    color: var(--color-black, #000000);
  }
  .blog-content pre {
    margin-top: 1.25rem;
    margin-bottom: 1.25rem;
    padding: 1rem;
    background: var(--blog-nav-hover-color, #0f172a);
    border-radius: 0.75rem;
    overflow-x: auto;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-white, #FFFFFF);
  }
  .blog-content pre code {
    background: none;

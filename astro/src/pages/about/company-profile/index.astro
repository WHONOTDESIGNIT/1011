---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import { t } from '../../../lib/i18n';
import { getLocalizedPath, buildBreadcrumbs } from '../../../lib/breadcrumbs';
import { responsiveImageSources } from '../../../lib/netlify-images';

const locale = Astro.currentLocale ?? 'en';
const heroBackgroundImage =
  'https://images.pexels.com/photos/3825517/pexels-photo-3825517.jpeg?auto=compress&cs=tinysrgb&w=1600';
const heroBackgroundImageSources = responsiveImageSources(heroBackgroundImage, [800, 1200, 1600], 1600);
const companyProfileFacilityImage = responsiveImageSources(
  'https://images.pexels.com/photos/3825569/pexels-photo-3825569.jpeg?auto=compress&cs=tinysrgb&w=1200',
);

const facilityBullets = [
  'aboutPages.companyProfile.facilityBullets.0',
  'aboutPages.companyProfile.facilityBullets.1',
  'aboutPages.companyProfile.facilityBullets.2',
  'aboutPages.companyProfile.facilityBullets.3',
];

const rndCards = [
  {
    titleKey: 'aboutPages.companyProfile.rnd.card1.title',
    descriptionKey: 'aboutPages.companyProfile.rnd.card1.description',
  },
  {
    titleKey: 'aboutPages.companyProfile.rnd.card2.title',
    descriptionKey: 'aboutPages.companyProfile.rnd.card2.description',
  },
  {
    titleKey: 'aboutPages.companyProfile.rnd.card3.title',
    descriptionKey: 'aboutPages.companyProfile.rnd.card3.description',
  },
  {
    titleKey: 'aboutPages.companyProfile.rnd.card4.title',
    descriptionKey: 'aboutPages.companyProfile.rnd.card4.description',
  },
];

const processSteps = [
  {
    titleKey: 'aboutPages.companyProfile.process.step1.title',
    descriptionKey: 'aboutPages.companyProfile.process.step1.description',
  },
  {
    titleKey: 'aboutPages.companyProfile.process.step2.title',
    descriptionKey: 'aboutPages.companyProfile.process.step2.description',
  },
  {
    titleKey: 'aboutPages.companyProfile.process.step3.title',
    descriptionKey: 'aboutPages.companyProfile.process.step3.description',
  },
  {
    titleKey: 'aboutPages.companyProfile.process.step4.title',
    descriptionKey: 'aboutPages.companyProfile.process.step4.description',
  },
];

const qcTests = [
  'aboutPages.companyProfile.qcTests.0',
  'aboutPages.companyProfile.qcTests.1',
  'aboutPages.companyProfile.qcTests.2',
  'aboutPages.companyProfile.qcTests.3',
];

const qcCerts = [
  'aboutPages.companyProfile.qcCerts.0',
  'aboutPages.companyProfile.qcCerts.1',
  'aboutPages.companyProfile.qcCerts.2',
  'aboutPages.companyProfile.qcCerts.3',
];

const customizationCards = [
  {
    titleKey: 'aboutPages.companyProfile.customization.card1.title',
    bulletKeys: [
      'aboutPages.companyProfile.customization.card1.bullets.0',
      'aboutPages.companyProfile.customization.card1.bullets.1',
      'aboutPages.companyProfile.customization.card1.bullets.2',
      'aboutPages.companyProfile.customization.card1.bullets.3',
    ],
  },
  {
    titleKey: 'aboutPages.companyProfile.customization.card2.title',
    bulletKeys: [
      'aboutPages.companyProfile.customization.card2.bullets.0',
      'aboutPages.companyProfile.customization.card2.bullets.1',
      'aboutPages.companyProfile.customization.card2.bullets.2',
      'aboutPages.companyProfile.customization.card2.bullets.3',
    ],
  },
  {
    titleKey: 'aboutPages.companyProfile.customization.card3.title',
    bulletKeys: [
      'aboutPages.companyProfile.customization.card3.bullets.0',
      'aboutPages.companyProfile.customization.card3.bullets.1',
      'aboutPages.companyProfile.customization.card3.bullets.2',
      'aboutPages.companyProfile.customization.card3.bullets.3',
    ],
  },
];

const certifications = [
  'aboutPages.companyProfile.certifications.0',
  'aboutPages.companyProfile.certifications.1',
  'aboutPages.companyProfile.certifications.2',
  'aboutPages.companyProfile.certifications.3',
];

const standards = [
  'aboutPages.companyProfile.standards.0',
  'aboutPages.companyProfile.standards.1',
  'aboutPages.companyProfile.standards.2',
  'aboutPages.companyProfile.standards.3',
];

const logisticsBullets = [
  'aboutPages.companyProfile.logisticsBullets.0',
  'aboutPages.companyProfile.logisticsBullets.1',
  'aboutPages.companyProfile.logisticsBullets.2',
  'aboutPages.companyProfile.logisticsBullets.3',
  'aboutPages.companyProfile.logisticsBullets.4',
];
const pageTitle = t(locale, 'nav.companyProfile');
const pageDescription = t(locale, 'aboutPages.companyProfile.description');
const breadcrumbs = buildBreadcrumbs(locale, [
  { label: t(locale, 'common.home'), path: '/' },
  { label: t(locale, 'nav.about'), path: '/about' },
  { label: pageTitle },
]);
---

<BaseLayout title={pageTitle} lang={locale} description={pageDescription}>
  <div class="space-y-48">
    <section class="relative overflow-hidden rounded-2xl bg-ink-900 px-8 py-14 text-white">
      <picture class="pointer-events-none absolute inset-0 h-full w-full" aria-hidden="true">
        <source srcset={heroBackgroundImageSources.avifSrcSet} sizes="100vw" type="image/avif" />
        <source srcset={heroBackgroundImageSources.webpSrcSet} sizes="100vw" type="image/webp" />
        <img
          src={heroBackgroundImageSources.src}
          srcset={heroBackgroundImageSources.webpSrcSet}
          sizes="100vw"
          alt=""
          loading="eager"
          fetchpriority="high"
          decoding="async"
          width="1600"
          height="900"
          class="absolute inset-0 h-full w-full object-cover"
        />
      </picture>
      <div class="pointer-events-none absolute inset-0 bg-black/40" />
      <div class="relative">
        <Breadcrumb items={breadcrumbs} variant="dark" locale={locale} />
        <h1 class="mt-6 text-4xl font-bold md:text-5xl">{pageTitle}</h1>
        <p class="mt-4 max-w-3xl text-lg text-neutral-200">
          {t(locale, 'aboutPages.companyProfile.heroSubtitle')}
        </p>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-6">
      <h2 class="text-sm font-semibold uppercase tracking-[0.22em] text-neutral-600">{t(locale, 'common.citableSummary')}</h2>
      <h3 class="mt-2 text-2xl font-bold text-ink-900">{t(locale, 'aboutPages.companyProfile.summaryTitle')}</h3>
      <p class="mt-4 max-w-4xl text-lg leading-relaxed text-neutral-700">
        {t(locale, 'aboutPages.companyProfile.summaryDescription')}
      </p>
    </section>

    <section class="space-y-6">
      <h2 class="text-3xl font-bold text-ink-900">{t(locale, 'aboutPages.companyProfile.excellenceTitle')}</h2>
      <p class="text-xl leading-relaxed text-neutral-700">
        {t(locale, 'aboutPages.companyProfile.excellenceParagraph')}
      </p>
    </section>

    <section class="space-y-8">
      <h2 class="text-3xl font-bold text-ink-900">{t(locale, 'aboutPages.companyProfile.facilitiesTitle')}</h2>
      <div class="grid gap-10 lg:grid-cols-2 lg:items-center">
        <div>
          <p class="text-neutral-700">
            {t(locale, 'aboutPages.companyProfile.facilitiesParagraph')}
          </p>
          <ul class="mt-6 space-y-3 text-neutral-700">
            {facilityBullets.map((b) => (
              <li class="flex items-start gap-3">
                <span class="mt-2 h-2 w-2 flex-shrink-0 rounded-2xl bg-sky-600" />
                <span>{t(locale, b)}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="overflow-hidden rounded-2xl border border-neutral-200 bg-white shadow-sm">
          <div class="aspect-[4/3]">
            <picture>
              <source srcset={companyProfileFacilityImage.avifSrcSet} sizes="(min-width: 1024px) 33vw, 100vw" type="image/avif" />
              <source srcset={companyProfileFacilityImage.webpSrcSet} sizes="(min-width: 1024px) 33vw, 100vw" type="image/webp" />
              <img
                src={companyProfileFacilityImage.src}
                srcset={companyProfileFacilityImage.webpSrcSet}
                sizes="(min-width: 1024px) 33vw, 100vw"
                alt={t(locale, 'aboutPages.companyProfile.facilityImageAlt')}
                loading="lazy"
                decoding="async"
                width="1200"
                height="900"
                class="h-full w-full object-cover"
              />
            </picture>
          </div>
        </div>
      </div>
    </section>

    <section class="rounded-2xl bg-neutral-50 p-8">
      <div class="grid gap-8 lg:grid-cols-[80px_1fr] lg:items-start">
        <div class="hidden lg:block">
          <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-white shadow-sm">
            <span class="text-2xl font-bold text-sky-700">R&amp;D</span>
          </div>
        </div>
        <div class="space-y-8">
          <div>
            <h2 class="text-3xl font-bold text-ink-900">{t(locale, 'aboutPages.companyProfile.rndTitle')}</h2>
            <p class="mt-3 text-neutral-700">
              {t(locale, 'aboutPages.companyProfile.rndParagraph')}
            </p>
          </div>
          <div class="grid gap-6 md:grid-cols-2">
            {rndCards.map((card) => (
              <div class="rounded-xl border border-neutral-200 bg-white p-6 shadow-sm">
                <div class="text-xl font-semibold text-ink-900">{t(locale, card.titleKey)}</div>
                <div class="mt-2 text-neutral-700">{t(locale, card.descriptionKey)}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="space-y-8">
      <h2 class="text-3xl font-bold text-ink-900">{t(locale, 'aboutPages.companyProfile.processTitle')}</h2>
      <p class="text-neutral-700">
        {t(locale, 'aboutPages.companyProfile.processParagraph')}
      </p>
      <div class="grid gap-6 md:grid-cols-2">
        {processSteps.map((step, idx) => (
          <div class="flex items-start gap-4 rounded-xl border border-neutral-200 bg-white p-6 shadow-sm">
            <div class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-2xl bg-sky-600 text-sm font-bold text-white">
              {idx + 1}
            </div>
            <div>
              <div class="text-lg font-semibold text-ink-900">{t(locale, step.titleKey)}</div>
              <div class="mt-2 text-sm text-neutral-700">{t(locale, step.descriptionKey)}</div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="space-y-8">
      <h2 class="text-3xl font-bold text-ink-900">{t(locale, 'aboutPages.companyProfile.qualityTitle')}</h2>
      <div class="grid gap-8 md:grid-cols-2">
        <div class="rounded-2xl border border-neutral-200 bg-white p-8 shadow-sm">
          <div class="text-xl font-semibold text-ink-900">{t(locale, 'aboutPages.companyProfile.rigorousTestingTitle')}</div>
          <p class="mt-3 text-neutral-700">{t(locale, 'aboutPages.companyProfile.rigorousTestingParagraph')}</p>
          <ul class="mt-5 space-y-3 text-neutral-700">
            {qcTests.map((b) => (
              <li class="flex items-start gap-3">
                <span class="mt-2 h-2 w-2 flex-shrink-0 rounded-2xl bg-sky-600" />
                <span>{t(locale, b)}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="rounded-2xl border border-neutral-200 bg-white p-8 shadow-sm">
          <div class="text-xl font-semibold text-ink-900">{t(locale, 'aboutPages.companyProfile.certificationsTitle')}</div>
          <p class="mt-3 text-neutral-700">{t(locale, 'aboutPages.companyProfile.certificationsParagraph')}</p>
          <ul class="mt-5 space-y-3 text-neutral-700">
            {qcCerts.map((b) => (
              <li class="flex items-start gap-3">
                <span class="mt-2 h-2 w-2 flex-shrink-0 rounded-2xl bg-sky-600" />
                <span>{t(locale, b)}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
      <p class="text-neutral-700">
        {t(locale, 'aboutPages.companyProfile.inspectionParagraph')}
      </p>
    </section>

    <section class="rounded-2xl border border-sky-100 bg-sky-50 p-8">
      <h2 class="text-3xl font-bold text-ink-900">{t(locale, 'aboutPages.companyProfile.customizationTitle')}</h2>
      <p class="mt-3 text-neutral-700">
        {t(locale, 'aboutPages.companyProfile.customizationParagraph')}
      </p>
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        {customizationCards.map((card) => (
          <div class="rounded-xl border border-neutral-200 bg-white p-6 shadow-sm">
            <div class="text-xl font-semibold text-ink-900">{t(locale, card.titleKey)}</div>
            <ul class="mt-4 space-y-2 text-sm text-neutral-700">
              {card.bulletKeys.map((b) => (
                <li class="flex items-start gap-3">
                  <span class="mt-2 h-2 w-2 flex-shrink-0 rounded-2xl bg-sky-600" />
                  <span>{t(locale, b)}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <section class="space-y-8">
      <h2 class="text-3xl font-bold text-ink-900">{t(locale, 'aboutPages.companyProfile.complianceTitle')}</h2>
      <p class="text-neutral-700">
        {t(locale, 'aboutPages.companyProfile.complianceParagraph')}
      </p>
      <div class="grid gap-6 md:grid-cols-2">
        <div class="rounded-2xl bg-neutral-50 p-6">
          <div class="text-xl font-semibold text-ink-900">{t(locale, 'aboutPages.companyProfile.globalCertificationsTitle')}</div>
          <ul class="mt-5 space-y-3 text-neutral-700">
            {certifications.map((c) => (
              <li class="flex items-start gap-3">
                <span class="mt-2 h-2 w-2 flex-shrink-0 rounded-2xl bg-sky-600" />
                <span>{t(locale, c)}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="rounded-2xl bg-neutral-50 p-6">
          <div class="text-xl font-semibold text-ink-900">{t(locale, 'aboutPages.companyProfile.technicalStandardsTitle')}</div>
          <ul class="mt-5 space-y-3 text-neutral-700">
            {standards.map((s) => (
              <li class="flex items-start gap-3">
                <span class="mt-2 h-2 w-2 flex-shrink-0 rounded-2xl bg-sky-600" />
                <span>{t(locale, s)}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
      <div class="rounded-lg border-l-4 border-violet-600 bg-violet-50 p-4 text-violet-900">
        {t(locale, 'aboutPages.companyProfile.mdrNote')}
      </div>
    </section>

    <section class="space-y-8">
      <h2 class="text-3xl font-bold text-ink-900">{t(locale, 'aboutPages.companyProfile.logisticsTitle')}</h2>
      <div class="grid gap-8 md:grid-cols-[2fr_1fr] md:items-start">
        <div class="rounded-2xl border border-neutral-200 bg-white p-8 shadow-sm">
          <p class="text-neutral-700">
            {t(locale, 'aboutPages.companyProfile.logisticsParagraph')}
          </p>
          <ul class="mt-6 space-y-3 text-neutral-700">
            {logisticsBullets.map((b) => (
              <li class="flex items-start gap-3">
                <span class="mt-2 h-2 w-2 flex-shrink-0 rounded-2xl bg-sky-600" />
                <span>{t(locale, b)}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="rounded-2xl bg-neutral-50 p-6">
          <div class="text-xl font-semibold text-sky-700">{t(locale, 'aboutPages.companyProfile.globalReachTitle')}</div>
          <p class="mt-3 text-neutral-700">
            {t(locale, 'aboutPages.companyProfile.globalReachParagraph1')}
          </p>
          <p class="mt-3 text-neutral-700">
            {t(locale, 'aboutPages.companyProfile.globalReachParagraph2')}
          </p>
        </div>
      </div>
    </section>

    <section class="rounded-2xl bg-sky-600 p-8 text-center text-white">
      <h2 class="text-2xl font-bold">{t(locale, 'aboutPages.companyProfile.ctaTitle')}</h2>
      <p class="mx-auto mt-3 max-w-3xl text-lg text-sky-100">
        {t(locale, 'aboutPages.companyProfile.ctaParagraph')}
      </p>
      <div class="mt-8 flex justify-center gap-3">
        <a class="rounded bg-white px-5 py-3 text-sm font-medium text-sky-700" href={getLocalizedPath(locale, '/contact')}>{t(locale, 'aboutPages.companyProfile.contactCta')}</a>
        <a class="rounded border border-white/30 px-5 py-3 text-sm font-medium text-white" href={getLocalizedPath(locale, '/about')}>{t(locale, 'aboutPages.backToAbout')}</a>
      </div>
    </section>
  </div>
</BaseLayout>

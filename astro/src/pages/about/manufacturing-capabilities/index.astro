---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import { t } from '../../../lib/i18n';
import { getLocalizedPath, buildBreadcrumbs } from '../../../lib/breadcrumbs';
import { responsiveImageSources } from '../../../lib/netlify-images';

const locale = Astro.currentLocale ?? 'en';
const heroBackgroundImage =
  'https://images.pexels.com/photos/3825517/pexels-photo-3825517.jpeg?auto=compress&cs=tinysrgb&w=1600';
const heroBackgroundImageSources = responsiveImageSources(heroBackgroundImage, [800, 1200, 1600], 1600);

const cards = [
  {
    titleKey: 'aboutPages.manufacturing.cards.card1.title',
    accent: 'bg-sky-600',
    descriptionKey: 'aboutPages.manufacturing.cards.card1.description',
  },
  {
    titleKey: 'aboutPages.manufacturing.cards.card2.title',
    accent: 'bg-emerald-600',
    descriptionKey: 'aboutPages.manufacturing.cards.card2.description',
  },
  {
    titleKey: 'aboutPages.manufacturing.cards.card3.title',
    accent: 'bg-violet-600',
    descriptionKey: 'aboutPages.manufacturing.cards.card3.description',
  },
  {
    titleKey: 'aboutPages.manufacturing.cards.card4.title',
    accent: 'bg-violet-600',
    descriptionKey: 'aboutPages.manufacturing.cards.card4.description',
  },
];

const reasons = [
  'aboutPages.reasons.0',
  'aboutPages.reasons.1',
  'aboutPages.reasons.2',
  'aboutPages.reasons.3',
  'aboutPages.reasons.4',
];
const pageTitle = t(locale, 'nav.manufacturing');
const pageDescription = t(locale, 'aboutPages.manufacturing.description');
const breadcrumbs = buildBreadcrumbs(locale, [
  { label: t(locale, 'common.home'), path: '/' },
  { label: t(locale, 'nav.about'), path: '/about' },
  { label: pageTitle },
]);
---

<BaseLayout title={pageTitle} lang={locale} description={pageDescription}>
  <div class="space-y-48">
    <section class="relative overflow-hidden rounded-2xl bg-slate-900 px-8 py-14 text-white">
      <picture class="pointer-events-none absolute inset-0 h-full w-full" aria-hidden="true">
        <source srcset={heroBackgroundImageSources.avifSrcSet} sizes="100vw" type="image/avif" />
        <source srcset={heroBackgroundImageSources.webpSrcSet} sizes="100vw" type="image/webp" />
        <img
          src={heroBackgroundImageSources.src}
          srcset={heroBackgroundImageSources.webpSrcSet}
          sizes="100vw"
          alt=""
          loading="eager"
          fetchpriority="high"
          decoding="async"
          width="1600"
          height="900"
          class="absolute inset-0 h-full w-full object-cover"
        />
      </picture>
      <div class="pointer-events-none absolute inset-0 bg-black/40" />
      <div class="relative">
        <Breadcrumb items={breadcrumbs} variant="dark" locale={locale} />
        <h1 class="mt-6 text-4xl font-bold md:text-5xl">{pageTitle}</h1>
        <p class="mt-4 max-w-3xl text-lg text-slate-200">
          {t(locale, 'aboutPages.manufacturing.heroSubtitle')}
        </p>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-6">
      <h2 class="text-sm font-semibold uppercase tracking-[0.22em] text-slate-600">{t(locale, 'common.citableSummary')}</h2>
      <h3 class="mt-2 text-2xl font-bold text-slate-900">{t(locale, 'aboutPages.manufacturing.summaryTitle')}</h3>
      <p class="mt-4 max-w-4xl text-lg leading-relaxed text-slate-700">
        {t(locale, 'aboutPages.manufacturing.summaryDescription')}
      </p>
    </section>

    <section class="space-y-6">
      <h2 class="text-3xl font-bold text-slate-900">{t(locale, 'aboutPages.manufacturing.facilitiesTitle')}</h2>
      <p class="text-lg text-slate-700">
        {t(locale, 'aboutPages.manufacturing.heroSubtitle')}
      </p>
      <p class="text-lg text-slate-700">
        {t(locale, 'aboutPages.manufacturing.introParagraph')}
      </p>
    </section>

    <section class="grid gap-8 md:grid-cols-2">
      {cards.map((card) => (
        <div class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm">
          <div class={`mb-6 flex h-14 w-14 items-center justify-center rounded-2xl ${card.accent}`}>
            <span class="text-lg font-bold text-white">+</span>
          </div>
          <h3 class="text-xl font-semibold text-slate-900">{t(locale, card.titleKey)}</h3>
          <p class="mt-3 text-slate-700">{t(locale, card.descriptionKey)}</p>
        </div>
      ))}
    </section>

    <section class="rounded-2xl bg-slate-50 p-8">
      <h2 class="text-2xl font-bold text-slate-900">{t(locale, 'aboutPages.whyChooseTitle')}</h2>
      <ul class="mt-6 space-y-3 text-slate-700">
        {reasons.map((r) => (
          <li class="flex items-start gap-3">
            <span class="mt-2 h-2 w-2 flex-shrink-0 rounded-2xl bg-emerald-600" />
            <span>{t(locale, r)}</span>
          </li>
        ))}
      </ul>
      <div class="mt-8 flex flex-wrap gap-3">
        <a class="rounded bg-slate-900 px-4 py-2 text-sm font-medium text-white" href={getLocalizedPath(locale, '/contact')}>{t(locale, 'aboutPages.requestQuote')}</a>
        <a class="rounded border border-slate-300 px-4 py-2 text-sm font-medium text-slate-900" href={getLocalizedPath(locale, '/about')}>{t(locale, 'aboutPages.backToAbout')}</a>
      </div>
    </section>
  </div>
</BaseLayout>

---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import { t } from '../../../lib/i18n';
import { getLocalizedPath, buildBreadcrumbs } from '../../../lib/breadcrumbs';
import { responsiveImageSources } from '../../../lib/netlify-images';

const locale = Astro.currentLocale ?? 'en';
const heroBackgroundImage =
  '/images/about/brand-story-hero.webp';
const heroBackgroundImageSources = responsiveImageSources(heroBackgroundImage, [800, 1200, 1600], 1600);

const highlights = [
  {
    titleKey: 'aboutPages.brandStory.highlights.item1.title',
    descriptionKey: 'aboutPages.brandStory.highlights.item1.description',
  },
  {
    titleKey: 'aboutPages.brandStory.highlights.item2.title',
    descriptionKey: 'aboutPages.brandStory.highlights.item2.description',
  },
  {
    titleKey: 'aboutPages.brandStory.highlights.item3.title',
    descriptionKey: 'aboutPages.brandStory.highlights.item3.description',
  },
  {
    titleKey: 'aboutPages.brandStory.highlights.item4.title',
    descriptionKey: 'aboutPages.brandStory.highlights.item4.description',
  },
];

const reasons = [
  'aboutPages.reasons.0',
  'aboutPages.reasons.1',
  'aboutPages.reasons.2',
  'aboutPages.reasons.3',
  'aboutPages.reasons.4',
];
const pageTitle = t(locale, 'nav.brandStory');
// EN SEO 富化标题（仅 meta title；H1/导航/面包屑仍用共享文案）
const seoTitle = locale === 'en' ? 'Brand Story | iShine Technology Ltd. IPL Manufacturer' : pageTitle;
const pageDescription = t(locale, 'aboutPages.brandStory.description');
const breadcrumbs = buildBreadcrumbs(locale, [
  { label: t(locale, 'common.home'), path: '/' },
  { label: t(locale, 'nav.about'), path: '/about' },
  { label: pageTitle },
]);
---

<BaseLayout title={seoTitle} lang={locale} description={pageDescription}>
  <div class="space-y-48">
    <section
      class="relative overflow-hidden rounded-2xl bg-ink-900 px-8 py-14 text-white"
      style="min-height:764px;"
    >
      <picture class="pointer-events-none absolute inset-0 h-full w-full" aria-hidden="true">
        <source srcset={heroBackgroundImageSources.avifSrcSet} sizes="100vw" type="image/avif" />
        <source srcset={heroBackgroundImageSources.webpSrcSet} sizes="100vw" type="image/webp" />
        <img
          src={heroBackgroundImageSources.src}
          srcset={heroBackgroundImageSources.webpSrcSet}
          sizes="100vw"
          alt=""
          loading="eager"
          fetchpriority="high"
          decoding="async"
          width="1600"
          height="764"
          class="absolute inset-0 h-full w-full object-cover"
        />
      </picture>
      <div class="pointer-events-none absolute inset-0 bg-black/40" />
      <div class="relative">
        <Breadcrumb items={breadcrumbs} variant="dark" locale={locale} />
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-6">
      <h2 class="text-sm font-semibold uppercase tracking-[0.22em] text-neutral-600">{t(locale, 'common.citableSummary')}</h2>
      <h3 class="mt-2 text-2xl font-bold text-ink-900">{t(locale, 'aboutPages.brandStory.summaryTitle')}</h3>
      <p class="mt-4 max-w-4xl text-lg leading-relaxed text-neutral-700">
        {t(locale, 'aboutPages.brandStory.summaryDescription')}
      </p>
    </section>

    <section class="space-y-6">
      <div class="max-w-3xl">
        <h1 class="text-3xl font-bold text-ink-900 md:text-4xl">{pageTitle}</h1>
        <p class="mt-4 text-lg text-neutral-700">
          {t(locale, 'aboutPages.brandStory.introSubtitle')}
        </p>
        <p class="mt-4 text-lg text-neutral-700">
          {t(locale, 'aboutPages.brandStory.introParagraph')}
        </p>
      </div>
    </section>

    <section class="space-y-8">
      <div class="grid gap-8 md:grid-cols-2">
        {highlights.map((item) => (
          <div class="rounded-xl border border-neutral-200 bg-white p-6 shadow-sm">
            <h2 class="text-xl font-semibold text-ink-900">{t(locale, item.titleKey)}</h2>
            <p class="mt-3 text-neutral-700">{t(locale, item.descriptionKey)}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="rounded-2xl bg-neutral-50 p-8">
      <h2 class="text-2xl font-bold text-ink-900">{t(locale, 'aboutPages.whyChooseTitle')}</h2>
      <ul class="mt-6 space-y-3 text-neutral-700">
        {reasons.map((r) => (
          <li class="flex items-start gap-3">
            <span class="mt-2 h-2 w-2 flex-shrink-0 rounded-2xl bg-sky-600" />
            <span>{t(locale, r)}</span>
          </li>
        ))}
      </ul>
      <div class="mt-8 flex flex-wrap gap-3">
        <a class="rounded bg-ink-900 px-4 py-2 text-sm font-medium text-white" href={getLocalizedPath(locale, '/contact')}>{t(locale, 'aboutPages.brandStory.contactCta')}</a>
        <a class="rounded border border-neutral-300 px-4 py-2 text-sm font-medium text-ink-900" href={getLocalizedPath(locale, '/about')}>{t(locale, 'aboutPages.backToAbout')}</a>
      </div>
    </section>

    <section class="space-y-8">
      <div class="max-w-3xl">
        <h2 class="text-3xl font-bold text-ink-900 md:text-4xl">{t(locale, 'aboutPages.brandStory.teamTitle')}</h2>
        <p class="mt-4 text-lg text-neutral-700">
          {t(locale, 'aboutPages.brandStory.teamSubtitle')}
        </p>
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        <div class="rounded-xl border border-neutral-200 bg-white p-6 shadow-sm text-center">
          <div class="mx-auto h-24 w-24 rounded-2xl bg-neutral-200 flex items-center justify-center text-3xl font-bold text-neutral-400">EA</div>
          <h3 class="mt-4 text-lg font-semibold text-ink-900">{t(locale, 'aboutPages.brandStory.team.member1.name')}</h3>
          <p class="text-sm text-sky-600 font-medium">{t(locale, 'aboutPages.brandStory.team.member1.role')}</p>
          <p class="mt-2 text-sm text-neutral-600">{t(locale, 'aboutPages.brandStory.team.member1.description')}</p>
        </div>
        <div class="rounded-xl border border-neutral-200 bg-white p-6 shadow-sm text-center">
          <div class="mx-auto h-24 w-24 rounded-2xl bg-neutral-200 flex items-center justify-center text-3xl font-bold text-neutral-400">SC</div>
          <h3 class="mt-4 text-lg font-semibold text-ink-900">{t(locale, 'aboutPages.brandStory.team.member2.name')}</h3>
          <p class="text-sm text-sky-600 font-medium">{t(locale, 'aboutPages.brandStory.team.member2.role')}</p>
          <p class="mt-2 text-sm text-neutral-600">{t(locale, 'aboutPages.brandStory.team.member2.description')}</p>
        </div>
        <div class="rounded-xl border border-neutral-200 bg-white p-6 shadow-sm text-center">
          <div class="mx-auto h-24 w-24 rounded-2xl bg-neutral-200 flex items-center justify-center text-3xl font-bold text-neutral-400">MB</div>
          <h3 class="mt-4 text-lg font-semibold text-ink-900">{t(locale, 'aboutPages.brandStory.team.member3.name')}</h3>
          <p class="text-sm text-sky-600 font-medium">{t(locale, 'aboutPages.brandStory.team.member3.role')}</p>
          <p class="mt-2 text-sm text-neutral-600">{t(locale, 'aboutPages.brandStory.team.member3.description')}</p>
        </div>
        <div class="rounded-xl border border-neutral-200 bg-white p-6 shadow-sm text-center">
          <div class="mx-auto h-24 w-24 rounded-2xl bg-neutral-200 flex items-center justify-center text-3xl font-bold text-neutral-400">AD</div>
          <h3 class="mt-4 text-lg font-semibold text-ink-900">{t(locale, 'aboutPages.brandStory.team.member4.name')}</h3>
          <p class="text-sm text-sky-600 font-medium">{t(locale, 'aboutPages.brandStory.team.member4.role')}</p>
          <p class="mt-2 text-sm text-neutral-600">{t(locale, 'aboutPages.brandStory.team.member4.description')}</p>
        </div>
        <div class="rounded-xl border border-neutral-200 bg-white p-6 shadow-sm text-center">
          <div class="mx-auto h-24 w-24 rounded-2xl bg-neutral-200 flex items-center justify-center text-3xl font-bold text-neutral-400">VP</div>
          <h3 class="mt-4 text-lg font-semibold text-ink-900">{t(locale, 'aboutPages.brandStory.team.member5.name')}</h3>
          <p class="text-sm text-sky-600 font-medium">{t(locale, 'aboutPages.brandStory.team.member5.role')}</p>
          <p class="mt-2 text-sm text-neutral-600">{t(locale, 'aboutPages.brandStory.team.member5.description')}</p>
        </div>
        <div class="rounded-xl border border-neutral-200 bg-white p-6 shadow-sm text-center">
          <div class="mx-auto h-24 w-24 rounded-2xl bg-neutral-200 flex items-center justify-center text-3xl font-bold text-neutral-400">ML</div>
          <h3 class="mt-4 text-lg font-semibold text-ink-900">{t(locale, 'aboutPages.brandStory.team.member6.name')}</h3>
          <p class="text-sm text-sky-600 font-medium">{t(locale, 'aboutPages.brandStory.team.member6.role')}</p>
          <p class="mt-2 text-sm text-neutral-600">{t(locale, 'aboutPages.brandStory.team.member6.description')}</p>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

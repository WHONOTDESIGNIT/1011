---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t } from '../../lib/i18n';
import { responsiveImageSources } from '../../lib/netlify-images';

const locale = Astro.currentLocale ?? 'en';
const values = [
  {
    titleKey: 'aboutPages.overview.values.item1.title',
    descriptionKey: 'aboutPages.overview.values.item1.description',
  },
  {
    titleKey: 'aboutPages.overview.values.item2.title',
    descriptionKey: 'aboutPages.overview.values.item2.description',
  },
  {
    titleKey: 'aboutPages.overview.values.item3.title',
    descriptionKey: 'aboutPages.overview.values.item3.description',
  },
  {
    titleKey: 'aboutPages.overview.values.item4.title',
    descriptionKey: 'aboutPages.overview.values.item4.description',
  },
];

const pageTitle = t(locale, 'aboutPages.overview.title');
// EN SEO 富化标题（仅 meta title，H1/导航/面包屑仍用 pageTitle 共享文案；其他语言走 buildFinalTitle 自动补尾）
const seoTitle = locale === 'en' ? 'About iShine | Professional IPL Device Manufacturer' : pageTitle;
const pageDescription = t(locale, 'aboutPages.overview.description');
const aboutFacilityImage = responsiveImageSources(
  'https://images.pexels.com/photos/3825569/pexels-photo-3825569.jpeg?auto=compress&cs=tinysrgb&w=1200',
);
---

<BaseLayout title={seoTitle} lang={locale} description={pageDescription}>
  <style is:inline>
    /* ═══ iShine About — Develo Design 风格（对齐 develo-blog.astro） ═══ */
    .about-page{background:var(--color-white);color:var(--color-ink);font-family:Manrope,-apple-system,Roboto,Helvetica,sans-serif;-webkit-font-smoothing:antialiased}
    .about-page a{text-decoration:none;color:inherit}
    .content-area{max-width:var(--max-w-page,1843px);padding-left:0;padding-right:0}
    @media(max-width:1279px){.content-area{max-width:100%}}

    /* Hero */
    .about-hero{width:100%;max-width:var(--max-w-page,1843px);margin:0 auto 24px;padding:0 100px}
    .about-hero-inner{display:flex;flex-direction:column;gap:8px}
    .about-hero-label{display:flex;align-items:center;gap:12px;padding:3px 12px;margin-bottom:16px}
    .about-hero-label svg{flex-shrink:0}
    .about-hero-label span{font-family:Manrope,sans-serif;font-size:18px;font-weight:400;color:var(--color-ink);line-height:26px}
    .about-hero h1{font-family:Syne,sans-serif;font-size:62px;font-weight:400;line-height:68px;letter-spacing:-.61px;color:var(--color-ink);margin:0}
    .about-hero-desc{font-family:Manrope,sans-serif;font-size:20px;font-weight:400;line-height:30px;color:var(--color-gray-600);max-width:600px}

    /* Citable Summary */
    .about-summary{width:100%;max-width:var(--max-w-page,1843px);margin:0 auto;padding:0 100px 48px}
    .about-summary-kicker{font-family:Manrope,sans-serif;font-size:12px;font-weight:600;color:var(--color-primary);text-transform:uppercase;letter-spacing:.5px}
    .about-summary-title{font-family:Syne,sans-serif;font-size:24px;font-weight:400;line-height:31px;color:var(--color-ink);margin:8px 0 0}
    .about-summary-desc{font-family:Manrope,sans-serif;font-size:15px;font-weight:400;line-height:23px;color:var(--color-gray-600);max-width:900px;margin:12px 0 0}

    /* Full-stack partner（左文右图） */
    .about-partner-section{width:100%;max-width:var(--max-w-page,1843px);margin:0 auto;padding:0 100px 100px;display:flex;gap:60px;align-items:flex-start}
    .about-partner-text{flex:1}
    .about-partner-text h2{font-family:Syne,sans-serif;font-size:32px;font-weight:400;line-height:38px;color:var(--color-ink);margin:0}
    .about-partner-text p{font-family:Manrope,sans-serif;font-size:15px;font-weight:400;line-height:23px;color:var(--color-gray-600);margin:20px 0 0}
    .about-partner-text p strong{font-weight:600;color:var(--color-ink)}
    .about-partner-image{width:46%;flex-shrink:0;border-radius:20px;overflow:hidden;background:var(--color-gray-200)}
    .about-partner-image img{width:100%;height:100%;object-fit:cover}

    /* Core Values（grey-50 底） */
    .about-values-section{background:var(--color-gray-50);padding:60px 0 80px}
    .about-values-container{width:100%;max-width:var(--max-w-page,1843px);margin:0 auto;padding:0 100px}
    .about-section-header{margin-bottom:40px}
    .about-section-header h2{font-family:Syne,sans-serif;font-size:32px;font-weight:400;line-height:38px;color:var(--color-ink);margin:0}
    .about-section-header p{font-family:Manrope,sans-serif;font-size:15px;font-weight:400;line-height:23px;color:var(--color-gray-600);max-width:560px;margin:8px 0 0}
    .about-values-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:24px}
    .about-card{background:var(--color-white);border:1px solid var(--color-gray-200);border-radius:16px;padding:24px;transition:transform .2s}
    .about-card:hover{transform:translateY(-4px)}
    .about-card h3{font-family:Syne,sans-serif;font-size:18px;font-weight:400;line-height:26px;color:var(--color-ink);margin:0;transition:color .2s}
    .about-card:hover h3{color:var(--color-primary)}
    .about-card p{font-family:Manrope,sans-serif;font-size:15px;font-weight:400;line-height:23px;color:var(--color-gray-600);margin:8px 0 0}

    /* Stats */
    .about-stats-section{width:100%;max-width:var(--max-w-page,1843px);margin:0 auto;padding:0 100px 100px}
    .about-stats-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
    .about-stat{background:var(--color-white);border:1px solid var(--color-gray-200);border-radius:16px;padding:32px 24px;text-align:center;transition:transform .2s}
    .about-stat:hover{transform:translateY(-4px)}
    .about-stat-value{font-family:Syne,sans-serif;font-size:32px;font-weight:400;line-height:38px;color:var(--color-ink)}
    .about-stat-label{font-family:Manrope,sans-serif;font-size:14px;font-weight:400;line-height:21px;color:var(--color-gray-500);margin-top:4px}

    /* Responsive — 与 develo-blog.astro 断点一致 */
    @media(max-width:1279px){
      .about-hero{padding:0 40px}
      .about-summary{padding:0 40px 40px}
      .about-partner-section{padding:0 40px 80px;flex-direction:column;gap:40px}
      .about-partner-image{width:100%}
      .about-values-container{padding:0 40px}
      .about-values-grid{grid-template-columns:repeat(2,1fr)}
      .about-stats-section{padding:0 40px 80px}
    }
    @media(max-width:767px){
      .about-hero{padding:0 24px}
      .about-hero h1{font-size:38px;line-height:44px;letter-spacing:-.37px}
      .about-hero-desc{font-size:16px;line-height:25px}
      .about-summary{padding:0 24px 32px}
      .about-summary-title{font-size:20px;line-height:27px}
      .about-partner-section{padding:0 24px 60px}
      .about-partner-text h2{font-size:24px;line-height:31px}
      .about-values-container{padding:0 24px}
      .about-values-grid{grid-template-columns:1fr}
      .about-values-section{padding:40px 0 60px}
      .about-stats-section{padding:0 24px 60px}
      .about-stats-grid{grid-template-columns:1fr}
    }
  </style>

  <div class="about-page">
    <!-- ═══ HERO ═══ -->
    <header class="about-hero">
      <div class="about-hero-inner">
        <div class="about-hero-label">
          <svg width="16" height="17" viewBox="0 0 16 17" fill="none"><g clip-path="url(#aboutHeroShape)"><path d="M2.16 16.4999C0.7733 14.3158 0 11.465 0 8.49995C0 5.53493 0.7733 2.68405 2.16 0.5V16.4999Z" fill="#020303"/><path d="M16 16.5C13.8783 16.5 11.8434 15.6572 10.3431 14.1569C8.84286 12.6566 8 10.6217 8 8.50001C8 6.37827 8.84285 4.34344 10.3431 2.84314C11.8434 1.34284 13.8783 0.5 16 0.5V16.5Z" fill="#020303"/></g><defs><clipPath id="aboutHeroShape"><rect fill="#fff" width="16" height="17"/></clipPath></defs></svg>
          <span>{t(locale, 'aboutPages.overview.heroLabel')}</span>
        </div>
        <h1>{pageTitle}</h1>
        <p class="about-hero-desc">
          {t(locale, 'aboutPages.overview.heroDescription')}
        </p>
      </div>
    </header>

    <!-- ═══ Citable Summary ═══ -->
    <section class="about-summary">
      <div class="about-summary-kicker">{t(locale, 'common.citableSummary')}</div>
      <h2 class="about-summary-title">{t(locale, 'aboutPages.overview.summaryTitle')}</h2>
      <p class="about-summary-desc">
        {t(locale, 'aboutPages.overview.summaryDescription')}
      </p>
    </section>

    <!-- ═══ Full-stack partner（左文右图） ═══ -->
    <section class="about-partner-section">
      <div class="about-partner-text">
        <h2>{t(locale, 'aboutPages.overview.partnerTitle')}</h2>
        <div>
          <p>
            <strong>{t(locale, 'aboutPages.overview.partner.entityLabel')}</strong> {t(locale, 'aboutPages.overview.partner.entityValue')}<br />
            <strong>{t(locale, 'aboutPages.overview.partner.industryLabel')}</strong> {t(locale, 'aboutPages.overview.partner.industryValue')}<br />
            <strong>{t(locale, 'aboutPages.overview.partner.headquartersLabel')}</strong> {t(locale, 'aboutPages.overview.partner.headquartersValue')}<br />
            <strong>{t(locale, 'aboutPages.overview.partner.certificationsLabel')}</strong> {t(locale, 'aboutPages.overview.partner.certificationsValue')}
          </p>
          <p>
            <strong>{t(locale, 'aboutPages.overview.partner.whatDoesLabel')}</strong> {t(locale, 'aboutPages.overview.partner.whatDoesValue')}
          </p>
          <p>
            <strong>{t(locale, 'aboutPages.overview.partner.keyPartnersLabel')}</strong> {t(locale, 'aboutPages.overview.partner.keyPartnersValue')}
          </p>
          <p>
            <strong>{t(locale, 'aboutPages.overview.partner.capabilitiesLabel')}</strong> {t(locale, 'aboutPages.overview.partner.capabilitiesValue')}
          </p>
          <p>
            <strong>{t(locale, 'aboutPages.overview.partner.clientTypesLabel')}</strong> {t(locale, 'aboutPages.overview.partner.clientTypesValue')}
          </p>
          <p>
            <strong>{t(locale, 'aboutPages.overview.partner.geographicLabel')}</strong> {t(locale, 'aboutPages.overview.partner.geographicValue')}
          </p>
          <p>
            <strong>{t(locale, 'aboutPages.overview.partner.trackRecordLabel')}</strong> {t(locale, 'aboutPages.overview.partner.trackRecordValue')}
          </p>
        </div>
      </div>
      <div class="about-partner-image">
        <picture>
          <source srcset={aboutFacilityImage.avifSrcSet} sizes="(min-width: 1024px) 46vw, 100vw" type="image/avif" />
          <source srcset={aboutFacilityImage.webpSrcSet} sizes="(min-width: 1024px) 46vw, 100vw" type="image/webp" />
          <img
            src={aboutFacilityImage.src}
            srcset={aboutFacilityImage.webpSrcSet}
            sizes="(min-width: 1024px) 46vw, 100vw"
            alt={t(locale, 'aboutPages.overview.facilityImageAlt')}
            loading="lazy"
            decoding="async"
            width="1200"
            height="900"
            class="h-full w-full object-cover"
          />
        </picture>
      </div>
    </section>

    <!-- ═══ Core Values ═══ -->
    <section class="about-values-section">
      <div class="about-values-container">
        <div class="about-section-header">
          <h2>{t(locale, 'aboutPages.overview.valuesTitle')}</h2>
          <p>{t(locale, 'aboutPages.overview.valuesSubtitle')}</p>
        </div>
        <div class="about-values-grid">
          {values.map((value) => (
            <div class="about-card">
              <h3>{t(locale, value.titleKey)}</h3>
              <p>{t(locale, value.descriptionKey)}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══ Stats ═══ -->
    <section class="about-stats-section">
      <div class="about-stats-grid">
        <div class="about-stat">
          <div class="about-stat-value">500K+</div>
          <div class="about-stat-label">{t(locale, 'aboutPages.overview.stats.devicesLabel')}</div>
        </div>
        <div class="about-stat">
          <div class="about-stat-value">50+</div>
          <div class="about-stat-label">{t(locale, 'aboutPages.overview.stats.clientsLabel')}</div>
        </div>
        <div class="about-stat">
          <div class="about-stat-value">2021</div>
          <div class="about-stat-label">{t(locale, 'aboutPages.overview.stats.yearsLabel')}</div>
        </div>
      </div>
    </section>

  </div>
</BaseLayout>

---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import { t } from '../../../lib/i18n';
import { getLocalizedPath, buildBreadcrumbs } from '../../../lib/breadcrumbs';
import { responsiveImageSources } from '../../../lib/netlify-images';

const locale = Astro.currentLocale ?? 'en';
const heroBackgroundImage =
  'https://images.pexels.com/photos/3825517/pexels-photo-3825517.jpeg?auto=compress&cs=tinysrgb&w=1600';
const heroBackgroundImageSources = responsiveImageSources(heroBackgroundImage, [800, 1200, 1600], 1600);

const qcFlow = [
  { titleKey: 'aboutPages.qualityControl.flow.step1.title', descriptionKey: 'aboutPages.qualityControl.flow.step1.description' },
  { titleKey: 'aboutPages.qualityControl.flow.step2.title', descriptionKey: 'aboutPages.qualityControl.flow.step2.description' },
  { titleKey: 'aboutPages.qualityControl.flow.step3.title', descriptionKey: 'aboutPages.qualityControl.flow.step3.description' },
  { titleKey: 'aboutPages.qualityControl.flow.step4.title', descriptionKey: 'aboutPages.qualityControl.flow.step4.description' },
  { titleKey: 'aboutPages.qualityControl.flow.step5.title', descriptionKey: 'aboutPages.qualityControl.flow.step5.description' },
];

const tests = [
  'aboutPages.qualityControl.tests.0',
  'aboutPages.qualityControl.tests.1',
  'aboutPages.qualityControl.tests.2',
  'aboutPages.qualityControl.tests.3',
  'aboutPages.qualityControl.tests.4',
];

const certifications = [
  'aboutPages.qualityControl.certifications.0',
  'aboutPages.qualityControl.certifications.1',
  'aboutPages.qualityControl.certifications.2',
  'aboutPages.qualityControl.certifications.3',
];
const pageTitle = t(locale, 'nav.quality');
const pageDescription = t(locale, 'aboutPages.qualityControl.description');
const breadcrumbs = buildBreadcrumbs(locale, [
  { label: t(locale, 'common.home'), path: '/' },
  { label: t(locale, 'nav.about'), path: '/about' },
  { label: pageTitle },
]);
---

<BaseLayout title={pageTitle} lang={locale} description={pageDescription}>
  <div class="space-y-48">
    <section class="relative overflow-hidden rounded-2xl bg-slate-900 px-8 py-14 text-white">
      <picture class="pointer-events-none absolute inset-0 h-full w-full" aria-hidden="true">
        <source srcset={heroBackgroundImageSources.avifSrcSet} sizes="100vw" type="image/avif" />
        <source srcset={heroBackgroundImageSources.webpSrcSet} sizes="100vw" type="image/webp" />
        <img
          src={heroBackgroundImageSources.src}
          srcset={heroBackgroundImageSources.webpSrcSet}
          sizes="100vw"
          alt=""
          loading="eager"
          fetchpriority="high"
          decoding="async"
          width="1600"
          height="900"
          class="absolute inset-0 h-full w-full object-cover"
        />
      </picture>
      <div class="pointer-events-none absolute inset-0 bg-black/40" />
      <div class="relative">
        <Breadcrumb items={breadcrumbs} variant="dark" locale={locale} />
        <h1 class="mt-6 text-4xl font-bold md:text-5xl">{pageTitle}</h1>
        <p class="mt-4 max-w-3xl text-lg text-slate-200">
          {t(locale, 'aboutPages.qualityControl.heroSubtitle')}
        </p>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-6">
      <h2 class="text-sm font-semibold uppercase tracking-[0.22em] text-slate-600">{t(locale, 'common.citableSummary')}</h2>
      <h3 class="mt-2 text-2xl font-bold text-slate-900">{t(locale, 'aboutPages.qualityControl.summaryTitle')}</h3>
      <p class="mt-4 max-w-4xl text-lg leading-relaxed text-slate-700">
        {t(locale, 'aboutPages.qualityControl.summaryDescription')}
      </p>
    </section>

    <section class="space-y-6">
      <h2 class="text-3xl font-bold text-slate-900">{t(locale, 'aboutPages.qualityControl.philosophyTitle')}</h2>
      <p class="text-lg text-slate-700">
        {t(locale, 'aboutPages.qualityControl.philosophyParagraph')}
      </p>
    </section>

    <section class="space-y-8">
      <h2 class="text-3xl font-bold text-slate-900">{t(locale, 'aboutPages.qualityControl.flowTitle')}</h2>
      <div class="grid gap-6 md:grid-cols-2">
        {qcFlow.map((step, idx) => (
          <div class="flex items-start gap-4 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
            <div class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-2xl bg-sky-600 text-sm font-bold text-white">
              {idx + 1}
            </div>
            <div>
              <div class="text-lg font-semibold text-slate-900">{t(locale, step.titleKey)}</div>
              <div class="mt-2 text-sm text-slate-700">{t(locale, step.descriptionKey)}</div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="grid gap-6 md:grid-cols-2">
      <div class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm">
        <h2 class="text-2xl font-bold text-slate-900">{t(locale, 'aboutPages.qualityControl.testingTitle')}</h2>
        <ul class="mt-6 space-y-3 text-slate-700">
          {tests.map((item) => (
            <li class="flex items-start gap-3">
              <span class="mt-2 h-2 w-2 flex-shrink-0 rounded-2xl bg-sky-600" />
              <span>{t(locale, item)}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm">
        <h2 class="text-2xl font-bold text-slate-900">{t(locale, 'aboutPages.qualityControl.certificationsTitle')}</h2>
        <ul class="mt-6 space-y-3 text-slate-700">
          {certifications.map((c) => (
            <li class="flex items-start gap-3">
              <span class="mt-2 h-2 w-2 flex-shrink-0 rounded-2xl bg-sky-600" />
              <span>{t(locale, c)}</span>
            </li>
          ))}
        </ul>
        <a
          class="mt-5 inline-flex items-center gap-2 rounded border border-slate-300 px-4 py-2 text-sm font-medium text-slate-900 transition hover:border-slate-400 hover:bg-slate-50"
          href="https://www.accessdata.fda.gov/scripts/cdrh/cfdocs/cfpmn/pmn.cfm"
          target="_blank"
          rel="noopener noreferrer"
        >
          {t(locale, 'aboutPages.qualityControl.fda510kDatabase')}
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M7 17L17 7M7 7h10v10" /></svg>
        </a>
      </div>
    </section>

    <section class="rounded-2xl bg-slate-50 p-8">
      <h2 class="text-2xl font-bold text-slate-900">{t(locale, 'aboutPages.qualityControl.qcSupportTitle')}</h2>
      <p class="mt-3 max-w-3xl text-slate-700">
        {t(locale, 'aboutPages.qualityControl.qcSupportParagraph')}
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a class="rounded bg-slate-900 px-4 py-2 text-sm font-medium text-white" href={getLocalizedPath(locale, '/contact')}>{t(locale, 'aboutPages.qualityControl.talkToTeam')}</a>
        <a class="rounded border border-slate-300 px-4 py-2 text-sm font-medium text-slate-900" href={getLocalizedPath(locale, '/about')}>{t(locale, 'aboutPages.backToAbout')}</a>
      </div>
    </section>
  </div>
</BaseLayout>

﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿---
// Develo Design — Privacy and Cookies Policy
import { t } from '../lib/i18n';
import { getLocalizedPath } from '../lib/breadcrumbs';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';

const locale = Astro.currentLocale ?? 'en';
---
<!doctype html>
<html lang={locale} dir={locale === 'ar' || locale === 'he' || locale === 'fa' ? 'rtl' : 'ltr'}>
<head>
<meta charset="utf-8" />
<meta name="robots" content="noindex, nofollow" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<script is:inline>
  // 语言偏好持久化：读取用户选定的语言（localStorage），
  // 若当前 URL 语言与偏好不一致，立即重定向到偏好语言对应页面（支持 en/tr/ar）
  (function () {
    var KEY = 'ishine_lang';
    try {
      var stored = localStorage.getItem(KEY);
      if (!stored) return;
      var LANGS = ['tr', 'ro', 'ar', 'es', 'fr', 'ru', 'he', 'fa', 'el', 'pt-BR', 'pt-PT', 'nl', 'id', 'th', 'pl', 'ja', 'ko', 'cs', 'vi', 'it'];
      var path = window.location.pathname;
      var cur = 'en';
      for (var i = 0; i < LANGS.length; i++) {
        if (path === '/' + LANGS[i] || path.indexOf('/' + LANGS[i] + '/') === 0) {
          cur = LANGS[i];
          break;
        }
      }
      if (stored === cur) return;
      var stripped = path;
      for (var j = 0; j < LANGS.length; j++) {
        stripped = stripped.replace(new RegExp('^/' + LANGS[j] + '/?'), '');
      }
      if (stored === 'en') {
        stripped = stripped.replace(/\/+$/, '');
        if (stripped === '' || stripped === '/') stripped = '/';
        if (stripped !== path) window.location.replace(stripped);
      } else {
        var target = '/' + stored + (stripped === '' || stripped === '/' ? '' : stripped);
        target = target.replace(/\/+$/, '');
        if (target === '') target = '/' + stored;
        if (target !== path) window.location.replace(target);
      }
    } catch (e) { /* 隐私模式等场景忽略 */ }
  })();
</script>
<title>{t(locale, 'develoContent.privacy.pageTitle')}</title>
<meta name="description" content={t(locale, 'develoContent.privacy.pageDescription')} />
<link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=Syne:wght@400;700&display=swap" rel="stylesheet" />
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{--blue:#563cfa;--black:#020303;--white:#fff;--grey-50:#f9fafb;--grey-200:#e5e7eb;--grey-400:#9ca3af;--grey-500:#6b7280;--grey-text:#4b5563;--max-w:1536px;--pad-100:100px}
html{scroll-behavior:smooth;overflow-x:hidden}
body{font-family:Manrope,-apple-system,Roboto,Helvetica,sans-serif;font-size:16px;font-weight:400;color:#000;background:#fff;overflow-x:hidden;-webkit-font-smoothing:antialiased}
a{text-decoration:none;color:inherit}img{max-width:100%;height:auto;display:block}

/* ═══ Shared ═══ */
.trust-bar{position:fixed;top:0;left:0;right:0;z-index:100;height:60px;display:flex;align-items:center;justify-content:center;background:transparent}
.trust-bar-inner{display:flex;align-items:center}
.trust-slide{display:flex;align-items:center;justify-content:center;gap:8px;padding:12px 24px}
.trust-slide[aria-hidden="true"]{display:none}.trust-slide[aria-hidden="false"]{display:flex}
.trust-text{font-family:Manrope,sans-serif;font-size:16px;font-weight:400;color:#020303;line-height:25px}
.site-header{position:fixed;top:66px;left:50%;transform:translate(-50%);width:calc(100% - 48px);max-width:1400px;z-index:110}
.header-inner{display:flex;align-items:center;justify-content:space-between;height:70px;padding:0 24px 0 40px;background:rgba(255,255,255,.9);border-radius:40px;box-shadow:0 10px 24px rgba(2,3,3,.06);gap:40px}
.header-logo{display:flex;align-items:center;flex-shrink:0}
.header-nav{display:flex;align-items:center;gap:8px}
.nav-item{display:flex;align-items:center;gap:4px;padding:12px 16px;font-family:Manrope,sans-serif;font-size:16px;font-weight:400;color:#020303;line-height:25px;background:transparent;border:none;cursor:pointer;border-radius:8px;transition:background .2s;white-space:nowrap}
.nav-item:hover{background:rgba(0,0,0,.04)}
.header-cta{display:flex;align-items:center;gap:12px}
.btn-primary{display:inline-flex;align-items:center;justify-content:center;gap:6px;padding:12px 20px;background:var(--blue);color:#fff;font-family:Manrope,sans-serif;font-size:16px;font-weight:400;line-height:16px;border-radius:100px;border:none;cursor:pointer;white-space:nowrap;transition:all .2s;text-decoration:none}
.btn-primary:hover{gap:16px;background:#374151}
.desktop-nav{display:flex}
@media(max-width:959px){.desktop-nav{display:none}.header-cta .btn-primary{display:none}}
@media(max-width:767px){.site-header{top:66px;width:calc(100% - 32px)}.header-inner{height:56px;padding:0 24px 0 32px}}

/* ═══ Page ═══ */
.page-main{margin-top:136px;padding-bottom:80px}
.page-container{max-width:800px;margin:0 auto;padding:0 var(--pad-100)}

.legal-hero{padding:40px 0 48px}
.legal-label{font-family:Manrope,sans-serif;font-size:14px;font-weight:600;color:var(--blue);text-transform:uppercase;letter-spacing:.5px;margin-bottom:12px}
.legal-hero h1{font-family:Syne,sans-serif;font-size:44px;font-weight:400;line-height:52px;letter-spacing:-.43px;color:var(--black);margin:0 0 16px}
.legal-hero-desc{font-family:Manrope,sans-serif;font-size:18px;font-weight:400;line-height:28px;color:var(--grey-text)}

.legal-body{font-family:Manrope,sans-serif;font-size:16px;font-weight:400;line-height:26px;color:var(--black)}
.legal-body h2{font-family:Syne,sans-serif;font-size:26px;font-weight:400;line-height:34px;color:var(--black);margin:40px 0 16px;padding-bottom:8px;border-bottom:1px solid var(--grey-200)}
.legal-body h3{font-family:Syne,sans-serif;font-size:20px;font-weight:400;line-height:28px;color:var(--black);margin:28px 0 12px}
.legal-body p{margin-bottom:16px}
.legal-body ul{margin:0 0 16px 20px;list-style:none}
.legal-body ul li{position:relative;padding-left:16px;margin-bottom:8px}
.legal-body ul li::before{content:'•';position:absolute;left:0;color:var(--blue);font-weight:700}
.legal-body a{color:var(--blue);text-decoration:underline;text-underline-offset:2px;transition:color .2s}
.legal-body a:hover{color:#374151}
.legal-updated{margin-top:48px;padding-top:24px;border-top:1px solid var(--grey-200);font-family:Manrope,sans-serif;font-size:14px;font-style:italic;color:var(--grey-500)}

@media(max-width:767px){
  .page-container{padding:0 24px}
  .legal-hero h1{font-size:34px;line-height:42px;letter-spacing:-.33px}
  .legal-hero-desc{font-size:16px;line-height:26px}
  .legal-body h2{font-size:22px;line-height:30px}
}
</style>
</head>
<body>

<SiteHeader />

<main class="page-main">
  <div class="page-container">

    <div class="legal-hero">
      <p class="legal-label">{t(locale, 'develoContent.privacy.hero.label')}</p>
      <h1>{t(locale, 'develoContent.privacy.hero.title')}</h1>
      <p class="legal-hero-desc">{t(locale, 'develoContent.privacy.hero.description')}</p>
    </div>

    <div class="legal-body">
      <h2>{t(locale, 'develoContent.privacy.body.introTitle')}</h2>
      <p>{t(locale, 'develoContent.privacy.body.introPara')}</p>

      <h2>{t(locale, 'develoContent.privacy.body.collectTitle')}</h2>
      <p>{t(locale, 'develoContent.privacy.body.collectIntro')}</p>
      <h3>{t(locale, 'develoContent.privacy.body.collectProvidedTitle')}</h3>
      <p>{t(locale, 'develoContent.privacy.body.collectProvidedPara')}</p>
      <h3>{t(locale, 'develoContent.privacy.body.collectAutoTitle')}</h3>
      <p>{t(locale, 'develoContent.privacy.body.collectAutoPara')}</p>
      <h3>{t(locale, 'develoContent.privacy.body.collectCookiesTitle')}</h3>
      <p>{t(locale, 'develoContent.privacy.body.collectCookiesPara')}</p>

      <h2>{t(locale, 'develoContent.privacy.body.useTitle')}</h2>
      <p>{t(locale, 'develoContent.privacy.body.useIntro')}</p>
      <ul>
        <li>{t(locale, 'develoContent.privacy.body.useItem1')}</li>
        <li>{t(locale, 'develoContent.privacy.body.useItem2')}</li>
        <li>{t(locale, 'develoContent.privacy.body.useItem3')}</li>
        <li>{t(locale, 'develoContent.privacy.body.useItem4')}</li>
        <li>{t(locale, 'develoContent.privacy.body.useItem5')}</li>
      </ul>

      <h2>{t(locale, 'develoContent.privacy.body.securityTitle')}</h2>
      <p>{t(locale, 'develoContent.privacy.body.securityPara')}</p>

      <h2>{t(locale, 'develoContent.privacy.body.rightsTitle')}</h2>
      <p>{t(locale, 'develoContent.privacy.body.rightsIntro')}</p>
      <ul>
        <li>{t(locale, 'develoContent.privacy.body.rightsItem1')}</li>
        <li>{t(locale, 'develoContent.privacy.body.rightsItem2')}</li>
        <li>{t(locale, 'develoContent.privacy.body.rightsItem3')}</li>
        <li>{t(locale, 'develoContent.privacy.body.rightsItem4')}</li>
        <li>{t(locale, 'develoContent.privacy.body.rightsItem5')}</li>
        <li>{t(locale, 'develoContent.privacy.body.rightsItem6')}</li>
      </ul>

      <h2>{t(locale, 'develoContent.privacy.body.cookiesTitle')}</h2>
      <p>{t(locale, 'develoContent.privacy.body.cookiesIntro')}</p>
      <h3>{t(locale, 'develoContent.privacy.body.cookiesTypesTitle')}</h3>
      <ul>
        <li><strong>{t(locale, 'develoContent.privacy.body.cookiesEssential')}</strong> {t(locale, 'develoContent.privacy.body.cookiesEssentialDesc')}</li>
        <li><strong>{t(locale, 'develoContent.privacy.body.cookiesAnalytics')}</strong> {t(locale, 'develoContent.privacy.body.cookiesAnalyticsDesc')}</li>
        <li><strong>{t(locale, 'develoContent.privacy.body.cookiesMarketing')}</strong> {t(locale, 'develoContent.privacy.body.cookiesMarketingDesc')}</li>
      </ul>
      <h3>{t(locale, 'develoContent.privacy.body.cookiesManageTitle')}</h3>
      <p>{t(locale, 'develoContent.privacy.body.cookiesManagePara')}</p>

      <h2>{t(locale, 'develoContent.privacy.body.thirdPartyTitle')}</h2>
      <p>{t(locale, 'develoContent.privacy.body.thirdPartyPara')}</p>

      <h2>{t(locale, 'develoContent.privacy.body.contactTitle')}</h2>
      <p>{t(locale, 'develoContent.privacy.body.contactPara')}</p>
      <p>{t(locale, 'develoContent.privacy.body.contactEmailLabel')} <a href="mailto:hello@develodesign.co.uk">hello@develodesign.co.uk</a></p>
      <p>{t(locale, 'develoContent.privacy.body.contactPhoneLabel')} <a href="tel:01216630817">0121 663 0817</a></p>

      <p class="legal-updated">{t(locale, 'develoContent.privacy.updated')}</p>
    </div>

  </div>
</main>

<!-- ═══ Footer ═══ -->
<style>.sf{background:#020303;color:#fff;width:100vw;position:relative;left:50%;right:50%;margin-left:-50vw;margin-right:-50vw;padding:120px 0;margin-top:0}.fc{max-width:1536px;margin:0 auto;padding:0 100px}.fg{display:grid;grid-template-columns:1.5fr 1fr 1fr 1fr;gap:60px;margin-bottom:60px}.fb p{font-family:Manrope,sans-serif;font-size:16px;font-weight:400;line-height:25px;color:rgba(255,255,255,.6);margin-top:16px;max-width:280px}.fch4{font-family:Manrope,sans-serif;font-size:16px;font-weight:600;color:#fff;line-height:25px;margin-bottom:16px}.fca{display:block;font-family:Manrope,sans-serif;font-size:14px;font-weight:400;color:rgba(255,255,255,.6);line-height:21px;padding:6px 0;transition:color .2s}.fca:hover{color:#fff}.fbot{display:flex;align-items:center;justify-content:space-between;padding-top:24px;border-top:1px solid rgba(255,255,255,.1)}.fbot span{font-family:Manrope,sans-serif;font-size:14px;font-weight:400;color:rgba(255,255,255,.5);line-height:21px}@media(max-width:767px){.fc{padding:0 24px}.sf{padding:60px 0}.fg{grid-template-columns:1fr;gap:32px}.fbot{flex-direction:column;gap:12px;text-align:center}}</style>
<SiteFooter />
</body>
</html>

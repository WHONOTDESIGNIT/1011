---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { t } from '../../lib/i18n';
import { getLocalizedPath, buildBreadcrumbs } from '../../lib/breadcrumbs';

const locale = Astro.currentLocale ?? 'en';
function resolveBaseUrl() {
  return (process.env.URL ?? process.env.DEPLOY_PRIME_URL ?? process.env.SITE_URL ?? 'https://iplmanufacturer.com').replace(/\/$/, '');
}

const pageTitle = t(locale, 'aboutPages.iplSafety.title');
const pageDescription = t(locale, 'aboutPages.iplSafety.description');
const canonical = `${resolveBaseUrl()}/ipl-hair-removal-is-safe`;
const breadcrumbs = buildBreadcrumbs(locale, [
  { label: t(locale, 'common.home'), path: '/' },
  { label: t(locale, 'aboutPages.iplSafety.breadcrumbLabel') },
]);

const pillarCtas = [
  { labelKey: 'aboutPages.iplSafety.cta.explorePlatforms', href: getLocalizedPath(locale, '/products'), style: 'primary' },
  { labelKey: 'aboutPages.iplSafety.cta.compareModels', href: getLocalizedPath(locale, '/catalogue'), style: 'secondary' },
  { labelKey: 'aboutPages.requestQuote', href: getLocalizedPath(locale, '/contact'), style: 'secondary' },
];

const safetyTopics = [
  {
    id: 'clinical-data',
    titleKey: 'aboutPages.iplSafety.topics.clinicalData.title',
    anchorKey: 'aboutPages.iplSafety.topics.clinicalData.anchor',
    descriptionKey: 'aboutPages.iplSafety.topics.clinicalData.description',
    href: getLocalizedPath(locale, '/blog/28-clinical-data-why-ipl-hair-removal-is-safe'),
  },
  {
    id: 'fda-context',
    titleKey: 'aboutPages.iplSafety.topics.fdaContext.title',
    anchorKey: 'aboutPages.iplSafety.topics.fdaContext.anchor',
    descriptionKey: 'aboutPages.iplSafety.topics.fdaContext.description',
    href: getLocalizedPath(locale, '/blog/14-fda-cleared-ipl-device-manufacturer-guide'),
  },
  {
    id: 'at-home-protocol',
    titleKey: 'aboutPages.iplSafety.topics.atHomeProtocol.title',
    anchorKey: 'aboutPages.iplSafety.topics.atHomeProtocol.anchor',
    descriptionKey: 'aboutPages.iplSafety.topics.atHomeProtocol.description',
    href: getLocalizedPath(locale, '/blog/29-safe-ipl-hair-removal-at-home-protocol'),
  },
  {
    id: 'fitzpatrick',
    titleKey: 'aboutPages.iplSafety.topics.fitzpatrick.title',
    anchorKey: 'aboutPages.iplSafety.topics.fitzpatrick.anchor',
    descriptionKey: 'aboutPages.iplSafety.topics.fitzpatrick.description',
    href: getLocalizedPath(locale, '/blog/25-ipl-hair-removal-safe-skin-types-fitzpatrick'),
  },
  {
    id: 'ipl-vs-laser',
    titleKey: 'aboutPages.iplSafety.topics.iplVsLaser.title',
    anchorKey: 'aboutPages.iplSafety.topics.iplVsLaser.anchor',
    descriptionKey: 'aboutPages.iplSafety.topics.iplVsLaser.description',
    href: getLocalizedPath(locale, '/blog/30-ipl-vs-laser-which-is-safer'),
  },
  {
    id: 'uv-filtering',
    titleKey: 'aboutPages.iplSafety.topics.uvFiltering.title',
    anchorKey: 'aboutPages.iplSafety.topics.uvFiltering.anchor',
    descriptionKey: 'aboutPages.iplSafety.topics.uvFiltering.description',
    href: getLocalizedPath(locale, '/blog/31-uv-filtering-wavelengths-why-ipl-is-safe'),
  },
  {
    id: 'safety-sensors',
    titleKey: 'aboutPages.iplSafety.topics.safetySensors.title',
    anchorKey: 'aboutPages.iplSafety.topics.safetySensors.anchor',
    descriptionKey: 'aboutPages.iplSafety.topics.safetySensors.description',
    href: getLocalizedPath(locale, '/blog/15-skin-tone-detection-ipl-safety-guide'),
  },
  {
    id: 'side-effects',
    titleKey: 'aboutPages.iplSafety.topics.sideEffects.title',
    anchorKey: 'aboutPages.iplSafety.topics.sideEffects.anchor',
    descriptionKey: 'aboutPages.iplSafety.topics.sideEffects.description',
    href: getLocalizedPath(locale, '/blog/32-ipl-hair-removal-side-effects-what-is-normal'),
  },
  {
    id: 'contraindications',
    titleKey: 'aboutPages.iplSafety.topics.contraindications.title',
    anchorKey: 'aboutPages.iplSafety.topics.contraindications.anchor',
    descriptionKey: 'aboutPages.iplSafety.topics.contraindications.description',
    href: getLocalizedPath(locale, '/blog/33-who-should-not-use-ipl-hair-removal-contraindications'),
  },
  {
    id: 'before-after-care',
    titleKey: 'aboutPages.iplSafety.topics.beforeAfterCare.title',
    anchorKey: 'aboutPages.iplSafety.topics.beforeAfterCare.anchor',
    descriptionKey: 'aboutPages.iplSafety.topics.beforeAfterCare.description',
    href: getLocalizedPath(locale, '/blog/34-ipl-hair-removal-before-and-aftercare-for-safety'),
  },
];
---

<BaseLayout title={pageTitle} lang={locale} description={pageDescription} canonical={canonical}>
  <div class="space-y-36">
    <section class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-slate-50 via-white to-sky-50 px-8 py-12 shadow-sm md:px-10 lg:px-12 lg:py-16">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,_rgba(56,189,248,0.12),_transparent_28%),radial-gradient(circle_at_bottom_left,_rgba(168,85,247,0.10),_transparent_30%)]" />
      <div class="relative grid gap-10 lg:grid-cols-[1.05fr_0.95fr] lg:items-center">
        <div>
          <Breadcrumb items={breadcrumbs} locale={locale} />
          <div class="mt-8 max-w-3xl">
            <div class="text-sm font-semibold uppercase tracking-[0.22em] text-sky-700">{t(locale, 'aboutPages.iplSafety.heroKicker')}</div>
            <h1 class="mt-3 text-4xl font-bold text-slate-900 md:text-5xl">
              {t(locale, 'aboutPages.iplSafety.heroTitle')}
            </h1>
            <p class="mt-5 text-lg leading-relaxed text-slate-700">
              {t(locale, 'aboutPages.iplSafety.heroParagraph')}
            </p>
          </div>
          <div class="mt-8 flex flex-wrap gap-3">
            {pillarCtas.map((cta) => (
              <a
                class={cta.style === 'primary'
                  ? 'rounded-2xl bg-slate-900 px-5 py-3 text-sm font-semibold text-white transition hover:bg-slate-800'
                  : 'rounded-2xl border border-slate-300 bg-white px-5 py-3 text-sm font-semibold text-slate-900 transition hover:border-slate-400 hover:bg-slate-50'}
                href={cta.href}
              >
                {t(locale, cta.labelKey)}
              </a>
            ))}
          </div>
        </div>

        <div class="rounded-[1.75rem] border border-slate-200 bg-white p-7 shadow-sm">
          <div class="text-sm font-semibold uppercase tracking-[0.22em] text-violet-700">{t(locale, 'aboutPages.iplSafety.howToKicker')}</div>
          <h2 class="mt-3 text-2xl font-bold text-slate-900">{t(locale, 'aboutPages.iplSafety.howToTitle')}</h2>
          <ol class="mt-5 space-y-3 text-sm text-slate-700">
            <li class="flex items-start gap-3">
              <span class="mt-1 inline-flex h-6 w-6 flex-shrink-0 items-center justify-center rounded-2xl bg-slate-900 text-sm font-semibold text-white">
                1
              </span>
              <span>{t(locale, 'aboutPages.iplSafety.howToSteps.0')}</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="mt-1 inline-flex h-6 w-6 flex-shrink-0 items-center justify-center rounded-2xl bg-slate-900 text-sm font-semibold text-white">
                2
              </span>
              <span>{t(locale, 'aboutPages.iplSafety.howToSteps.1')}</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="mt-1 inline-flex h-6 w-6 flex-shrink-0 items-center justify-center rounded-2xl bg-slate-900 text-sm font-semibold text-white">
                3
              </span>
              <span>{t(locale, 'aboutPages.iplSafety.howToSteps.2')}</span>
            </li>
          </ol>
        </div>
      </div>
    </section>

    <section class="grid gap-6 lg:grid-cols-[0.85fr_1.15fr]">
      <div class="rounded-[1.75rem] border border-slate-200 bg-white p-7 shadow-sm">
        <div class="text-sm font-semibold uppercase tracking-[0.22em] text-violet-700">{t(locale, 'aboutPages.iplSafety.topicMapKicker')}</div>
        <h2 class="mt-3 text-2xl font-bold text-slate-900">{t(locale, 'aboutPages.iplSafety.topicMapTitle')}</h2>
        <p class="mt-3 text-slate-700">
          {t(locale, 'aboutPages.iplSafety.topicMapParagraph')}
        </p>
      </div>
      <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
        {safetyTopics.map((topic) => (
          <a
            class="group rounded-[1.5rem] border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:border-slate-300 hover:shadow-lg"
            href={topic.href}
          >
            <div class="text-sm font-semibold uppercase tracking-[0.18em] text-slate-500">{t(locale, 'aboutPages.iplSafety.guideLabel')}</div>
            <h3 class="mt-4 text-xl font-semibold text-slate-900 group-hover:text-violet-700">{t(locale, topic.anchorKey)}</h3>
            <p class="mt-3 text-sm leading-relaxed text-slate-700">{t(locale, topic.descriptionKey)}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="space-y-10">
      <div class="mx-auto max-w-3xl text-center">
        <div class="text-sm font-semibold uppercase tracking-[0.22em] text-violet-700">{t(locale, 'aboutPages.iplSafety.pillarKicker')}</div>
        <h2 class="mt-3 text-3xl font-bold text-slate-900 md:text-4xl">{t(locale, 'aboutPages.iplSafety.pillarTitle')}</h2>
        <p class="mt-4 text-lg text-slate-700">
          {t(locale, 'aboutPages.iplSafety.pillarParagraph')}
        </p>
      </div>

      <div class="mx-auto grid max-w-5xl gap-6">
        {safetyTopics.map((topic) => (
          <section id={topic.id} class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm md:p-10">
            <div class="flex flex-col gap-4 md:flex-row md:items-start md:justify-between">
              <div class="max-w-3xl">
                <h3 class="text-2xl font-bold text-slate-900 md:text-3xl">{t(locale, topic.titleKey)}</h3>
                <p class="mt-4 text-lg leading-relaxed text-slate-700">{t(locale, topic.descriptionKey)}</p>
              </div>
              <div class="flex flex-wrap gap-3">
                <a class="rounded-2xl bg-slate-900 px-5 py-3 text-sm font-semibold text-white transition hover:bg-slate-800" href={topic.href}>
                  {t(locale, 'aboutPages.iplSafety.readGuide')}
                </a>
                <a class="rounded-2xl border border-slate-300 bg-white px-5 py-3 text-sm font-semibold text-slate-900 transition hover:border-slate-400 hover:bg-slate-50" href={getLocalizedPath(locale, '/products')}>
                  {t(locale, 'common.exploreProducts')}
                </a>
              </div>
            </div>
          </section>
        ))}
      </div>
    </section>

    <section class="rounded-2xl bg-gradient-to-r from-slate-900 to-slate-800 px-8 py-14 text-white shadow-2xl">
      <div class="mx-auto max-w-4xl text-center">
        <div class="text-sm font-semibold uppercase tracking-[0.22em] text-slate-300">{t(locale, 'aboutPages.iplSafety.finalKicker')}</div>
        <h2 class="mt-3 text-3xl font-bold md:text-4xl">{t(locale, 'aboutPages.iplSafety.finalTitle')}</h2>
        <p class="mx-auto mt-4 max-w-3xl text-lg text-slate-200">
          {t(locale, 'aboutPages.iplSafety.finalParagraph')}
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <a class="rounded-2xl bg-white px-5 py-3 text-sm font-semibold text-slate-900 transition hover:bg-slate-100" href={getLocalizedPath(locale, '/products')}>
            {t(locale, 'aboutPages.iplSafety.cta.explorePlatforms')}
          </a>
          <a class="rounded-2xl border border-white/20 px-5 py-3 text-sm font-semibold text-white transition hover:bg-white/10" href={getLocalizedPath(locale, '/catalogue')}>
            {t(locale, 'aboutPages.iplSafety.cta.compareModels')}
          </a>
          <a class="rounded-2xl border border-white/20 px-5 py-3 text-sm font-semibold text-white transition hover:bg-white/10" href={getLocalizedPath(locale, '/contact')}>
            {t(locale, 'aboutPages.requestQuote')}
          </a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

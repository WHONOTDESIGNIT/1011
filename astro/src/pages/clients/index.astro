---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t } from '../../lib/i18n';
import { getLocalizedPath } from '../../lib/breadcrumbs';

const locale = Astro.currentLocale ?? 'en';
const clients = [
  {
    name: 'Costco',
    region: 'Canada',
    industry: t(locale, 'clientPage.clients.costco.industry'),
    slug: 'costco-canada-ipl',
    logo: '/images/logos/costco-logo.svg',
    description: t(locale, 'clientPage.clients.costco.description'),
  },
  {
    name: 'RoseSkinCo',
    region: 'USA',
    industry: t(locale, 'clientPage.clients.roseskin.industry'),
    slug: 'roseskin-ipl',
    logo: '/images/logos/roseskin-logo.svg',
    description: t(locale, 'clientPage.clients.roseskin.description'),
  },
  {
    name: 'KU-2 Cosmetics',
    region: 'Germany',
    industry: t(locale, 'clientPage.clients.ku2.industry'),
    slug: 'ku2-ipl',
    logo: '/images/logos/KU-2%20logo.svg',
    description: t(locale, 'clientPage.clients.ku2.description'),
  },
  {
    name: 'HappySkinCo',
    region: t(locale, 'clientPage.clients.happyskinco.region'),
    industry: 'DTC',
    slug: 'happyskinco-ipl',
    logo: '/images/logos/happyskin-logo.webp',
    description: t(locale, 'clientPage.clients.happyskinco.description'),
  },
];

const testimonials = [
  {
    quote: t(locale, 'clientPage.testimonials.0.quote'),
    author: t(locale, 'clientPage.testimonials.0.author'),
    company: t(locale, 'clientPage.testimonials.0.company'),
  },
  {
    quote: t(locale, 'clientPage.testimonials.1.quote'),
    author: t(locale, 'clientPage.testimonials.1.author'),
    company: t(locale, 'clientPage.testimonials.1.company'),
  },
  {
    quote: t(locale, 'clientPage.testimonials.2.quote'),
    author: t(locale, 'clientPage.testimonials.2.author'),
    company: t(locale, 'clientPage.testimonials.2.company'),
  },
];
---

<BaseLayout title={t(locale, 'clientPage.meta.title')} lang={locale} description={t(locale, 'clientPage.meta.description')}>
  <div class="space-y-48">
    <section class="rounded-2xl bg-slate-50 px-8 py-12">
      <h1 class="text-4xl font-bold">{t(locale, 'clientPage.meta.title')}</h1>
      <p class="mt-4 max-w-3xl text-lg text-slate-700">
        {t(locale, 'clientPage.heroDescription')}
      </p>
    </section>

    <section class="mx-auto max-w-6xl px-6">
      <h2 class="text-sm font-semibold uppercase tracking-[0.22em] text-slate-600">{t(locale, 'common.citableSummary')}</h2>
      <h3 class="mt-2 text-2xl font-bold text-slate-900">{t(locale, 'clientPage.citableSummaryTitle')}</h3>
      <p class="mt-4 max-w-4xl text-lg leading-relaxed text-slate-700">
        {t(locale, 'clientPage.citableSummaryBody')}
      </p>
    </section>

    <section class="space-y-6">
      <div>
        <h2 class="text-2xl font-semibold">{t(locale, 'clientPage.globalPartnershipsTitle')}</h2>
        <p class="mt-2 max-w-3xl text-slate-700">
          {t(locale, 'clientPage.globalPartnershipsDescription')}
        </p>
      </div>

      <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {clients.map((client) => (
          <a class="block rounded-xl border-2 border-slate-200 bg-white p-8 shadow-sm transition-colors hover:border-violet-500" href={getLocalizedPath(locale, '/clients/' + client.slug)}>
            <div class="mx-auto mb-6 flex h-24 w-24 items-center justify-center overflow-hidden rounded-2xl bg-white shadow-md">
              <img
                src={client.logo}
                alt={`${client.name} ${t(locale, 'clientPage.logoAlt')}`}
                loading="lazy"
                decoding="async"
                width="64"
                height="64"
                class="h-16 w-16 object-contain"
              />
            </div>
            <div class="text-center">
              <div class="text-2xl font-bold text-slate-900">{client.name}</div>
              <div class="mt-1 text-sky-700">{client.region}</div>
              <p class="mt-4 text-slate-700">{client.description}</p>
              <div class="mt-4">
                <span class="inline-block rounded-2xl bg-slate-100 px-3 py-1 text-sm text-slate-700">{client.industry}</span>
              </div>
              <div class="mt-6 text-sm font-medium text-slate-900">{t(locale, 'clientPage.viewCaseStudy')}</div>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="grid gap-6 md:grid-cols-3">
      <div class="rounded-xl border border-slate-200 bg-white p-8 text-center">
        <div class="text-4xl font-bold">50+</div>
        <div class="mt-1 text-sm text-slate-700">{t(locale, 'clientPage.stats.globalClients')}</div>
      </div>
      <div class="rounded-xl border border-slate-200 bg-white p-8 text-center">
        <div class="text-4xl font-bold">30+</div>
        <div class="mt-1 text-sm text-slate-700">{t(locale, 'clientPage.stats.countriesServed')}</div>
      </div>
      <div class="rounded-xl border border-slate-200 bg-white p-8 text-center">
        <div class="text-4xl font-bold">500K+</div>
        <div class="mt-1 text-sm text-slate-700">{t(locale, 'clientPage.stats.devicesDelivered')}</div>
      </div>
    </section>

    <section class="space-y-6">
      <div>
        <h2 class="text-2xl font-semibold">{t(locale, 'clientPage.testimonialsTitle')}</h2>
        <p class="mt-2 max-w-2xl text-slate-700">{t(locale, 'clientPage.testimonialsDescription')}</p>
      </div>
      <div class="grid gap-6 md:grid-cols-3">
        {testimonials.map((testimonial) => (
          <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
            <p class="text-sm italic leading-relaxed text-slate-700">"{testimonial.quote}"</p>
            <div class="mt-4">
              <div class="text-sm font-semibold">{testimonial.author}</div>
              <div class="text-xs text-slate-600">{testimonial.company}</div>
            </div>
          </div>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

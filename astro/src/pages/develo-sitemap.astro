<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{--blue:#563cfa;--black:#020303;--white:#fff;--grey-50:#f9fafb;--grey-200:#e5e7eb;--grey-400:#9ca3af;--grey-500:#6b7280;--grey-text:#4b5563;--max-w:1536px;--pad-100:100px}
html{scroll-behavior:smooth;overflow-x:hidden}
body{font-family:Manrope,-apple-system,Roboto,Helvetica,sans-serif;font-size:16px;font-weight:400;color:#000;background:#fff;overflow-x:hidden;-webkit-font-smoothing:antialiased}
a{text-decoration:none;color:inherit}img{max-width:100%;height:auto;display:block}

/* ═══ Shared ═══ */
.trust-bar{position:fixed;top:0;left:0;right:0;z-index:100;height:60px;display:flex;align-items:center;justify-content:center;background:transparent}
.trust-bar-inner{display:flex;align-items:center}
.trust-slide{display:flex;align-items:center;justify-content:center;gap:8px;padding:12px 24px}
.trust-slide[aria-hidden="true"]{display:none}.trust-slide[aria-hidden="false"]{display:flex}
.trust-text{font-family:Manrope,sans-serif;font-size:16px;font-weight:400;color:#020303;line-height:25px}
.site-header{position:fixed;top:66px;left:50%;transform:translate(-50%);width:calc(100% - 48px);max-width:1400px;z-index:110}
.header-inner{display:flex;align-items:center;justify-content:space-between;height:70px;padding:0 24px 0 40px;background:rgba(255,255,255,.9);border-radius:40px;box-shadow:0 10px 24px rgba(2,3,3,.06);gap:40px}
.header-logo{display:flex;align-items:center;flex-shrink:0}
.header-nav{display:flex;align-items:center;gap:8px}
.nav-item{display:flex;align-items:center;gap:4px;padding:12px 16px;font-family:Manrope,sans-serif;font-size:16px;font-weight:400;color:#020303;line-height:25px;background:transparent;border:none;cursor:pointer;border-radius:8px;transition:background .2s;white-space:nowrap}
.nav-item:hover{background:rgba(0,0,0,.04)}
.header-cta{display:flex;align-items:center;gap:12px}
.btn-primary{display:inline-flex;align-items:center;justify-content:center;gap:6px;padding:12px 20px;background:var(--blue);color:#fff;font-family:Manrope,sans-serif;font-size:16px;font-weight:400;line-height:16px;border-radius:100px;border:none;cursor:pointer;white-space:nowrap;transition:all .2s;text-decoration:none}
.btn-primary:hover{gap:16px;background:#374151}
.desktop-nav{display:flex}
@media(max-width:959px){.desktop-nav{display:none}.header-cta .btn-primary{display:none}}
@media(max-width:767px){.site-header{top:66px;width:calc(100% - 32px)}.header-inner{height:56px;padding:0 24px 0 32px}}

/* ═══ Page ═══ */
.page-main{margin-top:136px;padding-bottom:80px}
.page-container{max-width:var(--max-w);margin:0 auto;padding:0 var(--pad-100)}

.sitemap-hero{padding:40px 0 48px}
.sitemap-hero h1{font-family:Syne,sans-serif;font-size:44px;font-weight:400;line-height:52px;letter-spacing:-.43px;color:var(--black);margin:0 0 12px}
.sitemap-subtitle{font-family:Manrope,sans-serif;font-size:18px;font-weight:400;line-height:28px;color:var(--grey-text)}
.sitemap-count{font-family:Manrope,sans-serif;font-size:16px;font-weight:600;color:var(--blue);margin-bottom:8px}

.sitemap-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:48px 32px;margin-top:8px}

.sm-category{margin-bottom:0}
.sm-category h2{font-family:Syne,sans-serif;font-size:22px;font-weight:400;line-height:30px;color:var(--black);margin:0 0 12px;padding-bottom:8px;border-bottom:1px solid var(--grey-200)}
.sm-category .sm-count{font-family:Manrope,sans-serif;font-size:14px;font-weight:400;color:var(--grey-500);margin-left:4px}

.sm-links{list-style:none;padding:0;margin:0}
.sm-links li{margin-bottom:2px}
.sm-links li a{display:block;padding:6px 0;font-family:Manrope,sans-serif;font-size:14px;font-weight:400;line-height:21px;color:var(--grey-text);transition:color .2s}
.sm-links li a:hover{color:var(--blue)}

@media(max-width:959px){
  .sitemap-grid{grid-template-columns:repeat(2,1fr);gap:40px 24px}
}
@media(max-width:767px){
  .page-container{padding:0 24px}
  .sitemap-hero h1{font-size:34px;line-height:42px;letter-spacing:-.33px}
  .sitemap-subtitle{font-size:16px;line-height:26px}
  .sitemap-grid{grid-template-columns:1fr;gap:32px}
}
</style>
</head>

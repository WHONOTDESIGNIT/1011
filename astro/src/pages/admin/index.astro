---
// 【方案A · 2026-08-21】移除 prerender = false：站点已改纯静态（无 adapter），
// 页面静态化后表单仍由客户端 fetch 调用 /.netlify/functions/save-post，功能不变。
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdminPostForm from '../../components/react/AdminPostForm';
---

<BaseLayout title="Admin" lang="en">
  <div class="space-y-8">
    <div class="space-y-2">
      <h1 class="text-3xl font-bold text-ink-900">Admin</h1>
      <p class="text-neutral-600">Publish a new post via Netlify Functions.</p>
    </div>
    <AdminPostForm client:load />
  </div>
</BaseLayout>

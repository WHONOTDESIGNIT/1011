---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t } from '../../lib/i18n';
import { getLocalizedPath, buildBreadcrumbs } from '../../lib/breadcrumbs';
import { Image } from 'astro:assets';
import { Zap, Lock, Headphones } from '@lucide/astro';

const locale = Astro.currentLocale ?? 'en';

function resolveBaseUrl() {
  return (process.env.URL ?? process.env.DEPLOY_PRIME_URL ?? process.env.SITE_URL ?? 'https://iplmanufacturer.com').replace(/\/$/, '');
}

const pageTitle = t(locale, 'contact.title');
const pageDescription = t(locale, 'contact.description');
const canonical = `${resolveBaseUrl()}/contact`;
const breadcrumbs = buildBreadcrumbs(locale, [
  { label: t(locale, 'common.home'), path: '/' },
  { label: pageTitle },
]);

const benefits = [
  { titleKey: 'aboutPages.contactPage.benefits.item1.title', icon: Zap, descriptionKey: 'aboutPages.contactPage.benefits.item1.description' },
  { titleKey: 'aboutPages.contactPage.benefits.item2.title', icon: Lock, descriptionKey: 'aboutPages.contactPage.benefits.item2.description' },
  { titleKey: 'aboutPages.contactPage.benefits.item3.title', icon: Headphones, descriptionKey: 'aboutPages.contactPage.benefits.item3.description' },
];

const contactCards = [
  { labelKey: 'aboutPages.contactPage.cards.email.label', title: 'service@ishineco.com', descriptionKey: 'aboutPages.contactPage.cards.email.description', href: 'mailto:service@ishineco.com' },
  { labelKey: 'aboutPages.contactPage.cards.phone1.label', title: '+86 138 2350 8753', descriptionKey: 'aboutPages.contactPage.cards.phone1.description', href: 'tel:+8613823508753' },
  { labelKey: 'aboutPages.contactPage.cards.phone2.label', title: '+86 150 1289 1148', descriptionKey: 'aboutPages.contactPage.cards.phone2.description', href: 'tel:+8615012891148' },
  { labelKey: 'aboutPages.contactPage.cards.address.label', title: "401 Room, 5 Building, No.27, Makan Road, Xi'li Street", descriptionKey: 'aboutPages.contactPage.cards.address.description' },
];

// 图片下方替代表单的联系卡片：mailto 预填主题 + 正文，WhatsApp 直达
const altMailtoHref = `mailto:service@ishineco.com?subject=${encodeURIComponent('IPL Device Manufacturer Inquiry')}&body=${encodeURIComponent('Hi iShine Team, I am looking for at-home ipl hair removal and beauty device manufacturer, and would like to know more details about...')}`;

const selectOptions = {
  product: ['aboutPages.contactPage.form.productOptions.0', 'aboutPages.contactPage.form.productOptions.1', 'aboutPages.contactPage.form.productOptions.2', 'aboutPages.contactPage.form.productOptions.3', 'aboutPages.contactPage.form.productOptions.4'],
  quantity: ['aboutPages.contactPage.form.quantityOptions.0', 'aboutPages.contactPage.form.quantityOptions.1', 'aboutPages.contactPage.form.quantityOptions.2'],
  timeline: ['aboutPages.contactPage.form.timelineOptions.0', 'aboutPages.contactPage.form.timelineOptions.1', 'aboutPages.contactPage.form.timelineOptions.2', 'aboutPages.contactPage.form.timelineOptions.3', 'aboutPages.contactPage.form.timelineOptions.4'],
};
---

<BaseLayout title={pageTitle} lang={locale} description={pageDescription} canonical={canonical}>

  <div class="space-y-48">
    <section class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-slate-950 via-slate-900 to-violet-950 px-8 py-12 text-white shadow-2xl md:px-10 lg:px-12 lg:py-16">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,_rgba(196,181,253,0.18),_transparent_24%),radial-gradient(circle_at_bottom_left,_rgba(56,189,248,0.14),_transparent_28%)]" />
      <div class="relative">
        <div class="max-w-3xl">
          <h1 class="text-4xl font-bold md:text-5xl">{t(locale, 'aboutPages.contactPage.heroTitle')}</h1>
          <p class="mt-5 text-lg leading-relaxed text-slate-200">
            {t(locale, 'aboutPages.contactPage.heroParagraph')}
          </p>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-6">
      <h2 class="text-sm font-semibold uppercase tracking-[0.22em] text-slate-600">{t(locale, 'common.citableSummary')}</h2>
      <h3 class="mt-2 text-2xl font-bold text-slate-900">{t(locale, 'aboutPages.contactPage.summaryTitle')}</h3>
      <p class="mt-4 max-w-4xl text-lg leading-relaxed text-slate-700">
        {t(locale, 'aboutPages.contactPage.summaryDescription')}
      </p>
    </section>

    <section class="grid gap-8 lg:grid-cols-[0.85fr_1.15fr]">
      <div class="overflow-hidden rounded-[1.75rem] border border-slate-200 bg-white shadow-sm lg:sticky lg:top-24 lg:self-start">
        <div class="relative aspect-[4/3] bg-slate-100">
          <Image
            src="/images/home/themis-ice-feeling-ipl-device.jpg"
            alt={t(locale, 'aboutPages.contactPage.imageAlt')}
            class="absolute inset-0 h-full w-full object-cover"
            loading="lazy"
            width={1200}
            height={900}
          />
        </div>

        <div class="mt-4 rounded-[1.75rem] border border-slate-200 bg-[#f9fafb] p-6 shadow-sm">
          <p class="text-base font-bold text-slate-900">Don't like forms?</p>
          <p class="mt-1 text-sm text-slate-600">Drop us an email or a call.</p>
          <p class="mt-4 text-sm leading-relaxed text-slate-700">
            Mail to: <a class="contact-alt-link" href={altMailtoHref}>service@ishineco.com</a>
          </p>
          <p class="mt-2 text-sm leading-relaxed text-slate-700">
            WhatsApp/Wechat: <a class="contact-alt-link" href="https://wa.me/8615012891148" target="_blank" rel="noopener">+86 150 1289 1148</a>
          </p>
        </div>
      </div>

      <section id="inquiry-form" class="rounded-2xl border border-slate-200 bg-white p-8 shadow-xl md:p-10">
        <div class="rounded-[1.5rem] bg-gradient-to-r from-violet-600 to-fuchsia-600 p-5 text-white">
          <h2 class="text-2xl font-bold">{t(locale, 'aboutPages.contactPage.form.title')}</h2>
        </div>

        <form
          name="contact"
          method="POST"
          action="/__forms/"
          data-netlify="true"
          data-netlify-honeypot="bot-field"
          class="mt-8 space-y-6"
        >
          <input type="hidden" name="form-name" value="contact" />
          <input type="hidden" name="locale" value={locale} />
          <input type="hidden" name="page" value="contact" />
          <p class="hidden">
            <label>
              {t(locale, 'aboutPages.contactPage.form.honeypotLabel')}
              <input name="bot-field" />
            </label>
          </p>

          <div class="grid gap-5 md:grid-cols-2">
            <label class="space-y-2">
              <span class="text-sm font-medium text-slate-900">{t(locale, 'aboutPages.contactPage.form.fullName')}</span>
              <input class="w-full rounded-2xl border border-slate-300 bg-slate-50 px-4 py-3 text-sm text-slate-900 outline-none transition focus:border-violet-500 focus:bg-white" type="text" name="name" required />
            </label>
            <label class="space-y-2">
              <span class="text-sm font-medium text-slate-900">{t(locale, 'aboutPages.contactPage.form.email')}</span>
              <input class="w-full rounded-2xl border border-slate-300 bg-slate-50 px-4 py-3 text-sm text-slate-900 outline-none transition focus:border-violet-500 focus:bg-white" type="email" name="email" required />
            </label>
            <label class="space-y-2">
              <span class="text-sm font-medium text-slate-900">{t(locale, 'aboutPages.contactPage.form.companyName')}</span>
              <input class="w-full rounded-2xl border border-slate-300 bg-slate-50 px-4 py-3 text-sm text-slate-900 outline-none transition focus:border-violet-500 focus:bg-white" type="text" name="company" />
            </label>
            <label class="space-y-2">
              <span class="text-sm font-medium text-slate-900">{t(locale, 'aboutPages.contactPage.form.phoneNumber')}</span>
              <input class="w-full rounded-2xl border border-slate-300 bg-slate-50 px-4 py-3 text-sm text-slate-900 outline-none transition focus:border-violet-500 focus:bg-white" type="tel" name="phone" />
            </label>
            <label class="space-y-2">
              <span class="text-sm font-medium text-slate-900">{t(locale, 'aboutPages.contactPage.form.productInterest')}</span>
              <select class="w-full rounded-2xl border border-slate-300 bg-slate-50 px-4 py-3 text-sm text-slate-900 outline-none transition focus:border-violet-500 focus:bg-white" name="product">
                {selectOptions.product.map((option) => (
                  <option value={t(locale, option)}>{t(locale, option)}</option>
                ))}
              </select>
            </label>
            <label class="space-y-2">
              <span class="text-sm font-medium text-slate-900">{t(locale, 'aboutPages.contactPage.form.expectedQuantity')}</span>
              <select class="w-full rounded-2xl border border-slate-300 bg-slate-50 px-4 py-3 text-sm text-slate-900 outline-none transition focus:border-violet-500 focus:bg-white" name="quantity">
                {selectOptions.quantity.map((option) => (
                  <option value={t(locale, option)}>{t(locale, option)}</option>
                ))}
              </select>
            </label>
            <label class="space-y-2 md:col-span-2">
              <span class="text-sm font-medium text-slate-900">{t(locale, 'aboutPages.contactPage.form.projectTimeline')}</span>
              <select class="w-full rounded-2xl border border-slate-300 bg-slate-50 px-4 py-3 text-sm text-slate-900 outline-none transition focus:border-violet-500 focus:bg-white" name="timeline">
                {selectOptions.timeline.map((option) => (
                  <option value={t(locale, option)}>{t(locale, option)}</option>
                ))}
              </select>
            </label>
            <label class="space-y-2 md:col-span-2">
              <span class="text-sm font-medium text-slate-900">{t(locale, 'aboutPages.contactPage.form.projectDetails')}</span>
              <textarea
                class="min-h-[180px] w-full rounded-2xl border border-slate-300 bg-slate-50 px-4 py-3 text-sm text-slate-900 outline-none transition focus:border-violet-500 focus:bg-white"
                name="message"
                placeholder={t(locale, 'contact.form.messagePlaceholder')}
                required
              />
            </label>
          </div>

          <div class="flex justify-end">
            <button class="rounded-2xl bg-slate-900 px-6 py-3 text-sm font-semibold text-white transition hover:bg-slate-800" type="submit">
              {t(locale, 'aboutPages.contactPage.form.send')}
            </button>
          </div>
        </form>
      </section>
    </section>
  </div>
</BaseLayout>

<style>
  .contact-alt-link {
    color: #334155;
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: #563cfa;
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
    transition: text-decoration-color 0.2s ease;
  }
  .contact-alt-link:hover {
    text-decoration-color: transparent;
  }
  .contact-alt-link:focus-visible {
    outline: 2px solid #563cfa;
    outline-offset: 2px;
    border-radius: 2px;
  }
</style>

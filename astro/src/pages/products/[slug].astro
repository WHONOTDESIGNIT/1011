  specs: { label: string; value: string }[];
  features: { title: string; description: string }[];
  priceTiers?: { quantity: string; unitPrice: string }[];
  priceNote?: string;
  /** 商用基线的两行（已本地化）：采样 MOQ 与批量 MOQ。缺省取全站共用文案 */
  commercialSample: string;
  commercialBulk: string;
  /** 建议零售价区间（excl. VAT），仅公开 RSP 的品类才有 */
  rsp?: string;
  badge?: string;
  colors: string[];
  story?: {
    kicker: string;
    title: string;
    paragraphs: string[];
    cta?: { label: string; href: string };

                      </h4>
                      <dl class="mt-2 divide-y divide-neutral-100">
                        {getPaymentRegionRows(region).map((row) => (
                          <div class="flex justify-between gap-4 py-2 text-sm">
                            <dt class="text-neutral-600">{row.currency} · {row.network}</dt>
                            <dd class="ml-4 text-right font-medium text-ink-900">
                              {t(locale, `productDetail.paymentSolutions.timings.${row.timing}`)}
                            </dd>
                          </div>
                        ))}
                      </dl>
                    </div>
                  ))}
                </details>

                <p class="mt-4 text-xs text-neutral-500">{t(locale, 'productDetail.paymentSolutions.timingNote')}</p>
              </div>
            </div>
          </div>

          <div class="rounded-xl border border-neutral-200 bg-white p-6 shadow-sm">
            <h2 class="text-lg font-semibold text-ink-900">{t(locale, 'productDetail.specifications')}</h2>
            <dl class="mt-4 divide-y divide-neutral-100">
              {product.specs.map((spec) => (
                <div class="flex justify-between py-3 text-sm">
                  <dt class="text-neutral-600">{spec.label}</dt>
                  <dd class="ml-4 text-right font-medium text-ink-900">{spec.value}</dd>
                </div>
              ))}
            </dl>
          </div>

          {product.colors.length > 0 && (
            <div class="rounded-xl border border-neutral-200 bg-white p-6 shadow-sm">
              <h2 class="text-lg font-semibold text-ink-900">{t(locale, 'productDetail.availableColors')}</h2>
              <div class="mt-3 flex flex-wrap gap-2">
                {product.colors.map((color) => (
                  <span class="rounded-full border border-neutral-200 bg-neutral-50 px-4 py-1.5 text-sm text-neutral-700">{color}</span>
                ))}
              </div>
            </div>
          )}
        </div>
      </div>
    </section>

    {/* 肤色与毛发适配性：紧接规格/颜色区，先给结论再讲机理（借鉴 Philips 的科普式讲法）。
        仅 IPL 机型渲染；LED 光疗品类见上方 LED_SLUGS 的说明。 */}
    {!isLedProduct && (
    <section class="space-y-8">
      <div class="max-w-3xl">
        <h2 class="text-3xl font-bold text-ink-900 md:text-4xl">{suit.heading}</h2>
        <p class="mt-3 text-lg text-neutral-700">{suit.intro}</p>
      </div>
      <div class="grid gap-6 md:grid-cols-2">
        <div class="rounded-xl border border-neutral-200 bg-white p-6 shadow-sm">
          <h3 class="text-xl font-semibold text-ink-900">{suit.skinTitle}</h3>
          <p class="mt-3 text-neutral-700">{suit.skinBody}</p>
        </div>
        <div class="rounded-xl border border-neutral-200 bg-white p-6 shadow-sm">
          <h3 class="text-xl font-semibold text-ink-900">{suit.hairTitle}</h3>
          <p class="mt-3 text-neutral-700">{suit.hairBody}</p>
        </div>
      </div>
      <figure class="rounded-2xl border border-neutral-200 bg-white p-4 shadow-sm md:p-6">
        <img
          src="/images/products/suitability/ipl-fit-for-hair-colors.webp"
          alt={suit.imageAlt}
          width="610"
          height="346"
          loading="lazy"
          decoding="async"
          class="mx-auto h-auto w-full max-w-[610px] rounded-lg"
        />
      </figure>
      <p class="text-sm text-neutral-500">{suit.note}</p>
    </section>
    )}

    <section class="space-y-8">
      <div class="max-w-3xl">
        <h2 class="text-3xl font-bold text-ink-900 md:text-4xl">{t(locale, 'common.keyFeatures')}</h2>

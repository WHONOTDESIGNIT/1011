      '/images/products/LED-Mask-002A/led-therapy-mask-002a-red-light.webp',
    ],
    colorCount: 1,
    badge: true,
    priceTiers: [59.2, 56.5, 53.5, 48.5],
    tierQuantityKeys: LED_TIER_QUANTITY_KEYS,
    commercialKeys: LED_COMMERCIAL_KEYS,
    rsp: 'USD 189–219',
    priceNote: true,
  },
  'led-therapy-panel-f618': {
    heroImage: '/images/products/LED-Panel-F618/led-therapy-panel-f618-front.webp',
    gallery: [
      '/images/products/LED-Panel-F618/led-therapy-panel-f618-front.webp',
      '/images/products/LED-Panel-F618/led-therapy-panel-f618-lens-array.webp',
      '/images/products/LED-Panel-F618/led-therapy-panel-f618-mode-p1-red.webp',
      '/images/products/LED-Panel-F618/led-therapy-panel-f618-mode-p4.webp',
      '/images/products/LED-Panel-F618/led-therapy-panel-f618-mode-p2-amber.webp',
      '/images/products/LED-Panel-F618/led-therapy-panel-f618-stand.webp',
    ],
    colorCount: 1,
    badge: true,
    priceTiers: [45.2, 43.5, 40.5, 36.5],
    tierQuantityKeys: LED_TIER_QUANTITY_KEYS,
    commercialKeys: LED_COMMERCIAL_KEYS,
    rsp: 'USD 169–199',
    priceNote: true,
  },
};

const HIDDEN_SPEC_KEYS = new Set(['maxOpticalPowerDensity', 'deviceSize', 'netWeight', 'bulkMoq']);
const TIER_KEYS = ['tier1', 'tier2', 'tier3', 'tier4'];

/** 读取可选品牌故事（story）——仅当 en 消息中存在该产品的 story 时才渲染 */
function getStory(slug: string): ProductData['story'] | undefined {
  const root = enMessages as { productDetail?: Record<string, { story?: { paragraphs?: unknown[]; cta?: { href?: string } } }> };
  const story = root?.productDetail?.[slug]?.story;
  if (!story || !Array.isArray(story.paragraphs) || story.paragraphs.length === 0) return undefined;
  const base = `productDetail.${slug}.story`;
  return {
    kicker: t(locale, `${base}.kicker`),
    title: t(locale, `${base}.title`),
    paragraphs: story.paragraphs.map((_, index) => t(locale, `${base}.paragraphs.${index}`)),
    ...(story.cta?.href
      ? {
          cta: {
            label: t(locale, `${base}.cta.label`),
            href: story.cta.href,
          },
        }
      : {}),
  };
}

/** 用 messages 键构建产品数据（全语言经 t() 本地化） */
function buildProduct(slug: string): ProductData {
  const base = `productDetail.${slug}`;
  const assets = PRODUCT_ASSETS[slug];
  return {
    name: t(locale, `${base}.name`),
    tagline: t(locale, `${base}.tagline`),
    description: t(locale, `${base}.description`),
    heroImage: assets.heroImage,
    gallery: assets.gallery,
    specs: (SPEC_KEYS[slug] ?? [])
      .filter((key) => !HIDDEN_SPEC_KEYS.has(key))
      .map((key) => ({
        label: t(locale, `${base}.specs.${key}.label`),
        value: t(locale, `${base}.specs.${key}.value`),
      })),
    features: (FEATURE_KEYS[slug] ?? []).map((key) => ({
      title: t(locale, `${base}.features.${key}.title`),
      description: t(locale, `${base}.features.${key}.description`),
    })),
    priceTiers: assets.priceTiers
      ? assets.priceTiers.map((unitPrice, i) => ({
          quantity: t(locale, assets.tierQuantityKeys?.[i] ?? `productDetail.priceTierQuantities.${TIER_KEYS[i]}`),
          unitPrice: unitPrice.toFixed(2),
        }))
      : undefined,
    priceNote: assets.priceNote ? t(locale, `${base}.priceNote`) : undefined,
    commercialSample: t(locale, assets.commercialKeys?.[0] ?? 'productDetail.sampleMoq'),
    commercialBulk: t(locale, assets.commercialKeys?.[1] ?? 'productDetail.bulkMoqLabel'),
    rsp: assets.rsp,
    badge: assets.badge ? t(locale, `${base}.badge`) : undefined,
    colors: Array.from({ length: assets.colorCount }, (_, i) => t(locale, `${base}.colors.${i}`)),
    story: getStory(slug),
  };
}

export function getStaticPaths() {
  return [
    'lumi',
    'lumi-2',
    'venus',
    'hestia',
    'alpha',
    'emerald',
    'euno',
    'themis',
    'hebe',
    'helix',
    'eirene',
    'wooden',
    // LED light therapy 品类（2026-10-13）
    'led-therapy-mask-001a',
    'led-therapy-mask-002a',
    'led-therapy-panel-f618',
  ].map((slug) => ({ params: { slug } }));
}

if (!PRODUCT_ASSETS[slug]) {
  return new Response('Not found', { status: 404 });
}
const product = buildProduct(slug);
const productGallery = product.gallery.map((image) => responsiveImageSources(image));
const heroImageSources = responsiveImageSources(product.heroImage, [400, 800, 1200], 1200);
const displayPricing = getDisplayPricing(product);

const pageTitle = product.name;
const pageDescription = product.description;
// 语言化 canonical：早期硬编码英文路径导致 21 个语种的产品页全部 canonical 到 /products/<slug>，
// 与自身 hreflang（声明这些 URL 是该语言的版本）互相矛盾，Google 会只收录英文版而丢弃 21 个语种页。
// 产品页正文与 meta description 均已按语言翻译，因此必须自指 canonical（2026-09-10 修复）。
const canonical = `https://iplmanufacturer.com${getLocalizedPath(locale, `/products/${slug}`)}`;
const breadcrumbs = buildBreadcrumbs(locale, [
  { label: t(locale, 'common.home'), path: '/' },
  { label: t(locale, 'nav.products'), path: '/products' },
  { label: pageTitle },
]);

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbs.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.label,
    item: item.href ? `https://iplmanufacturer.com${item.href}` : canonical,
  })),
};

// —— offers 增强字段：商家退换货政策 + 物流信息（Google Merchant Listing 富媒体增强）
// 数据来源：https://iplmanufacturer.com/return-policy（15 天退货窗口、缺陷品免退货运费、非缺陷品买家承担运费）
const merchantReturnPolicy = {
  '@type': 'MerchantReturnPolicy',
  applicableCountry: 'US',
  returnPolicyCategory: 'https://schema.org/MerchantReturnFiniteReturnWindow',
  merchantReturnDays: 15,
  returnMethod: 'https://schema.org/ReturnByMail',
  returnFees: 'https://schema.org/ReturnFeesCustomerResponsibility',
  merchantReturnLink: 'https://iplmanufacturer.com/return-policy',
};

// 全球直邮：处理 0-1 个工作日 + 国际运输 5-14 个工作日（与 messages/en.json 物流 deliveryTime 一致）
const shippingDetails = {
  '@type': 'OfferShippingDetails',
  shippingRate: {
    '@type': 'MonetaryAmount',
    value: '0',
    currency: 'USD',
  },
  shippingDestination: {
    '@type': 'DefinedRegion',
    addressCountry: 'US',
  },
  deliveryTime: {
    '@type': 'ShippingDeliveryTime',
    handlingTime: {
      '@type': 'QuantitativeValue',
      minValue: 0,
      maxValue: 1,
      unitCode: 'DAY',
    },
    transitTime: {
      '@type': 'QuantitativeValue',
      minValue: 5,
      maxValue: 14,
      unitCode: 'DAY',
    },
  },
};

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.name,
  description: product.description,
  image: product.gallery.map((img) => `https://iplmanufacturer.com${img}`),
  brand: {
    '@type': 'Brand',
    name: 'iShine',
  },
  offers: product.priceTiers?.length
    ? {
        '@type': 'AggregateOffer',
        priceCurrency: 'USD',
        lowPrice: product.priceTiers[product.priceTiers.length - 1]?.unitPrice,
        highPrice: product.priceTiers[0]?.unitPrice,
        offerCount: product.priceTiers.length,
        availability: 'https://schema.org/InStock',
        hasMerchantReturnPolicy: merchantReturnPolicy,
        shippingDetails,
      }
    : {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'USD',
        availability: 'https://schema.org/InStock',
        hasMerchantReturnPolicy: merchantReturnPolicy,
        shippingDetails,
      },
  ...(product.badge ? { award: product.badge } : {}),
};
---

<BaseLayout title={pageTitle} lang={locale} description={pageDescription} canonical={canonical} blogRecPage={`/products/${slug}`} image={product.heroImage} hideFooterCertClaims={isLedProduct}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />
  </Fragment>

  <div class="space-y-48">
    <section class="space-y-8">
      <div class="px-6 pt-6">
        <Breadcrumb items={breadcrumbs} locale={locale} />
      </div>

      <div class="grid gap-8 lg:grid-cols-2">
        {/* min-w-0 必需：本列是 grid 子项，自动最小尺寸取内容 min-content。
            缩略图行是 flex + flex-shrink-0 的 80px 方块（gap 12px），6 张即 540px；
            缺 min-w-0 时本列收缩不到 540px 以下，会把单列轨道顶宽并连带右列同宽，
            表现为 375px 手机上图片区偏右、Pricing 表格右侧约 179px 被裁——html/body 的
            overflow-x:hidden 把它变成静默裁切，看不出滚动条。加 min-w-0 后列可收缩到
            容器宽，缩略图行恢复成行内横向滚动。 */}
        <div class="min-w-0 space-y-4" data-product-gallery>
          <div class="overflow-hidden rounded-2xl bg-neutral-100">
            <picture>
              <source
                id="product-hero-image-avif"
                srcset={heroImageSources.avifSrcSet}
                sizes="(min-width: 1024px) 50vw, 100vw"
                type="image/avif"
              />
              <source
                id="product-hero-image-webp"
                srcset={heroImageSources.webpSrcSet}
                sizes="(min-width: 1024px) 50vw, 100vw"
                type="image/webp"
              />
              <img
                id="product-hero-image"
                src={heroImageSources.src}
                srcset={heroImageSources.webpSrcSet}
                sizes="(min-width: 1024px) 50vw, 100vw"
                alt={product.name}
                class="h-full w-full object-cover"
                style="aspect-ratio:1/1;max-height:500px;"
                loading="eager"
                fetchpriority="high"
                decoding="async"
                width="1200"
                height="1200"
              />
            </picture>
          </div>
          {product.gallery.length > 1 && (
            <div class="flex gap-3 overflow-x-auto pb-2">
              {productGallery.map((img, index) => (
                <button
                  type="button"
                  class="h-20 w-20 flex-shrink-0 overflow-hidden rounded-xl bg-neutral-100"
                  data-product-gallery-thumb
                  data-img={img.src}
                  data-img-srcset={img.webpSrcSet}
                  data-img-avif-srcset={img.avifSrcSet}
                  aria-label={fill(t(locale, 'productDetail.viewImage'), { productName: product.name })}
                >
                  <picture>
                    <source srcset={img.avifSrcSet} sizes="80px" type="image/avif" />
                    <source srcset={img.webpSrcSet} sizes="80px" type="image/webp" />
                    <img
                      src={img.src}
                      srcset={img.webpSrcSet}
                      sizes="80px"
                      alt={fill(t(locale, 'productDetail.galleryAlt'), { productName: product.name, index: index + 1 })}
                      class="h-full w-full object-cover"
                      loading="lazy"
                      decoding="async"
                      width="160"
                      height="160"
                    />
                  </picture>
                </button>
              ))}
            </div>
          )}
          <script is:inline>
            (() => {
              const root = document.querySelector('[data-product-gallery]');
              if (!root) return;
              const hero = root.querySelector('#product-hero-image');
              const avifSource = root.querySelector('#product-hero-image-avif');
              const webpSource = root.querySelector('#product-hero-image-webp');
              if (!hero) return;

              root.addEventListener('click', (event) => {
                const target = event.target;
                if (!(target instanceof Element)) return;
                const thumb = target.closest('[data-product-gallery-thumb][data-img]');
                if (!thumb || !root.contains(thumb)) return;
                const src = thumb.getAttribute('data-img');
                const srcSet = thumb.getAttribute('data-img-srcset');
                const avifSrcSet = thumb.getAttribute('data-img-avif-srcset');
                if (!src) return;
                hero.setAttribute('src', src);
                if (srcSet) {
                  hero.setAttribute('srcset', srcSet);
                }
                if (webpSource && srcSet) {
                  webpSource.setAttribute('srcset', srcSet);
                }
                if (avifSource && avifSrcSet) {
                  avifSource.setAttribute('srcset', avifSrcSet);
                }
              });
            })();
          </script>
        </div>

        {/* 右列同样是 grid 子项，加上 min-w-0 以免内部（规格值/价格/长文案）把它顶宽 */}
        <div class="min-w-0 space-y-6">
          <div class="space-y-3">
            {product.badge && (
              <span class="inline-block rounded-full bg-sky-700 px-4 py-1 text-xs font-semibold uppercase tracking-wider text-white">
                {product.badge}
              </span>
            )}
            <h1 class="text-4xl font-bold text-ink-900 md:text-5xl">{product.name}</h1>
            <p class="text-xl text-sky-600 font-medium">{product.tagline}</p>
            <p class="text-base leading-relaxed text-neutral-700">{product.description}</p>
            <div class="flex flex-wrap gap-2 pt-2">
              <span class="rounded-full bg-ink-900 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-white">{t(locale, 'productDetail.oemOdmReady')}</span>
              <span class="rounded-full bg-neutral-100 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-neutral-700">{t(locale, 'productDetail.sampleSupport')}</span>
              <span class="rounded-full bg-neutral-100 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-neutral-700">{t(locale, 'productDetail.factoryDirect')}</span>
            </div>
          </div>

          <div class="rounded-[1.5rem] border border-neutral-200 bg-white p-6 shadow-sm">
            <div class="flex flex-wrap items-start justify-between gap-4">
              <div>
                <div class="text-sm font-semibold uppercase tracking-[0.18em] text-sky-600">{t(locale, 'productDetail.pricingPayment')}</div>
                {displayPricing ? (
                  <>
                    <div class="mt-3 text-3xl font-bold text-ink-900">
                      USD {displayPricing.firstTier.unitPrice}
                      <span class="ml-2 text-base font-medium text-slate-500">{t(locale, 'productDetail.perUnit')}</span>
                    </div>
                    <p class="mt-1 text-sm text-neutral-600">{fill(t(locale, 'productDetail.pricingRange'), { firstQty: displayPricing.firstTier.quantity, lastPrice: displayPricing.lastTier.unitPrice, lastQty: displayPricing.lastTier.quantity })}</p>
                  </>
                ) : (
                  <>
                    <div class="mt-3 text-2xl font-bold text-ink-900">{t(locale, 'productDetail.contactForQuote')}</div>
                    <p class="mt-1 text-sm text-neutral-600">{product.priceNote || t(locale, 'productDetail.pricingDepends')}</p>
                  </>
                )}
                {product.rsp ? (
                  <p class="mt-2 text-sm font-semibold text-ink-900">{fill(t(locale, 'productDetail.rspLine'), { value: product.rsp })}</p>
                ) : null}
              </div>
              <div class="rounded-2xl bg-neutral-50 px-4 py-3 text-sm text-neutral-700">
                <div class="font-semibold text-ink-900">{t(locale, 'productDetail.commercialBaseline')}</div>
                <div class="mt-1">{product.commercialSample}</div>
                <div>{product.commercialBulk}</div>
              </div>
            </div>

            {product.priceTiers?.length ? (
              <div class="mt-6 overflow-hidden rounded-2xl border border-neutral-200">
                <table class="min-w-full divide-y divide-neutral-200 text-sm">
                  <thead class="bg-neutral-50">
                    <tr>
                      <th class="px-4 py-3 text-left font-semibold text-ink-900">{t(locale, 'productDetail.quantityHeader')}</th>
                      <th class="px-4 py-3 text-right font-semibold text-ink-900">{t(locale, 'productDetail.unitPriceHeader')}</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-neutral-200 bg-white">
                    {product.priceTiers.map((tier, index) => (
                      <tr class={index % 2 === 0 ? 'bg-white' : 'bg-neutral-50/60'}>
                        <td class="px-4 py-3 text-neutral-700">{tier.quantity}</td>
                        <td class="px-4 py-3 text-right font-semibold text-ink-900">{tier.unitPrice}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            ) : null}

            {product.priceNote ? <p class="mt-4 text-sm leading-relaxed text-neutral-600">{product.priceNote}</p> : null}

            <div class="mt-6 border-t border-neutral-200 pt-6">
              <h2 class="text-lg font-semibold text-ink-900">{t(locale, 'productDetail.acceptedPaymentMethods')}</h2>
              <p class="mt-2 text-sm text-neutral-600">{t(locale, 'productDetail.paymentMethodsDescription')}</p>
              <div class="mt-4 flex flex-wrap gap-2">
                {acceptedPayments.map((method) => (
                  <span class="rounded-full border border-neutral-200 bg-neutral-50 px-3 py-1.5 text-sm text-neutral-700">{method}</span>
                ))}
              </div>

              {/* 本地收款方案（22 语种，见 src/lib/payment-solutions.ts）
                  主推区域展开、其余区域折叠；只出现币种 / 清算网络 / 到账时效，不出现银行名与账号。 */}
              <div class="mt-6 border-t border-neutral-200 pt-6">
                <h3 class="text-base font-semibold text-ink-900">{t(locale, 'productDetail.paymentSolutions.title')}</h3>
                <p class="mt-2 text-sm text-neutral-600">{t(locale, 'productDetail.paymentSolutions.intro')}</p>

                {primaryPaymentRegions.map((region) => (
                  <div class="mt-4">
                    <h4 class="text-sm font-semibold text-ink-900">
                      {t(locale, `productDetail.paymentSolutions.regions.${region}`)}
                    </h4>
                    <dl class="mt-2 divide-y divide-neutral-100">
                      {getPaymentRegionRows(region).map((row) => (
                        <div class="flex justify-between gap-4 py-2 text-sm">
                          <dt class="text-neutral-600">{row.currency} · {row.network}</dt>

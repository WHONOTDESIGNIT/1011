---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t } from '../../lib/i18n';
import { getLocalizedPath } from '../../lib/breadcrumbs';
import { Image } from 'astro:assets';

const locale = Astro.currentLocale ?? 'en';

function netlifyImage(path: string, width: number, format: 'avif' | 'webp', quality = 80) {
  return `/.netlify/images?url=${encodeURIComponent(path)}&w=${width}&fm=${format}&q=${quality}`;
}

function buildSrcSet(path: string, widths: number[], format: 'avif' | 'webp', quality = 80) {
  return widths.map((width) => `${netlifyImage(path, width, format, quality)} ${width}w`).join(', ');
}

function responsiveImageSources(path: string, widths = [400, 800, 1200], defaultWidth = 800) {
  return {
    src: netlifyImage(path, defaultWidth, 'webp'),
    webpSrcSet: buildSrcSet(path, widths, 'webp'),
    avifSrcSet: buildSrcSet(path, widths, 'avif'),
  };
}

const products = [
  { slug: 'lumi', nameKey: 'nav.lumi', firstImage: '/images/products/lumi/RoseSkinCo-Lumi-IPL-Hair-Removal-Handset-white-Gold_jpg.webp' },
  { slug: 'lumi-2', nameKey: 'nav.lumi2', firstImage: '/images/products/lumi-2/lumi-2-images (1).jpg' },
  { slug: 'venus', nameKey: 'nav.venus', firstImage: '/images/products/Venus/purple-venus-sapphire-ipl.webp' },
  { slug: 'hestia', nameKey: 'nav.hestia', firstImage: '/images/products/Hestia/hestia-smart-app-ipl-device-12pro-2.png' },
  { slug: 'alpha', nameKey: 'nav.alpha', firstImage: '/images/products/Alpha/alpha-ipl-device-front-view.jpg' },
  { slug: 'emerald', nameKey: 'nav.emerald', firstImage: '/images/products/Emerald/emerald%20ipl%20white%20color.webp' },
  { slug: 'euno', nameKey: 'nav.euno', firstImage: '/images/products/Euno/euno%20ipl%20white%20color.webp' },
  { slug: 'themis', nameKey: 'nav.themis', firstImage: '/images/products/Themis/golden-luxury-front-view.jpg' },
  { slug: 'hebe', nameKey: 'nav.hebe', firstImage: '/images/products/Hebe/hebe%20ipl%20hair%20removal%20white%20color.webp' },
  { slug: 'helix', nameKey: 'nav.helix', firstImage: '/images/products/Helix/helix-ipl-front-view.jpg' },
  { slug: 'eirene', nameKey: 'nav.eirene', firstImage: '/images/products/Eirene/battery-built-in%20ipl%20device%20front%20view.jpg' },
  { slug: 'wooden', nameKey: 'nav.wooden', firstImage: '/images/products/Wooden/wooden%20ipl%20white%20color%20front%20view.webp' },
].map((product) => ({
  ...product,
  taglineKey: `productDetail.index.cards.${product.slug}.tagline`,
  imageSources: responsiveImageSources(product.firstImage),
}));
const freeSampleImage = responsiveImageSources('/images/products/free_sample.jpg', [400, 800, 1200], 1200);

const platformTracks = [
  {
    titleKey: 'productDetail.index.tracks.comfort.title',
    descriptionKey: 'productDetail.index.tracks.comfort.description',
    links: [
      { labelKey: 'productDetail.index.tracks.comfort.linkVenus', href: getLocalizedPath(locale, '/products/venus') },
      { labelKey: 'productDetail.index.tracks.comfort.linkLumi2', href: getLocalizedPath(locale, '/products/lumi-2') },
    ],
  },
  {
    titleKey: 'productDetail.index.tracks.smartApp.title',
    descriptionKey: 'productDetail.index.tracks.smartApp.description',
    links: [
      { labelKey: 'productDetail.index.tracks.smartApp.linkHestia', href: getLocalizedPath(locale, '/products/hestia') },
      { labelKey: 'productDetail.index.tracks.smartApp.linkLumi', href: getLocalizedPath(locale, '/products/lumi') },
    ],
  },
  {
    titleKey: 'productDetail.index.tracks.portable.title',
    descriptionKey: 'productDetail.index.tracks.portable.description',
    links: [{ labelKey: 'productDetail.index.tracks.portable.linkEuno', href: getLocalizedPath(locale, '/products/euno') }],
  },
  {
    titleKey: 'productDetail.index.tracks.luxury.title',
    descriptionKey: 'productDetail.index.tracks.luxury.description',
    links: [{ labelKey: 'productDetail.index.tracks.luxury.linkWooden', href: getLocalizedPath(locale, '/products/wooden') }],
  },
  {
    titleKey: 'productDetail.index.tracks.professional.title',
    descriptionKey: 'productDetail.index.tracks.professional.description',
    links: [
      { labelKey: 'productDetail.index.tracks.professional.linkThemis', href: getLocalizedPath(locale, '/products/themis') },
      { labelKey: 'productDetail.index.tracks.professional.linkAlpha', href: getLocalizedPath(locale, '/products/alpha') },
    ],
  },
];

const faqHrefs = [
  [getLocalizedPath(locale, '/catalogue')],
  [
    getLocalizedPath(locale, '/services/logo-printing'),
    getLocalizedPath(locale, '/services/box-custom'),
    getLocalizedPath(locale, '/services/user-manual-guide-custom'),
  ],
  [getLocalizedPath(locale, '/services/no-moq')],
  [
    getLocalizedPath(locale, '/services/packaging-logistics'),
    getLocalizedPath(locale, '/services/dropshipping'),
  ],
];
const productFaq = [0, 1, 2, 3].map((i) => ({
  question: t(locale, `productDetail.index.faq.items.${i}.question`),
  answer: t(locale, `productDetail.index.faq.items.${i}.answer`),
  links: faqHrefs[i].map((href, j) => ({
    label: t(locale, `productDetail.index.faq.items.${i}.links.${j}`),
    href,
  })),
}));

const safetyPillar = { labelKey: 'productDetail.index.safety.pillar', href: getLocalizedPath(locale, '/ipl-hair-removal-is-safe') };
const safetyHrefs = [
  '/blog/28-clinical-data-why-ipl-hair-removal-is-safe',
  '/blog/30-ipl-vs-laser-which-is-safer',
  '/blog/14-fda-cleared-ipl-device-manufacturer-guide',
  '/ipl-hair-removal-is-safe',
  '/blog/31-uv-filtering-wavelengths-why-ipl-is-safe',
  '/blog/15-skin-tone-detection-ipl-safety-guide',
  '/blog/29-safe-ipl-hair-removal-at-home-protocol',
  '/ipl-hair-removal-is-safe',
  '/blog/33-who-should-not-use-ipl-hair-removal-contraindications',
  '/ipl-hair-removal-is-safe',
];
const safetyResources = safetyHrefs.map((href, i) => ({
  labelKey: `productDetail.index.safety.links.${i}`,
  href: getLocalizedPath(locale, href),
}));
---

<BaseLayout
  title={`${t(locale, 'productDetail.index.page.title')} | iShine`}
  lang={locale}
  description={t(locale, 'productDetail.index.page.description')}
>
  <div class="space-y-36">
    <section class="relative w-screen left-1/2 -translate-x-1/2 overflow-hidden -mt-[160px] pt-[160px] min-h-[400px] md:min-h-[500px] lg:min-h-[600px]">
      <Image
        src="/images/products/ipl-products-banner.webp"
        alt={t(locale, 'productDetail.index.hero.alt')}
        loading="eager"
        class="absolute inset-0 h-full w-full object-cover"
        width={1920}
        height={1080}
      />
      <div class="absolute inset-0 bg-black/20" />
      <div class="relative z-10 flex h-full items-end px-6 pb-10 md:px-12">
        <div class="max-w-4xl">
          <h1 class="text-4xl font-bold text-white md:text-5xl lg:text-6xl">{t(locale, 'productDetail.index.hero.title')}</h1>
          <p class="mt-4 max-w-3xl text-lg text-white/90">
            {t(locale, 'productDetail.index.hero.description')}
          </p>
          <div class="mt-6 flex flex-wrap gap-3">
            <a class="rounded-2xl bg-white px-5 py-3 text-sm font-semibold text-slate-900 transition hover:bg-slate-100" href={getLocalizedPath(locale, '/catalogue')}>
              {t(locale, 'productDetail.index.hero.compareModels')}
            </a>
            <a class="rounded-2xl border border-white/30 bg-white/10 px-5 py-3 text-sm font-semibold text-white transition hover:bg-white/15" href={getLocalizedPath(locale, '/services')}>
              {t(locale, 'productDetail.index.hero.exploreServices')}
            </a>
            <a class="rounded-2xl border border-white/30 bg-white/10 px-5 py-3 text-sm font-semibold text-white transition hover:bg-white/15" href={getLocalizedPath(locale, '/contact')}>
              {t(locale, 'productDetail.index.hero.getAQuote')}
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-6">
      <h2 class="text-3xl font-bold text-slate-900">{t(locale, 'productDetail.index.summary.title')}</h2>
      <p class="mt-4 max-w-4xl text-lg leading-relaxed text-slate-700">
        {t(locale, 'productDetail.index.summary.description')}
      </p>
    </section>

    <section class="space-y-10">
      <div class="mx-auto max-w-3xl text-center">
        <div class="text-sm font-semibold uppercase tracking-[0.22em] text-violet-700">{t(locale, 'productDetail.index.choose.kicker')}</div>
        <h2 class="mt-3 text-3xl font-bold text-slate-900 md:text-4xl">{t(locale, 'productDetail.index.choose.title')}</h2>
        <p class="mt-4 text-lg text-slate-700">{t(locale, 'productDetail.index.choose.description')}</p>
      </div>
      <div class="mx-auto grid max-w-6xl gap-6 md:grid-cols-2 lg:grid-cols-3">
        {platformTracks.map((track) => (
          <article class="rounded-[1.75rem] border border-slate-200 bg-white p-7 shadow-sm">
            <h3 class="text-2xl font-semibold text-slate-900">{t(locale, track.titleKey)}</h3>
            <p class="mt-3 text-sm leading-relaxed text-slate-700">{t(locale, track.descriptionKey)}</p>
            <ul class="mt-6 space-y-3 text-sm font-semibold text-slate-900">
              {track.links.map((link) => (
                <li>
                  <a class="inline-flex items-center gap-2 text-slate-900 transition hover:text-violet-700" href={link.href}>
                    <span class="h-2.5 w-2.5 rounded-2xl bg-violet-500" />
                    <span>{t(locale, link.labelKey)}</span>
                  </a>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </section>

    <section class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {products.map((product) => (
        <a
          class="product-card flex flex-col overflow-hidden rounded-xl border-2 border-black bg-white shadow-sm transition-all hover:shadow-md"
          href={getLocalizedPath(locale, '/products/' + product.slug)}
        >
          <div class="relative bg-slate-100" style="aspect-ratio:1000/806">
            <picture>
              <source
                srcset={product.imageSources.avifSrcSet}
                sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw"
                type="image/avif"
              />
              <source
                srcset={product.imageSources.webpSrcSet}
                sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw"
                type="image/webp"
              />
              <img
                class="h-full w-full object-cover"
                src={product.imageSources.src}
                srcset={product.imageSources.webpSrcSet}
                sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw"
                alt={t(locale, product.nameKey)}
                loading="lazy"
                decoding="async"
                width="1000"
                height="806"
              />
            </picture>
          </div>
          <div class="flex flex-col justify-end p-3" style="aspect-ratio:1000/194">
            <div>
              <h2 class="text-xl font-semibold text-slate-900">{t(locale, product.nameKey)}</h2>
              <p class="mt-1 text-sm text-slate-700">{t(locale, product.taglineKey)}</p>
            </div>
          </div>
        </a>
      ))}
    </section>

    <section class="mx-auto max-w-6xl px-6">
      <div class="grid gap-6 rounded-2xl border border-slate-200 bg-white p-8 shadow-sm md:grid-cols-3 md:p-10">
        <div class="md:col-span-2">
          <div class="text-sm font-semibold uppercase tracking-[0.22em] text-violet-700">{t(locale, 'productDetail.index.nextStep.kicker')}</div>
          <h2 class="mt-3 text-3xl font-bold text-slate-900">{t(locale, 'productDetail.index.nextStep.title')}</h2>
          <p class="mt-4 max-w-3xl text-lg leading-relaxed text-slate-700">
            {t(locale, 'productDetail.index.nextStep.description')}
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a class="rounded-2xl bg-slate-900 px-6 py-3 text-sm font-semibold text-white transition hover:bg-slate-800" href={getLocalizedPath(locale, '/services/no-moq')}>
              {t(locale, 'productDetail.index.nextStep.startNoMoq')}
            </a>
            <a class="rounded-2xl border border-slate-300 bg-white px-6 py-3 text-sm font-semibold text-slate-900 transition hover:border-slate-400 hover:bg-slate-50" href={getLocalizedPath(locale, '/services/box-custom')}>
              {t(locale, 'productDetail.index.nextStep.customizeBox')}
            </a>
            <a class="rounded-2xl border border-slate-300 bg-white px-6 py-3 text-sm font-semibold text-slate-900 transition hover:border-slate-400 hover:bg-slate-50" href={getLocalizedPath(locale, '/services/dropshipping')}>
              {t(locale, 'productDetail.index.nextStep.shipDirectly')}
            </a>
          </div>
        </div>
        <div class="rounded-2xl bg-slate-50 p-6">
          <div class="text-sm font-semibold uppercase tracking-[0.22em] text-slate-600">{t(locale, 'productDetail.index.fastLinks.kicker')}</div>
          <ul class="mt-4 space-y-3 text-sm font-semibold text-slate-900">
            <li><a class="transition hover:text-violet-700" href={getLocalizedPath(locale, '/services/logo-printing')}>{t(locale, 'productDetail.index.fastLinks.logoPrinting')}</a></li>
            <li><a class="transition hover:text-violet-700" href={getLocalizedPath(locale, '/services/user-manual-guide-custom')}>{t(locale, 'productDetail.index.fastLinks.userManual')}</a></li>
            <li><a class="transition hover:text-violet-700" href={getLocalizedPath(locale, '/services/packaging-logistics')}>{t(locale, 'productDetail.index.fastLinks.packagingLogistics')}</a></li>
            <li><a class="transition hover:text-violet-700" href={getLocalizedPath(locale, '/contact')}>{t(locale, 'productDetail.index.fastLinks.getAQuote')}</a></li>
          </ul>
        </div>
      </div>
    </section>

    <section class="space-y-8">
      <div class="mx-auto max-w-3xl text-center">
        <div class="text-sm font-semibold uppercase tracking-[0.22em] text-violet-700">{t(locale, 'productDetail.index.faq.kicker')}</div>
        <h2 class="mt-3 text-3xl font-bold text-slate-900 md:text-4xl">{t(locale, 'productDetail.index.faq.title')}</h2>
        <p class="mt-4 text-lg text-slate-700">{t(locale, 'productDetail.index.faq.description')}</p>
      </div>
      <div class="mx-auto grid max-w-4xl gap-4">
        {productFaq.map((item) => (
          <details class="group rounded-[1.5rem] border border-slate-200 bg-white p-6 shadow-sm">
            <summary class="cursor-pointer list-none text-lg font-semibold text-slate-900">
              <div class="flex items-start justify-between gap-4">
                <span>{item.question}</span>
                <span class="mt-1 text-slate-500 transition group-open:rotate-45">+</span>
              </div>
            </summary>
            <div class="mt-4 space-y-4 text-sm leading-relaxed text-slate-700">
              <p>{item.answer}</p>
              <div class="flex flex-wrap gap-3">
                {item.links.map((link) => (
                  <a class="inline-flex items-center rounded-2xl border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-900 transition hover:border-slate-300 hover:bg-slate-50" href={link.href}>
                    {link.label}
                  </a>
                ))}
              </div>
            </div>
          </details>
        ))}
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-6">
      <div class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm md:p-10">
        <div class="grid gap-8 lg:grid-cols-[1fr_1fr] lg:items-start">
          <div>
            <div class="text-sm font-semibold uppercase tracking-[0.22em] text-violet-700">{t(locale, 'productDetail.index.safety.kicker')}</div>
            <h2 class="mt-3 text-3xl font-bold text-slate-900 md:text-4xl">{t(locale, 'productDetail.index.safety.title')}</h2>
            <p class="mt-4 max-w-2xl text-lg leading-relaxed text-slate-700">
              {t(locale, 'productDetail.index.safety.description')}
            </p>
            <div class="mt-8">
              <a class="inline-flex items-center justify-center rounded-2xl bg-slate-900 px-6 py-3 text-sm font-semibold text-white transition hover:bg-slate-800" href={safetyPillar.href}>
                {t(locale, safetyPillar.labelKey)}
              </a>
            </div>
          </div>
          <div class="rounded-[1.75rem] bg-slate-50 p-7">
            <div class="text-sm font-semibold uppercase tracking-[0.22em] text-slate-600">{t(locale, 'productDetail.index.safety.deepLinks')}</div>
            <ul class="mt-4 space-y-3 text-sm font-semibold text-slate-900">
              {safetyResources.map((item) => (
                <li>
                  <a class="transition hover:text-violet-700" href={item.href}>
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-6">
      <div class="w-full overflow-hidden rounded-2xl bg-slate-100">
        <picture>
          <source srcset={freeSampleImage.avifSrcSet} sizes="(min-width: 1024px) 72rem, 100vw" type="image/avif" />
          <source srcset={freeSampleImage.webpSrcSet} sizes="(min-width: 1024px) 72rem, 100vw" type="image/webp" />
          <img
            src={freeSampleImage.src}
            srcset={freeSampleImage.webpSrcSet}
            sizes="(min-width: 1024px) 72rem, 100vw"
            alt={t(locale, 'productDetail.index.freeSampleAlt')}
            loading="lazy"
            decoding="async"
            width="1200"
            height="520"
            class="h-auto w-full object-contain"
          />
        </picture>
      </div>
    </section>
  </div>
</BaseLayout>

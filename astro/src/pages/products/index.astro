---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t } from '../../lib/i18n';
import { getLocalizedPath } from '../../lib/breadcrumbs';

const locale = Astro.currentLocale ?? 'en';

function netlifyImage(path: string, width: number, format: 'avif' | 'webp', quality = 80) {
  return `/.netlify/images?url=${encodeURIComponent(path)}&w=${width}&fm=${format}&q=${quality}`;
}

function buildSrcSet(path: string, widths: number[], format: 'avif' | 'webp', quality = 80) {
  return widths.map((width) => `${netlifyImage(path, width, format, quality)} ${width}w`).join(', ');
}

function responsiveImageSources(path: string, widths = [400, 800, 1200], defaultWidth = 800) {
  return {
    src: netlifyImage(path, defaultWidth, 'webp'),
    webpSrcSet: buildSrcSet(path, widths, 'webp'),
    avifSrcSet: buildSrcSet(path, widths, 'avif'),
  };
}

const products = [
  { slug: 'lumi', nameKey: 'nav.lumi', firstImage: '/images/products/lumi/RoseSkinCo-Lumi-IPL-Hair-Removal-Handset-white-Gold_jpg.webp' },
  { slug: 'lumi-2', nameKey: 'nav.lumi2', firstImage: '/images/products/lumi-2/lumi-2-images-1.webp' },
  { slug: 'venus', nameKey: 'nav.venus', firstImage: '/images/products/Venus/purple-venus-sapphire-ipl.webp' },
  { slug: 'hestia', nameKey: 'nav.hestia', firstImage: '/images/products/Hestia/hestia-smart-app-ipl-device-12pro-2.png' },
  { slug: 'alpha', nameKey: 'nav.alpha', firstImage: '/images/products/Alpha/alpha-ipl-device-front-view.jpg' },
  { slug: 'emerald', nameKey: 'nav.emerald', firstImage: '/images/products/Emerald/emerald%20ipl%20white%20color.webp' },
  { slug: 'euno', nameKey: 'nav.euno', firstImage: '/images/products/Euno/euno%20ipl%20white%20color.webp' },
  { slug: 'themis', nameKey: 'nav.themis', firstImage: '/images/products/Themis/golden-luxury-front-view.jpg' },
  { slug: 'hebe', nameKey: 'nav.hebe', firstImage: '/images/products/Hebe/hebe%20ipl%20hair%20removal%20white%20color.webp' },
  { slug: 'helix', nameKey: 'nav.helix', firstImage: '/images/products/Helix/helix-ipl-front-view.jpg' },
  { slug: 'eirene', nameKey: 'nav.eirene', firstImage: '/images/products/Eirene/battery-built-in%20ipl%20device%20front%20view.jpg' },
  { slug: 'wooden', nameKey: 'nav.wooden', firstImage: '/images/products/Wooden/wooden%20ipl%20white%20color%20front%20view.webp' },
].map((product) => ({
  ...product,
  taglineKey: `productDetail.index.cards.${product.slug}.tagline`,
  imageSources: responsiveImageSources(product.firstImage, [256, 512], 512),
}));

const faqHrefs = [
  [getLocalizedPath(locale, '/catalogue')],
  [
    getLocalizedPath(locale, '/services/logo-printing'),
    getLocalizedPath(locale, '/services/box-custom'),
    getLocalizedPath(locale, '/services/user-manual-guide-custom'),
  ],
  [getLocalizedPath(locale, '/services/no-moq')],
  [
    getLocalizedPath(locale, '/services/packaging-logistics'),
    getLocalizedPath(locale, '/services/dropshipping'),
  ],
  [getLocalizedPath(locale, '/blog/30-ipl-vs-laser-which-is-safer')],
  [getLocalizedPath(locale, '/services/no-moq')],
];
const productFaq = [0, 1, 2, 3, 4, 5].map((i) => ({
  question: t(locale, `productDetail.index.faq.items.${i}.question`),
  answer: t(locale, `productDetail.index.faq.items.${i}.answer`),
  links: faqHrefs[i].map((href, j) => ({
    label: t(locale, `productDetail.index.faq.items.${i}.links.${j}`),
    href,
  })),
}));

const scopeNote = {
  title: t(locale, 'productDetail.index.scopeNote.title'),
  intro: t(locale, 'productDetail.index.scopeNote.intro'),
  criteria: t(locale, 'productDetail.index.scopeNote.criteria'),
};
const quickFacts = Array.from({ length: 6 }, (_, i) => ({
  title: t(locale, `productDetail.index.hero.quickFacts.items.${i}.title`),
  subtitle: t(locale, `productDetail.index.hero.quickFacts.items.${i}.subtitle`),
}));
// 五款旗舰（与 Excel comparison 对应）：轮播图直连 public 原图，
// 本地 dev 与生产均可见；如需响应式裁剪可后续换 Netlify CDN srcset。
const heroSlides = ['helix', 'lumi-2', 'lumi', 'venus', 'themis'].map((slug) => {
  const product = products.find((p) => p.slug === slug);
  if (!product) throw new Error(`Missing hero slide product: ${slug}`);
  return { slug, name: t(locale, product.nameKey), src: product.firstImage };
});
// byApplication 六卡名单（细分市场各 1 款）：
// ice-cooling → helix / ice+app → lumi-2 / app 控制 → lumi / 便携 → euno / salon 专业 → themis / bikini+ice-cooling → venus
const byApplicationCards = ['helix', 'lumi-2', 'lumi', 'euno', 'themis', 'venus'].map((slug, i) => {
  const product = products.find((p) => p.slug === slug);
  if (!product) throw new Error(`Missing by-application product: ${slug}`);
  return {
    slug,
    name: t(locale, product.nameKey),
    image: product.firstImage,
    href: getLocalizedPath(locale, `/products/${slug}`),
    market: t(locale, `productDetail.index.byApplication.cards.${i}.market`),
    body: t(locale, `productDetail.index.byApplication.cards.${i}.body`),
  };
});
const scqaRows = ['s', 'c', 'q', 'a'].map((key) => ({
  tag: t(locale, `productDetail.index.scqa.${key}.tag`),
  title: t(locale, `productDetail.index.scqa.${key}.title`),
  body: t(locale, `productDetail.index.scqa.${key}.body`),
}));
// 三轴（Energy Density × Flash Rating × Cooling）：第 3 节开头卡片
const threeAxes = [0, 1, 2].map((i) => ({
  axis: t(locale, `productDetail.index.threeAxis.axes.${i}.axis`),
  title: t(locale, `productDetail.index.threeAxis.axes.${i}.title`),
  body: t(locale, `productDetail.index.threeAxis.axes.${i}.body`),
}));
// 定制规格 / 颜色：展示 4 款实拍多色图
const colorVariants = [
  { slug: 'hebe', src: '/images/products/Hebe/hebe%20ipl%20hair%20removal%20white%20gold%20and%20black%20color.webp' },
  { slug: 'venus', src: '/images/products/Venus/different-colors-venus-sapphire-ipl.webp' },
  { slug: 'euno', src: '/images/products/Euno/euno%20ipl%20pink%20color%20option.webp' },
  { slug: 'wooden', src: '/images/products/Wooden/wooden%20ipl%20pink%20black%20white%20color.webp' },
].map((variant) => ({
  ...variant,
  name: t(locale, `nav.${variant.slug}`),
}));
const customDimensions = Array.from({ length: 6 }, (_, i) => t(locale, `productDetail.index.customSpec.dimensions.${i}`));
// IPL vs 脱毛蜡 / 剃刀
const methodCards = [0, 1, 2].map((i) => ({
  name: t(locale, `productDetail.index.vsAlternatives.methods.${i}.name`),
  body: t(locale, `productDetail.index.vsAlternatives.methods.${i}.body`),
}));
// 智造场景：复用两篇已发布的工程博客封面
const manufacturingScenes = [
  {
    src: '/images/blog/blog-06-quality-control-in-ipl-manufacturing-best-practices.webp',
    href: getLocalizedPath(locale, '/blog/06-quality-control-in-ipl-manufacturing-best-practices'),
  },
  {
    src: '/images/blog/blog-02-oem-vs-odm-choosing-the-right-manufacturing-model.webp',
    href: getLocalizedPath(locale, '/blog/02-oem-vs-odm-choosing-the-right-manufacturing-model'),
  },
].map((scene, i) => ({
  ...scene,
  title: t(locale, `productDetail.index.manufacturing.scenes.${i}.title`),
  body: t(locale, `productDetail.index.manufacturing.scenes.${i}.body`),
  cta: t(locale, `productDetail.index.manufacturing.scenes.${i}.cta`),
}));
const sourcingFacts = [0, 1, 2].map((i) => ({
  title: t(locale, `productDetail.index.sourcing.facts.${i}.title`),
  body: t(locale, `productDetail.index.sourcing.facts.${i}.body`),
}));
const qualityPillars = Array.from({ length: 3 }, (_, i) => t(locale, `productDetail.index.quality.pillars.${i}`));
const tools = [
  {
    title: t(locale, 'productDetail.index.toolsStrip.tools.0.title'),
    body: t(locale, 'productDetail.index.toolsStrip.tools.0.body'),
    cta: t(locale, 'productDetail.index.toolsStrip.tools.0.cta'),
    href: getLocalizedPath(locale, '/catalogue'),
  },
  {
    title: t(locale, 'productDetail.index.toolsStrip.tools.1.title'),
    body: t(locale, 'productDetail.index.toolsStrip.tools.1.body'),
    cta: t(locale, 'productDetail.index.toolsStrip.tools.1.cta'),
    href: getLocalizedPath(locale, '/blog'),
  },
];

// 页尾 Q&A band 之前的固定 tools section：三张工具卡（目标工具页尚未上线，按钮暂不加链接）
const specTools = [0, 1, 2].map((i) => ({
  title: t(locale, `productDetail.index.specTools.cards.${i}.title`),
  body: t(locale, `productDetail.index.specTools.cards.${i}.body`),
  cta: t(locale, `productDetail.index.specTools.cards.${i}.cta`),
}));

const safetyPillar = { labelKey: 'productDetail.index.quality.pillarCta', href: getLocalizedPath(locale, '/ipl-hair-removal-is-safe') };
const safetyHrefs = [
  '/blog/28-clinical-data-why-ipl-hair-removal-is-safe',
  '/blog/30-ipl-vs-laser-which-is-safer',
  '/blog/14-fda-cleared-ipl-device-manufacturer-guide',
  '/ipl-hair-removal-is-safe',
  '/blog/31-uv-filtering-wavelengths-why-ipl-is-safe',
  '/blog/15-skin-tone-detection-ipl-safety-guide',
  '/blog/29-safe-ipl-hair-removal-at-home-protocol',
  '/ipl-hair-removal-is-safe',
  '/blog/33-who-should-not-use-ipl-hair-removal-contraindications',
  '/ipl-hair-removal-is-safe',
];
const safetyResources = safetyHrefs.map((href, i) => ({
  labelKey: `productDetail.index.safety.links.${i}`,
  href: getLocalizedPath(locale, href),
}));
const siteBaseUrl = (
  Astro.site?.toString()
  ?? process.env.URL
  ?? process.env.DEPLOY_PRIME_URL
  ?? process.env.SITE_URL
  ?? 'https://iplmanufacturer.com'
).replace(/\/$/, '');
---

<BaseLayout
  title={`${t(locale, 'productDetail.index.page.title')} | iShine`}
  lang={locale}
  description={t(locale, 'productDetail.index.page.description')}
  blogRecPage="/products"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'ItemList',
      name: t(locale, 'productDetail.index.page.title'),
      itemListElement: products.map((product, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        item: {
          // 列表页不标记为 Product：Google 产品富结果要求 offers/review/aggregateRating 三者其一，
          // 且技术规范仅支持单一产品页。列表页用 Thing 保持 ItemList 有效（见 product snippet 文档）。
          '@type': 'Thing',
          name: t(locale, product.nameKey),
          url: new URL(getLocalizedPath(locale, `/products/${product.slug}`), `${siteBaseUrl}/`).href.replace(/\/+$/, ''),
          image: new URL(product.firstImage, `${siteBaseUrl}/`).href,
        },
      })),
    })}></script>
  </Fragment>
  <div class="space-y-36">
    {/* ═══ 1. Hero ═══ */}
    <section class="relative w-screen left-1/2 -translate-x-1/2 mt-[60px] bg-black">
      <div class="mx-auto px-6 pt-14 pb-16 md:px-10 md:pt-20 md:pb-24" style="width:min(100% - 48px, 1843px)">
        <div class="grid items-center gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,0.95fr)] lg:gap-16">
          <div class="max-w-3xl">
            <h1 class="text-4xl font-bold text-white md:text-5xl lg:text-6xl">{t(locale, 'productDetail.index.hero.title')}</h1>
            <p class="mt-4 max-w-3xl text-lg text-neutral-300">
              {t(locale, 'productDetail.index.hero.description')}
            </p>
            <div class="mt-6 flex flex-wrap gap-3">
              <a class="rounded-2xl bg-white px-5 py-3 text-sm font-semibold text-ink-900 transition hover:bg-neutral-200" href={getLocalizedPath(locale, '/contact')}>
                {t(locale, 'productDetail.index.hero.getAQuote')}
              </a>
              <a class="rounded-2xl border border-white/30 bg-white/10 px-5 py-3 text-sm font-semibold text-white transition hover:bg-white/20" href={getLocalizedPath(locale, '/catalogue')}>
                {t(locale, 'productDetail.index.hero.compareModels')}
              </a>
            </div>
          </div>

          <div
            class="mx-auto w-full max-w-md sm:max-w-lg lg:mx-0 lg:max-w-none"
            data-carousel
            role="group"
            aria-roledescription="carousel"
            aria-label={t(locale, 'productDetail.index.hero.carousel.region')}
          >
            <div class="relative aspect-[4/5] overflow-hidden rounded-3xl border border-white/10 bg-neutral-950">
              {heroSlides.map((slide, i) => (
                <div data-slide class={`absolute inset-0 transition-opacity duration-500 ${i === 0 ? 'opacity-100' : 'opacity-0'}`} aria-hidden={i === 0 ? 'false' : 'true'}>
                  <img src={slide.src} alt={slide.name} class="h-full w-full object-cover" loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
                </div>
              ))}
              <button data-prev type="button" aria-label={t(locale, 'productDetail.index.hero.carousel.prev')} class="absolute left-3 top-1/2 flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full bg-black/40 text-white backdrop-blur-sm transition hover:bg-black/70">
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6" /></svg>
              </button>
              <button data-next type="button" aria-label={t(locale, 'productDetail.index.hero.carousel.next')} class="absolute right-3 top-1/2 flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full bg-black/40 text-white backdrop-blur-sm transition hover:bg-black/70">
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg>
              </button>
            </div>
            <div class="mt-4 flex items-center justify-center gap-2">
              {heroSlides.map((slide, i) => (
                <button
                  data-dot
                  type="button"
                  aria-label={slide.name}
                  aria-current={i === 0 ? 'true' : 'false'}
                  class={`h-2.5 rounded-full transition-all duration-300 ${i === 0 ? 'w-6 bg-white' : 'w-2.5 bg-white/30 hover:bg-white/50'}`}
                ></button>
              ))}
            </div>
          </div>
        </div>

        <div class="mt-12 border-t border-white/10 pt-8 md:mt-16 md:pt-10">
          <h2 class="text-2xl font-semibold text-white md:text-3xl">{scopeNote.title}</h2>
          <p class="mt-5 max-w-4xl text-base leading-relaxed text-neutral-200 md:text-lg md:leading-relaxed">{scopeNote.intro}</p>
          <p class="mt-4 max-w-4xl text-sm leading-relaxed text-amber-200/90 md:text-base md:leading-relaxed">{scopeNote.criteria}</p>
        </div>

        <ul class="mt-10 grid grid-cols-2 gap-3 md:mt-14 md:grid-cols-3 md:gap-4 xl:grid-cols-6">
          {quickFacts.map((fact) => (
            <li class="rounded-2xl border border-white/10 bg-white/[0.04] p-5 md:p-6">
              <div class="text-lg font-bold tracking-tight text-white md:text-xl">{fact.title}</div>
              <div class="mt-2 text-sm leading-relaxed text-neutral-400">{fact.subtitle}</div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    {/* ═══ 2. Why Sourcing the Right IPL Is Harder Than It Looks ═══ */}
    <section class="mx-auto max-w-6xl px-6">
      <div class="mx-auto max-w-4xl">
        <div class="text-sm font-semibold uppercase tracking-[0.22em] text-violet-700">{t(locale, 'productDetail.index.scqa.sectionKicker')}</div>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-ink-900 md:text-4xl">{t(locale, 'productDetail.index.scqa.sectionTitle')}</h2>
        <div class="mt-2 space-y-0">
          {scqaRows.map((row) => (
            <article class="grid gap-3 border-t border-neutral-200 py-7 first:border-t-0 md:grid-cols-[minmax(0,180px)_1fr] md:gap-10 md:py-9">
              <div class="text-sm font-semibold uppercase tracking-[0.2em] text-slate-500">{row.tag}</div>
              <div>
                <h3 class="text-xl font-semibold text-ink-900 md:text-2xl">{row.title}</h3>
                {row.body && <p class="mt-2 text-neutral-700 md:text-lg md:leading-relaxed">{row.body}</p>}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    {/* ═══ 3. IPL Devices We Manufacture — Three-Axis Core + 12 平台 + 自查双卡 ═══ */}
    <section class="mx-auto max-w-6xl space-y-16 px-6">
      <div class="mx-auto max-w-4xl text-center">
        <div class="text-sm font-semibold uppercase tracking-[0.22em] text-violet-700">{t(locale, 'productDetail.index.threeAxis.kicker')}</div>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-ink-900 md:text-4xl">{t(locale, 'productDetail.index.threeAxis.title')}</h2>
        <p class="mt-5 text-lg leading-relaxed text-neutral-700 md:text-xl md:leading-relaxed">{t(locale, 'productDetail.index.threeAxis.lead')}</p>
      </div>
      <div class="mx-auto grid max-w-5xl gap-6 md:grid-cols-3">
        {threeAxes.map((axis) => (
          <article class="rounded-[1.75rem] border border-neutral-200 bg-white p-7 shadow-sm">
            <div class="text-xs font-bold uppercase tracking-[0.2em] text-violet-700">{axis.axis}</div>
            <h3 class="mt-3 text-xl font-semibold text-ink-900">{axis.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-neutral-700">{axis.body}</p>
          </article>
        ))}
      </div>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {products.map((product) => (
          <a
            class="product-card flex flex-col overflow-hidden rounded-xl border-2 border-black bg-white shadow-sm transition-all hover:shadow-md"
            href={getLocalizedPath(locale, '/products/' + product.slug)}
          >
            <div class="relative bg-neutral-100" style="aspect-ratio:1000/806">
              <picture>
                <source
                  srcset={product.imageSources.avifSrcSet}
                  sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw"
                  type="image/avif"
                />
                <source
                  srcset={product.imageSources.webpSrcSet}
                  sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw"
                  type="image/webp"
                />
                <img
                  class="h-full w-full object-cover"
                  src={product.imageSources.src}
                  srcset={product.imageSources.webpSrcSet}
                  sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw"
                  alt={t(locale, product.nameKey)}
                  loading="lazy"
                  decoding="async"
                  width="1000"
                  height="806"
                />
              </picture>
            </div>
            <div class="flex flex-col justify-end p-3" style="aspect-ratio:1000/194">
              <div>
                <h2 class="text-xl font-semibold text-ink-900">{t(locale, product.nameKey)}</h2>
                <p class="mt-1 text-sm text-neutral-700">{t(locale, product.taglineKey)}</p>
              </div>
            </div>
          </a>
        ))}
      </div>
      <div class="space-y-10">
        <div class="mx-auto max-w-3xl text-center">
          <div class="text-sm font-semibold uppercase tracking-[0.22em] text-violet-700">{t(locale, 'productDetail.index.toolsStrip.kicker')}</div>
          <h2 class="mt-3 text-3xl font-bold text-ink-900 md:text-4xl">{t(locale, 'productDetail.index.toolsStrip.title')}</h2>
        </div>
        <div class="mx-auto grid max-w-5xl gap-6 md:grid-cols-2">
          {tools.map((tool, i) => (
            <article class="flex flex-col rounded-[1.75rem] border border-neutral-200 bg-white p-7 shadow-sm">
              <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-violet-100 text-base font-bold text-sky-700">0{i + 1}</div>
              <h3 class="mt-5 text-2xl font-semibold text-ink-900">{tool.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-neutral-700">{tool.body}</p>
              <div class="mt-auto pt-6">
                <a class="inline-flex items-center gap-2 rounded-2xl bg-ink-900 px-5 py-3 text-sm font-semibold text-white transition hover:bg-neutral-800" href={tool.href}>
                  {tool.cta}
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    {/* ═══ 4. The IPL Specification Atlas — by Channel ═══ */}
    <section class="mx-auto max-w-6xl space-y-12 px-6">
      <div class="mx-auto max-w-4xl">
        <div class="text-sm font-semibold uppercase tracking-[0.22em] text-violet-700">{t(locale, 'productDetail.index.atlas.kicker')}</div>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-ink-900 md:text-4xl">{t(locale, 'productDetail.index.atlas.title')}</h2>
        <p class="mt-5 text-lg leading-relaxed text-neutral-700 md:text-xl md:leading-relaxed">{t(locale, 'productDetail.index.atlas.intro')}</p>
        <p class="mt-5 text-lg font-semibold text-ink-900 md:text-xl">{t(locale, 'productDetail.index.atlas.selectHint')}</p>
      </div>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {byApplicationCards.map((card) => (
          <a class="group flex flex-col overflow-hidden rounded-xl border-2 border-black bg-white shadow-sm transition-all hover:shadow-md" href={card.href}>
            <div class="relative overflow-hidden bg-neutral-100" style="aspect-ratio:1000/806">
              <img class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]" src={card.image} alt={card.name} loading="lazy" decoding="async" />
            </div>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t } from '../../lib/i18n';
import { getLocalizedPath } from '../../lib/breadcrumbs';

const locale = Astro.currentLocale ?? 'en';
const serviceTypes = [
  {
    type: t(locale, 'servicesPage.oemOdm.types.items.0.type'),
    title: t(locale, 'servicesPage.oemOdm.types.items.0.title'),
    description: t(locale, 'servicesPage.oemOdm.types.items.0.description'),
    features: [
      t(locale, 'servicesPage.oemOdm.types.items.0.features.0'),
      t(locale, 'servicesPage.oemOdm.types.items.0.features.1'),
      t(locale, 'servicesPage.oemOdm.types.items.0.features.2'),
      t(locale, 'servicesPage.oemOdm.types.items.0.features.3'),
    ],
    gradient: 'from-purple-500 to-pink-500',
  },
  {
    type: t(locale, 'servicesPage.oemOdm.types.items.1.type'),
    title: t(locale, 'servicesPage.oemOdm.types.items.1.title'),
    description: t(locale, 'servicesPage.oemOdm.types.items.1.description'),
    features: [
      t(locale, 'servicesPage.oemOdm.types.items.1.features.0'),
      t(locale, 'servicesPage.oemOdm.types.items.1.features.1'),
      t(locale, 'servicesPage.oemOdm.types.items.1.features.2'),
      t(locale, 'servicesPage.oemOdm.types.items.1.features.3'),
    ],
    gradient: 'from-sky-500 to-cyan-500',
  },
];

const capabilities = [
  {
    title: t(locale, 'servicesPage.oemOdm.capabilities.items.0.title'),
    description: t(locale, 'servicesPage.oemOdm.capabilities.items.0.description'),
    details: [
      t(locale, 'servicesPage.oemOdm.capabilities.items.0.details.0'),
      t(locale, 'servicesPage.oemOdm.capabilities.items.0.details.1'),
      t(locale, 'servicesPage.oemOdm.capabilities.items.0.details.2'),
      t(locale, 'servicesPage.oemOdm.capabilities.items.0.details.3'),
    ],
  },
  {
    title: t(locale, 'servicesPage.oemOdm.capabilities.items.1.title'),
    description: t(locale, 'servicesPage.oemOdm.capabilities.items.1.description'),
    details: [
      t(locale, 'servicesPage.oemOdm.capabilities.items.1.details.0'),
      t(locale, 'servicesPage.oemOdm.capabilities.items.1.details.1'),
      t(locale, 'servicesPage.oemOdm.capabilities.items.1.details.2'),
      t(locale, 'servicesPage.oemOdm.capabilities.items.1.details.3'),
    ],
  },
  {
    title: t(locale, 'servicesPage.oemOdm.capabilities.items.2.title'),
    description: t(locale, 'servicesPage.oemOdm.capabilities.items.2.description'),
    details: [
      t(locale, 'servicesPage.oemOdm.capabilities.items.2.details.0'),
      t(locale, 'servicesPage.oemOdm.capabilities.items.2.details.1'),
      t(locale, 'servicesPage.oemOdm.capabilities.items.2.details.2'),
      t(locale, 'servicesPage.oemOdm.capabilities.items.2.details.3'),
    ],
  },
  {
    title: t(locale, 'servicesPage.oemOdm.capabilities.items.3.title'),
    description: t(locale, 'servicesPage.oemOdm.capabilities.items.3.description'),
    details: [
      t(locale, 'servicesPage.oemOdm.capabilities.items.3.details.0'),
      t(locale, 'servicesPage.oemOdm.capabilities.items.3.details.1'),
      t(locale, 'servicesPage.oemOdm.capabilities.items.3.details.2'),
      t(locale, 'servicesPage.oemOdm.capabilities.items.3.details.3'),
    ],
  },
];

const processSteps = [
  {
    step: t(locale, 'servicesPage.oemOdm.process.items.0.step'),
    title: t(locale, 'servicesPage.oemOdm.process.items.0.title'),
    description: t(locale, 'servicesPage.oemOdm.process.items.0.description'),
    duration: t(locale, 'servicesPage.oemOdm.process.items.0.duration'),
    deliverables: [
      t(locale, 'servicesPage.oemOdm.process.items.0.deliverables.0'),
      t(locale, 'servicesPage.oemOdm.process.items.0.deliverables.1'),
      t(locale, 'servicesPage.oemOdm.process.items.0.deliverables.2'),
    ],
  },
  {
    step: t(locale, 'servicesPage.oemOdm.process.items.1.step'),
    title: t(locale, 'servicesPage.oemOdm.process.items.1.title'),
    description: t(locale, 'servicesPage.oemOdm.process.items.1.description'),
    duration: t(locale, 'servicesPage.oemOdm.process.items.1.duration'),
    deliverables: [
      t(locale, 'servicesPage.oemOdm.process.items.1.deliverables.0'),
      t(locale, 'servicesPage.oemOdm.process.items.1.deliverables.1'),
      t(locale, 'servicesPage.oemOdm.process.items.1.deliverables.2'),
    ],
  },
  {
    step: t(locale, 'servicesPage.oemOdm.process.items.2.step'),
    title: t(locale, 'servicesPage.oemOdm.process.items.2.title'),
    description: t(locale, 'servicesPage.oemOdm.process.items.2.description'),
    duration: t(locale, 'servicesPage.oemOdm.process.items.2.duration'),
    deliverables: [
      t(locale, 'servicesPage.oemOdm.process.items.2.deliverables.0'),
      t(locale, 'servicesPage.oemOdm.process.items.2.deliverables.1'),
      t(locale, 'servicesPage.oemOdm.process.items.2.deliverables.2'),
    ],
  },
  {
    step: t(locale, 'servicesPage.oemOdm.process.items.3.step'),
    title: t(locale, 'servicesPage.oemOdm.process.items.3.title'),
    description: t(locale, 'servicesPage.oemOdm.process.items.3.description'),
    duration: t(locale, 'servicesPage.oemOdm.process.items.3.duration'),
    deliverables: [
      t(locale, 'servicesPage.oemOdm.process.items.3.deliverables.0'),
      t(locale, 'servicesPage.oemOdm.process.items.3.deliverables.1'),
      t(locale, 'servicesPage.oemOdm.process.items.3.deliverables.2'),
    ],
  },
];

const successMetrics = [
  {
    metric: t(locale, 'servicesPage.oemOdm.metrics.items.0.metric'),
    label: t(locale, 'servicesPage.oemOdm.metrics.items.0.label'),
  },
  {
    metric: t(locale, 'servicesPage.oemOdm.metrics.items.1.metric'),
    label: t(locale, 'servicesPage.oemOdm.metrics.items.1.label'),
  },
  {
    metric: t(locale, 'servicesPage.oemOdm.metrics.items.2.metric'),
    label: t(locale, 'servicesPage.oemOdm.metrics.items.2.label'),
  },
];

const partnerBenefits = [
  {
    title: t(locale, 'servicesPage.oemOdm.benefits.items.0.title'),
    description: t(locale, 'servicesPage.oemOdm.benefits.items.0.description'),
  },
  {
    title: t(locale, 'servicesPage.oemOdm.benefits.items.1.title'),
    description: t(locale, 'servicesPage.oemOdm.benefits.items.1.description'),
  },
  {
    title: t(locale, 'servicesPage.oemOdm.benefits.items.2.title'),
    description: t(locale, 'servicesPage.oemOdm.benefits.items.2.description'),
  },
  {
    title: t(locale, 'servicesPage.oemOdm.benefits.items.3.title'),
    description: t(locale, 'servicesPage.oemOdm.benefits.items.3.description'),
  },
];
---

<BaseLayout title={t(locale, 'servicesPage.oemOdm.meta.title')} lang={locale} description={t(locale, 'servicesPage.oemOdm.meta.description')}>
  <div class="space-y-60">
    <section class="rounded-2xl bg-gradient-to-br from-purple-50 to-pink-50 px-8 py-16">
      <div class="mx-auto max-w-4xl text-center">
        <h1 class="text-4xl font-bold text-slate-900 md:text-6xl">
          {t(locale, 'servicesPage.oemOdm.hero.title1')}
          <span class="block bg-gradient-to-r from-purple-600 to-pink-600 bg-clip-text text-transparent">{t(locale, 'servicesPage.oemOdm.hero.title2')}</span>
        </h1>
        <p class="mx-auto mt-6 max-w-3xl text-xl leading-relaxed text-slate-700">
          {t(locale, 'servicesPage.oemOdm.hero.description')}
        </p>
        <div class="mt-10 flex justify-center">
          <a class="rounded bg-purple-600 px-6 py-3 text-sm font-medium text-white hover:bg-purple-700" href={getLocalizedPath(locale, '/contact')}>{t(locale, 'servicesPage.oemOdm.hero.cta')}</a>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-6">
      <h2 class="text-sm font-semibold uppercase tracking-[0.22em] text-slate-600">{t(locale, 'common.citableSummary')}</h2>
      <h3 class="mt-2 text-2xl font-bold text-slate-900">{t(locale, 'servicesPage.oemOdm.citable.heading')}</h3>
      <p class="mt-4 max-w-4xl text-lg leading-relaxed text-slate-700">
        {t(locale, 'servicesPage.oemOdm.citable.body')}
      </p>
    </section>

    <section class="space-y-10">
      <div class="text-center">
        <h2 class="text-3xl font-bold text-slate-900 md:text-4xl">{t(locale, 'servicesPage.oemOdm.types.heading')}</h2>
        <p class="mx-auto mt-4 max-w-2xl text-lg text-slate-700">
          {t(locale, 'servicesPage.oemOdm.types.sub')}
        </p>
      </div>
      <div class="grid gap-8 md:grid-cols-2">
        {serviceTypes.map((s) => (
          <div class="rounded-2xl border border-slate-200 bg-white p-8 shadow-lg transition-shadow hover:shadow-xl">
            <div class={`mb-6 flex h-20 w-20 items-center justify-center rounded-2xl bg-gradient-to-r ${s.gradient}`}>
              <span class="text-2xl font-bold text-white">{s.type}</span>
            </div>
            <h3 class="text-2xl font-bold text-slate-900">{s.title}</h3>
            <p class="mt-4 text-slate-700">{s.description}</p>
            <div class="mt-6 space-y-3">
              {s.features.map((f) => (
                <div class="flex items-center gap-3 text-slate-700">
                  <span class="h-2 w-2 rounded-2xl bg-emerald-500" />
                  <span>{f}</span>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="rounded-2xl bg-slate-50 px-8 py-16">
      <div class="text-center">
        <h2 class="text-3xl font-bold text-slate-900 md:text-4xl">{t(locale, 'servicesPage.oemOdm.capabilities.heading')}</h2>
        <p class="mx-auto mt-4 max-w-2xl text-lg text-slate-700">
          {t(locale, 'servicesPage.oemOdm.capabilities.sub')}
        </p>
      </div>
      <div class="mt-12 grid gap-8 md:grid-cols-2">
        {capabilities.map((c) => (
          <div class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm">
            <h3 class="text-xl font-bold text-slate-900">{c.title}</h3>
            <p class="mt-3 text-slate-700">{c.description}</p>
            <div class="mt-6 grid grid-cols-2 gap-2">
              {c.details.map((d) => (
                <div class="flex items-center gap-2 text-sm text-slate-700">
                  <span class="h-2 w-2 rounded-2xl bg-purple-400" />
                  <span>{d}</span>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="space-y-10">
      <div class="text-center">
        <h2 class="text-3xl font-bold text-slate-900 md:text-4xl">{t(locale, 'servicesPage.oemOdm.process.heading')}</h2>
        <p class="mx-auto mt-4 max-w-2xl text-lg text-slate-700">
          {t(locale, 'servicesPage.oemOdm.process.sub')}
        </p>
      </div>
      <div class="space-y-6">
        {processSteps.map((step) => (
          <div class="rounded-2xl border border-slate-200 bg-white p-8 shadow-lg">
            <div class="grid gap-6 lg:grid-cols-[240px_1fr] lg:items-start">
              <div class="flex items-center gap-6">
                <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-gradient-to-r from-purple-600 to-pink-600">
                  <span class="text-xl font-bold text-white">{step.step}</span>
                </div>
                <div>
                  <div class="text-xl font-bold text-slate-900">{step.title}</div>
                  <div class="mt-1 font-medium text-purple-600">{step.duration}</div>
                </div>
              </div>
              <div>
                <p class="text-slate-700">{step.description}</p>
                <div class="mt-4 flex flex-wrap gap-2">
                  {step.deliverables.map((d) => (
                    <span class="rounded bg-slate-100 px-3 py-1 text-xs text-slate-700">{d}</span>
                  ))}
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="rounded-2xl bg-gradient-to-br from-purple-50 to-pink-50 px-8 py-16">
      <div class="text-center">
        <h2 class="text-3xl font-bold text-slate-900 md:text-4xl">{t(locale, 'servicesPage.oemOdm.metrics.heading')}</h2>
        <p class="mx-auto mt-4 max-w-2xl text-lg text-slate-700">
          {t(locale, 'servicesPage.oemOdm.metrics.sub')}
        </p>
      </div>
      <div class="mt-12 grid gap-8 md:grid-cols-3">
        {successMetrics.map((m) => (
          <div class="rounded-2xl border border-slate-200 bg-white p-8 text-center shadow-lg">
            <div class="text-4xl font-bold text-purple-600">{m.metric}</div>
            <div class="mt-2 font-medium text-slate-700">{m.label}</div>
          </div>
        ))}
      </div>
    </section>

    <section class="space-y-10">
      <div class="text-center">
        <h2 class="text-3xl font-bold text-slate-900 md:text-4xl">{t(locale, 'servicesPage.oemOdm.benefits.heading')}</h2>
        <p class="mx-auto mt-4 max-w-2xl text-lg text-slate-700">
          {t(locale, 'servicesPage.oemOdm.benefits.sub')}
        </p>
      </div>
      <div class="grid gap-8 md:grid-cols-2">
        {partnerBenefits.map((b) => (
          <div class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm">
            <h3 class="text-xl font-bold text-slate-900">{b.title}</h3>
            <p class="mt-3 text-slate-700">{b.description}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="rounded-2xl bg-slate-900 px-8 py-16 text-white">
      <div class="mx-auto max-w-3xl text-center">
        <h2 class="text-3xl font-bold md:text-4xl">{t(locale, 'servicesPage.oemOdm.cta.title')}</h2>
        <p class="mx-auto mt-4 max-w-2xl text-xl text-slate-200">
          {t(locale, 'servicesPage.oemOdm.cta.description')}
        </p>
        <div class="mt-10 flex justify-center gap-3">
          <a class="rounded bg-purple-600 px-6 py-3 text-sm font-medium text-white hover:bg-purple-700" href={getLocalizedPath(locale, '/contact')}>{t(locale, 'servicesPage.oemOdm.cta.start')}</a>
          <a class="rounded border border-white/30 px-6 py-3 text-sm font-medium text-white" href={getLocalizedPath(locale, '/services')}>{t(locale, 'servicesPage.oemOdm.cta.back')}</a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

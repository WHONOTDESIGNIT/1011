---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLocalizedPath } from '../../lib/breadcrumbs';
import { t } from '../../lib/i18n';

const locale = Astro.currentLocale ?? 'en';
const manualModules = [
  {
    title: t(locale, 'servicesPage.userManualGuideCustom.modules.items.0.title'),
    description: t(locale, 'servicesPage.userManualGuideCustom.modules.items.0.description'),
    features: [t(locale, 'servicesPage.userManualGuideCustom.modules.items.0.features.0'), t(locale, 'servicesPage.userManualGuideCustom.modules.items.0.features.1'), t(locale, 'servicesPage.userManualGuideCustom.modules.items.0.features.2'), t(locale, 'servicesPage.userManualGuideCustom.modules.items.0.features.3')],
  },
  {
    title: t(locale, 'servicesPage.userManualGuideCustom.modules.items.1.title'),
    description: t(locale, 'servicesPage.userManualGuideCustom.modules.items.1.description'),
    features: [t(locale, 'servicesPage.userManualGuideCustom.modules.items.1.features.0'), t(locale, 'servicesPage.userManualGuideCustom.modules.items.1.features.1'), t(locale, 'servicesPage.userManualGuideCustom.modules.items.1.features.2'), t(locale, 'servicesPage.userManualGuideCustom.modules.items.1.features.3')],
  },
  {
    title: t(locale, 'servicesPage.userManualGuideCustom.modules.items.2.title'),
    description: t(locale, 'servicesPage.userManualGuideCustom.modules.items.2.description'),
    features: [t(locale, 'servicesPage.userManualGuideCustom.modules.items.2.features.0'), t(locale, 'servicesPage.userManualGuideCustom.modules.items.2.features.1'), t(locale, 'servicesPage.userManualGuideCustom.modules.items.2.features.2'), t(locale, 'servicesPage.userManualGuideCustom.modules.items.2.features.3')],
  },
];
---

<BaseLayout title={t(locale, 'servicesPage.userManualGuideCustom.meta.title')} lang={locale} description={t(locale, 'servicesPage.userManualGuideCustom.meta.description')}>
  <div class="space-y-60">
    <section class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-slate-50 via-white to-violet-50 px-8 py-12 shadow-sm md:px-10 lg:px-12 lg:py-16">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,_rgba(168,85,247,0.12),_transparent_25%),radial-gradient(circle_at_bottom_left,_rgba(15,23,42,0.12),_transparent_32%)]" />
      <div class="relative mx-auto max-w-5xl">
        <h1 class="text-4xl font-bold text-slate-900 md:text-6xl">
          {t(locale, 'servicesPage.userManualGuideCustom.hero.title1')}
          <span class="block bg-gradient-to-r from-violet-700 to-slate-900 bg-clip-text text-transparent">{t(locale, 'servicesPage.userManualGuideCustom.hero.title2')}</span>
        </h1>
        <p class="mt-6 max-w-3xl text-xl leading-relaxed text-slate-700">
          {t(locale, 'servicesPage.userManualGuideCustom.hero.description')}
        </p>
        <div class="mt-10 flex flex-wrap gap-3">
          <a class="rounded-2xl bg-slate-900 px-6 py-3 text-sm font-semibold text-white transition hover:bg-slate-800" href={getLocalizedPath(locale, '/contact')}>
            {t(locale, 'servicesPage.userManualGuideCustom.hero.cta1')}
          </a>
          <a class="rounded-2xl border border-slate-300 bg-white px-6 py-3 text-sm font-semibold text-slate-900 transition hover:border-slate-400 hover:bg-slate-50" href={getLocalizedPath(locale, '/services')}>
            {t(locale, 'servicesPage.userManualGuideCustom.hero.cta2')}
          </a>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-6">
      <h2 class="text-sm font-semibold uppercase tracking-[0.22em] text-slate-600">{t(locale, 'common.citableSummary')}</h2>
      <h3 class="mt-2 text-2xl font-bold text-slate-900">{t(locale, 'servicesPage.userManualGuideCustom.citable.heading')}</h3>
      <p class="mt-4 max-w-4xl text-lg leading-relaxed text-slate-700">
        {t(locale, 'servicesPage.userManualGuideCustom.citable.body')}
      </p>
    </section>

    <section class="space-y-10">
      <div class="mx-auto max-w-3xl text-center">
        <div class="text-sm font-semibold uppercase tracking-[0.22em] text-violet-700">{t(locale, 'servicesPage.userManualGuideCustom.modules.eyebrow')}</div>
        <h2 class="mt-3 text-3xl font-bold text-slate-900 md:text-4xl">{t(locale, 'servicesPage.userManualGuideCustom.modules.heading')}</h2>
        <p class="mt-4 text-lg text-slate-700">{t(locale, 'servicesPage.userManualGuideCustom.modules.sub')}</p>
      </div>
      <div class="mx-auto grid max-w-6xl gap-6 md:grid-cols-3">
        {manualModules.map((card) => (
          <article class="rounded-[1.75rem] border border-slate-200 bg-white p-7 shadow-sm">
            <h3 class="text-xl font-semibold text-slate-900">{card.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-slate-700">{card.description}</p>
            <ul class="mt-6 space-y-3 text-sm text-slate-700">
              {card.features.map((item) => (
                <li class="flex items-start gap-3">
                  <span class="mt-2 h-2.5 w-2.5 flex-shrink-0 rounded-2xl bg-violet-500" />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

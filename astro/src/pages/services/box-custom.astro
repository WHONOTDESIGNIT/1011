---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLocalizedPath } from '../../lib/breadcrumbs';
import { t } from '../../lib/i18n';

const locale = Astro.currentLocale ?? 'en';
const packagingAreas = [
  {
    title: t(locale, 'servicesPage.boxCustom.scope.items.0.title'),
    description: t(locale, 'servicesPage.boxCustom.scope.items.0.description'),
    points: [t(locale, 'servicesPage.boxCustom.scope.items.0.points.0'), t(locale, 'servicesPage.boxCustom.scope.items.0.points.1'), t(locale, 'servicesPage.boxCustom.scope.items.0.points.2'), t(locale, 'servicesPage.boxCustom.scope.items.0.points.3')],
  },
  {
    title: t(locale, 'servicesPage.boxCustom.scope.items.1.title'),
    description: t(locale, 'servicesPage.boxCustom.scope.items.1.description'),
    points: [t(locale, 'servicesPage.boxCustom.scope.items.1.points.0'), t(locale, 'servicesPage.boxCustom.scope.items.1.points.1'), t(locale, 'servicesPage.boxCustom.scope.items.1.points.2'), t(locale, 'servicesPage.boxCustom.scope.items.1.points.3')],
  },
  {
    title: t(locale, 'servicesPage.boxCustom.scope.items.2.title'),
    description: t(locale, 'servicesPage.boxCustom.scope.items.2.description'),
    points: [t(locale, 'servicesPage.boxCustom.scope.items.2.points.0'), t(locale, 'servicesPage.boxCustom.scope.items.2.points.1'), t(locale, 'servicesPage.boxCustom.scope.items.2.points.2'), t(locale, 'servicesPage.boxCustom.scope.items.2.points.3')],
  },
];
---

<BaseLayout title={t(locale, 'servicesPage.boxCustom.meta.title')} lang={locale} description={t(locale, 'servicesPage.boxCustom.meta.description')}>
  <div class="space-y-60">
    <section class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-neutral-50 via-white to-neutral-100 px-8 py-12 shadow-sm md:px-10 lg:px-12 lg:py-16">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,_rgba(15,23,42,0.10),_transparent_28%),radial-gradient(circle_at_bottom_left,_rgba(56,189,248,0.10),_transparent_34%)]" />
      <div class="relative mx-auto max-w-5xl">
        <h1 class="text-4xl font-bold text-ink-900 md:text-6xl">
          {t(locale, 'servicesPage.boxCustom.hero.title1')}
          <span class="block bg-gradient-to-r from-ink-900 to-sky-600 bg-clip-text text-transparent">{t(locale, 'servicesPage.boxCustom.hero.title2')}</span>
        </h1>
        <p class="mt-6 max-w-3xl text-xl leading-relaxed text-neutral-700">
          {t(locale, 'servicesPage.boxCustom.hero.description')}
        </p>
        <div class="mt-10 flex flex-wrap gap-3">
          <a class="rounded-2xl bg-ink-900 px-6 py-3 text-sm font-semibold text-white transition hover:bg-neutral-800" href={getLocalizedPath(locale, '/contact')}>
            {t(locale, 'servicesPage.boxCustom.hero.cta1')}
          </a>
          <a class="rounded-2xl border border-neutral-300 bg-white px-6 py-3 text-sm font-semibold text-ink-900 transition hover:border-neutral-400 hover:bg-neutral-50" href={getLocalizedPath(locale, '/services')}>
            {t(locale, 'servicesPage.boxCustom.hero.cta2')}
          </a>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-6">
      <h2 class="text-sm font-semibold uppercase tracking-[0.22em] text-neutral-600">{t(locale, 'common.citableSummary')}</h2>
      <h3 class="mt-2 text-2xl font-bold text-ink-900">{t(locale, 'servicesPage.boxCustom.citable.heading')}</h3>
      <p class="mt-4 max-w-4xl text-lg leading-relaxed text-neutral-700">
        {t(locale, 'servicesPage.boxCustom.citable.body')}
      </p>
    </section>

    <section class="space-y-10">
      <div class="mx-auto max-w-3xl text-center">
        <div class="text-sm font-semibold uppercase tracking-[0.22em] text-violet-700">{t(locale, 'servicesPage.boxCustom.scope.eyebrow')}</div>
        <h2 class="mt-3 text-3xl font-bold text-ink-900 md:text-4xl">{t(locale, 'servicesPage.boxCustom.scope.heading')}</h2>
        <p class="mt-4 text-lg text-neutral-700">{t(locale, 'servicesPage.boxCustom.scope.sub')}</p>
      </div>
      <div class="mx-auto grid max-w-6xl gap-6 md:grid-cols-3">
        {packagingAreas.map((card) => (
          <article class="rounded-[1.75rem] border border-neutral-200 bg-white p-7 shadow-sm">
            <h3 class="text-xl font-semibold text-ink-900">{card.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-neutral-700">{card.description}</p>
            <ul class="mt-6 space-y-3 text-sm text-neutral-700">
              {card.points.map((item) => (
                <li class="flex items-start gap-3">
                  <span class="mt-2 h-2.5 w-2.5 flex-shrink-0 rounded-2xl bg-violet-500" />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

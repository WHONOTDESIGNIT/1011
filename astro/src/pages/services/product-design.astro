---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t } from '../../lib/i18n';
import { getLocalizedPath } from '../../lib/breadcrumbs';
import { responsiveImageSources } from '../../lib/netlify-images';

const locale = Astro.currentLocale ?? 'en';
const designServices = [
  {
    title: t(locale, 'servicesPage.productDesign.services.items.0.title'),
    description: t(locale, 'servicesPage.productDesign.services.items.0.description'),
    features: [
      t(locale, 'servicesPage.productDesign.services.items.0.features.0'),
      t(locale, 'servicesPage.productDesign.services.items.0.features.1'),
      t(locale, 'servicesPage.productDesign.services.items.0.features.2'),
      t(locale, 'servicesPage.productDesign.services.items.0.features.3'),
    ],
    gradient: 'from-purple-500 to-pink-500',
  },
  {
    title: t(locale, 'servicesPage.productDesign.services.items.1.title'),
    description: t(locale, 'servicesPage.productDesign.services.items.1.description'),
    features: [
      t(locale, 'servicesPage.productDesign.services.items.1.features.0'),
      t(locale, 'servicesPage.productDesign.services.items.1.features.1'),
      t(locale, 'servicesPage.productDesign.services.items.1.features.2'),
      t(locale, 'servicesPage.productDesign.services.items.1.features.3'),
    ],
    gradient: 'from-sky-500 to-cyan-500',
  },
  {
    title: t(locale, 'servicesPage.productDesign.services.items.2.title'),
    description: t(locale, 'servicesPage.productDesign.services.items.2.description'),
    features: [
      t(locale, 'servicesPage.productDesign.services.items.2.features.0'),
      t(locale, 'servicesPage.productDesign.services.items.2.features.1'),
      t(locale, 'servicesPage.productDesign.services.items.2.features.2'),
      t(locale, 'servicesPage.productDesign.services.items.2.features.3'),
    ],
    gradient: 'from-emerald-500 to-green-500',
  },
  {
    title: t(locale, 'servicesPage.productDesign.services.items.3.title'),
    description: t(locale, 'servicesPage.productDesign.services.items.3.description'),
    features: [
      t(locale, 'servicesPage.productDesign.services.items.3.features.0'),
      t(locale, 'servicesPage.productDesign.services.items.3.features.1'),
      t(locale, 'servicesPage.productDesign.services.items.3.features.2'),
      t(locale, 'servicesPage.productDesign.services.items.3.features.3'),
    ],
    gradient: 'from-violet-600 to-fuchsia-600',
  },
];

const designProcess = [
  {
    phase: t(locale, 'servicesPage.productDesign.process.items.0.phase'),
    title: t(locale, 'servicesPage.productDesign.process.items.0.title'),
    description: t(locale, 'servicesPage.productDesign.process.items.0.description'),
    activities: [
      t(locale, 'servicesPage.productDesign.process.items.0.activities.0'),
      t(locale, 'servicesPage.productDesign.process.items.0.activities.1'),
      t(locale, 'servicesPage.productDesign.process.items.0.activities.2'),
      t(locale, 'servicesPage.productDesign.process.items.0.activities.3'),
    ],
    duration: t(locale, 'servicesPage.productDesign.process.items.0.duration'),
  },
  {
    phase: t(locale, 'servicesPage.productDesign.process.items.1.phase'),
    title: t(locale, 'servicesPage.productDesign.process.items.1.title'),
    description: t(locale, 'servicesPage.productDesign.process.items.1.description'),
    activities: [
      t(locale, 'servicesPage.productDesign.process.items.1.activities.0'),
      t(locale, 'servicesPage.productDesign.process.items.1.activities.1'),
      t(locale, 'servicesPage.productDesign.process.items.1.activities.2'),
      t(locale, 'servicesPage.productDesign.process.items.1.activities.3'),
    ],
    duration: t(locale, 'servicesPage.productDesign.process.items.1.duration'),
  },
  {
    phase: t(locale, 'servicesPage.productDesign.process.items.2.phase'),
    title: t(locale, 'servicesPage.productDesign.process.items.2.title'),
    description: t(locale, 'servicesPage.productDesign.process.items.2.description'),
    activities: [
      t(locale, 'servicesPage.productDesign.process.items.2.activities.0'),
      t(locale, 'servicesPage.productDesign.process.items.2.activities.1'),
      t(locale, 'servicesPage.productDesign.process.items.2.activities.2'),
      t(locale, 'servicesPage.productDesign.process.items.2.activities.3'),
    ],
    duration: t(locale, 'servicesPage.productDesign.process.items.2.duration'),
  },
  {
    phase: t(locale, 'servicesPage.productDesign.process.items.3.phase'),
    title: t(locale, 'servicesPage.productDesign.process.items.3.title'),
    description: t(locale, 'servicesPage.productDesign.process.items.3.description'),
    activities: [
      t(locale, 'servicesPage.productDesign.process.items.3.activities.0'),
      t(locale, 'servicesPage.productDesign.process.items.3.activities.1'),
      t(locale, 'servicesPage.productDesign.process.items.3.activities.2'),
      t(locale, 'servicesPage.productDesign.process.items.3.activities.3'),
    ],
    duration: t(locale, 'servicesPage.productDesign.process.items.3.duration'),
  },
];

const designPrinciples = [
  {
    title: t(locale, 'servicesPage.productDesign.principles.items.0.title'),
    description: t(locale, 'servicesPage.productDesign.principles.items.0.description'),
    examples: [
      t(locale, 'servicesPage.productDesign.principles.items.0.examples.0'),
      t(locale, 'servicesPage.productDesign.principles.items.0.examples.1'),
      t(locale, 'servicesPage.productDesign.principles.items.0.examples.2'),
    ],
  },
  {
    title: t(locale, 'servicesPage.productDesign.principles.items.1.title'),
    description: t(locale, 'servicesPage.productDesign.principles.items.1.description'),
    examples: [
      t(locale, 'servicesPage.productDesign.principles.items.1.examples.0'),
      t(locale, 'servicesPage.productDesign.principles.items.1.examples.1'),
      t(locale, 'servicesPage.productDesign.principles.items.1.examples.2'),
    ],
  },
  {
    title: t(locale, 'servicesPage.productDesign.principles.items.2.title'),
    description: t(locale, 'servicesPage.productDesign.principles.items.2.description'),
    examples: [
      t(locale, 'servicesPage.productDesign.principles.items.2.examples.0'),
      t(locale, 'servicesPage.productDesign.principles.items.2.examples.1'),
      t(locale, 'servicesPage.productDesign.principles.items.2.examples.2'),
    ],
  },
];

const caseStudies = [
  {
    title: t(locale, 'servicesPage.productDesign.caseStudies.items.0.title'),
    challenge: t(locale, 'servicesPage.productDesign.caseStudies.items.0.challenge'),
    solution: t(locale, 'servicesPage.productDesign.caseStudies.items.0.solution'),
    results: [
      t(locale, 'servicesPage.productDesign.caseStudies.items.0.results.0'),
      t(locale, 'servicesPage.productDesign.caseStudies.items.0.results.1'),
      t(locale, 'servicesPage.productDesign.caseStudies.items.0.results.2'),
    ],
    image:
      '/images/products/Venus/using-venus-sapphire-ipl.webp',
  },
  {
    title: t(locale, 'servicesPage.productDesign.caseStudies.items.1.title'),
    challenge: t(locale, 'servicesPage.productDesign.caseStudies.items.1.challenge'),
    solution: t(locale, 'servicesPage.productDesign.caseStudies.items.1.solution'),
    results: [
      t(locale, 'servicesPage.productDesign.caseStudies.items.1.results.0'),
      t(locale, 'servicesPage.productDesign.caseStudies.items.1.results.1'),
      t(locale, 'servicesPage.productDesign.caseStudies.items.1.results.2'),
    ],
    image:
      '/images/products/Eirene/battery-built-in%20ipl%20device%20holding.jpg',
  },
].map((item) => ({
  ...item,
  imageSources: responsiveImageSources(item.image),
}));
---

<BaseLayout title={t(locale, 'servicesPage.productDesign.meta.title')} lang={locale} description={t(locale, 'servicesPage.productDesign.meta.description')}>
  <div class="space-y-60">
    <section class="rounded-2xl bg-gradient-to-br from-sky-50 to-cyan-50 px-8 py-16">
      <div class="mx-auto max-w-4xl text-center">
        <h1 class="text-4xl font-bold text-slate-900 md:text-6xl">
          {t(locale, 'servicesPage.productDesign.hero.title1')}
          <span class="block bg-gradient-to-r from-sky-600 to-cyan-600 bg-clip-text text-transparent">{t(locale, 'servicesPage.productDesign.hero.title2')}</span>
        </h1>
        <p class="mx-auto mt-6 max-w-3xl text-xl leading-relaxed text-slate-700">
          {t(locale, 'servicesPage.productDesign.hero.description')}
        </p>
        <div class="mt-10 flex justify-center">
          <a class="rounded bg-sky-600 px-6 py-3 text-sm font-medium text-white hover:bg-sky-700" href={getLocalizedPath(locale, '/contact')}>{t(locale, 'servicesPage.productDesign.hero.cta')}</a>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-6">
      <h2 class="text-sm font-semibold uppercase tracking-[0.22em] text-slate-600">{t(locale, 'common.citableSummary')}</h2>
      <h3 class="mt-2 text-2xl font-bold text-slate-900">{t(locale, 'servicesPage.productDesign.citable.heading')}</h3>
      <p class="mt-4 max-w-4xl text-lg leading-relaxed text-slate-700">
        {t(locale, 'servicesPage.productDesign.citable.body')}
      </p>
    </section>

    <section class="space-y-10">
      <div class="text-center">
        <h2 class="text-3xl font-bold text-slate-900 md:text-4xl">{t(locale, 'servicesPage.productDesign.services.heading')}</h2>
        <p class="mx-auto mt-4 max-w-2xl text-lg text-slate-700">
          {t(locale, 'servicesPage.productDesign.services.sub')}
        </p>
      </div>
      <div class="grid gap-8 md:grid-cols-2">
        {designServices.map((service) => (
          <div class="rounded-2xl border border-slate-200 bg-white p-8 shadow-lg transition-all hover:-translate-y-1 hover:shadow-xl">
            <div class={`mb-6 h-16 w-16 rounded-2xl bg-gradient-to-r ${service.gradient}`} />
            <h3 class="text-2xl font-bold text-slate-900">{service.title}</h3>
            <p class="mt-4 text-slate-700">{service.description}</p>
            <div class="mt-6 grid grid-cols-2 gap-3">
              {service.features.map((f) => (
                <div class="flex items-center gap-2 text-sm text-slate-700">
                  <span class="h-2 w-2 rounded-2xl bg-emerald-500" />
                  <span>{f}</span>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="rounded-2xl bg-slate-50 px-8 py-16">
      <div class="text-center">
        <h2 class="text-3xl font-bold text-slate-900 md:text-4xl">{t(locale, 'servicesPage.productDesign.process.heading')}</h2>
        <p class="mx-auto mt-4 max-w-2xl text-lg text-slate-700">
          {t(locale, 'servicesPage.productDesign.process.sub')}
        </p>
      </div>
      <div class="mt-12 space-y-6">
        {designProcess.map((p, idx) => (
          <div class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm">
            <div class="grid gap-6 lg:grid-cols-[240px_1fr]">
              <div class="flex items-center gap-6">
                <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-gradient-to-r from-sky-600 to-cyan-600">
                  <span class="text-xl font-bold text-white">{String(idx + 1).padStart(2, '0')}</span>
                </div>
                <div>
                  <div class="text-sm font-semibold text-sky-700">{p.phase}</div>
                  <div class="text-xl font-bold text-slate-900">{p.title}</div>
                  <div class="mt-1 text-sm font-medium text-slate-600">{p.duration}</div>
                </div>
              </div>
              <div>
                <p class="text-slate-700">{p.description}</p>
                <div class="mt-4 grid grid-cols-2 gap-2">
                  {p.activities.map((a) => (
                    <div class="flex items-center gap-2 text-sm text-slate-700">
                      <span class="h-2 w-2 rounded-2xl bg-sky-400" />
                      <span>{a}</span>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="space-y-10">
      <div class="text-center">
        <h2 class="text-3xl font-bold text-slate-900 md:text-4xl">{t(locale, 'servicesPage.productDesign.principles.heading')}</h2>
        <p class="mx-auto mt-4 max-w-2xl text-lg text-slate-700">
          {t(locale, 'servicesPage.productDesign.principles.sub')}
        </p>
      </div>
      <div class="grid gap-8 lg:grid-cols-3">
        {designPrinciples.map((p) => (
          <div class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm">
            <h3 class="text-xl font-bold text-slate-900">{p.title}</h3>
            <p class="mt-3 text-slate-700">{p.description}</p>
            <ul class="mt-5 space-y-2 text-sm text-slate-700">
              {p.examples.map((e) => (
                <li class="flex items-start gap-3">
                  <span class="mt-2 h-2 w-2 flex-shrink-0 rounded-2xl bg-sky-600" />
                  <span>{e}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <section class="space-y-10">
      <div class="text-center">
        <h2 class="text-3xl font-bold text-slate-900 md:text-4xl">{t(locale, 'servicesPage.productDesign.caseStudies.heading')}</h2>
        <p class="mx-auto mt-4 max-w-2xl text-lg text-slate-700">
          {t(locale, 'servicesPage.productDesign.caseStudies.sub')}
        </p>
      </div>
      <div class="grid gap-8 lg:grid-cols-2">
        {caseStudies.map((c) => (
          <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
            <div class="aspect-[4/3]">
              <picture>
                <source srcset={c.imageSources.avifSrcSet} sizes="(min-width: 1024px) 33vw, 100vw" type="image/avif" />
                <source srcset={c.imageSources.webpSrcSet} sizes="(min-width: 1024px) 33vw, 100vw" type="image/webp" />
                <img
                  src={c.imageSources.src}
                  srcset={c.imageSources.webpSrcSet}
                  sizes="(min-width: 1024px) 33vw, 100vw"
                  alt={c.title}
                  loading="lazy"
                  decoding="async"
                  width="1200"
                  height="900"
                  class="h-full w-full object-cover"
                />
              </picture>
            </div>
            <div class="space-y-4 p-8">
              <h3 class="text-2xl font-bold text-slate-900">{c.title}</h3>
              <div>
                <div class="text-sm font-semibold text-slate-900">{t(locale, 'servicesPage.productDesign.caseStudies.challenge')}</div>
                <div class="mt-1 text-slate-700">{c.challenge}</div>
              </div>
              <div>
                <div class="text-sm font-semibold text-slate-900">{t(locale, 'servicesPage.productDesign.caseStudies.solution')}</div>
                <div class="mt-1 text-slate-700">{c.solution}</div>
              </div>
              <div>
                <div class="text-sm font-semibold text-slate-900">{t(locale, 'servicesPage.productDesign.caseStudies.results')}</div>
                <ul class="mt-2 space-y-2 text-slate-700">
                  {c.results.map((r) => (
                    <li class="flex items-start gap-3">
                      <span class="mt-2 h-2 w-2 flex-shrink-0 rounded-2xl bg-emerald-500" />
                      <span>{r}</span>
                    </li>
                  ))}
                </ul>
              </div>
              <div class="flex flex-wrap gap-3 pt-2">
                <a class="rounded bg-sky-600 px-4 py-2 text-sm font-medium text-white hover:bg-sky-700" href={getLocalizedPath(locale, '/contact')}>{t(locale, 'servicesPage.productDesign.caseStudies.start')}</a>
                <a class="rounded border border-slate-300 px-4 py-2 text-sm font-medium text-slate-900" href={getLocalizedPath(locale, '/services')}>{t(locale, 'servicesPage.productDesign.caseStudies.back')}</a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="rounded-2xl bg-slate-900 px-8 py-16 text-white">
      <div class="mx-auto max-w-3xl text-center">
        <h2 class="text-3xl font-bold md:text-4xl">{t(locale, 'servicesPage.productDesign.cta.title')}</h2>
        <p class="mx-auto mt-4 max-w-2xl text-xl text-slate-200">
          {t(locale, 'servicesPage.productDesign.cta.description')}
        </p>
        <div class="mt-10 flex justify-center gap-3">
          <a class="rounded bg-sky-600 px-6 py-3 text-sm font-medium text-white hover:bg-sky-700" href={getLocalizedPath(locale, '/contact')}>{t(locale, 'servicesPage.productDesign.cta.start')}</a>
          <a class="rounded border border-white/30 px-6 py-3 text-sm font-medium text-white" href={getLocalizedPath(locale, '/services')}>{t(locale, 'servicesPage.productDesign.cta.back')}</a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

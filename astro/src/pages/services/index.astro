<style>
  .wwd-services{display:flex;flex-direction:column;gap:0}
  .wwd-service-item{border-bottom:none}
  .wwd-service-header{display:flex;align-items:center;justify-content:flex-start;width:100%;padding:12px 0;background:transparent;border:none;cursor:pointer;text-align:left;gap:0}
  .wwd-service-header h3{font-family:Syne,sans-serif;font-size:21px;font-weight:400;line-height:27px;color:#020303;display:inline-flex;align-items:center;position:relative;padding-right:0;padding-bottom:4px;border-bottom:1px solid #020303;transition:padding-right .3s ease;margin:0}
  .wwd-hover-arrow{position:absolute;top:50%;transform:translateY(-50%);right:0;width:16px;height:16px;opacity:0;transition:opacity .3s ease;pointer-events:none}
  .wwd-hover-arrow svg{width:16px;height:16px;display:block}
  .wwd-service-item:not(.open) .wwd-service-header:hover h3{padding-right:2em}
  .wwd-service-item:not(.open) .wwd-service-header:hover .wwd-hover-arrow{opacity:1}
  .wwd-service-item.open .wwd-service-header h3{padding-right:5em}
  .wwd-service-item.open .wwd-hover-arrow{opacity:1}
  .wwd-service-body{max-height:0;overflow:hidden;transition:max-height .4s ease}
  .wwd-service-item.open .wwd-service-body{max-height:200px}
  .wwd-service-body p{font-family:Manrope,sans-serif;font-size:16px;font-weight:400;line-height:25px;color:#020303;padding-bottom:8px;margin:0}
  .wwd-service-cta{display:inline-flex;align-items:center;gap:4px;font-family:Manrope,sans-serif;font-size:14px;font-weight:400;line-height:21px;color:#020303;padding-bottom:12px;text-decoration:none;transition:color .2s}
  .wwd-service-item.open .wwd-service-cta{text-decoration:underline;text-underline-offset:3px}
  .wwd-service-cta:hover{color:#563cfa}
  .wwd-cta-arrow{width:14px;height:14px;flex-shrink:0;opacity:0;transition:opacity .2s ease}
  .wwd-service-cta:hover .wwd-cta-arrow{opacity:1}
</style>

<script>
  (function () {
    var serviceItems = document.querySelectorAll('.wwd-service-item');
    if (!serviceItems.length) return;
    var autoTimer = null;
    var autoIndex = 1;

    function expandItem(el) {
      serviceItems.forEach(function (it) {
        it.classList.remove('open');
        it.querySelector('.wwd-service-header').setAttribute('aria-expanded', 'false');
      });
      el.classList.add('open');
      el.querySelector('.wwd-service-header').setAttribute('aria-expanded', 'true');
      return Array.prototype.indexOf.call(serviceItems, el);
    }

    function startAutoRotate(startIndex) {
      if (typeof startIndex !== 'undefined') autoIndex = startIndex;
      if (autoTimer) clearInterval(autoTimer);
      autoTimer = setInterval(function () {
        expandItem(serviceItems[autoIndex]);
        autoIndex = (autoIndex + 1) % serviceItems.length;
      }, 6000);
    }

    expandItem(serviceItems[0]);
    startAutoRotate(1);

    serviceItems.forEach(function (item) {
      var header = item.querySelector('.wwd-service-header');
      header.addEventListener('click', function () {
        var idx = expandItem(item);
        startAutoRotate((idx + 1) % serviceItems.length);
      });
    });
  })();
</script>

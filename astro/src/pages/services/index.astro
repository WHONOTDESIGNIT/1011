---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { t } from '../../lib/i18n';
import { getLocalizedPath, buildBreadcrumbs } from '../../lib/breadcrumbs';
import { responsiveImageSources } from '../../lib/netlify-images';
import { PenTool, Cog, Truck, Clock, Globe, RefreshCw, ShieldCheck } from '@lucide/astro';

const locale = Astro.currentLocale ?? 'en';

const pageTitle = t(locale, 'servicesPage.index.meta.title');
const breadcrumbs = buildBreadcrumbs(locale, [
  { label: t(locale, 'common.home'), path: '/' },
  { label: t(locale, 'nav.serviceSupport') },
]);

const pickYourPath = [
  {
    title: t(locale, 'servicesPage.index.pickYourPath.items.0.title'),
    description: t(locale, 'servicesPage.index.pickYourPath.items.0.description'),
    links: [
      { label: t(locale, 'servicesPage.index.pickYourPath.items.0.links.0'), href: getLocalizedPath(locale, '/services/no-moq') },
      { label: t(locale, 'servicesPage.index.pickYourPath.items.0.links.1'), href: getLocalizedPath(locale, '/catalogue') },
      { label: t(locale, 'servicesPage.index.pickYourPath.items.0.links.2'), href: getLocalizedPath(locale, '/contact') },
      { label: t(locale, 'servicesPage.index.pickYourPath.items.0.links.3'), href: getLocalizedPath(locale, '/services/oem-odm') },
    ],
  },
  {
    title: t(locale, 'servicesPage.index.pickYourPath.items.1.title'),
    description: t(locale, 'servicesPage.index.pickYourPath.items.1.description'),
    links: [
      { label: t(locale, 'servicesPage.index.pickYourPath.items.1.links.0'), href: getLocalizedPath(locale, '/services/logo-printing') },
      { label: t(locale, 'servicesPage.index.pickYourPath.items.1.links.1'), href: getLocalizedPath(locale, '/services/box-custom') },
      { label: t(locale, 'servicesPage.index.pickYourPath.items.1.links.2'), href: getLocalizedPath(locale, '/services/user-manual-guide-custom') },
      { label: t(locale, 'servicesPage.index.pickYourPath.items.1.links.3'), href: getLocalizedPath(locale, '/services/packaging-logistics') },
    ],
  },
  {
    title: t(locale, 'servicesPage.index.pickYourPath.items.2.title'),
    description: t(locale, 'servicesPage.index.pickYourPath.items.2.description'),
    links: [
      { label: t(locale, 'servicesPage.index.pickYourPath.items.2.links.0'), href: getLocalizedPath(locale, '/services/dropshipping') },
      { label: t(locale, 'servicesPage.index.pickYourPath.items.2.links.1'), href: getLocalizedPath(locale, '/services/packaging-logistics') },
      { label: t(locale, 'servicesPage.index.pickYourPath.items.2.links.2'), href: getLocalizedPath(locale, '/contact') },
      { label: t(locale, 'servicesPage.index.pickYourPath.items.2.links.3'), href: getLocalizedPath(locale, '/faq') },
    ],
  },
];

const brandingServices = [
  {
    title: t(locale, 'servicesPage.index.brandingServices.items.0.title'),
    icon: Clock,
    description: t(locale, 'servicesPage.index.brandingServices.items.0.description'),
    features: [
      t(locale, 'servicesPage.index.brandingServices.items.0.features.0'),
      t(locale, 'servicesPage.index.brandingServices.items.0.features.1'),
      t(locale, 'servicesPage.index.brandingServices.items.0.features.2'),
      t(locale, 'servicesPage.index.brandingServices.items.0.features.3'),
    ],
    href: getLocalizedPath(locale, '/services/no-moq'),
    linkLabel: t(locale, 'servicesPage.index.brandingServices.items.0.linkLabel'),
    accent: 'from-sky-600 to-violet-600',
    badge: t(locale, 'servicesPage.index.brandingServices.items.0.badge'),
  },
  {
    title: t(locale, 'servicesPage.index.brandingServices.items.1.title'),
    icon: PenTool,
    description: t(locale, 'servicesPage.index.brandingServices.items.1.description'),
    features: [
      t(locale, 'servicesPage.index.brandingServices.items.1.features.0'),
      t(locale, 'servicesPage.index.brandingServices.items.1.features.1'),
      t(locale, 'servicesPage.index.brandingServices.items.1.features.2'),
      t(locale, 'servicesPage.index.brandingServices.items.1.features.3'),
    ],
    href: getLocalizedPath(locale, '/services/logo-printing'),
    linkLabel: t(locale, 'servicesPage.index.brandingServices.items.1.linkLabel'),
    accent: 'from-violet-600 to-fuchsia-600',
    badge: t(locale, 'servicesPage.index.brandingServices.items.1.badge'),
  },
  {
    title: t(locale, 'servicesPage.index.brandingServices.items.2.title'),
    icon: Cog,
    description: t(locale, 'servicesPage.index.brandingServices.items.2.description'),
    features: [
      t(locale, 'servicesPage.index.brandingServices.items.2.features.0'),
      t(locale, 'servicesPage.index.brandingServices.items.2.features.1'),
      t(locale, 'servicesPage.index.brandingServices.items.2.features.2'),
      t(locale, 'servicesPage.index.brandingServices.items.2.features.3'),
    ],
    href: getLocalizedPath(locale, '/services/box-custom'),
    linkLabel: t(locale, 'servicesPage.index.brandingServices.items.2.linkLabel'),
    accent: 'from-slate-900 to-sky-600',
    badge: t(locale, 'servicesPage.index.brandingServices.items.2.badge'),
  },
  {
    title: t(locale, 'servicesPage.index.brandingServices.items.3.title'),
    icon: ShieldCheck,
    description: t(locale, 'servicesPage.index.brandingServices.items.3.description'),
    features: [
      t(locale, 'servicesPage.index.brandingServices.items.3.features.0'),
      t(locale, 'servicesPage.index.brandingServices.items.3.features.1'),
      t(locale, 'servicesPage.index.brandingServices.items.3.features.2'),
      t(locale, 'servicesPage.index.brandingServices.items.3.features.3'),
    ],
    href: getLocalizedPath(locale, '/services/user-manual-guide-custom'),
    linkLabel: t(locale, 'servicesPage.index.brandingServices.items.3.linkLabel'),
    accent: 'from-violet-700 to-slate-900',
    badge: t(locale, 'servicesPage.index.brandingServices.items.3.badge'),
  },
  {
    title: t(locale, 'servicesPage.index.brandingServices.items.4.title'),
    icon: Truck,
    description: t(locale, 'servicesPage.index.brandingServices.items.4.description'),
    features: [
      t(locale, 'servicesPage.index.brandingServices.items.4.features.0'),
      t(locale, 'servicesPage.index.brandingServices.items.4.features.1'),
      t(locale, 'servicesPage.index.brandingServices.items.4.features.2'),
      t(locale, 'servicesPage.index.brandingServices.items.4.features.3'),
    ],
    href: getLocalizedPath(locale, '/services/packaging-logistics'),
    linkLabel: t(locale, 'servicesPage.index.brandingServices.items.4.linkLabel'),
    accent: 'from-sky-600 to-slate-900',
    badge: t(locale, 'servicesPage.index.brandingServices.items.4.badge'),
  },
  {
    title: t(locale, 'servicesPage.index.brandingServices.items.5.title'),
    icon: Globe,
    description: t(locale, 'servicesPage.index.brandingServices.items.5.description'),
    features: [
      t(locale, 'servicesPage.index.brandingServices.items.5.features.0'),
      t(locale, 'servicesPage.index.brandingServices.items.5.features.1'),
      t(locale, 'servicesPage.index.brandingServices.items.5.features.2'),
      t(locale, 'servicesPage.index.brandingServices.items.5.features.3'),
    ],
    href: getLocalizedPath(locale, '/services/dropshipping'),
    linkLabel: t(locale, 'servicesPage.index.brandingServices.items.5.linkLabel'),
    accent: 'from-violet-600 to-sky-600',
    badge: t(locale, 'servicesPage.index.brandingServices.items.5.badge'),
  },
];

const advantages = [
  {
    title: t(locale, 'servicesPage.advantages.experience.title'),
    icon: Clock,
    description: t(locale, 'servicesPage.advantages.experience.description'),
  },
  {
    title: t(locale, 'servicesPage.advantages.global.title'),
    icon: Globe,
    description: t(locale, 'servicesPage.advantages.global.description'),
  },
  {
    title: t(locale, 'servicesPage.advantages.endToEnd.title'),
    icon: RefreshCw,
    description: t(locale, 'servicesPage.advantages.endToEnd.description'),
  },
  {
    title: t(locale, 'servicesPage.advantages.quality.title'),
    icon: ShieldCheck,
    description: t(locale, 'servicesPage.advantages.quality.description'),
  },
];

const processSteps = [
  {
    step: '01',
    title: t(locale, 'servicesPage.index.process.items.0.title'),
    description: t(locale, 'servicesPage.index.process.items.0.description'),
    duration: t(locale, 'servicesPage.index.process.items.0.duration'),
    links: [{ label: t(locale, 'servicesPage.index.process.items.0.links.0'), href: getLocalizedPath(locale, '/catalogue') }],
  },
  {
    step: '02',
    title: t(locale, 'servicesPage.index.process.items.1.title'),
    description: t(locale, 'servicesPage.index.process.items.1.description'),
    duration: t(locale, 'servicesPage.index.process.items.1.duration'),
    links: [{ label: t(locale, 'servicesPage.index.process.items.1.links.0'), href: getLocalizedPath(locale, '/services/oem-odm') }],
  },
  {
    step: '03',
    title: t(locale, 'servicesPage.index.process.items.2.title'),
    description: t(locale, 'servicesPage.index.process.items.2.description'),
    duration: t(locale, 'servicesPage.index.process.items.2.duration'),
    links: [{ label: t(locale, 'servicesPage.index.process.items.2.links.0'), href: getLocalizedPath(locale, '/services/logo-printing') }],
  },
  {
    step: '04',
    title: t(locale, 'servicesPage.index.process.items.3.title'),
    description: t(locale, 'servicesPage.index.process.items.3.description'),
    duration: t(locale, 'servicesPage.index.process.items.3.duration'),
    links: [
      { label: t(locale, 'servicesPage.index.process.items.3.links.0'), href: getLocalizedPath(locale, '/services/box-custom') },
      { label: t(locale, 'servicesPage.index.process.items.3.links.1'), href: getLocalizedPath(locale, '/services/user-manual-guide-custom') },
    ],
  },
  {
    step: '05',
    title: t(locale, 'servicesPage.index.process.items.4.title'),
    description: t(locale, 'servicesPage.index.process.items.4.description'),
    duration: t(locale, 'servicesPage.index.process.items.4.duration'),
    links: [{ label: t(locale, 'servicesPage.index.process.items.4.links.0'), href: getLocalizedPath(locale, '/services/production-assembly') }],
  },
  {
    step: '06',
    title: t(locale, 'servicesPage.index.process.items.5.title'),
    description: t(locale, 'servicesPage.index.process.items.5.description'),
    duration: t(locale, 'servicesPage.index.process.items.5.duration'),
    links: [
      { label: t(locale, 'servicesPage.index.process.items.5.links.0'), href: getLocalizedPath(locale, '/services/packaging-logistics') },
      { label: t(locale, 'servicesPage.index.process.items.5.links.1'), href: getLocalizedPath(locale, '/services/dropshipping') },
    ],
  },
];

const serviceFaq = [
  {
    question: t(locale, 'servicesPage.index.faq.items.0.question'),
    answer: t(locale, 'servicesPage.index.faq.items.0.answer'),
    links: [{ label: t(locale, 'servicesPage.index.faq.items.0.links.0'), href: getLocalizedPath(locale, '/services/no-moq') }],
  },
  {
    question: t(locale, 'servicesPage.index.faq.items.1.question'),
    answer: t(locale, 'servicesPage.index.faq.items.1.answer'),
    links: [{ label: t(locale, 'servicesPage.index.faq.items.1.links.0'), href: getLocalizedPath(locale, '/services/logo-printing') }],
  },
  {
    question: t(locale, 'servicesPage.index.faq.items.2.question'),
    answer: t(locale, 'servicesPage.index.faq.items.2.answer'),
    links: [{ label: t(locale, 'servicesPage.index.faq.items.2.links.0'), href: getLocalizedPath(locale, '/services/box-custom') }],
  },
  {
    question: t(locale, 'servicesPage.index.faq.items.3.question'),
    answer: t(locale, 'servicesPage.index.faq.items.3.answer'),
    links: [{ label: t(locale, 'servicesPage.index.faq.items.3.links.0'), href: getLocalizedPath(locale, '/services/user-manual-guide-custom') }],
  },
  {
    question: t(locale, 'servicesPage.index.faq.items.4.question'),
    answer: t(locale, 'servicesPage.index.faq.items.4.answer'),
    links: [{ label: t(locale, 'servicesPage.index.faq.items.4.links.0'), href: getLocalizedPath(locale, '/services/packaging-logistics') }],
  },
  {
    question: t(locale, 'servicesPage.index.faq.items.5.question'),
    answer: t(locale, 'servicesPage.index.faq.items.5.answer'),
    links: [{ label: t(locale, 'servicesPage.index.faq.items.5.links.0'), href: getLocalizedPath(locale, '/services/dropshipping') }],
  },
  {
    question: t(locale, 'servicesPage.index.faq.items.6.question'),
    answer: t(locale, 'servicesPage.index.faq.items.6.answer'),
    links: [{ label: t(locale, 'servicesPage.index.faq.items.6.links.0'), href: getLocalizedPath(locale, '/catalogue') }],
  },
  {
    question: t(locale, 'servicesPage.index.faq.items.7.question'),
    answer: t(locale, 'servicesPage.index.faq.items.7.answer'),
    links: [{ label: t(locale, 'servicesPage.index.faq.items.7.links.0'), href: getLocalizedPath(locale, '/contact') }],
  },
];

const trustedStats = Array.from({ length: 3 }, (_, index) => ({
  value: t(locale, `servicesPage.trusted.stats.${index}.value`),
  label: t(locale, `servicesPage.trusted.stats.${index}.label`),
}));

const trustedBrands = [
  { name: t(locale, 'servicesPage.index.trustedBrands.items.0.name'), logo: '/images/logos/costco-logo.svg' },
  { name: t(locale, 'servicesPage.index.trustedBrands.items.1.name'), logo: '/images/logos/roseskin-logo.svg' },
  { name: t(locale, 'servicesPage.index.trustedBrands.items.2.name'), logo: '/images/logos/KU-2%20logo.svg' },
];

const servicesHeroImage = responsiveImageSources('/images/service/service-ipl.jpg');
const servicesWorkflowImage = responsiveImageSources(
  'https://images.pexels.com/photos/4481259/pexels-photo-4481259.jpeg?auto=compress&cs=tinysrgb&w=1200',
);
---

<BaseLayout
  title={pageTitle}
  lang={locale}
  description={t(locale, 'servicesPage.index.meta.description')}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: serviceFaq.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: item.answer,
        },
      })),
    })}></script>
  </Fragment>
  <div class="space-y-60">
    <section class="relative py-12 lg:py-16">
      <div
        class="pointer-events-none absolute inset-y-0 left-1/2 right-1/2 -ml-[50vw] -mr-[50vw]"
        aria-hidden="true"
        style="background:linear-gradient(135deg,#f8fafc,#ffffff,#f5f3ff),radial-gradient(circle at top right,rgba(168,85,247,.12),transparent 25%),radial-gradient(circle at bottom left,rgba(56,189,248,.12),transparent 30%)"
      ></div>
      <div class="relative grid gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
        <div>
          <Breadcrumb items={breadcrumbs} locale={locale} />
          <div class="mt-8 max-w-3xl">
            <h1 class="text-4xl font-bold text-[#020303] md:text-5xl">
              {t(locale, 'servicesPage.index.heroTitle1')}
              <span class="block text-[#020303]">
                {t(locale, 'servicesPage.index.heroTitle2')}
              </span>
            </h1>
            <p class="mt-5 text-lg leading-relaxed text-slate-700">
              {t(locale, 'servicesPage.index.heroDescription')}
            </p>
          </div>
          <div class="mt-8 flex flex-wrap gap-3">
            <a class="rounded-2xl bg-slate-900 px-5 py-3 text-sm font-semibold text-white transition hover:bg-slate-800" href={getLocalizedPath(locale, '/contact')}>
              {t(locale, 'servicesPage.index.getAQuote')}
            </a>
          </div>
        </div>

        <div class="space-y-6">
          <div class="overflow-hidden rounded-[1.75rem] border border-slate-200 bg-white shadow-sm">
            <div class="aspect-[4/3] bg-slate-100">
              <picture>
                <source srcset={servicesHeroImage.avifSrcSet} sizes="(min-width: 1024px) 33vw, 100vw" type="image/avif" />
                <source srcset={servicesHeroImage.webpSrcSet} sizes="(min-width: 1024px) 33vw, 100vw" type="image/webp" />
                <img
                  src={servicesHeroImage.src}
                  srcset={servicesHeroImage.webpSrcSet}
                  sizes="(min-width: 1024px) 33vw, 100vw"
                  alt={t(locale, 'servicesPage.index.heroImageAlt')}
                  loading="lazy"
                  decoding="async"
                  width="1200"
                  height="900"
                  class="h-full w-full object-cover"
                />
              </picture>
            </div>
          </div>
          <div class="wwd-services">
            <div class="wwd-service-item" data-index="0">
              <button class="wwd-service-header" aria-expanded="false">
                <h3>{t(locale, 'servicesPage.index.wwd.items.0.title')}<span class="wwd-hover-arrow"><svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M4 12L12 4" stroke="#020303" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M5.5 4H12V10.5" stroke="#020303" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></span></h3>
              </button>
              <div class="wwd-service-body">
                <p>{t(locale, 'servicesPage.index.wwd.items.0.description')}</p>
                <a class="wwd-service-cta" href={getLocalizedPath(locale, '/services/maintain-or-fix-ipl-project')}>{t(locale, 'servicesPage.index.wwd.items.0.cta')} <svg class="wwd-cta-arrow" width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M3 11L11 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M4.5 3H11v6.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
              </div>
            </div>
            <div class="wwd-service-item" data-index="1">
              <button class="wwd-service-header" aria-expanded="false">
                <h3>{t(locale, 'servicesPage.index.wwd.items.1.title')}<span class="wwd-hover-arrow"><svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M4 12L12 4" stroke="#020303" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M5.5 4H12V10.5" stroke="#020303" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></span></h3>
              </button>
              <div class="wwd-service-body">
                <p>{t(locale, 'servicesPage.index.wwd.items.1.description')}</p>
                <a class="wwd-service-cta" href={getLocalizedPath(locale, '/services/find-a-technology-partner')}>{t(locale, 'servicesPage.index.wwd.items.1.cta')} <svg class="wwd-cta-arrow" width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M3 11L11 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M4.5 3H11v6.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
              </div>
            </div>
            <div class="wwd-service-item" data-index="2">
              <button class="wwd-service-header" aria-expanded="false">
                <h3>{t(locale, 'servicesPage.index.wwd.items.2.title')}<span class="wwd-hover-arrow"><svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M4 12L12 4" stroke="#020303" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M5.5 4H12V10.5" stroke="#020303" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></span></h3>
              </button>
              <div class="wwd-service-body">
                <p>{t(locale, 'servicesPage.index.wwd.items.2.description')}</p>
                <a class="wwd-service-cta" href={getLocalizedPath(locale, '/services/oem-odm')}>{t(locale, 'servicesPage.index.wwd.items.2.cta')} <svg class="wwd-cta-arrow" width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M3 11L11 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M4.5 3H11v6.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
              </div>
            </div>
            <div class="wwd-service-item" data-index="3">
              <button class="wwd-service-header" aria-expanded="false">
                <h3>{t(locale, 'servicesPage.index.wwd.items.3.title')}<span class="wwd-hover-arrow"><svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M4 12L12 4" stroke="#020303" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M5.5 4H12V10.5" stroke="#020303" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></span></h3>
              </button>
              <div class="wwd-service-body">
                <p>{t(locale, 'servicesPage.index.wwd.items.3.description')}</p>
                <a class="wwd-service-cta" href={getLocalizedPath(locale, '/services/build-a-new-ipl')}>{t(locale, 'servicesPage.index.wwd.items.3.cta')} <svg class="wwd-cta-arrow" width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M3 11L11 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M4.5 3H11v6.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-6">
      <h2 class="text-sm font-semibold uppercase tracking-[0.22em] text-slate-600">{t(locale, 'servicesPage.index.citableEyebrow')}</h2>
      <h3 class="mt-2 text-2xl font-bold text-slate-900">{t(locale, 'servicesPage.index.citableQuestion')}</h3>
      <p class="mt-4 max-w-4xl text-lg leading-relaxed text-slate-700">
        {t(locale, 'servicesPage.index.citableParagraph')}
      </p>
    </section>

    <section class="space-y-10">
      <div class="mx-auto max-w-3xl text-center">
        <div class="text-sm font-semibold uppercase tracking-[0.22em] text-violet-700">{t(locale, 'servicesPage.index.pickYourPath.eyebrow')}</div>
        <h2 class="mt-3 text-3xl font-bold text-slate-900 md:text-4xl">{t(locale, 'servicesPage.index.pickYourPath.title')}</h2>
        <p class="mt-4 text-lg text-slate-700">
          {t(locale, 'servicesPage.index.pickYourPath.description')}
        </p>
      </div>
      <div class="mx-auto grid max-w-6xl gap-6 lg:grid-cols-3">
        {pickYourPath.map((path) => (
          <article class="rounded-[1.75rem] border border-slate-200 bg-white p-7 shadow-sm">
            <h3 class="text-2xl font-semibold text-slate-900">{path.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-slate-700">{path.description}</p>
            <ul class="mt-6 space-y-3 text-sm font-semibold text-slate-900">
              {path.links.map((link) => (
                <li>

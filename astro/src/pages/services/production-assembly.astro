---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t } from '../../lib/i18n';
import { getLocalizedPath } from '../../lib/breadcrumbs';

const locale = Astro.currentLocale ?? 'en';
const productionCapabilities = [
  {
    title: t(locale, 'servicesPage.productionAssembly.capabilities.items.0.title'),
    description: t(locale, 'servicesPage.productionAssembly.capabilities.items.0.description'),
    features: [
      t(locale, 'servicesPage.productionAssembly.capabilities.items.0.features.0'),
      t(locale, 'servicesPage.productionAssembly.capabilities.items.0.features.1'),
      t(locale, 'servicesPage.productionAssembly.capabilities.items.0.features.2'),
      t(locale, 'servicesPage.productionAssembly.capabilities.items.0.features.3'),
    ],
    gradient: 'from-emerald-500 to-green-500',
  },
  {
    title: t(locale, 'servicesPage.productionAssembly.capabilities.items.1.title'),
    description: t(locale, 'servicesPage.productionAssembly.capabilities.items.1.description'),
    features: [
      t(locale, 'servicesPage.productionAssembly.capabilities.items.1.features.0'),
      t(locale, 'servicesPage.productionAssembly.capabilities.items.1.features.1'),
      t(locale, 'servicesPage.productionAssembly.capabilities.items.1.features.2'),
      t(locale, 'servicesPage.productionAssembly.capabilities.items.1.features.3'),
    ],
    gradient: 'from-sky-500 to-cyan-500',
  },
  {
    title: t(locale, 'servicesPage.productionAssembly.capabilities.items.2.title'),
    description: t(locale, 'servicesPage.productionAssembly.capabilities.items.2.description'),
    features: [
      t(locale, 'servicesPage.productionAssembly.capabilities.items.2.features.0'),
      t(locale, 'servicesPage.productionAssembly.capabilities.items.2.features.1'),
      t(locale, 'servicesPage.productionAssembly.capabilities.items.2.features.2'),
      t(locale, 'servicesPage.productionAssembly.capabilities.items.2.features.3'),
    ],
    gradient: 'from-purple-500 to-pink-500',
  },
  {
    title: t(locale, 'servicesPage.productionAssembly.capabilities.items.3.title'),
    description: t(locale, 'servicesPage.productionAssembly.capabilities.items.3.description'),
    features: [
      t(locale, 'servicesPage.productionAssembly.capabilities.items.3.features.0'),
      t(locale, 'servicesPage.productionAssembly.capabilities.items.3.features.1'),
      t(locale, 'servicesPage.productionAssembly.capabilities.items.3.features.2'),
      t(locale, 'servicesPage.productionAssembly.capabilities.items.3.features.3'),
    ],
    gradient: 'from-violet-600 to-fuchsia-600',
  },
];

const productionStages = [
  {
    stage: t(locale, 'servicesPage.productionAssembly.process.items.0.stage'),
    title: t(locale, 'servicesPage.productionAssembly.process.items.0.title'),
    description: t(locale, 'servicesPage.productionAssembly.process.items.0.description'),
    details: [
      t(locale, 'servicesPage.productionAssembly.process.items.0.details.0'),
      t(locale, 'servicesPage.productionAssembly.process.items.0.details.1'),
      t(locale, 'servicesPage.productionAssembly.process.items.0.details.2'),
      t(locale, 'servicesPage.productionAssembly.process.items.0.details.3'),
    ],
    duration: t(locale, 'servicesPage.productionAssembly.process.items.0.duration'),
  },
  {
    stage: t(locale, 'servicesPage.productionAssembly.process.items.1.stage'),
    title: t(locale, 'servicesPage.productionAssembly.process.items.1.title'),
    description: t(locale, 'servicesPage.productionAssembly.process.items.1.description'),
    details: [
      t(locale, 'servicesPage.productionAssembly.process.items.1.details.0'),
      t(locale, 'servicesPage.productionAssembly.process.items.1.details.1'),
      t(locale, 'servicesPage.productionAssembly.process.items.1.details.2'),
      t(locale, 'servicesPage.productionAssembly.process.items.1.details.3'),
    ],
    duration: t(locale, 'servicesPage.productionAssembly.process.items.1.duration'),
  },
  {
    stage: t(locale, 'servicesPage.productionAssembly.process.items.2.stage'),
    title: t(locale, 'servicesPage.productionAssembly.process.items.2.title'),
    description: t(locale, 'servicesPage.productionAssembly.process.items.2.description'),
    details: [
      t(locale, 'servicesPage.productionAssembly.process.items.2.details.0'),
      t(locale, 'servicesPage.productionAssembly.process.items.2.details.1'),
      t(locale, 'servicesPage.productionAssembly.process.items.2.details.2'),
      t(locale, 'servicesPage.productionAssembly.process.items.2.details.3'),
    ],
    duration: t(locale, 'servicesPage.productionAssembly.process.items.2.duration'),
  },
  {
    stage: t(locale, 'servicesPage.productionAssembly.process.items.3.stage'),
    title: t(locale, 'servicesPage.productionAssembly.process.items.3.title'),
    description: t(locale, 'servicesPage.productionAssembly.process.items.3.description'),
    details: [
      t(locale, 'servicesPage.productionAssembly.process.items.3.details.0'),
      t(locale, 'servicesPage.productionAssembly.process.items.3.details.1'),
      t(locale, 'servicesPage.productionAssembly.process.items.3.details.2'),
      t(locale, 'servicesPage.productionAssembly.process.items.3.details.3'),
    ],
    duration: t(locale, 'servicesPage.productionAssembly.process.items.3.duration'),
  },
];

const qualityStandards = [
  {
    standard: t(locale, 'servicesPage.productionAssembly.standards.items.0.standard'),
    title: t(locale, 'servicesPage.productionAssembly.standards.items.0.title'),
    description: t(locale, 'servicesPage.productionAssembly.standards.items.0.description'),
    scope: t(locale, 'servicesPage.productionAssembly.standards.items.0.scope'),
  },
  {
    standard: t(locale, 'servicesPage.productionAssembly.standards.items.1.standard'),
    title: t(locale, 'servicesPage.productionAssembly.standards.items.1.title'),
    description: t(locale, 'servicesPage.productionAssembly.standards.items.1.description'),
    scope: t(locale, 'servicesPage.productionAssembly.standards.items.1.scope'),
  },
  {
    standard: t(locale, 'servicesPage.productionAssembly.standards.items.2.standard'),
    title: t(locale, 'servicesPage.productionAssembly.standards.items.2.title'),
    description: t(locale, 'servicesPage.productionAssembly.standards.items.2.description'),
    scope: t(locale, 'servicesPage.productionAssembly.standards.items.2.scope'),
  },
  {
    standard: t(locale, 'servicesPage.productionAssembly.standards.items.3.standard'),
    title: t(locale, 'servicesPage.productionAssembly.standards.items.3.title'),
    description: t(locale, 'servicesPage.productionAssembly.standards.items.3.description'),
    scope: t(locale, 'servicesPage.productionAssembly.standards.items.3.scope'),
  },
];

const productionMetrics = [
  {
    metric: t(locale, 'servicesPage.productionAssembly.metrics.items.0.metric'),
    label: t(locale, 'servicesPage.productionAssembly.metrics.items.0.label'),
    description: t(locale, 'servicesPage.productionAssembly.metrics.items.0.description'),
  },
  {
    metric: t(locale, 'servicesPage.productionAssembly.metrics.items.1.metric'),
    label: t(locale, 'servicesPage.productionAssembly.metrics.items.1.label'),
    description: t(locale, 'servicesPage.productionAssembly.metrics.items.1.description'),
  },
  {
    metric: t(locale, 'servicesPage.productionAssembly.metrics.items.2.metric'),
    label: t(locale, 'servicesPage.productionAssembly.metrics.items.2.label'),
    description: t(locale, 'servicesPage.productionAssembly.metrics.items.2.description'),
  },
  {
    metric: t(locale, 'servicesPage.productionAssembly.metrics.items.3.metric'),
    label: t(locale, 'servicesPage.productionAssembly.metrics.items.3.label'),
    description: t(locale, 'servicesPage.productionAssembly.metrics.items.3.description'),
  },
];

const testingProcedures = [
  {
    category: t(locale, 'servicesPage.productionAssembly.testing.items.0.category'),
    tests: [
      t(locale, 'servicesPage.productionAssembly.testing.items.0.tests.0'),
      t(locale, 'servicesPage.productionAssembly.testing.items.0.tests.1'),
      t(locale, 'servicesPage.productionAssembly.testing.items.0.tests.2'),
      t(locale, 'servicesPage.productionAssembly.testing.items.0.tests.3'),
    ],
  },
  {
    category: t(locale, 'servicesPage.productionAssembly.testing.items.1.category'),
    tests: [
      t(locale, 'servicesPage.productionAssembly.testing.items.1.tests.0'),
      t(locale, 'servicesPage.productionAssembly.testing.items.1.tests.1'),
      t(locale, 'servicesPage.productionAssembly.testing.items.1.tests.2'),
      t(locale, 'servicesPage.productionAssembly.testing.items.1.tests.3'),
    ],
  },
  {
    category: t(locale, 'servicesPage.productionAssembly.testing.items.2.category'),
    tests: [
      t(locale, 'servicesPage.productionAssembly.testing.items.2.tests.0'),
      t(locale, 'servicesPage.productionAssembly.testing.items.2.tests.1'),
      t(locale, 'servicesPage.productionAssembly.testing.items.2.tests.2'),
      t(locale, 'servicesPage.productionAssembly.testing.items.2.tests.3'),
    ],
  },
  {
    category: t(locale, 'servicesPage.productionAssembly.testing.items.3.category'),
    tests: [
      t(locale, 'servicesPage.productionAssembly.testing.items.3.tests.0'),
      t(locale, 'servicesPage.productionAssembly.testing.items.3.tests.1'),
      t(locale, 'servicesPage.productionAssembly.testing.items.3.tests.2'),
      t(locale, 'servicesPage.productionAssembly.testing.items.3.tests.3'),
    ],
  },
];
---

<BaseLayout title={t(locale, 'servicesPage.productionAssembly.meta.title')} lang={locale} description={t(locale, 'servicesPage.productionAssembly.meta.description')}>
  <div class="space-y-60">
    <section class="rounded-2xl bg-gradient-to-br from-emerald-50 to-green-50 px-8 py-16">
      <div class="mx-auto max-w-4xl text-center">
        <h1 class="text-4xl font-bold text-slate-900 md:text-6xl">
          {t(locale, 'servicesPage.productionAssembly.hero.title1')}
          <span class="block bg-gradient-to-r from-emerald-600 to-green-600 bg-clip-text text-transparent">{t(locale, 'servicesPage.productionAssembly.hero.title2')}</span>
        </h1>
        <p class="mx-auto mt-6 max-w-3xl text-xl leading-relaxed text-slate-700">
          {t(locale, 'servicesPage.productionAssembly.hero.description')}
        </p>
        <div class="mt-10 flex justify-center">
          <a class="rounded bg-emerald-600 px-6 py-3 text-sm font-medium text-white hover:bg-emerald-700" href={getLocalizedPath(locale, '/contact')}>{t(locale, 'servicesPage.productionAssembly.hero.cta')}</a>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-6">
      <h2 class="text-sm font-semibold uppercase tracking-[0.22em] text-slate-600">{t(locale, 'common.citableSummary')}</h2>
      <h3 class="mt-2 text-2xl font-bold text-slate-900">{t(locale, 'servicesPage.productionAssembly.citable.heading')}</h3>
      <p class="mt-4 max-w-4xl text-lg leading-relaxed text-slate-700">
        {t(locale, 'servicesPage.productionAssembly.citable.body')}
      </p>
    </section>

    <section class="space-y-10">
      <div class="text-center">
        <h2 class="text-3xl font-bold text-slate-900 md:text-4xl">{t(locale, 'servicesPage.productionAssembly.capabilities.heading')}</h2>
        <p class="mx-auto mt-4 max-w-2xl text-lg text-slate-700">
          {t(locale, 'servicesPage.productionAssembly.capabilities.sub')}
        </p>
      </div>
      <div class="grid gap-8 md:grid-cols-2">
        {productionCapabilities.map((cap) => (
          <div class="rounded-2xl border border-slate-200 bg-white p-8 shadow-lg transition-shadow hover:shadow-xl">
            <div class={`mb-6 h-16 w-16 rounded-2xl bg-gradient-to-r ${cap.gradient}`} />
            <h3 class="text-2xl font-bold text-slate-900">{cap.title}</h3>
            <p class="mt-4 text-slate-700">{cap.description}</p>
            <div class="mt-6 grid grid-cols-2 gap-3">
              {cap.features.map((f) => (
                <div class="flex items-center gap-2 text-sm text-slate-700">
                  <span class="h-2 w-2 rounded-2xl bg-emerald-500" />
                  <span>{f}</span>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="rounded-2xl bg-slate-50 px-8 py-16">
      <div class="text-center">
        <h2 class="text-3xl font-bold text-slate-900 md:text-4xl">{t(locale, 'servicesPage.productionAssembly.process.heading')}</h2>
        <p class="mx-auto mt-4 max-w-2xl text-lg text-slate-700">
          {t(locale, 'servicesPage.productionAssembly.process.sub')}
        </p>
      </div>
      <div class="mt-12 space-y-6">
        {productionStages.map((stage) => (
          <div class="rounded-2xl border border-slate-200 bg-white p-8 shadow-lg">
            <div class="grid gap-6 lg:grid-cols-[260px_1fr]">
              <div class="flex items-center gap-6">
                <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-gradient-to-r from-emerald-600 to-green-600">
                  <span class="text-xl font-bold text-white">{stage.stage}</span>
                </div>
                <div>
                  <div class="text-xl font-bold text-slate-900">{stage.title}</div>
                  <div class="mt-1 font-medium text-emerald-600">{stage.duration}</div>
                </div>
              </div>
              <div>
                <p class="text-slate-700">{stage.description}</p>
                <div class="mt-4 grid grid-cols-2 gap-2">
                  {stage.details.map((d) => (
                    <div class="flex items-center gap-2 text-sm text-slate-700">
                      <span class="h-2 w-2 rounded-2xl bg-emerald-400" />
                      <span>{d}</span>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="space-y-10">
      <div class="text-center">
        <h2 class="text-3xl font-bold text-slate-900 md:text-4xl">{t(locale, 'servicesPage.productionAssembly.standards.heading')}</h2>
        <p class="mx-auto mt-4 max-w-2xl text-lg text-slate-700">
          {t(locale, 'servicesPage.productionAssembly.standards.sub')}
        </p>
      </div>
      <div class="grid gap-8 md:grid-cols-2">
        {qualityStandards.map((s) => (
          <div class="rounded-2xl border border-slate-200 bg-white p-8 shadow-lg transition-shadow hover:shadow-xl">
            <div class="inline-flex rounded-2xl border border-violet-200 bg-violet-50 px-3 py-1 text-xs font-medium text-sky-700">{s.standard}</div>
            <h3 class="mt-4 text-xl font-bold text-slate-900">{s.title}</h3>
            <p class="mt-3 text-slate-700">{s.description}</p>
            <div class="mt-4 text-sm text-slate-600"><span class="font-semibold text-slate-700">{t(locale, 'servicesPage.productionAssembly.standards.scopeLabel')}</span> {s.scope}</div>
          </div>
        ))}
      </div>
    </section>

    <section class="rounded-2xl bg-gradient-to-br from-emerald-50 to-green-50 px-8 py-16">
      <div class="text-center">
        <h2 class="text-3xl font-bold text-slate-900 md:text-4xl">{t(locale, 'servicesPage.productionAssembly.metrics.heading')}</h2>
        <p class="mx-auto mt-4 max-w-2xl text-lg text-slate-700">
          {t(locale, 'servicesPage.productionAssembly.metrics.sub')}
        </p>
      </div>
      <div class="mt-12 grid gap-8 md:grid-cols-2 lg:grid-cols-4">
        {productionMetrics.map((m) => (
          <div class="rounded-2xl border border-slate-200 bg-white p-8 text-center shadow-lg">
            <div class="text-4xl font-bold text-emerald-600">{m.metric}</div>
            <div class="mt-2 font-semibold text-slate-900">{m.label}</div>
            <div class="mt-2 text-sm text-slate-700">{m.description}</div>
          </div>
        ))}
      </div>
    </section>

    <section class="space-y-10">
      <div class="text-center">
        <h2 class="text-3xl font-bold text-slate-900 md:text-4xl">{t(locale, 'servicesPage.productionAssembly.testing.heading')}</h2>
        <p class="mx-auto mt-4 max-w-2xl text-lg text-slate-700">
          {t(locale, 'servicesPage.productionAssembly.testing.sub')}
        </p>
      </div>
      <div class="grid gap-8 md:grid-cols-2">
        {testingProcedures.map((t) => (
          <div class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm">
            <h3 class="text-xl font-bold text-slate-900">{t.category}</h3>
            <ul class="mt-5 space-y-2 text-slate-700">
              {t.tests.map((x) => (
                <li class="flex items-start gap-3">
                  <span class="mt-2 h-2 w-2 flex-shrink-0 rounded-2xl bg-emerald-500" />
                  <span>{x}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <section class="rounded-2xl bg-slate-900 px-8 py-16 text-white">
      <div class="mx-auto max-w-3xl text-center">
        <h2 class="text-3xl font-bold md:text-4xl">{t(locale, 'servicesPage.productionAssembly.cta.title')}</h2>
        <p class="mx-auto mt-4 max-w-2xl text-xl text-slate-200">
          {t(locale, 'servicesPage.productionAssembly.cta.description')}
        </p>
        <div class="mt-10 flex justify-center gap-3">
          <a class="rounded bg-emerald-600 px-6 py-3 text-sm font-medium text-white hover:bg-emerald-700" href={getLocalizedPath(locale, '/contact')}>{t(locale, 'servicesPage.productionAssembly.cta.start')}</a>
          <a class="rounded border border-white/30 px-6 py-3 text-sm font-medium text-white" href={getLocalizedPath(locale, '/services')}>{t(locale, 'servicesPage.productionAssembly.cta.back')}</a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

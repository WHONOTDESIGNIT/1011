---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLocalizedPath } from '../../lib/breadcrumbs';
import { t } from '../../lib/i18n';
import AirShippingTable from '../../components/AirShippingTable.astro';
import { DDP_MARKETS, DDP_UNSUPPORTED, ddpName, ddpTotalUsd } from '../../lib/ddp-shipping';

const locale = Astro.currentLocale ?? 'en';

// DDP 单件物流价格表：金额与时效来自 lib/ddp-shipping，国名按当前语种用 Intl.DisplayNames 生成。
// 行序按单件美元合计升序（便宜 → 贵）。无时效数据的市场显示 —。
const ddpRows = DDP_MARKETS.slice()
  .sort((a, b) => ddpTotalUsd(a) - ddpTotalUsd(b))
  .map((m) => ({
    name: ddpName(locale, m.code),
    rate: `$${ddpTotalUsd(m).toFixed(2)}`,
    days:
      m.daysFrom === null || m.daysTo === null
        ? '—'
        : `${m.daysFrom}-${m.daysTo} ${t(locale, 'servicesPage.ddpShipping.daysUnit')}`,
    onTime: m.onTime ?? '—',
  }));
const ddpUnsupportedList = DDP_UNSUPPORTED.map((code) => ddpName(locale, code)).join(', ');

const capabilities = [
  {
    title: t(locale, 'servicesPage.dropshipping.capabilities.items.0.title'),
    description: t(locale, 'servicesPage.dropshipping.capabilities.items.0.description'),
    items: [t(locale, 'servicesPage.dropshipping.capabilities.items.0.items.0'), t(locale, 'servicesPage.dropshipping.capabilities.items.0.items.1'), t(locale, 'servicesPage.dropshipping.capabilities.items.0.items.2'), t(locale, 'servicesPage.dropshipping.capabilities.items.0.items.3')],
  },
  {
    title: t(locale, 'servicesPage.dropshipping.capabilities.items.1.title'),
    description: t(locale, 'servicesPage.dropshipping.capabilities.items.1.description'),
    items: [t(locale, 'servicesPage.dropshipping.capabilities.items.1.items.0'), t(locale, 'servicesPage.dropshipping.capabilities.items.1.items.1'), t(locale, 'servicesPage.dropshipping.capabilities.items.1.items.2'), t(locale, 'servicesPage.dropshipping.capabilities.items.1.items.3')],
  },
  {
    title: t(locale, 'servicesPage.dropshipping.capabilities.items.2.title'),
    description: t(locale, 'servicesPage.dropshipping.capabilities.items.2.description'),
    items: [t(locale, 'servicesPage.dropshipping.capabilities.items.2.items.0'), t(locale, 'servicesPage.dropshipping.capabilities.items.2.items.1'), t(locale, 'servicesPage.dropshipping.capabilities.items.2.items.2'), t(locale, 'servicesPage.dropshipping.capabilities.items.2.items.3')],
  },
];
---

<BaseLayout title={t(locale, 'servicesPage.dropshipping.meta.title')} lang={locale} description={t(locale, 'servicesPage.dropshipping.meta.description')} blogRecPage="/services/dropshipping">
  <div class="space-y-60">
    <section class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-neutral-50 via-white to-sky-50 px-8 py-12 shadow-sm md:px-10 lg:px-12 lg:py-16">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,_rgba(168,85,247,0.10),_transparent_28%),radial-gradient(circle_at_bottom_left,_rgba(56,189,248,0.14),_transparent_30%)]" />
      <div class="relative mx-auto max-w-5xl">
        <h1 class="text-4xl font-bold text-ink-900 md:text-6xl">
          {t(locale, 'servicesPage.dropshipping.hero.title1')}
          <span class="block bg-gradient-to-r from-violet-600 to-sky-600 bg-clip-text text-transparent">{t(locale, 'servicesPage.dropshipping.hero.title2')}</span>
        </h1>
        <p class="mt-6 max-w-3xl text-xl leading-relaxed text-neutral-700">
          {t(locale, 'servicesPage.dropshipping.hero.description')}
        </p>
        <div class="mt-10 flex flex-wrap gap-3">
          <a class="rounded-2xl bg-ink-900 px-6 py-3 text-sm font-semibold text-white transition hover:bg-neutral-800" href={getLocalizedPath(locale, '/contact')}>
            {t(locale, 'servicesPage.dropshipping.hero.cta1')}
          </a>
          <a class="rounded-2xl border border-neutral-300 bg-white px-6 py-3 text-sm font-semibold text-ink-900 transition hover:border-neutral-400 hover:bg-neutral-50" href={getLocalizedPath(locale, '/services')}>
            {t(locale, 'servicesPage.dropshipping.hero.cta2')}
          </a>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-6">
      <h2 class="text-sm font-semibold uppercase tracking-[0.22em] text-neutral-600">{t(locale, 'common.citableSummary')}</h2>
      <h3 class="mt-2 text-2xl font-bold text-ink-900">{t(locale, 'servicesPage.dropshipping.citable.heading')}</h3>
      <p class="mt-4 max-w-4xl text-lg leading-relaxed text-neutral-700">
        {t(locale, 'servicesPage.dropshipping.citable.body')}
      </p>
    </section>

    <section class="space-y-10">
      <div class="mx-auto max-w-3xl text-center">
        <div class="text-sm font-semibold uppercase tracking-[0.22em] text-violet-700">{t(locale, 'servicesPage.dropshipping.capabilities.eyebrow')}</div>
        <h2 class="mt-3 text-3xl font-bold text-ink-900 md:text-4xl">{t(locale, 'servicesPage.dropshipping.capabilities.heading')}</h2>
        <p class="mt-4 text-lg text-neutral-700">{t(locale, 'servicesPage.dropshipping.capabilities.sub')}</p>
      </div>
      <div class="mx-auto grid max-w-6xl gap-6 md:grid-cols-3">
        {capabilities.map((card) => (
          <article class="rounded-[1.75rem] border border-neutral-200 bg-white p-7 shadow-sm">
            <h3 class="text-xl font-semibold text-ink-900">{card.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-neutral-700">{card.description}</p>
            <ul class="mt-6 space-y-3 text-sm text-neutral-700">
              {card.items.map((item) => (
                <li class="flex items-start gap-3">
                  <span class="mt-2 h-2.5 w-2.5 flex-shrink-0 rounded-2xl bg-violet-500" />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-6">
      <h2 class="text-3xl font-bold text-ink-900 md:text-4xl">{t(locale, 'servicesPage.ddpShipping.heading')}</h2>
      <p class="mt-4 max-w-4xl text-lg leading-relaxed text-neutral-700">
        {t(locale, 'servicesPage.ddpShipping.intro')}
      </p>
      <div class="mt-8 overflow-x-auto rounded-2xl border border-neutral-200 bg-white shadow-sm">
        <table class="w-full min-w-[720px] border-collapse text-sm">
          <thead>
            <tr class="bg-neutral-50">
              <th class="px-5 py-3.5 text-left text-xs font-bold uppercase tracking-[0.08em] text-neutral-500">{t(locale, 'servicesPage.ddpShipping.colMarket')}</th>
              <th class="px-5 py-3.5 text-left text-xs font-bold uppercase tracking-[0.08em] text-neutral-500">{t(locale, 'servicesPage.ddpShipping.colRate')}</th>
              <th class="px-5 py-3.5 text-left text-xs font-bold uppercase tracking-[0.08em] text-neutral-500">{t(locale, 'servicesPage.ddpShipping.colDays')}</th>
              <th class="px-5 py-3.5 text-left text-xs font-bold uppercase tracking-[0.08em] text-neutral-500">{t(locale, 'servicesPage.ddpShipping.colOnTime')}</th>
            </tr>
          </thead>
          <tbody>
            {ddpRows.map((row) => (
              <tr class="border-t border-neutral-100">
                <td class="px-5 py-3.5 font-semibold text-ink-900">{row.name}</td>
                <td class="px-5 py-3.5 text-neutral-700">{row.rate}</td>
                <td class="px-5 py-3.5 text-neutral-700">{row.days}</td>
                <td class="px-5 py-3.5 text-neutral-700">{row.onTime}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class="mt-10 rounded-[1.75rem] border border-neutral-200 bg-white p-7 shadow-sm">
        <h3 class="text-xl font-semibold text-ink-900">{t(locale, 'servicesPage.ddpShipping.unsupportedHeading')}</h3>
        <p class="mt-3 text-sm leading-relaxed text-neutral-700">{t(locale, 'servicesPage.ddpShipping.unsupportedNote')}</p>
        <p class="mt-3 text-sm leading-relaxed text-neutral-700">{ddpUnsupportedList}</p>
      </div>
      <p class="mt-6 text-sm leading-relaxed text-neutral-500">{t(locale, 'servicesPage.ddpShipping.note')}</p>
    </section>

<section class="mx-auto max-w-6xl px-6">
  <h2 class="text-3xl font-bold text-ink-900 md:text-4xl">{t(locale, 'servicesPage.airShipping.heading')}</h2>
  <p class="mt-4 max-w-4xl text-lg leading-relaxed text-neutral-700">{t(locale, 'servicesPage.airShipping.intro')}</p>
  <div class="mt-8">
    <AirShippingTable lang={locale} />
  </div>
</section>
  </div>
</BaseLayout>

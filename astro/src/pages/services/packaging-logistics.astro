---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t } from '../../lib/i18n';
import { getLocalizedPath } from '../../lib/breadcrumbs';
import { responsiveImageSources } from '../../lib/netlify-images';

const locale = Astro.currentLocale ?? 'en';
const heroImageSource =
  'https://images.pexels.com/photos/4483610/pexels-photo-4483610.jpeg?auto=compress&cs=tinysrgb&w=1600';
const heroImageSources = responsiveImageSources(heroImageSource, [800, 1200, 1600], 1600);
const packagingLogisticsImage = responsiveImageSources(
  'https://images.pexels.com/photos/4481259/pexels-photo-4481259.jpeg?auto=compress&cs=tinysrgb&w=1200',
);

const packagingServices = [
  {
    title: t(locale, 'servicesPage.packagingLogistics.services.items.0.title'),
    description: t(locale, 'servicesPage.packagingLogistics.services.items.0.description'),
    features: [
      t(locale, 'servicesPage.packagingLogistics.services.items.0.features.0'),
      t(locale, 'servicesPage.packagingLogistics.services.items.0.features.1'),

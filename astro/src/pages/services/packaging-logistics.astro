      t(locale, 'servicesPage.packagingLogistics.services.items.2.features.0'),
      t(locale, 'servicesPage.packagingLogistics.services.items.2.features.1'),
      t(locale, 'servicesPage.packagingLogistics.services.items.2.features.2'),
      t(locale, 'servicesPage.packagingLogistics.services.items.2.features.3'),

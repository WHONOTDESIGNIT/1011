    ],
    deliveryTime: t(locale, 'servicesPage.packagingLogistics.network.items.3.deliveryTime'),
    services: [
      t(locale, 'servicesPage.packagingLogistics.network.items.3.services.0'),
      t(locale, 'servicesPage.packagingLogistics.network.items.3.services.1'),
      t(locale, 'servicesPage.packagingLogistics.network.items.3.services.2'),
    ],
  },
];

const packagingProcess = [
  {
    step: t(locale, 'servicesPage.packagingLogistics.process.items.0.step'),
    title: t(locale, 'servicesPage.packagingLogistics.process.items.0.title'),
    description: t(locale, 'servicesPage.packagingLogistics.process.items.0.description'),
    deliverables: [
      t(locale, 'servicesPage.packagingLogistics.process.items.0.deliverables.0'),
      t(locale, 'servicesPage.packagingLogistics.process.items.0.deliverables.1'),
      t(locale, 'servicesPage.packagingLogistics.process.items.0.deliverables.2'),
      t(locale, 'servicesPage.packagingLogistics.process.items.0.deliverables.3'),
    ],
  },
  {
    step: t(locale, 'servicesPage.packagingLogistics.process.items.1.step'),
    title: t(locale, 'servicesPage.packagingLogistics.process.items.1.title'),
    description: t(locale, 'servicesPage.packagingLogistics.process.items.1.description'),
    deliverables: [
      t(locale, 'servicesPage.packagingLogistics.process.items.1.deliverables.0'),
      t(locale, 'servicesPage.packagingLogistics.process.items.1.deliverables.1'),
      t(locale, 'servicesPage.packagingLogistics.process.items.1.deliverables.2'),
      t(locale, 'servicesPage.packagingLogistics.process.items.1.deliverables.3'),
    ],
  },
  {
    step: t(locale, 'servicesPage.packagingLogistics.process.items.2.step'),
    title: t(locale, 'servicesPage.packagingLogistics.process.items.2.title'),
    description: t(locale, 'servicesPage.packagingLogistics.process.items.2.description'),
    deliverables: [
      t(locale, 'servicesPage.packagingLogistics.process.items.2.deliverables.0'),
      t(locale, 'servicesPage.packagingLogistics.process.items.2.deliverables.1'),
      t(locale, 'servicesPage.packagingLogistics.process.items.2.deliverables.2'),
      t(locale, 'servicesPage.packagingLogistics.process.items.2.deliverables.3'),
    ],
  },
  {
    step: t(locale, 'servicesPage.packagingLogistics.process.items.3.step'),
    title: t(locale, 'servicesPage.packagingLogistics.process.items.3.title'),
    description: t(locale, 'servicesPage.packagingLogistics.process.items.3.description'),
    deliverables: [
      t(locale, 'servicesPage.packagingLogistics.process.items.3.deliverables.0'),
      t(locale, 'servicesPage.packagingLogistics.process.items.3.deliverables.1'),

      t(locale, 'servicesPage.packagingLogistics.process.items.3.deliverables.3'),
    ],
  },
];

const sustainabilityFeatures = [
  {
    title: t(locale, 'servicesPage.packagingLogistics.sustainability.items.0.title'),
    description: t(locale, 'servicesPage.packagingLogistics.sustainability.items.0.description'),
    examples: [
      t(locale, 'servicesPage.packagingLogistics.sustainability.items.0.examples.0'),
      t(locale, 'servicesPage.packagingLogistics.sustainability.items.0.examples.1'),
      t(locale, 'servicesPage.packagingLogistics.sustainability.items.0.examples.2'),
      t(locale, 'servicesPage.packagingLogistics.sustainability.items.0.examples.3'),
    ],
  },
  {
    title: t(locale, 'servicesPage.packagingLogistics.sustainability.items.1.title'),
    description: t(locale, 'servicesPage.packagingLogistics.sustainability.items.1.description'),
    examples: [
      t(locale, 'servicesPage.packagingLogistics.sustainability.items.1.examples.0'),
      t(locale, 'servicesPage.packagingLogistics.sustainability.items.1.examples.1'),
      t(locale, 'servicesPage.packagingLogistics.sustainability.items.1.examples.2'),
      t(locale, 'servicesPage.packagingLogistics.sustainability.items.1.examples.3'),
    ],
  },
  {
    title: t(locale, 'servicesPage.packagingLogistics.sustainability.items.2.title'),
    description: t(locale, 'servicesPage.packagingLogistics.sustainability.items.2.description'),
    examples: [
      t(locale, 'servicesPage.packagingLogistics.sustainability.items.2.examples.0'),
      t(locale, 'servicesPage.packagingLogistics.sustainability.items.2.examples.1'),
      t(locale, 'servicesPage.packagingLogistics.sustainability.items.2.examples.2'),
      t(locale, 'servicesPage.packagingLogistics.sustainability.items.2.examples.3'),
    ],
  },
];

const performanceMetrics = [
  { metric: t(locale, 'servicesPage.packagingLogistics.performance.items.0.metric'), label: t(locale, 'servicesPage.packagingLogistics.performance.items.0.label') },
  { metric: t(locale, 'servicesPage.packagingLogistics.performance.items.1.metric'), label: t(locale, 'servicesPage.packagingLogistics.performance.items.1.label') },
  { metric: t(locale, 'servicesPage.packagingLogistics.performance.items.2.metric'), label: t(locale, 'servicesPage.packagingLogistics.performance.items.2.label') },
  { metric: t(locale, 'servicesPage.packagingLogistics.performance.items.3.metric'), label: t(locale, 'servicesPage.packagingLogistics.performance.items.3.label') },
];
---

<BaseLayout title={t(locale, 'servicesPage.packagingLogistics.meta.title')} lang={locale} description={t(locale, 'servicesPage.packagingLogistics.meta.description')}>
  <div class="space-y-60">
    <section class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-violet-50 to-fuchsia-50 px-8 py-16">
      <picture class="pointer-events-none absolute inset-0 h-full w-full opacity-10" aria-hidden="true">
        <source srcset={heroImageSources.avifSrcSet} sizes="100vw" type="image/avif" />
        <source srcset={heroImageSources.webpSrcSet} sizes="100vw" type="image/webp" />
        <img
          src={heroImageSources.src}
          srcset={heroImageSources.webpSrcSet}
          sizes="100vw"
          alt=""
          loading="eager"
          fetchpriority="high"
          decoding="async"
          width="1600"
          height="900"
          class="absolute inset-0 h-full w-full object-cover"
        />
      </picture>
      <div class="relative mx-auto grid max-w-5xl gap-10 lg:grid-cols-2 lg:items-center">
        <div>
          <h1 class="text-4xl font-bold text-slate-900 md:text-6xl">
            {t(locale, 'servicesPage.packagingLogistics.hero.title1')}
            <span class="block bg-gradient-to-r from-violet-600 to-fuchsia-600 bg-clip-text text-transparent">{t(locale, 'servicesPage.packagingLogistics.hero.title2')}</span>
          </h1>
          <p class="mt-6 text-xl leading-relaxed text-slate-700">
            {t(locale, 'servicesPage.packagingLogistics.hero.description')}
          </p>
          <div class="mt-10 flex gap-3">
            <a class="rounded bg-violet-600 px-6 py-3 text-sm font-medium text-white hover:bg-violet-700" href={getLocalizedPath(locale, '/contact')}>{t(locale, 'servicesPage.packagingLogistics.hero.cta1')}</a>
            <a class="rounded border border-slate-300 px-6 py-3 text-sm font-medium text-slate-900" href={getLocalizedPath(locale, '/services')}>{t(locale, 'servicesPage.packagingLogistics.hero.cta2')}</a>
          </div>
        </div>
        <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
          <div class="aspect-[4/3]">
            <picture>
              <source srcset={packagingLogisticsImage.avifSrcSet} sizes="(min-width: 1024px) 33vw, 100vw" type="image/avif" />
              <source srcset={packagingLogisticsImage.webpSrcSet} sizes="(min-width: 1024px) 33vw, 100vw" type="image/webp" />
              <img
                src={packagingLogisticsImage.src}
                srcset={packagingLogisticsImage.webpSrcSet}
                sizes="(min-width: 1024px) 33vw, 100vw"
                alt={t(locale, 'servicesPage.packagingLogistics.hero.imgAlt')}
                loading="lazy"
                decoding="async"
                width="1200"
                height="900"
                class="h-full w-full object-cover"
              />
            </picture>
          </div>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-6">
      <h2 class="text-sm font-semibold uppercase tracking-[0.22em] text-slate-600">{t(locale, 'common.citableSummary')}</h2>
      <h3 class="mt-2 text-2xl font-bold text-slate-900">{t(locale, 'servicesPage.packagingLogistics.citable.heading')}</h3>
      <p class="mt-4 max-w-4xl text-lg leading-relaxed text-slate-700">
        {t(locale, 'servicesPage.packagingLogistics.citable.body')}
      </p>
    </section>

    <section class="space-y-10">
      <div class="text-center">
        <h2 class="text-3xl font-bold text-slate-900 md:text-4xl">{t(locale, 'servicesPage.packagingLogistics.services.heading')}</h2>
        <p class="mx-auto mt-4 max-w-2xl text-lg text-slate-700">
          {t(locale, 'servicesPage.packagingLogistics.services.sub')}
        </p>
      </div>
      <div class="grid gap-8 md:grid-cols-2">
        {packagingServices.map((s) => (
          <div class="rounded-2xl border border-slate-200 bg-white p-8 shadow-lg transition-all hover:-translate-y-1 hover:shadow-xl">
            <div class={`mb-6 h-16 w-16 rounded-2xl bg-gradient-to-r ${s.gradient}`} />
            <h3 class="text-2xl font-bold text-slate-900">{s.title}</h3>
            <p class="mt-4 text-slate-700">{s.description}</p>
            <div class="mt-6 grid grid-cols-2 gap-3">
              {s.features.map((f) => (
                <div class="flex items-center gap-2 text-sm text-slate-700">
                  <span class="h-2 w-2 rounded-2xl bg-emerald-500" />
                  <span>{f}</span>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="rounded-2xl bg-slate-50 px-8 py-16">
      <div class="text-center">
        <h2 class="text-3xl font-bold text-slate-900 md:text-4xl">{t(locale, 'servicesPage.packagingLogistics.types.heading')}</h2>
        <p class="mx-auto mt-4 max-w-2xl text-lg text-slate-700">
          {t(locale, 'servicesPage.packagingLogistics.types.sub')}
        </p>
      </div>
      <div class="mt-12 grid gap-8 lg:grid-cols-3">
        {packagingTypes.map((p) => (
          <div class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm">
            <h3 class="text-xl font-bold text-slate-900">{p.type}</h3>
            <p class="mt-3 text-slate-700">{p.description}</p>
            <div class="mt-6">
              <div class="text-sm font-semibold text-slate-900">{t(locale, 'servicesPage.packagingLogistics.types.applicationsLabel')}</div>
              <ul class="mt-3 space-y-2 text-sm text-slate-700">
                {p.applications.map((a) => (
                  <li class="flex items-start gap-3">
                    <span class="mt-2 h-2 w-2 flex-shrink-0 rounded-2xl bg-violet-600" />
                    <span>{a}</span>
                  </li>
                ))}
              </ul>
            </div>
            <div class="mt-6">
              <div class="text-sm font-semibold text-slate-900">{t(locale, 'servicesPage.packagingLogistics.types.featuresLabel')}</div>
              <div class="mt-3 flex flex-wrap gap-2">
                {p.features.map((f) => (
                  <span class="rounded bg-slate-100 px-3 py-1 text-xs text-slate-700">{f}</span>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="space-y-10">
      <div class="text-center">
        <h2 class="text-3xl font-bold text-slate-900 md:text-4xl">{t(locale, 'servicesPage.packagingLogistics.network.heading')}</h2>
        <p class="mx-auto mt-4 max-w-2xl text-lg text-slate-700">
          {t(locale, 'servicesPage.packagingLogistics.network.sub')}
        </p>
      </div>
      <div class="grid gap-8 md:grid-cols-2">
        {logisticsNetwork.map((n) => (
          <div class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm">
            <div class="flex flex-wrap items-center justify-between gap-3">
              <h3 class="text-xl font-bold text-slate-900">{n.region}</h3>
              <span class="rounded-2xl bg-slate-100 px-3 py-1 text-xs text-slate-700">{n.deliveryTime}</span>
            </div>
            <div class="mt-3 text-slate-700">{n.coverage}</div>
            <div class="mt-6">
              <div class="text-sm font-semibold text-slate-900">{t(locale, 'servicesPage.packagingLogistics.network.hubsLabel')}</div>
              <div class="mt-3 flex flex-wrap gap-2">
                {n.hubs.map((h) => (
                  <span class="rounded bg-slate-100 px-3 py-1 text-xs text-slate-700">{h}</span>
                ))}
              </div>
            </div>
            <div class="mt-6">
              <div class="text-sm font-semibold text-slate-900">{t(locale, 'servicesPage.packagingLogistics.network.servicesLabel')}</div>
              <ul class="mt-3 space-y-2 text-sm text-slate-700">
                {n.services.map((s) => (
                  <li class="flex items-start gap-3">
                    <span class="mt-2 h-2 w-2 flex-shrink-0 rounded-2xl bg-emerald-500" />
                    <span>{s}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="rounded-2xl bg-slate-50 px-8 py-16">
      <div class="text-center">
        <h2 class="text-3xl font-bold text-slate-900 md:text-4xl">{t(locale, 'servicesPage.packagingLogistics.process.heading')}</h2>
        <p class="mx-auto mt-4 max-w-2xl text-lg text-slate-700">
          {t(locale, 'servicesPage.packagingLogistics.process.sub')}
        </p>
      </div>
      <div class="mt-12 space-y-6">
        {packagingProcess.map((step) => (
          <div class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm">
            <div class="grid gap-6 lg:grid-cols-[260px_1fr]">
              <div class="flex items-center gap-6">
                <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-gradient-to-r from-violet-600 to-fuchsia-600">
                  <span class="text-xl font-bold text-white">{step.step}</span>
                </div>
                <div>
                  <div class="text-xl font-bold text-slate-900">{step.title}</div>
                </div>
              </div>
              <div>
                <p class="text-slate-700">{step.description}</p>
                <div class="mt-4 flex flex-wrap gap-2">
                  {step.deliverables.map((d) => (
                    <span class="rounded bg-slate-100 px-3 py-1 text-xs text-slate-700">{d}</span>
                  ))}
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="space-y-10">
      <div class="text-center">
        <h2 class="text-3xl font-bold text-slate-900 md:text-4xl">{t(locale, 'servicesPage.packagingLogistics.sustainability.heading')}</h2>
        <p class="mx-auto mt-4 max-w-2xl text-lg text-slate-700">
          {t(locale, 'servicesPage.packagingLogistics.sustainability.sub')}
        </p>
      </div>
      <div class="grid gap-8 lg:grid-cols-3">
        {sustainabilityFeatures.map((s) => (
          <div class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm">
            <h3 class="text-xl font-bold text-slate-900">{s.title}</h3>
            <p class="mt-3 text-slate-700">{s.description}</p>
            <div class="mt-6 flex flex-wrap gap-2">
              {s.examples.map((e) => (
                <span class="rounded bg-slate-100 px-3 py-1 text-xs text-slate-700">{e}</span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="rounded-2xl bg-gradient-to-br from-violet-50 to-fuchsia-50 px-8 py-16">
      <div class="text-center">
        <h2 class="text-3xl font-bold text-slate-900 md:text-4xl">{t(locale, 'servicesPage.packagingLogistics.performance.heading')}</h2>
        <p class="mx-auto mt-4 max-w-2xl text-lg text-slate-700">
          {t(locale, 'servicesPage.packagingLogistics.performance.sub')}
        </p>
      </div>
      <div class="mt-12 grid gap-8 md:grid-cols-2 lg:grid-cols-4">
        {performanceMetrics.map((m) => (
          <div class="rounded-2xl border border-slate-200 bg-white p-8 text-center shadow-lg">
            <div class="text-4xl font-bold text-violet-600">{m.metric}</div>
            <div class="mt-2 font-medium text-slate-700">{m.label}</div>
          </div>
        ))}
      </div>
    </section>

    <section class="rounded-2xl bg-slate-900 px-8 py-16 text-white">
      <div class="mx-auto max-w-3xl text-center">
        <h2 class="text-3xl font-bold md:text-4xl">{t(locale, 'servicesPage.packagingLogistics.cta.title')}</h2>
        <p class="mx-auto mt-4 max-w-2xl text-xl text-slate-200">
          {t(locale, 'servicesPage.packagingLogistics.cta.description')}
        </p>
        <div class="mt-10 flex justify-center gap-3">
          <a class="rounded bg-violet-600 px-6 py-3 text-sm font-medium text-white hover:bg-violet-700" href={getLocalizedPath(locale, '/contact')}>{t(locale, 'servicesPage.packagingLogistics.cta.start')}</a>
          <a class="rounded border border-white/30 px-6 py-3 text-sm font-medium text-white" href={getLocalizedPath(locale, '/services')}>{t(locale, 'servicesPage.packagingLogistics.cta.back')}</a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

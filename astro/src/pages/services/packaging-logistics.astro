      t(locale, 'servicesPage.packagingLogistics.network.items.2.hubs.2'),
    ],
    deliveryTime: t(locale, 'servicesPage.packagingLogistics.network.items.2.deliveryTime'),
    services: [
      t(locale, 'servicesPage.packagingLogistics.network.items.2.services.0'),

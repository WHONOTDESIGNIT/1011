---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t } from '../../lib/i18n';
import { getLocalizedPath } from '../../lib/breadcrumbs';
import { responsiveImageSources } from '../../lib/netlify-images';

const locale = Astro.currentLocale ?? 'en';
const headerTitle = t(locale, 'componentsPower.header.title');
const headerDescription = t(locale, 'componentsPower.header.description');
// EN SEO 富化标题（仅 meta title；页内 H1/文案仍用 componentsPower 共享字段）
const seoTitle = locale === 'en' ? 'IPL Components & Parts | iShine Device Manufacturer' : headerTitle;
const introTitle = t(locale, 'componentsPower.intro.title');
const introParagraph = t(locale, 'componentsPower.intro.paragraph');
const overviewTitle = t(locale, 'componentsPower.overview.title');

const core = [
  {
    slug: 'lamp-cartridges',
    title: t(locale, 'componentsPower.core.lamp.title'),
    description: t(locale, 'componentsPower.core.lamp.description'),
    paragraph: t(locale, 'componentsPower.core.lamp.paragraph'),
    image: 'https://images.pexels.com/photos/876453/pexels-photo-876453.jpeg?auto=compress&cs=tinysrgb&w=1200',
    imageAlt: t(locale, 'componentsPower.core.lamp.imageAlt'),
    cta: t(locale, 'componentsPower.core.lamp.cta'),
    specs: [
      t(locale, 'componentsPower.core.lamp.specs.0'),
      t(locale, 'componentsPower.core.lamp.specs.1'),
      t(locale, 'componentsPower.core.lamp.specs.2'),
      t(locale, 'componentsPower.core.lamp.specs.3'),
    ],
  },
  {
    slug: 'optical-filters',
    title: t(locale, 'componentsPower.core.filter.title'),
    description: t(locale, 'componentsPower.core.filter.description'),
    paragraph: t(locale, 'componentsPower.core.filter.paragraph'),
    image: 'https://images.pexels.com/photos/4910460/pexels-photo-4910460.jpeg?auto=compress&cs=tinysrgb&w=1200',
    imageAlt: t(locale, 'componentsPower.core.filter.imageAlt'),
    cta: t(locale, 'componentsPower.core.filter.cta'),
    specs: [
      t(locale, 'componentsPower.core.filter.specs.0'),
      t(locale, 'componentsPower.core.filter.specs.1'),
      t(locale, 'componentsPower.core.filter.specs.2'),
      t(locale, 'componentsPower.core.filter.specs.3'),
    ],
  },
  {
    slug: 'cooling-system',
    title: t(locale, 'componentsPower.core.cooling.title'),
    description: t(locale, 'componentsPower.core.cooling.description'),
    paragraph: t(locale, 'componentsPower.core.cooling.paragraph'),
    image: 'https://images.pexels.com/photos/28101196/pexels-photo-28101196.jpeg?auto=compress&cs=tinysrgb&w=1200',
    imageAlt: t(locale, 'componentsPower.core.cooling.imageAlt'),
    cta: t(locale, 'componentsPower.core.cooling.cta'),
    specs: [
      t(locale, 'componentsPower.core.cooling.specs.0'),
      t(locale, 'componentsPower.core.cooling.specs.1'),
      t(locale, 'componentsPower.core.cooling.specs.2'),
      t(locale, 'componentsPower.core.cooling.specs.3'),
    ],
  },
  {
    slug: 'power-supply',
    title: t(locale, 'componentsPower.core.power.title'),
    description: t(locale, 'componentsPower.core.power.description'),
    paragraph: t(locale, 'componentsPower.core.power.paragraph'),
    image: 'https://images.pexels.com/photos/7174683/pexels-photo-7174683.jpeg?auto=compress&cs=tinysrgb&w=1200',
    imageAlt: t(locale, 'componentsPower.core.power.imageAlt'),
    cta: t(locale, 'componentsPower.core.power.cta'),
    specs: [
      t(locale, 'componentsPower.core.power.specs.0'),
      t(locale, 'componentsPower.core.power.specs.1'),
      t(locale, 'componentsPower.core.power.specs.2'),
      t(locale, 'componentsPower.core.power.specs.3'),
    ],
  },
].map((item) => ({
  ...item,
  imageSources: responsiveImageSources(item.image),
}));

const customizationTitle = t(locale, 'componentsPower.customization.title');
const customizationDescription = t(locale, 'componentsPower.customization.description');
const ctaTitle = t(locale, 'componentsPower.cta.title');
const ctaDescription = t(locale, 'componentsPower.cta.description');
const ctaButton = t(locale, 'componentsPower.cta.button');
const heroBackgroundImageSources = responsiveImageSources(
  'https://images.pexels.com/photos/7285970/pexels-photo-7285970.jpeg?auto=compress&cs=tinysrgb&w=1600',
  [800, 1200, 1600],
  1600,
);
const componentsDiagramImage = responsiveImageSources(
  'https://images.pexels.com/photos/8237500/pexels-photo-8237500.jpeg?auto=compress&cs=tinysrgb&w=1600',
  [400, 800, 1200, 1600],
  1200,
);
---

<BaseLayout title={seoTitle} lang={locale} description={headerDescription || t(locale, 'componentsPage.meta.description')}>
  <div class="space-y-48">
    <section class="relative overflow-hidden rounded-2xl bg-ink-900 px-8 py-14 text-white">
      <picture class="pointer-events-none absolute inset-0 h-full w-full opacity-30" aria-hidden="true">
        <source srcset={heroBackgroundImageSources.avifSrcSet} sizes="100vw" type="image/avif" />
        <source srcset={heroBackgroundImageSources.webpSrcSet} sizes="100vw" type="image/webp" />
        <img
          src={heroBackgroundImageSources.src}
          srcset={heroBackgroundImageSources.webpSrcSet}
          sizes="100vw"
          alt=""
          loading="eager"
          fetchpriority="high"
          decoding="async"
          width="1600"
          height="900"
          class="absolute inset-0 h-full w-full object-cover"
        />
      </picture>
      <div class="pointer-events-none absolute inset-0 bg-black/40" />
      <div class="relative">
        <h1 class="text-4xl font-bold md:text-5xl">{headerTitle}</h1>
        <p class="mt-4 max-w-3xl text-lg text-neutral-200">{headerDescription}</p>
      </div>
    </section>

    <section class="space-y-10">
      <div class="text-center">
        <h2 class="text-3xl font-bold text-ink-900">{introTitle}</h2>
        <p class="mx-auto mt-4 max-w-3xl text-lg leading-relaxed text-neutral-700">{introParagraph}</p>
      </div>

      <div class="overflow-hidden rounded-2xl border border-neutral-200 bg-white shadow-sm">
        <div class="aspect-[16/9]">
          <picture>
            <source srcset={componentsDiagramImage.avifSrcSet} sizes="(min-width: 1024px) 72rem, 100vw" type="image/avif" />
            <source srcset={componentsDiagramImage.webpSrcSet} sizes="(min-width: 1024px) 72rem, 100vw" type="image/webp" />
            <img
              src={componentsDiagramImage.src}
              srcset={componentsDiagramImage.webpSrcSet}
              sizes="(min-width: 1024px) 72rem, 100vw"
              alt={t(locale, 'componentsPower.diagram.alt')}
              loading="lazy"
              decoding="async"
              width="1600"
              height="900"
              class="h-full w-full object-cover"
            />
          </picture>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-6">
      <h2 class="text-sm font-semibold uppercase tracking-[0.22em] text-neutral-600">{t(locale, 'common.citableSummary')}</h2>
      <h3 class="mt-2 text-2xl font-bold text-ink-900">{t(locale, 'componentsPage.citable.question')}</h3>
      <p class="mt-4 max-w-4xl text-lg leading-relaxed text-neutral-700">
        {t(locale, 'componentsPage.citable.paragraph')}
      </p>
    </section>

    <section class="space-y-8">
      <h2 class="text-center text-3xl font-bold text-ink-900">{overviewTitle}</h2>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        {core.map((item) => (
          <a class="block rounded-xl border border-neutral-200 bg-white p-6 shadow-sm hover:shadow-md" href={getLocalizedPath(locale, '/components/' + item.slug)}>
            <div class="mb-4 overflow-hidden rounded-xl bg-neutral-100" style="aspect-ratio:16/10">
              <picture>
                <source srcset={item.imageSources.avifSrcSet} sizes="(min-width: 1024px) 18rem, (min-width: 768px) 22rem, 100vw" type="image/avif" />
                <source srcset={item.imageSources.webpSrcSet} sizes="(min-width: 1024px) 18rem, (min-width: 768px) 22rem, 100vw" type="image/webp" />
                <img
                  src={item.imageSources.src}
                  srcset={item.imageSources.webpSrcSet}
                  sizes="(min-width: 1024px) 18rem, (min-width: 768px) 22rem, 100vw"
                  alt={item.imageAlt}
                  loading="lazy"
                  decoding="async"
                  width="1200"
                  height="750"
                  class="h-full w-full object-cover"
                />
              </picture>
            </div>
            <div class="text-xl font-semibold">{item.title}</div>
            <div class="mt-2 text-sm text-neutral-700">{item.description}</div>
            <ul class="mt-4 list-disc space-y-1 pl-5 text-sm text-neutral-700">
              {item.specs.map((s) => (
                <li>{s}</li>
              ))}
            </ul>
            <div class="mt-4 text-sm font-medium text-ink-900">{t(locale, 'common.viewDetails')}</div>
          </a>
        ))}
      </div>
    </section>

    <section class="space-y-16">
      {core.map((item, idx) => (
        <div class="grid gap-10 md:grid-cols-2 md:items-center">
          <div class={idx % 2 === 0 ? 'md:order-2' : 'md:order-1'}>
            <div class="overflow-hidden rounded-2xl border border-neutral-200 bg-white shadow-sm">
              <div class="aspect-[4/3]">
                <picture>
                  <source srcset={item.imageSources.avifSrcSet} sizes="(min-width: 768px) 50vw, 100vw" type="image/avif" />
                  <source srcset={item.imageSources.webpSrcSet} sizes="(min-width: 768px) 50vw, 100vw" type="image/webp" />
                  <img
                    src={item.imageSources.src}
                    srcset={item.imageSources.webpSrcSet}
                    sizes="(min-width: 768px) 50vw, 100vw"
                    alt={item.imageAlt}
                    loading="lazy"
                    decoding="async"
                    width="1200"
                    height="900"
                    class="h-full w-full object-cover"
                  />
                </picture>
              </div>
            </div>
          </div>
          <div class={idx % 2 === 0 ? 'md:order-1' : 'md:order-2'}>
            <h3 class="text-2xl font-bold text-ink-900">{item.title}</h3>
            <p class="mt-4 text-neutral-700">{item.paragraph}</p>
            <ul class="mt-6 space-y-2 text-neutral-700">
              {item.specs.map((s) => (
                <li class="flex items-start gap-2">
                  <span class="mt-1 h-2 w-2 flex-shrink-0 rounded-2xl bg-ink-900" />
                  <span class="text-sm">{s}</span>
                </li>
              ))}
            </ul>
            <div class="mt-8">
              <a class="inline-flex rounded bg-ink-900 px-4 py-2 text-sm font-medium text-white" href={getLocalizedPath(locale, '/components/' + item.slug)}>
                {item.cta}
              </a>
            </div>
          </div>
        </div>
      ))}
    </section>

    <section class="rounded-2xl border border-neutral-200 bg-white p-8">
      <h2 class="text-2xl font-bold text-ink-900">{customizationTitle}</h2>
      <p class="mt-3 max-w-3xl text-neutral-700">{customizationDescription}</p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a class="rounded bg-ink-900 px-4 py-2 text-sm font-medium text-white" href={getLocalizedPath(locale, '/contact')}>{ctaButton}</a>
        <a class="rounded border border-neutral-300 px-4 py-2 text-sm font-medium text-ink-900" href={getLocalizedPath(locale, '/services')}>{t(locale, 'common.viewServices')}</a>
      </div>
    </section>

    <section class="rounded-2xl bg-ink-900 px-8 py-12 text-white">
      <h2 class="text-2xl font-bold">{ctaTitle}</h2>
      <p class="mt-3 max-w-3xl text-neutral-200">{ctaDescription}</p>
      <div class="mt-6">
        <a class="inline-flex rounded bg-white px-4 py-2 text-sm font-medium text-ink-900" href={getLocalizedPath(locale, '/contact')}>{ctaButton}</a>
      </div>
    </section>
  </div>
</BaseLayout>

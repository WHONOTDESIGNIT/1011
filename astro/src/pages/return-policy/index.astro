---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { t } from '../../lib/i18n';
import { getLocalizedPath, buildBreadcrumbs } from '../../lib/breadcrumbs';

// 文案全部走 messages/<locale>.json 的 auxPages.returnPolicy.*（93 个键，英文基准见
// MD-PRODUCTS-INFOS/_return_policy_en.json）。此前这里是硬编码英文，22 个语种渲染的都是
// 英文，canonical 也只能固定指向英文版，因此 21 个语种的 /return-policy 既不在各自
// sitemap 里、也不进索引的本地化集合。
// 21 个语种的译文已于 2026-09-14 全部落库，故此处 canonical 同步改为 getLocalizedPath 自指
// ——顺序不可颠倒：先有译本、再切自指，否则会产生 21 个 self-canonical 的英文页
//（正是隐私政策页 2026-09-10 修掉的那种重复内容形态）。
const locale = Astro.currentLocale ?? 'en';
const tr = (key: string) => t(locale, `auxPages.returnPolicy.${key}`);

function resolveBaseUrl() {
  return (process.env.URL ?? process.env.DEPLOY_PRIME_URL ?? process.env.SITE_URL ?? 'https://iplmanufacturer.com').replace(/\/$/, '');
}

const pageTitle = tr('pageTitle');
const pageDescription = tr('pageDescription');
const canonical = `${resolveBaseUrl()}${getLocalizedPath(locale, '/return-policy')}`;

const breadcrumbs = buildBreadcrumbs(locale, [
  { label: t(locale, 'common.home'), path: '/' },
  { label: tr('breadcrumb') },
]);

const toc = [
  { id: 'returns-accepted', label: tr('toc1') },
  { id: 'return-conditions', label: tr('toc2') },
  { id: 'return-process', label: tr('toc3') },
  { id: 'return-costs', label: tr('toc4') },
  { id: 'batch-return', label: tr('toc5') },
  { id: 'exchanges', label: tr('toc6') },
  { id: 'spare-units', label: tr('toc7') },
  { id: 'not-eligible', label: tr('toc8') },
  { id: 'warranty', label: tr('toc9') },
  { id: 'refund-processing', label: tr('toc10') },
  { id: 'contact', label: tr('toc11') },
  { id: 'final-interpretation', label: tr('toc12') },
];

const contact = {
  email: 'service@ishineco.com',
  phone: '+86 150 1289 1148',
  website: 'iplmanufacturer.com',
};
---

<BaseLayout title={pageTitle} lang={locale} description={pageDescription} canonical={canonical} stickyNav={false}>
  <div class="mx-auto max-w-5xl px-6 py-12">
    <div class="space-y-10">
      <header class="space-y-6">
        <Breadcrumb items={breadcrumbs} variant="dark" locale={locale} />
        <div class="space-y-3">
          <p class="text-sm font-semibold uppercase tracking-[0.22em] text-slate-500">{tr('companyName')}</p>
          <h1 class="text-4xl font-bold text-slate-950 md:text-5xl">{tr('h1')}</h1>
          <p class="max-w-3xl text-lg leading-relaxed text-neutral-600">{tr('lastUpdated')}</p>
        </div>
      </header>

      <section class="rounded-2xl border border-neutral-200 bg-white p-8 shadow-sm">
        <h2 class="text-sm font-semibold uppercase tracking-[0.22em] text-neutral-600">{tr('tocTitle')}</h2>
        <ol class="mt-6 list-decimal space-y-2 pl-6 text-neutral-700">
          {toc.map((item) => (
            <li><a class="text-sky-700 underline" href={`#${item.id}`}>{item.label}</a></li>
          ))}
        </ol>
      </section>

      <section class="space-y-10">
        <section id="returns-accepted" class="rounded-2xl border border-neutral-200 bg-white p-8 shadow-sm">
          <h2 class="text-2xl font-bold text-ink-900">{tr('s1Title')}</h2>
          <p class="mt-4 text-neutral-700">{tr('s1p1')}</p>
          <p class="mt-4 text-neutral-700">{tr('s1p2')}</p>
        </section>

        <section id="return-conditions" class="rounded-2xl border border-neutral-200 bg-white p-8 shadow-sm">
          <h2 class="text-2xl font-bold text-ink-900">{tr('s2Title')}</h2>
          <div class="mt-6 overflow-x-auto">
            <table class="w-full min-w-[640px] border-collapse text-left text-sm text-neutral-700">
              <thead>
                <tr class="border-b border-neutral-200 bg-neutral-50 text-ink-900">
                  <th class="px-4 py-3 font-semibold">{tr('s2col1')}</th>
                  <th class="px-4 py-3 font-semibold">{tr('s2col2')}</th>
                </tr>
              </thead>
              <tbody>
                {[
                  ['s2r1Label', 's2r1Text'],
                  ['s2r2Label', 's2r2Text'],
                  ['s2r3Label', 's2r3Text'],
                  ['s2r4Label', 's2r4Text'],
                  ['s2r5Label', 's2r5Text'],
                  ['s2r6Label', 's2r6Text'],
                ].map(([labelKey, textKey], i, all) => (
                  <tr class={i === all.length - 1 ? '' : 'border-b border-neutral-100'}>
                    <td class="px-4 py-3 align-top font-medium text-ink-900">{tr(labelKey)}</td>
                    <td class="px-4 py-3 align-top">{tr(textKey)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>

        <section id="return-process" class="rounded-2xl border border-neutral-200 bg-white p-8 shadow-sm">
          <h2 class="text-2xl font-bold text-ink-900">{tr('s3Title')}</h2>
          <ol class="mt-6 list-decimal space-y-4 pl-6 text-neutral-700">
            <li>
              <span class="font-semibold text-ink-900">{tr('s3i1Lead')}</span> {tr('s3i1Mid')} <a class="text-sky-700 underline" href={`mailto:${contact.email}`}>{contact.email}</a> {tr('s3i1After')}
              <ul class="mt-2 list-disc space-y-1 pl-6">
                <li>{tr('s3i1l1')}</li>
                <li>{tr('s3i1l2')}</li>
                <li>{tr('s3i1l3')}</li>
                <li>{tr('s3i1l4')}</li>
              </ul>
            </li>
            <li>
              <span class="font-semibold text-ink-900">{tr('s3i2Lead')}</span> – {tr('s3i2Text')}
            </li>
            <li>
              <span class="font-semibold text-ink-900">{tr('s3i3Lead')}</span> – {tr('s3i3Text')}
            </li>
            <li>
              <span class="font-semibold text-ink-900">{tr('s3i4Lead')}</span> – {tr('s3i4Text')}
            </li>
            <li>
              <span class="font-semibold text-ink-900">{tr('s3i5Lead')}</span> – {tr('s3i5Text')}
            </li>
          </ol>
        </section>

        <section id="return-costs" class="rounded-2xl border border-neutral-200 bg-white p-8 shadow-sm">
          <h2 class="text-2xl font-bold text-ink-900">{tr('s4Title')}</h2>
          <div class="mt-6 overflow-x-auto">
            <table class="w-full min-w-[640px] border-collapse text-left text-sm text-neutral-700">
              <thead>
                <tr class="border-b border-neutral-200 bg-neutral-50 text-ink-900">
                  <th class="px-4 py-3 font-semibold">{tr('s4col1')}</th>
                  <th class="px-4 py-3 font-semibold">{tr('s4col2')}</th>
                  <th class="px-4 py-3 font-semibold">{tr('s4col3')}</th>
                  <th class="px-4 py-3 font-semibold">{tr('s4col4')}</th>
                </tr>
              </thead>
              <tbody>
                {[
                  ['s4r1c1', 's4r1c2', 's4r1c3', 's4r1c4'],
                  ['s4r2c1', 's4r2c2', 's4r2c3', 's4r2c4'],
                ].map((row, i, all) => (
                  <tr class={i === all.length - 1 ? '' : 'border-b border-neutral-100'}>
                    <td class="px-4 py-3 align-top font-medium text-ink-900">{tr(row[0])}</td>
                    <td class="px-4 py-3 align-top">{tr(row[1])}</td>
                    <td class="px-4 py-3 align-top">{tr(row[2])}</td>
                    <td class="px-4 py-3 align-top">{tr(row[3])}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>

        <section id="batch-return" class="rounded-2xl border border-neutral-200 bg-white p-8 shadow-sm">
          <h2 class="text-2xl font-bold text-ink-900">{tr('s5Title')}</h2>
          <p class="mt-4 text-neutral-700">{tr('s5p1')}</p>
          <ul class="mt-4 list-disc space-y-2 pl-6 text-neutral-700">
            <li>{tr('s5l1')}</li>
            <li>{tr('s5l2')}</li>
            <li>{tr('s5l3')}</li>
          </ul>
        </section>

        <section id="exchanges" class="rounded-2xl border border-neutral-200 bg-white p-8 shadow-sm">
          <h2 class="text-2xl font-bold text-ink-900">{tr('s6Title')}</h2>
          <ul class="mt-6 list-disc space-y-2 pl-6 text-neutral-700">
            <li>{tr('s6l1')}</li>
            <li>{tr('s6l2')}</li>
            <li>{tr('s6l3')}</li>
            <li>{tr('s6l4')}</li>
          </ul>
        </section>

        <section id="spare-units" class="rounded-2xl border border-neutral-200 bg-white p-8 shadow-sm">
          <h2 class="text-2xl font-bold text-ink-900">{tr('s7Title')}</h2>
          <p class="mt-4 text-neutral-700">{tr('s7p1')}</p>
        </section>

        <section id="not-eligible" class="rounded-2xl border border-neutral-200 bg-white p-8 shadow-sm">
          <h2 class="text-2xl font-bold text-ink-900">{tr('s8Title')}</h2>
          <ul class="mt-6 list-disc space-y-2 pl-6 text-neutral-700">
            <li>{tr('s8l1')}</li>
            <li>{tr('s8l2')}</li>
            <li>{tr('s8l3')}</li>
          </ul>
        </section>

        <section id="warranty" class="rounded-2xl border border-neutral-200 bg-white p-8 shadow-sm">
          <h2 class="text-2xl font-bold text-ink-900">{tr('s9Title')}</h2>
          <p class="mt-4 text-neutral-700">{tr('s9p1')}</p>
        </section>

        <section id="refund-processing" class="rounded-2xl border border-neutral-200 bg-white p-8 shadow-sm">
          <h2 class="text-2xl font-bold text-ink-900">{tr('s10Title')}</h2>
          <p class="mt-4 text-neutral-700">{tr('s10p1')}</p>
        </section>

        <section id="contact" class="rounded-2xl border border-neutral-200 bg-white p-8 shadow-sm">
          <h2 class="text-2xl font-bold text-ink-900">{tr('s11Title')}</h2>
          <div class="mt-6 rounded-2xl border border-neutral-200 bg-neutral-50 p-6 text-sm text-neutral-700">
            <p class="font-semibold text-ink-900">{tr('companyName')}</p>
            <p>{tr('s11emailLabel')} <a class="text-sky-700 underline" href={`mailto:${contact.email}`}>{contact.email}</a></p>
            <p>{tr('s11websiteLabel')} <a class="text-sky-700 underline" href="https://iplmanufacturer.com/" target="_blank" rel="noopener">{contact.website}</a></p>
            <p>{tr('s11phoneLabel')} <a class="text-sky-700 underline" href="tel:+8615012891148">{contact.phone}</a></p>
          </div>
          <p class="mt-4 text-neutral-700">{tr('s11outro')}</p>
        </section>

        <section id="final-interpretation" class="rounded-2xl border border-neutral-200 bg-white p-8 shadow-sm">
          <h2 class="text-2xl font-bold text-ink-900">{tr('s12Title')}</h2>
          <p class="mt-4 text-neutral-700">{tr('s12p1')}</p>
        </section>
      </section>
    </div>
  </div>
</BaseLayout>

            <span class="review-meta">{t(locale, 'develoSocial.testimonialsPage.reviews.google.meta')}</span>
            <a class="review-link" href="https://www.google.com/search?q=develo+design+reviews" target="_blank" rel="noopener">{t(locale, 'develoSocial.testimonialsPage.reviews.google.cta')} <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M7 17L17 7M17 7H7M17 7V17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
          </div>
          <div class="review-card">
            <div class="review-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
            <span class="review-score">{t(locale, 'develoSocial.testimonialsPage.reviews.clutch.score')}</span>
            <span class="review-meta">{t(locale, 'develoSocial.testimonialsPage.reviews.clutch.meta')}</span>
            <a class="review-link" href="https://clutch.co/profile/develo-design" target="_blank" rel="noopener">{t(locale, 'develoSocial.testimonialsPage.reviews.clutch.cta')} <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M7 17L17 7M17 7H7M17 7V17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></a>

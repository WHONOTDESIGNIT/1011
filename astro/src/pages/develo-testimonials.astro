  <!-- ═══ BLOG ═══ -->
  <section class="blog-section">
    <div class="section-container">
      <div class="blog-header">
        <div>
          <p style="font-family:Manrope,sans-serif;font-size:14px;font-weight:600;color:var(--blue);text-transform:uppercase;letter-spacing:.5px;margin-bottom:8px">{t(locale, 'develoSocial.testimonialsPage.blog.label')}</p>
          <h2>{t(locale, 'develoSocial.testimonialsPage.blog.heading')}</h2>

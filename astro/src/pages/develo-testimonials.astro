﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿---
// Develo Design — Testimonials & Reviews
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { t } from '../lib/i18n';
import { getLocalizedPath } from '../lib/breadcrumbs';

const locale = Astro.currentLocale ?? 'en';
---
<!doctype html>
<html lang={locale} dir={locale === 'ar' || locale === 'he' || locale === 'fa' ? 'rtl' : 'ltr'}>
<head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<script is:inline>
  // 语言偏好持久化：读取用户选定的语言（localStorage），
  // 若当前 URL 语言与偏好不一致，立即重定向到偏好语言对应页面（支持 en/tr/ar）
  (function () {
    var KEY = 'ishine_lang';
    try {
      var stored = localStorage.getItem(KEY);
      if (!stored) return;
      var LANGS = ['tr', 'ro', 'ar', 'es', 'fr', 'ru', 'he', 'fa', 'el', 'pt-BR', 'nl', 'id', 'th', 'pl', 'ja', 'ko'];
      var path = window.location.pathname;
      var cur = 'en';
      for (var i = 0; i < LANGS.length; i++) {
        if (path === '/' + LANGS[i] || path.indexOf('/' + LANGS[i] + '/') === 0) {
          cur = LANGS[i];
          break;
        }
      }
      if (stored === cur) return;
      var stripped = path;
      for (var j = 0; j < LANGS.length; j++) {
        stripped = stripped.replace(new RegExp('^/' + LANGS[j] + '/?'), '');
      }
      if (stored === 'en') {
        stripped = stripped.replace(/\/+$/, '');
        if (stripped === '' || stripped === '/') stripped = '/';
        if (stripped !== path) window.location.replace(stripped);
      } else {
        var target = '/' + stored + (stripped === '' || stripped === '/' ? '' : stripped);
        target = target.replace(/\/+$/, '');
        if (target === '') target = '/' + stored;
        if (target !== path) window.location.replace(target);
      }
    } catch (e) { /* 隐私模式等场景忽略 */ }
  })();
</script>
<title>Testimonials &amp; Reviews | Develo Design</title>
<meta name="description" content="What Our Clients Say. Read testimonials and reviews from brands who trust Develo for Magento, Adobe Commerce and Hyva development." />
<link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=Syne:wght@400;700&display=swap" rel="stylesheet" />
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{--blue:#563cfa;--black:#020303;--white:#fff;--grey-50:#f9fafb;--grey-100:#f3f4f6;--grey-200:#e5e7eb;--grey-400:#9ca3af;--grey-500:#6b7280;--grey-text:#4b5563;--max-w:1536px;--pad-100:100px}
html{scroll-behavior:smooth;overflow-x:hidden}
body{font-family:Manrope,-apple-system,Roboto,Helvetica,sans-serif;font-size:16px;font-weight:400;color:#000;background:#fff;overflow-x:hidden;-webkit-font-smoothing:antialiased}
a{text-decoration:none;color:inherit}img{max-width:100%;height:auto;display:block}

.trust-bar{position:fixed;top:0;left:0;right:0;z-index:100;height:60px;display:flex;align-items:center;justify-content:center;background:transparent}
.trust-bar-inner{display:flex;align-items:center}
.trust-slide{display:flex;align-items:center;justify-content:center;gap:8px;padding:12px 24px}
.trust-slide[aria-hidden="true"]{display:none}.trust-slide[aria-hidden="false"]{display:flex}
.trust-text{font-family:Manrope,sans-serif;font-size:16px;font-weight:400;color:#020303;line-height:25px}
.site-header{position:fixed;top:66px;left:50%;transform:translate(-50%);width:calc(100% - 48px);max-width:1400px;z-index:110}
.header-inner{display:flex;align-items:center;justify-content:space-between;height:70px;padding:0 24px 0 40px;background:rgba(255,255,255,.9);border-radius:40px;box-shadow:0 10px 24px rgba(2,3,3,.06);gap:40px}
.header-logo{display:flex;align-items:center;flex-shrink:0}
.header-nav{display:flex;align-items:center;gap:8px}
.nav-item{display:flex;align-items:center;gap:4px;padding:12px 16px;font-family:Manrope,sans-serif;font-size:16px;font-weight:400;color:#020303;line-height:25px;background:transparent;border:none;cursor:pointer;border-radius:8px;transition:background .2s;white-space:nowrap}
.nav-item:hover{background:rgba(0,0,0,.04)}
.header-cta{display:flex;align-items:center;gap:12px}
.btn-primary{display:inline-flex;align-items:center;justify-content:center;gap:6px;padding:12px 20px;background:var(--blue);color:#fff;font-family:Manrope,sans-serif;font-size:16px;font-weight:400;line-height:16px;border-radius:100px;border:none;cursor:pointer;white-space:nowrap;transition:all .2s;text-decoration:none}
.btn-primary:hover{gap:16px;background:#374151}
.btn-outline{display:inline-flex;align-items:center;justify-content:center;gap:6px;padding:12px 20px;background:transparent;color:var(--black);font-family:Manrope,sans-serif;font-size:16px;font-weight:400;line-height:16px;border-radius:100px;border:1px solid var(--black);cursor:pointer;white-space:nowrap;transition:all .2s;text-decoration:none}
.btn-outline:hover{background:var(--black);color:#fff}
.desktop-nav{display:flex}
@media(max-width:959px){.desktop-nav{display:none}.header-cta .btn-primary{display:none}}
@media(max-width:767px){.site-header{top:66px;width:calc(100% - 32px)}.header-inner{height:56px;padding:0 24px 0 32px}}

.page-main{margin-top:136px}
.section-container{max-width:var(--max-w);margin:0 auto;padding:0 var(--pad-100)}

/* ═══ HERO ═══ */
.hero-section{padding:40px 0 60px}
.hero-label{font-family:Manrope,sans-serif;font-size:16px;font-weight:400;color:var(--grey-500);text-transform:uppercase;letter-spacing:.5px;margin-bottom:8px}
.hero-title{font-family:Syne,sans-serif;font-size:44px;font-weight:400;line-height:52px;letter-spacing:-.43px;color:var(--black);margin:0}

/* ═══ TESTIMONIALS GRID ═══ */
.testimonials-section{padding:0 0 80px}
.testimonials-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
.testimonial-card{display:flex;flex-direction:column;gap:16px;padding:32px;border:1px solid var(--grey-200);border-radius:16px;transition:all .2s}
.testimonial-card:hover{border-color:var(--grey-400)}
.testimonial-quote{font-family:Manrope,sans-serif;font-size:16px;font-weight:400;line-height:25px;color:var(--black)}
.testimonial-quote::before{content:'\201C';font-family:Syne,sans-serif;font-size:48px;color:var(--blue);display:block;line-height:1;margin-bottom:4px}
.testimonial-author{font-family:Manrope,sans-serif;font-size:14px;font-weight:600;color:var(--black);line-height:21px}
.testimonial-role{font-family:Manrope,sans-serif;font-size:13px;font-weight:400;color:var(--grey-500);line-height:19px}
.testimonial-link{display:inline-flex;align-items:center;gap:4px;font-family:Manrope,sans-serif;font-size:14px;font-weight:500;color:var(--blue);margin-top:auto}
.testimonials-pagination{display:flex;align-items:center;justify-content:center;gap:12px;margin-top:32px;font-family:Manrope,sans-serif;font-size:14px;color:var(--grey-500)}

/* ═══ REVIEWS ═══ */
.reviews-section{padding:80px 0;background:var(--black);color:#fff}
.reviews-grid{display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:center}
.reviews-text{display:flex;flex-direction:column;gap:16px;max-width:460px}
.reviews-text h2{font-family:Syne,sans-serif;font-size:32px;font-weight:400;line-height:40px;color:#fff;margin:0}
.reviews-text p{font-family:Manrope,sans-serif;font-size:17px;font-weight:400;line-height:28px;color:rgba(255,255,255,.7)}
.reviews-cards{display:flex;flex-direction:column;gap:20px}
.review-card{display:flex;flex-direction:column;gap:12px;padding:28px 32px;border:1px solid rgba(255,255,255,.15);border-radius:16px;transition:border-color .2s}
.review-card:hover{border-color:rgba(255,255,255,.4)}
.review-stars{display:flex;gap:2px;color:#f59e0b;font-size:20px}
.review-score{font-family:Syne,sans-serif;font-size:24px;font-weight:400;color:#fff;line-height:32px}
.review-meta{font-family:Manrope,sans-serif;font-size:14px;font-weight:400;color:rgba(255,255,255,.6);line-height:21px}
.review-link{display:inline-flex;align-items:center;gap:4px;font-family:Manrope,sans-serif;font-size:14px;font-weight:500;color:var(--blue);margin-top:4px}

/* ═══ BLOG ═══ */
.blog-section{padding:80px 0}
.blog-header{display:flex;align-items:flex-end;justify-content:space-between;margin-bottom:32px;flex-wrap:wrap;gap:16px}
.blog-header h2{font-family:Syne,sans-serif;font-size:32px;font-weight:400;line-height:40px;color:var(--black);margin:0}
.blog-header p{font-family:Manrope,sans-serif;font-size:16px;font-weight:400;line-height:25px;color:var(--grey-text);max-width:460px}
.blog-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
.blog-card{display:flex;flex-direction:column;gap:12px;padding:24px;border:1px solid var(--grey-200);border-radius:16px;transition:all .2s}
.blog-card:hover{border-color:var(--grey-400);transform:translateY(-2px)}
.blog-card h3{font-family:Syne,sans-serif;font-size:18px;font-weight:400;line-height:26px;color:var(--black);margin:0;transition:color .2s}
.blog-card:hover h3{color:var(--blue)}

@media(max-width:1279px){.section-container{padding:0 40px}.testimonials-grid{grid-template-columns:repeat(2,1fr)}.blog-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:959px){.reviews-grid{grid-template-columns:1fr}}
@media(max-width:767px){
  .section-container{padding:0 24px}
  .hero-title{font-size:34px;line-height:42px;letter-spacing:-.33px}
  .testimonials-grid{grid-template-columns:1fr}
  .blog-grid{grid-template-columns:1fr}
  .reviews-text h2,.blog-header h2{font-size:26px;line-height:34px}
}
</style>
</head>
<body>

<SiteHeader />

<main class="page-main">

  <!-- ═══ HERO ═══ -->
  <section class="hero-section">
    <div class="section-container">
      <p class="hero-label">{t(locale, 'develoSocial.testimonialsPage.hero.label')}</p>
      <h1 class="hero-title">{t(locale, 'develoSocial.testimonialsPage.hero.heading')}</h1>
    </div>
  </section>

  <!-- ═══ TESTIMONIALS ═══ -->
  <section class="testimonials-section">
    <div class="section-container">
      <div class="testimonials-grid">
        <div class="testimonial-card">
          <p class="testimonial-quote">{t(locale, 'develoSocial.testimonialsPage.testimonials.dominika.quote')}</p>
          <div><span class="testimonial-author">Dominika Miler-Zydek</span><br/><span class="testimonial-role">{t(locale, 'develoSocial.testimonialsPage.testimonials.dominika.role')}</span></div>
          <a class="testimonial-link" href={getLocalizedPath(locale, '/work/currys')}>{t(locale, 'develoSocial.testimonialsPage.seeCaseStudy')} <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M7 17L17 7M17 7H7M17 7V17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
        </div>
        <div class="testimonial-card">
          <p class="testimonial-quote">{t(locale, 'develoSocial.testimonialsPage.testimonials.aliceSorbyHyva.quote')}</p>
          <div><span class="testimonial-author">Alice Sorby</span><br/><span class="testimonial-role">{t(locale, 'develoSocial.testimonialsPage.testimonials.aliceSorbyHyva.role')}</span></div>
          <a class="testimonial-link" href={getLocalizedPath(locale, '/work/daylesford')}>{t(locale, 'develoSocial.testimonialsPage.seeCaseStudy')} <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M7 17L17 7M17 7H7M17 7V17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
        </div>
        <div class="testimonial-card">
          <p class="testimonial-quote">{t(locale, 'develoSocial.testimonialsPage.testimonials.pippaSilva.quote')}</p>
          <div><span class="testimonial-author">Pippa Silva</span><br/><span class="testimonial-role">{t(locale, 'develoSocial.testimonialsPage.testimonials.pippaSilva.role')}</span></div>
          <a class="testimonial-link" href={getLocalizedPath(locale, '/work/brandalley')}>{t(locale, 'develoSocial.testimonialsPage.seeCaseStudy')} <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M7 17L17 7M17 7H7M17 7V17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
        </div>
        <div class="testimonial-card">
          <p class="testimonial-quote">{t(locale, 'develoSocial.testimonialsPage.testimonials.aliceSorbyTeam.quote')}</p>
          <div><span class="testimonial-author">Alice Sorby</span><br/><span class="testimonial-role">{t(locale, 'develoSocial.testimonialsPage.testimonials.aliceSorbyTeam.role')}</span></div>
          <a class="testimonial-link" href={getLocalizedPath(locale, '/work/bamford')}>{t(locale, 'develoSocial.testimonialsPage.seeCaseStudy')} <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M7 17L17 7M17 7H7M17 7V17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
        </div>
        <div class="testimonial-card">
          <p class="testimonial-quote">{t(locale, 'develoSocial.testimonialsPage.testimonials.rileyBeament.quote')}</p>
          <div><span class="testimonial-author">Riley Beament</span><br/><span class="testimonial-role">{t(locale, 'develoSocial.testimonialsPage.testimonials.rileyBeament.role')}</span></div>
          <a class="testimonial-link" href={getLocalizedPath(locale, '/work/leonpaul')}>{t(locale, 'develoSocial.testimonialsPage.seeCaseStudy')} <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M7 17L17 7M17 7H7M17 7V17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
        </div>
        <div class="testimonial-card">
          <p class="testimonial-quote">{t(locale, 'develoSocial.testimonialsPage.testimonials.johnSpencer.quote')}</p>
          <div><span class="testimonial-author">John Spencer</span><br/><span class="testimonial-role">{t(locale, 'develoSocial.testimonialsPage.testimonials.johnSpencer.role')}</span></div>
        </div>
        <div class="testimonial-card">
          <p class="testimonial-quote">{t(locale, 'develoSocial.testimonialsPage.testimonials.benHawes.quote')}</p>
          <div><span class="testimonial-author">Ben Hawes</span><br/><span class="testimonial-role">{t(locale, 'develoSocial.testimonialsPage.testimonials.benHawes.role')}</span></div>
        </div>
        <div class="testimonial-card">
          <p class="testimonial-quote">{t(locale, 'develoSocial.testimonialsPage.testimonials.gemmaEdwards.quote')}</p>
          <div><span class="testimonial-author">Gemma Edwards</span><br/><span class="testimonial-role">{t(locale, 'develoSocial.testimonialsPage.testimonials.gemmaEdwards.role')}</span></div>
        </div>
        <div class="testimonial-card">
          <p class="testimonial-quote">{t(locale, 'develoSocial.testimonialsPage.testimonials.crisBrookes.quote')}</p>
          <div><span class="testimonial-author">Cris Brookes</span><br/><span class="testimonial-role">{t(locale, 'develoSocial.testimonialsPage.testimonials.crisBrookes.role')}</span></div>
        </div>
      </div>
      <div class="testimonials-pagination">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <span>1/10</span>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M9 18l6-6-6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </div>
    </div>
  </section>

  <!-- ═══ REVIEWS ═══ -->
  <section class="reviews-section">
    <div class="section-container">
      <div class="reviews-grid">
        <div class="reviews-text">
          <p style="font-family:Manrope,sans-serif;font-size:14px;font-weight:600;color:rgba(255,255,255,.5);text-transform:uppercase;letter-spacing:.5px">{t(locale, 'develoSocial.testimonialsPage.reviews.label')}</p>

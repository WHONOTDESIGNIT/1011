---
// Develo Design — Find a Technology Partner
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Find a Technology Partner | Develo Design</title>
<meta name="description" content="Platforms That Power Your Next Stage of Growth. We specialise in Magento, Adobe Commerce and Hyvä." />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=Syne:wght@400;700&display=swap" rel="stylesheet" />

<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{--blue:#563cfa;--black:#020303;--white:#fff;--grey-50:#f9fafb;--grey-100:#f3f4f6;--grey-200:#e5e7eb;--grey-400:#9ca3af;--grey-500:#6b7280;--grey-text:#4b5563;--max-w:1536px;--pad-100:100px}
html{scroll-behavior:smooth;overflow-x:hidden}
body{font-family:Manrope,-apple-system,Roboto,Helvetica,sans-serif;font-size:16px;font-weight:400;color:#000;background:#fff;overflow-x:hidden;-webkit-font-smoothing:antialiased}
a{text-decoration:none;color:inherit}
img{max-width:100%;height:auto;display:block}

/* ═══ 2. HEADER / NAV ═══ */
.site-header{position:fixed;top:66px;left:50%;transform:translate(-50%);width:calc(100% - 48px);max-width:1400px;z-index:110;transition:top .3s ease;will-change:top}
.header-inner{display:flex;align-items:center;justify-content:flex-start;height:70px;padding:0 24px 0 40px;background:rgba(255,255,255,.9);border-radius:40px;box-shadow:0 10px 24px rgba(2,3,3,.06);gap:0}
.header-logo{display:flex;align-items:center;flex-shrink:0;margin-right:502px}
.header-logo svg{display:block}
.header-nav{display:flex;align-items:center;gap:8px}
.nav-item{display:flex;align-items:center;gap:4px;padding:12px 16px;font-family:Manrope,sans-serif;font-size:16px;font-weight:400;color:#020303;line-height:25px;background:transparent;cursor:pointer;border-radius:8px;transition:background .2s;white-space:nowrap;text-decoration:none}
.nav-item:hover{background:rgba(0,0,0,.04)}

/* Desktop nav visibility */
.desktop-nav{display:flex}
@media(max-width:959px){.desktop-nav{display:none}}

/* Header CTA */
.header-cta{display:flex;align-items:center;gap:12px;margin-left:auto;margin-right:38px}
.btn-cta{display:inline-flex;align-items:center;justify-content:center;gap:6px;padding:12px 20px;background:var(--blue);color:#fff;font-family:Manrope,sans-serif;font-size:16px;font-weight:400;line-height:16px;border-radius:100px;border:none;cursor:pointer;white-space:nowrap;transition:all .25s}
.btn-cta:hover{gap:12px;background:#374151}
.btn-cta svg{width:16px;height:16px}
@media(max-width:959px){.header-cta .btn-cta{display:none}}

/* Nav collapse button */
.nav-collapse-btn{display:none;align-items:center;justify-content:center;width:40px;height:40px;border-radius:100px;background:var(--blue);border:none;cursor:pointer;margin-left:auto;margin-right:38px}
.nav-collapse-btn svg{width:20px;height:20px}
.nav-collapsed .desktop-nav,.nav-collapsed .header-cta{display:none}
@media(max-width:959px){.desktop-nav{display:none !important}.header-cta{display:none !important}.nav-collapse-btn{display:flex !important}}

@media(max-width:767px){
  .site-header{top:66px;width:calc(100% - 32px)}
  .header-inner{height:56px;padding:0 24px 0 32px;border-radius:40px}
}

/* ═══ Mega Dropdown ═══ */
.nav-dropdown-wrapper{position:relative}
.nav-has-dropdown{gap:6px}
.nav-dropdown-chevron{width:12px;height:7px;transition:transform .25s ease;flex-shrink:0}
.nav-dropdown-wrapper:hover .nav-dropdown-chevron{transform:rotate(180deg)}
.mega-dropdown{position:absolute;top:calc(100% + 12px);left:50%;transform:translateX(-50%) translateY(4px);min-width:640px;background:#fff;border-radius:20px;box-shadow:0 20px 40px rgba(2,3,3,.15);opacity:0;visibility:hidden;pointer-events:none;z-index:120;transition:opacity .2s ease,transform .25s ease,visibility 0s .25s}
.nav-dropdown-wrapper:hover .mega-dropdown,.mega-dropdown.open{opacity:1;visibility:visible;pointer-events:auto;transform:translateX(-50%) translateY(0);transition:opacity .2s ease,transform .25s ease,visibility 0s 0s}
.mega-inner{display:flex;gap:60px;padding:36px 40px}
.mega-left{flex:1;display:flex;flex-direction:column}
.mega-link-group{display:flex;flex-direction:column;gap:4px}
.mega-link{display:flex;flex-direction:column;gap:4px;padding:10px 14px;border-radius:10px;text-decoration:none;transition:background .15s;position:relative}
.mega-link:hover{background:rgba(0,0,0,.04)}
.mega-link-title{font-family:Manrope,sans-serif;font-size:18px;font-weight:500;line-height:26px;color:#020303}
.mega-link-desc{font-family:Manrope,sans-serif;font-size:14px;font-weight:400;line-height:21px;color:#6b7280}
.mega-link.has-plus{flex-direction:row;align-items:center;justify-content:space-between}
.mega-link.has-plus .mega-link-title,.mega-link.has-plus .mega-link-desc{display:block}
.mega-link.has-plus>div{display:flex;flex-direction:column;gap:4px}
.mega-plus{font-family:Manrope,sans-serif;font-size:20px;font-weight:400;color:#020303;width:28px;height:28px;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.mega-right{flex-shrink:0;width:260px}
.mega-card{background:var(--grey-50);border-radius:14px;padding:22px;display:flex;flex-direction:column;gap:12px}
.mega-card-heading{font-family:Syne,sans-serif;font-size:21px;font-weight:400;line-height:27px;color:#020303;margin:0}
.mega-card-desc{font-family:Manrope,sans-serif;font-size:14px;font-weight:400;line-height:21px;color:#6b7280;margin:0}
.mega-card-btn{display:inline-flex;align-items:center;gap:6px;font-family:Manrope,sans-serif;font-size:16px;font-weight:400;color:var(--blue);padding:10px 18px;border-radius:100px;background:transparent;transition:all .2s;align-self:flex-start;text-decoration:none}
.mega-card-btn:hover{background:var(--blue);color:#fff;gap:12px}
@media(max-width:959px){.mega-dropdown{display:none !important}}
/* Mobile menu panel */
.nav-collapse-btn.open{background:#374151}
.mobile-menu-overlay{position:fixed;inset:0;background:rgba(74,98,211,.1);opacity:0;visibility:hidden;pointer-events:none;z-index:108;transition:opacity .2s ease,visibility 0s .2s}
.mobile-menu-overlay.open{opacity:1;visibility:visible;pointer-events:auto;transition:opacity .2s ease,visibility 0s 0s}
.mobile-menu-panel{position:fixed;top:148px;left:50%;transform:translateX(-50%) translateY(-8px);width:calc(100% - 48px);max-width:520px;background:#fff;border-radius:20px;box-shadow:0 20px 40px rgba(2,3,3,.15);padding:20px;display:none;flex-direction:column;gap:8px;opacity:0;visibility:hidden;pointer-events:none;z-index:115;transition:opacity .2s ease,transform .25s ease,visibility 0s .25s}
.mobile-menu-panel.open{opacity:1;visibility:visible;pointer-events:auto;transform:translateX(-50%) translateY(0);transition:opacity .2s ease,transform .25s ease,visibility 0s 0s}
.mobile-menu-group{display:flex;flex-direction:column;border-bottom:1px solid #e5e7eb}
.mobile-menu-group:last-of-type{border-bottom:none}
.mobile-menu-toggle,.mobile-menu-link{width:100%;display:flex;align-items:center;justify-content:space-between;gap:12px;padding:14px 12px;background:transparent;border:none;border-radius:10px;text-decoration:none;font-family:Manrope,sans-serif;font-size:18px;font-weight:400;line-height:26px;color:#020303;text-align:left;cursor:pointer}
.mobile-menu-toggle:hover,.mobile-menu-link:hover{background:rgba(0,0,0,.04)}
.mobile-menu-toggle-chevron{width:12px;height:7px;flex-shrink:0;transition:transform .25s ease}
.mobile-menu-group.open .mobile-menu-toggle-chevron{transform:rotate(180deg)}
.mobile-submenu{max-height:0;overflow:hidden;display:flex;flex-direction:column;gap:4px;transition:max-height .3s ease,padding-bottom .3s ease}
.mobile-menu-group.open .mobile-submenu{max-height:480px;padding-bottom:12px}
.mobile-submenu-link{display:flex;flex-direction:column;gap:4px;padding:10px 12px 10px 24px;border-radius:10px;text-decoration:none}
.mobile-submenu-link:hover{background:rgba(0,0,0,.04)}
.mobile-submenu-title{font-family:Manrope,sans-serif;font-size:16px;font-weight:500;line-height:24px;color:#020303}
.mobile-submenu-desc{font-family:Manrope,sans-serif;font-size:13px;font-weight:400;line-height:19px;color:#6b7280}
.mobile-menu-cta{margin-top:8px}
.mobile-menu-cta .btn-cta{width:100%;justify-content:center}
@media(max-width:959px){.mobile-menu-panel{display:flex}}
@media(max-width:767px){.mobile-menu-panel{top:130px;width:calc(100% - 32px);padding:18px}}



/* ═══ Layout ═══ */
.page-main{margin-top:136px}
.section-container{max-width:var(--max-w);margin:0 auto;padding:0 var(--pad-100)}
.section-label{font-family:Manrope,sans-serif;font-size:14px;font-weight:600;color:var(--blue);text-transform:uppercase;letter-spacing:.5px;margin-bottom:12px}
.section-title{font-family:Syne,sans-serif;font-size:32px;font-weight:400;line-height:40px;color:var(--black);margin:0 0 12px}
.section-desc{font-family:Manrope,sans-serif;font-size:17px;font-weight:400;line-height:28px;color:var(--grey-text);max-width:620px}

/* ═══ HERO ═══ */
.hero-section{padding:40px 0 80px}
.hero-badge{display:inline-flex;align-items:center;gap:8px;padding:4px 14px;border:1px solid var(--grey-200);border-radius:100px;font-family:Manrope,sans-serif;font-size:13px;font-weight:500;color:var(--grey-500);margin-bottom:24px}
.hero-title{font-family:Syne,sans-serif;font-size:44px;font-weight:400;line-height:52px;letter-spacing:-.43px;color:var(--black);max-width:680px;margin:0 0 16px}
.hero-desc{font-family:Manrope,sans-serif;font-size:18px;font-weight:400;line-height:28px;color:var(--grey-text);max-width:560px}

/* ═══ CORE STACK ═══ */
.stack-section{padding:80px 0}
.stack-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-top:40px}
.stack-card{display:flex;flex-direction:column;gap:16px;padding:32px;border:1px solid var(--grey-200);border-radius:16px;transition:all .2s}
.stack-card:hover{border-color:var(--grey-400);transform:translateY(-2px)}
.stack-card h3{font-family:Syne,sans-serif;font-size:22px;font-weight:400;line-height:30px;color:var(--black);margin:0}
.stack-card p{font-family:Manrope,sans-serif;font-size:15px;font-weight:400;line-height:23px;color:var(--grey-text)}
.stack-card-link{display:inline-flex;align-items:center;gap:4px;font-family:Manrope,sans-serif;font-size:14px;font-weight:500;color:var(--blue);margin-top:auto}

/* ═══ TRUSTED ═══ */
.trusted-section{padding:60px 0}
.trusted-logos{display:flex;align-items:center;justify-content:center;gap:48px;flex-wrap:wrap;margin-top:24px}
.trusted-logo-text{font-family:Syne,sans-serif;font-size:22px;font-weight:700;color:var(--grey-400)}

/* ═══ GOALS ═══ */
.goals-section{padding:80px 0;background:var(--grey-50)}
.goals-content{display:flex;flex-direction:column;gap:16px;max-width:620px}

/* ═══ WHY SECTION ═══ */
.why-section{padding:80px 0}
.why-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-top:40px}
.why-card{display:flex;flex-direction:column;gap:12px;padding:28px 24px;border:1px solid var(--grey-200);border-radius:16px;transition:all .2s}
.why-card:hover{border-color:var(--grey-400)}
.why-card h3{font-family:Syne,sans-serif;font-size:18px;font-weight:400;line-height:26px;color:var(--black);margin:0}
.why-card p{font-family:Manrope,sans-serif;font-size:14px;font-weight:400;line-height:21px;color:var(--grey-text)}

/* ═══ PARTNERSHIPS ═══ */
.partner-section{padding:80px 0;background:var(--grey-50)}
.partner-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:16px;margin-top:32px}
.partner-logo{display:flex;align-items:center;justify-content:center;padding:24px;border:1px solid var(--grey-200);border-radius:12px;background:var(--white);font-family:Syne,sans-serif;font-size:14px;font-weight:600;color:var(--grey-400);transition:all .2s}
.partner-logo:hover{border-color:var(--grey-400)}

/* ═══ B2B ═══ */
.b2b-section{padding:80px 0}
.b2b-content{max-width:620px;display:flex;flex-direction:column;gap:16px}

/* ═══ RESULTS ═══ */
.results-section{padding:0 0 80px}
.results-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-top:32px}
.result-card{display:flex;flex-direction:column;gap:12px;padding:32px;border-radius:16px;border:1px solid var(--grey-200);transition:all .2s}
.result-card:hover{border-color:var(--grey-400);transform:translateY(-2px)}
.result-stat{font-family:Syne,sans-serif;font-size:28px;font-weight:400;line-height:36px;color:var(--blue)}
.result-stat-desc{font-family:Manrope,sans-serif;font-size:14px;font-weight:400;line-height:21px;color:var(--grey-text)}
.result-link{display:inline-flex;align-items:center;gap:4px;font-family:Manrope,sans-serif;font-size:14px;font-weight:500;color:var(--blue);margin-top:auto}
.results-pagination{display:flex;align-items:center;justify-content:center;gap:12px;margin-top:32px;font-family:Manrope,sans-serif;font-size:14px;color:var(--grey-500)}

/* ═══ CTA ═══ */
.cta-section{padding:80px 0;background:var(--grey-50)}
.cta-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:24px}
.cta-card{display:flex;align-items:center;justify-content:space-between;padding:20px 24px;border:1px solid var(--grey-200);border-radius:12px;background:var(--white);font-family:Manrope,sans-serif;font-size:15px;font-weight:400;color:var(--black);transition:all .2s}
.cta-card:hover{border-color:var(--blue);color:var(--blue)}

/* ═══ FAQ ═══ */
.faq-section{padding:0 0 100px}
.faq-list{display:flex;flex-direction:column;max-width:800px;margin-top:32px}
.faq-item{border-bottom:1px solid var(--grey-200)}
.faq-item:first-child{border-top:1px solid var(--grey-200)}
.faq-question{width:100%;display:flex;align-items:center;justify-content:space-between;padding:20px 0;font-family:Syne,sans-serif;font-size:18px;font-weight:400;line-height:26px;color:var(--black);background:transparent;border:none;cursor:pointer;text-align:left;transition:color .2s}
.faq-question:hover{color:var(--blue)}
.faq-toggle{flex-shrink:0;width:28px;height:28px;display:flex;align-items:center;justify-content:center;border-radius:50%;border:1px solid var(--grey-200);transition:all .2s;margin-left:16px}
.faq-answer{padding:0 0 20px;font-family:Manrope,sans-serif;font-size:16px;font-weight:400;line-height:25px;color:var(--grey-text)}
.faq-answer a{color:var(--blue);text-decoration:underline}

@media(max-width:1279px){.section-container{padding:0 40px}.stack-grid,.why-grid,.results-grid{grid-template-columns:repeat(2,1fr)}.partner-grid{grid-template-columns:repeat(3,1fr)}.cta-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:959px){.stack-grid,.why-grid,.results-grid,.cta-grid{grid-template-columns:repeat(2,1fr)}.partner-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:767px){
  .section-container{padding:0 24px}
  .hero-title{font-size:34px;line-height:42px;letter-spacing:-.33px}
  .section-title{font-size:26px;line-height:34px}
  .stack-grid,.why-grid,.results-grid,.cta-grid,.partner-grid{grid-template-columns:1fr}
  .trusted-logos{gap:20px}
}
</style>
</head>
<body>

<SiteHeader />

<main class="page-main">

  <!-- ═══ HERO ═══ -->
  <section class="hero-section">
    <div class="section-container">
      <div class="hero-badge">eCommerce Development Services</div>
      <h1 class="hero-title">Platforms That Power Your Next Stage of Growth</h1>
      <p class="hero-desc">We specialise in Magento, Adobe Commerce and Hyva, helping brands build, optimise and support stores that feel faster, scale smarter and grow with confidence.</p>
    </div>
  </section>

  <!-- ═══ OUR CORE STACK ═══ -->
  <section class="stack-section">
    <div class="section-container">
      <span class="section-label">Our core stack</span>
      <h2 class="section-title">Reliable platforms, chosen around your business</h2>
      <div class="stack-grid">
        <div class="stack-card">
          <h3>Magento Open Source</h3>
          <p>Magento Open Source gives ambitious brands the flexibility and control to build a fully custom, scalable eCommerce experience around how their business works.</p>
          <a class="stack-card-link" href="/services/magento-development">Explore <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M7 17L17 7M17 7H7M17 7V17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
        </div>
        <div class="stack-card">
          <h3>Adobe Commerce</h3>
          <p>Adobe Commerce builds on Magento with enterprise-level tools, advanced B2B functionality, strong security, and personalisation, supporting complex, international eCommerce at scale.</p>
          <a class="stack-card-link" href="/services/adobe-commerce-development">Explore <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M7 17L17 7M17 7H7M17 7V17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
        </div>
        <div class="stack-card">
          <h3>Hyva Themes</h3>
          <p>Hyva replaces Magento's traditional frontend with a lightweight, modern theme that dramatically improves performance, simplifies development, and supports better conversion.</p>
          <a class="stack-card-link" href="/services/hyva-themes">Explore <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M7 17L17 7M17 7H7M17 7V17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
        </div>
      </div>
      <div style="margin-top:24px"><a class="btn-outline" href="/services">All Services</a></div>
    </div>
  </section>

  <!-- ═══ TRUSTED BY ═══ -->
  <section class="trusted-section">
    <div class="section-container">
      <span class="section-label" style="text-align:center;display:block">Trusted by</span>
      <p style="text-align:center;font-family:Manrope,sans-serif;font-size:16px;color:var(--grey-text)">From premium retailers to fast growing independents.</p>
      <div class="trusted-logos">
        <span class="trusted-logo-text">BRANDALLEY</span>
        <span class="trusted-logo-text">BAMFORD</span>
        <span class="trusted-logo-text">DAYLESFORD</span>
        <span class="trusted-logo-text">CURRYS</span>
        <span class="trusted-logo-text">TEAGUE</span>
      </div>
    </div>
  </section>

  <!-- ═══ YOUR GOALS ═══ -->
  <section class="goals-section">
    <div class="section-container">
      <div class="goals-content">
        <span class="section-label">Your goals</span>
        <h2 class="section-title">The right solution starts with your goals</h2>
        <p class="section-desc">Whether you're improving an existing Magento or Adobe Commerce store, planning a rebuild or exploring long-term support, it starts with understanding your next step. A short discovery call helps shape the right approach and technology.</p>
        <div style="display:flex;gap:12px;flex-wrap:wrap">
          <a class="btn-primary" href="/contact">Talk to us</a>
          <a class="btn-outline" href="/services/magento-migration-solutions">Migrations and Upgrades</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ WHY CHOOSE US ═══ -->
  <section class="why-section">
    <div class="section-container">
      <span class="section-label">Why choose us?</span>
      <h2 class="section-title">We are focused on relationships and long-term success</h2>
      <div class="why-grid">
        <div class="why-card">
          <h3>Magento, Adobe &amp; Hyva Specialists</h3>
          <p>We've specialised in these platforms for years and know how to deliver at scale.</p>
        </div>
        <div class="why-card">
          <h3>Long-Term Partnerships</h3>
          <p>Many of our clients stay with us for years. We offer flexible retainers and growth support, not just launches.</p>
        </div>
        <div class="why-card">
          <h3>Boutique Size Agency</h3>
          <p>Big enough to handle complex projects, small enough to stay personal and responsive.</p>
        </div>
        <div class="why-card">
          <h3>Collaborative Approach</h3>
          <p>We work as an extension of your team, keeping communication clear and transparent throughout the project.</p>
        </div>
        <div class="why-card">
          <h3>Trusted by Leading Brands</h3>
          <p>From lifestyle to B2B enterprises, brands trust us to scale and support their eCommerce stores.</p>
        </div>
        <div class="why-card">
          <h3>Focused on results</h3>
          <p>We do not just write code. We help you achieve business goals like conversion, performance and scalability.</p>
        </div>
      </div>
      <div style="margin-top:24px"><a class="btn-outline" href="/about-us">About Develo</a></div>
    </div>
  </section>

  <!-- ═══ PARTNERSHIPS & INTEGRATIONS ═══ -->
  <section class="partner-section">
    <div class="section-container">
      <span class="section-label">Partnerships &amp; Integrations</span>
      <h2 class="section-title">Smarter commerce through connected systems</h2>
      <p class="section-desc">We integrate Magento, Adobe Commerce, and Hyva with the systems that power your business, ensuring everything works together smoothly behind the scenes.</p>
      <div class="partner-grid">
        <div class="partner-logo">Adobe Commerce</div>
        <div class="partner-logo">Magento</div>
        <div class="partner-logo">Hyva</div>
        <div class="partner-logo">Hypernode</div>
        <div class="partner-logo">Cloudflare</div>
        <div class="partner-logo">Algolia</div>
        <div class="partner-logo">Klaviyo</div>
        <div class="partner-logo">Stripe</div>

---
// iShine Marketplace — 数字创意资产交易平台（iShine 专属页面）
import { t } from '../lib/i18n';
import { getLocalizedPath } from '../lib/breadcrumbs';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';

const locale = Astro.currentLocale ?? 'en';
---
<!doctype html>
<html lang={locale}>
<head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<script is:inline>
  // 语言偏好持久化：读取用户选定的语言（localStorage），
  // 若当前 URL 语言与偏好不一致，立即重定向到偏好语言对应页面（支持 en/tr/ar）
  (function () {
    var KEY = 'ishine_lang';
    try {
      var stored = localStorage.getItem(KEY);
      if (!stored) return;
      var LANGS = ['tr', 'ar', 'es', 'fr', 'ru', 'he', 'pt-BR', 'nl'];
      var path = window.location.pathname;
      var cur = 'en';
      for (var i = 0; i < LANGS.length; i++) {
        if (path === '/' + LANGS[i] || path.indexOf('/' + LANGS[i] + '/') === 0) {
          cur = LANGS[i];
          break;
        }
      }
      if (stored === cur) return;
      var stripped = path;
      for (var j = 0; j < LANGS.length; j++) {
        stripped = stripped.replace(new RegExp('^/' + LANGS[j] + '/?'), '');
      }
      if (stored === 'en') {
        stripped = stripped.replace(/\/+$/, '');
        if (stripped === '' || stripped === '/') stripped = '/';
        if (stripped !== path) window.location.replace(stripped);
      } else {
        var target = '/' + stored + (stripped === '' || stripped === '/' ? '' : stripped);
        target = target.replace(/\/+$/, '');
        if (target === '') target = '/' + stored;
        if (target !== path) window.location.replace(target);
      }
    } catch (e) { /* 隐私模式等场景忽略 */ }
  })();
</script>
<title>{t(locale, 'auxPages.marketplace.pageTitle')}</title>
<meta name="description" content={t(locale, 'auxPages.marketplace.pageDescription')} />
<link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=Syne:wght@400;700&display=swap" rel="stylesheet" />
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{--blue:#563cfa;--black:#020303;--white:#fff;--max-w:1536px;--pad-100:100px}
html{scroll-behavior:smooth;overflow-x:hidden}
body{font-family:Manrope,-apple-system,Roboto,Helvetica,sans-serif;font-size:16px;font-weight:400;color:#000;background:#fff;overflow-x:hidden;-webkit-font-smoothing:antialiased}
a{text-decoration:none;color:inherit}img{max-width:100%;height:auto;display:block}
h1,h2,h3{font-weight:400}

/* ═══ 首页同款全页渐变背景（top bar / header / hero 共享） ═══ */
.gradient-bg{position:fixed;top:0;left:0;width:100%;height:100%;z-index:-1;pointer-events:none;
  background:radial-gradient(ellipse at 20% 30%,rgba(0,56,255,.09) 0%,transparent 45%),
    radial-gradient(ellipse at 70% 50%,rgba(55,127,255,.08) 0%,transparent 45%),
    radial-gradient(ellipse at 15% 70%,rgba(127,48,255,.09) 0%,transparent 45%),
    radial-gradient(ellipse at 80% 80%,rgba(242,80,110,.08) 0%,transparent 45%)}

.page-main{margin-top:148px;position:relative;z-index:1}

/* ═══ 通用按钮 ═══ */
.btn-base{display:inline-flex;align-items:center;gap:6px;padding:12px 20px;font-family:Manrope,sans-serif;font-size:16px;font-weight:400;line-height:16px;border-radius:100px;border:none;cursor:pointer;white-space:nowrap;transition:all .2s}
.btn-base:hover{gap:16px}
.btn-base .arrow-icon{width:16px;height:16px;display:block;flex-shrink:0}
.btn-primary-dark{background:var(--blue);color:#fff}
.btn-primary-light{background:#fff;color:var(--black)}

/* ═══ HERO ═══ */
.hero-content-simple-container{max-width:var(--max-w);margin:0 auto;padding:120px var(--pad-100)}
.content-col{max-width:1000px;display:flex;flex-direction:column;gap:16px}
.small-title{display:flex;align-items:center;gap:12px;padding:3px 12px}
.small-title .shape-icon{width:16px;height:16px;display:block;flex-shrink:0}
.hero-content-simple-container .small-title-text{font-family:Syne,sans-serif;font-size:21px;font-weight:400;line-height:27px;letter-spacing:-.21px;color:#020303}
.hero-content-simple-container .heading{font-family:Syne,sans-serif;font-size:62px;line-height:68px;letter-spacing:-.61px;color:#020303}
.hero-content-simple-container .subheading{padding-top:16px;font-family:Manrope,sans-serif;font-size:18px;line-height:26px;color:#374151}
.brand-slogan{font-family:Syne,sans-serif;font-size:16px;line-height:24px;color:#563cfa;padding-top:8px}
.button-group{display:flex;flex-direction:row;align-items:flex-start;gap:8px;padding-top:18px}

/* ═══ 产品卡片 ═══ */
.product-card-section{background:#fff;padding:60px 0}
.section-container{max-width:var(--max-w);margin:0 auto;padding:0 var(--pad-100)}
.product-card-wrapper{display:flex;flex-direction:row;align-items:center;gap:40px;padding:0 40px 0 0;background:#fff}
.product-image-col{display:block;flex-shrink:0}
.product-image{width:330px;height:330px;object-fit:cover;display:block}
.product-content-col{display:flex;flex-direction:column;align-items:flex-start;gap:8px;padding:60px 0}
.product-small-title{display:flex;align-items:center;gap:12px;padding:3px 12px}
.product-small-title .shape-icon{width:16px;height:16px;display:block;flex-shrink:0}
.product-small-title .small-title-text{font-family:Manrope,sans-serif;font-size:17px;font-weight:400;line-height:22px;color:#020303}
.product-heading-link{display:block}
.product-heading{font-family:Syne,sans-serif;font-size:32px;line-height:38px;letter-spacing:-.31px;color:#020303}
.product-description{font-family:Manrope,sans-serif;font-size:18px;line-height:26px;color:#020303}
.product-cta{display:flex;flex-direction:column;align-items:flex-start;gap:10px;padding-top:18px}
.product-link{display:inline-flex}

/* ═══ 底部深色 CTA ═══ */
.hero-content-links-wrapper{background:var(--black)}
.hero-content-links-container{max-width:var(--max-w);margin:0 auto;padding:120px var(--pad-100);display:flex;flex-direction:row;align-items:flex-start;gap:80px}
.left-col{display:flex;flex-direction:column;gap:16px}
.hero-content-links-container .small-title{display:flex;align-items:center;gap:12px;padding:3px 12px}
.hero-content-links-container .small-title .shape-icon{width:16px;height:16px;display:block;flex-shrink:0}
.hero-content-links-container .small-title span{font-family:Syne,sans-serif;font-size:21px;font-weight:400;line-height:27px;letter-spacing:-.21px;color:#fff}
.hero-content-links-container .heading{font-family:Syne,sans-serif;font-size:62px;line-height:68px;letter-spacing:-.61px;color:#fff}
.hero-content-links-container .brand-slogan{color:#fff}
.right-col{display:flex;flex-direction:column;max-width:520px;min-width:300px}
/* 参考首页 What We Do 服务标题的交互与排版 */
.mp-link{display:block;padding:12px 0}
.mp-link-title{font-family:Syne,sans-serif;font-size:21px;font-weight:400;line-height:27px;color:#fff;display:inline-flex;align-items:center;position:relative;padding-bottom:4px;border-bottom:1px solid #fff;transition:padding-right .3s ease}
.mp-link-arrow{position:absolute;top:50%;transform:translateY(-50%);right:0;width:16px;height:16px;opacity:0;transition:opacity .3s ease;pointer-events:none}
.mp-link-arrow svg{width:16px;height:16px;display:block}
.mp-link:hover .mp-link-title{padding-right:2em}
.mp-link:hover .mp-link-arrow{opacity:1}

/* ═══ BLOG ═══ */
.blog-template{background:#fff}
.blog-template .container{max-width:var(--max-w);margin:0 auto;padding:0}
.content-wrapper{max-width:var(--max-w);margin:0 auto;padding:120px var(--pad-100);display:flex;flex-direction:column;gap:24px}
.blog-header{display:flex;flex-direction:column;gap:8px}
.blog-header .small-title{display:flex;align-items:center;gap:12px;padding:3px 0;font-family:Manrope,sans-serif;font-size:18px;font-weight:400;line-height:26px;color:#020303}
.blog-header .diamond-icon{width:16px;height:16px;display:block;flex-shrink:0}
.blog-header .heading{font-family:Syne,sans-serif;font-size:38px;line-height:44px;letter-spacing:-.37px;color:#020303}
.blog-header .sub-heading{font-family:Manrope,sans-serif;font-size:18px;line-height:26px;color:#020303}
.blog-cards{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
.blog-card{display:flex;flex-direction:column;gap:12px}
.card-image{aspect-ratio:16/9;overflow:hidden;background:#f3f4f6;border-radius:12px}
.card-image img{width:100%;height:100%;object-fit:cover;display:block}
.card-content{display:flex;flex-direction:column;gap:8px}
.read-time{font-family:Manrope,sans-serif;font-size:14px;font-weight:400;line-height:21px;color:#020303}
.card-title{font-family:Syne,sans-serif;font-size:21px;font-weight:400;line-height:27px;letter-spacing:-.21px;color:#020303}
.blog-cta{display:flex;padding:18px 0 0}

/* ═══ 平板（≤1279px）：容器变窄 ═══ */
@media(max-width:1279px){
  .hero-content-simple-container{padding:80px 40px}
  .section-container{padding:0 40px}
  .hero-content-links-container{padding:120px 40px;gap:40px}
  .content-wrapper{padding:40px}
  .left-col{min-width:0;flex:1 1 auto}
}
/* ═══ 小平板（≤1024px）：产品卡片缩小 ═══ */
@media(max-width:1024px){
  .product-card-wrapper{gap:20px;padding:0 20px 0 0}
  .product-image{width:265px;height:265px}
  .product-content-col{padding:24px 0}
  .product-heading{font-size:24px;line-height:30px}
}
/* ═══ 小屏（≤959px）：CTA 与 blog 转单列 ═══ */
@media(max-width:959px){
  .hero-content-links-container{flex-direction:column;gap:40px;padding:80px 40px}
  .hero-content-links-container .heading{font-size:38px;line-height:44px}
  .right-col{max-width:none;min-width:0}
  .content-wrapper{padding:80px 40px}
  .blog-cards{display:flex;flex-direction:column;gap:16px}
}
/* ═══ 移动（≤767px） ═══ */
@media(max-width:767px){
  .hero-content-simple-container{padding:60px 24px}
  .hero-content-simple-container .heading{font-size:38px;line-height:44px}
  .hero-content-simple-container .subheading{padding-top:12px;font-size:16px;line-height:25px}
  .product-card-section .section-container{padding:0 24px}
  .product-card-wrapper{flex-direction:column;align-items:center;gap:0;padding:0 0 24px}
  .product-image-col{width:100%}
  .product-image{width:100%;height:auto}
  .product-content-col{padding:16px 0 0;align-items:flex-start}
  .product-description{font-size:16px;line-height:25px}
  .hero-content-links-container{padding:40px 24px}
  .hero-content-links-container .heading{font-size:38px;line-height:44px}
  .content-wrapper{padding:60px 24px}
  .blog-header .heading{font-size:32px;line-height:38px}
  .blog-header .sub-heading{font-size:16px;line-height:25px}
}
</style>
</head>
<body>

<div class="gradient-bg"></div>

<SiteHeader />

<main class="page-main">

  <!-- ═══ HERO ═══ -->
  <section class="hero-content-simple-wrapper theme-transparent">
    <div class="hero-content-simple-container">
      <div class="content-col">
        <div class="small-title">
          <svg class="shape-icon" width="16" height="16" viewBox="0 0 24 24" fill="#020303"><path d="M24 6C24 2.68629 21.3137 -1.44847e-07 18 0C14.6863 1.44847e-07 12 2.68629 12 6C12 2.68629 9.31371 3.7969e-07 6 5.24537e-07C2.68629 7.86805e-07 -2.62268e-07 2.68629 0 6C1.44847e-07 9.31371 2.68629 12 6 12C2.68629 12 3.7969e-07 14.6863 5.24537e-07 18C6.69384e-07 21.3137 2.68629 24 6 24C9.31371 24 12 21.3137 12 18C12 21.3137 14.6863 24 18 24C21.3137 24 24 21.3137 24 18C24 14.6871 21.315 12.0013 18.0024 12C21.315 11.9987 24 9.31292 24 6Z" fill="#020303"/></svg>
          <h1 class="small-title-text">{t(locale, 'auxPages.marketplace.hero.smallTitle')}</h1>
        </div>
        <h2 class="heading">{t(locale, 'auxPages.marketplace.hero.heading')}</h2>
        <p class="subheading">{t(locale, 'auxPages.marketplace.hero.subheading')}</p>
        <p class="brand-slogan">{t(locale, 'auxPages.marketplace.brandSlogan')}</p>
        <div class="button-group">
          <a class="btn-base btn-primary-dark with-icon" href={getLocalizedPath(locale, '/contact')}><span>{t(locale, 'auxPages.marketplace.contactCta')}</span> <svg class="arrow-icon" viewBox="0 0 16 16" fill="none"><path d="M4 12L12 4" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/><path d="M5.5 4H12V10.5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ 产品卡片 1：数字作品展示 ═══ -->
  <section class="product-card-section">
    <div class="section-container">
      <div class="product-card-wrapper">
        <a class="product-image-col" href={getLocalizedPath(locale, '/products')}>
          <img class="product-image" src="https://coresg-normal.trae.ai/api/ide/v1/text_to_image?prompt=Modern%20digital%20creative%20studio%20wall%20displaying%20a%20colorful%20gallery%20of%20digital%20artwork%2C%20UI%20design%20templates%2C%20and%20illustration%20pieces%20on%20sleek%20screens%2C%20clean%20minimal%20workspace%2C%20soft%20daylight%2C%20professional%20product%20photography%20style&image_size=square_hd" alt={t(locale, 'auxPages.marketplace.product1.imageAlt')} loading="lazy" />
        </a>
        <div class="product-content-col">
          <div class="product-small-title">
            <svg class="shape-icon" width="16" height="16" viewBox="0 0 24 24" fill="#020303"><path d="M12.0001 0L24.0001 12.0001L12.0001 24.0001L0 12.0001L12.0001 0Z" fill="#020303"/></svg>
            <span class="small-title-text">{t(locale, 'auxPages.marketplace.product1.smallTitle')}</span>
          </div>
          <a class="product-heading-link" href={getLocalizedPath(locale, '/products')}><h2 class="product-heading">{t(locale, 'auxPages.marketplace.product1.heading')}</h2></a>
          <p class="product-description">{t(locale, 'auxPages.marketplace.product1.description')}</p>
          <div class="product-cta">
            <a class="product-link" href={getLocalizedPath(locale, '/products')}><button class="btn-base btn-primary-dark with-icon" type="button"><span>{t(locale, 'auxPages.marketplace.detailsCta')}</span> <svg class="arrow-icon" viewBox="0 0 16 16" fill="none"><path d="M4 12L12 4" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/><path d="M5.5 4H12V10.5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/></svg></button></a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ 产品卡片 2：数字作品交易 ═══ -->
  <section class="product-card-section">
    <div class="section-container">
      <div class="product-card-wrapper">
        <a class="product-image-col" href={getLocalizedPath(locale, '/services/oem-odm')}>
          <img class="product-image" src="https://coresg-normal.trae.ai/api/ide/v1/text_to_image?prompt=Sleek%20laptop%20screen%20showing%20a%20secure%20digital%20marketplace%20interface%20for%20creative%20asset%20transactions%20with%20order%20confirmation%20and%20payment%20success%2C%20clean%20modern%20fintech%20UI%20design%2C%20blue%20and%20violet%20accents%2C%20studio%20lighting&image_size=square_hd" alt={t(locale, 'auxPages.marketplace.product2.imageAlt')} loading="lazy" />
        </a>
        <div class="product-content-col">
          <div class="product-small-title">
            <svg class="shape-icon" width="16" height="16" viewBox="0 0 24 24" fill="#020303"><path d="M12.0001 0L24.0001 12.0001L12.0001 24.0001L0 12.0001L12.0001 0Z" fill="#020303"/></svg>
            <span class="small-title-text">{t(locale, 'auxPages.marketplace.product2.smallTitle')}</span>
          </div>
          <a class="product-heading-link" href={getLocalizedPath(locale, '/services/oem-odm')}><h2 class="product-heading">{t(locale, 'auxPages.marketplace.product2.heading')}</h2></a>
          <p class="product-description">{t(locale, 'auxPages.marketplace.product2.description')}</p>
          <div class="product-cta">
            <a class="product-link" href={getLocalizedPath(locale, '/services/oem-odm')}><button class="btn-base btn-primary-dark with-icon" type="button"><span>{t(locale, 'auxPages.marketplace.detailsCta')}</span> <svg class="arrow-icon" viewBox="0 0 16 16" fill="none"><path d="M4 12L12 4" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/><path d="M5.5 4H12V10.5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/></svg></button></a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ 产品卡片 3：创作者服务 ═══ -->
  <section class="product-card-section">
    <div class="section-container">
      <div class="product-card-wrapper">
        <a class="product-image-col" href={getLocalizedPath(locale, '/services')}>
          <img class="product-image" src="https://coresg-normal.trae.ai/api/ide/v1/text_to_image?prompt=Digital%20creator%20desk%20setup%20with%20drawing%20tablet%2C%20color%20swatches%2C%20design%20mockups%20and%20a%20floating%20analytics%20dashboard%2C%20warm%20ambient%20lighting%2C%20cozy%20creative%20workspace%2C%20professional%20photography&image_size=square_hd" alt={t(locale, 'auxPages.marketplace.product3.imageAlt')} loading="lazy" />
        </a>
        <div class="product-content-col">
          <div class="product-small-title">
            <svg class="shape-icon" width="16" height="16" viewBox="0 0 24 24" fill="#020303"><path d="M12.0001 0L24.0001 12.0001L12.0001 24.0001L0 12.0001L12.0001 0Z" fill="#020303"/></svg>
            <span class="small-title-text">{t(locale, 'auxPages.marketplace.product3.smallTitle')}</span>
          </div>
          <a class="product-heading-link" href={getLocalizedPath(locale, '/services')}><h2 class="product-heading">{t(locale, 'auxPages.marketplace.product3.heading')}</h2></a>
          <p class="product-description">{t(locale, 'auxPages.marketplace.product3.description')}</p>
          <div class="product-cta">
            <a class="product-link" href={getLocalizedPath(locale, '/services')}><button class="btn-base btn-primary-dark with-icon" type="button"><span>{t(locale, 'auxPages.marketplace.detailsCta')}</span> <svg class="arrow-icon" viewBox="0 0 16 16" fill="none"><path d="M4 12L12 4" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/><path d="M5.5 4H12V10.5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/></svg></button></a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ 底部深色 CTA ═══ -->
  <section class="hero-content-links-wrapper theme-dark">
    <div class="hero-content-links-container">
      <div class="left-col">
        <div class="small-title">
          <svg class="shape-icon" width="16" height="16" viewBox="0 0 24 24" fill="#fff"><path d="M12.0001 0L24.0001 12.0001L12.0001 24.0001L0 12.0001L12.0001 0Z" fill="#fff"/></svg>
          <span>{t(locale, 'auxPages.marketplace.cta.smallTitle')}</span>
        </div>
        <h2 class="heading">{t(locale, 'auxPages.marketplace.cta.headingLine1')}<br>{t(locale, 'auxPages.marketplace.cta.headingLine2')}<br>{t(locale, 'auxPages.marketplace.cta.headingLine3')}</h2>
        <p class="brand-slogan">{t(locale, 'auxPages.marketplace.brandSlogan')}</p>
        <div class="button-group">
          <a class="btn-base btn-primary-light with-icon" href={getLocalizedPath(locale, '/contact')}><span>{t(locale, 'auxPages.marketplace.contactCta')}</span> <svg class="arrow-icon" viewBox="0 0 16 16" fill="none"><path d="M4 12L12 4" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/><path d="M5.5 4H12V10.5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
        </div>
      </div>
      <div class="right-col">

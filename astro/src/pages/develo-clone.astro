.quality-certs-heading{font-family:Syne,sans-serif;font-size:48px;font-weight:400;line-height:52px;color:var(--black);margin:0 0 16px}
.quality-certs-desc{font-family:Manrope,sans-serif;font-size:16px;font-weight:400;line-height:25px;color:var(--black);margin:0 0 32px}
.quality-certs-list{display:flex;flex-direction:column;gap:12px}
.quality-certs-item{display:flex;align-items:flex-start;gap:16px;padding:20px;background:var(--grey-50);border-radius:14px}
.quality-certs-item-icon{width:40px;height:40px;flex-shrink:0;border-radius:12px;background:var(--blue);display:flex;align-items:center;justify-content:center}

/* ═══ 10. TESTIMONIALS ═══ */
.testimonials{display:flex;width:100%;flex-direction:column;align-items:center;background:var(--grey-50);position:relative;padding:0}
.testimonials-container{display:flex;align-items:flex-start;width:100%;max-width:var(--max-w);margin:0 auto;padding:40px var(--pad-100) 124px;overflow:hidden;position:relative;gap:60px}
.testimonial-main{flex:1;display:flex;flex-direction:column}
.testimonial-quote-icon{position:absolute;right:184px;bottom:24px;margin-bottom:0}
.testimonial-quote{font-family:Syne,sans-serif;font-size:24px;font-weight:400;line-height:30px;color:var(--black);margin-bottom:24px}
.testimonial-author{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.testimonial-author img{width:48px;height:48px;border-radius:50%;object-fit:cover}
.testimonial-author-name{font-family:Manrope,sans-serif;font-size:16px;font-weight:400;color:var(--black);line-height:25px}
.testimonial-author-role{font-family:Manrope,sans-serif;font-size:14px;font-weight:400;color:#6b7280;line-height:21px}
.testimonial-cta{display:inline-flex;align-items:center;gap:6px;font-family:Manrope,sans-serif;font-size:16px;font-weight:400;color:var(--blue);margin-top:24px;transition:gap .2s}
.testimonial-cta:hover{gap:12px}
.testimonial-bottom{display:flex;align-items:center;gap:12px}
.testimonial-nav{display:flex;gap:12px;align-items:center;flex-shrink:0;position:absolute;right:100px;bottom:40px}
.testimonial-nav button{width:48px;height:48px;display:flex;align-items:center;justify-content:center;border-radius:100px;border:1px solid var(--black);background:transparent;cursor:pointer;transition:all .2s}
.testimonial-nav button:hover{background:var(--black);color:#fff}
.testimonial-nav button svg{width:24px;height:24px}
.testimonials-pagination{display:flex;align-items:center;position:absolute;left:100px;bottom:52px}
@media(max-width:959px){
  .testimonials-container{flex-direction:column;padding:40px var(--pad-40) 132px;gap:24px}
  .testimonial-quote-icon{right:124px}
  .testimonial-nav{right:40px}
  .testimonials-pagination{left:40px}
}
@media(max-width:767px){
  .testimonials-container{padding:32px var(--pad-24) 140px}
  .testimonial-quote{font-size:20px;line-height:26px}
  .testimonial-quote-icon{right:108px;bottom:24px}
  .testimonial-nav{right:24px}
  .testimonials-pagination{left:24px;bottom:56px}
}

/* ═══ 11. FOOTER ═══ */
.site-footer{background:var(--black);color:#fff;width:100vw;position:relative;left:50%;right:50%;margin-left:-50vw;margin-right:-50vw;padding:120px 0}
.footer-container{padding:0 var(--pad-100);max-width:var(--max-w);margin:0 auto}
.footer-grid{display:grid;grid-template-columns:1.3fr 1fr 1fr 1.2fr;gap:60px}
.footer-col h4{font-family:Manrope,sans-serif;font-size:18px;font-weight:600;color:#fff;line-height:27px;margin-bottom:16px}
.footer-col a{display:block;font-family:Manrope,sans-serif;font-size:16px;font-weight:400;color:#fff;line-height:25px;padding:6px 0;transition:color .2s}
.footer-col a:hover{color:#b4b4b4}
.footer-col-cta h4{font-size:42px;line-height:50px;font-weight:600;margin-bottom:12px}
.footer-col-cta p{font-family:Manrope,sans-serif;font-size:16px;font-weight:400;line-height:25px;color:var(--black)}
.footer-col-cta .btn-primary{color:#fff;background:var(--blue)}
.footer-cta-arrow{display:inline-flex;align-items:center}
.footer-contact-link{display:block;font-family:Manrope,sans-serif;font-size:16px;font-weight:400;color:#fff;line-height:25px;padding:6px 0;text-decoration:underline;text-decoration-color:#563cfa;text-underline-offset:4px;transition:text-decoration-color .2s}
.footer-contact-link:hover{text-decoration-color:transparent}
.footer-contact-text{display:block;font-family:Manrope,sans-serif;font-size:16px;font-weight:400;color:#fff;line-height:25px;padding:6px 0}
.footer-company-info{font-family:Manrope,sans-serif;font-size:14px;font-weight:400;line-height:21px;color:#fff;margin-bottom:8px}
.footer-col-info a{font-size:14px;line-height:21px;padding:2px 0;color:#fff;text-decoration:underline;text-decoration-color:#563cfa;text-underline-offset:3px}
.footer-col-info a:hover{text-decoration-color:transparent}
@media(max-width:959px){.site-footer{padding:60px 0}.footer-container{padding:0 var(--pad-40)}.footer-grid{grid-template-columns:1fr 1fr;gap:40px}.footer-col-cta h4{font-size:30px;line-height:38px}}
@media(max-width:767px){.footer-container{padding:0 var(--pad-24)}.footer-grid{grid-template-columns:1fr;gap:32px}.footer-col-cta h4{font-size:26px;line-height:34px}}

</style>
</head>
<body>
<div class="overflow-x-hidden">
<div class="gradient-bg"></div>

<SiteHeader lang={locale} />

<!-- ═══ 3. HERO ═══ -->
<!-- Hero SVG clipPaths for curved bottom container -->
<svg width="0" height="0" style="position:absolute;pointer-events:none" aria-hidden="true">
  <defs>
    <clipPath id="heroClipPc" clipPathUnits="objectBoundingBox">
      <path d="M0.06,0 H0.94 A0.06,0.06 0 0 1 1,0.06 V0.78 A0.08,0.08 0 0 1 0.92,0.86 H0.60 Q0.54,0.86 0.50,0.93 Q0.47,1 0.40,1 H0.06 A0.06,0.06 0 0 1 0,0.94 V0.06 A0.06,0.06 0 0 1 0.06,0 Z" />
    </clipPath>
    <clipPath id="heroClipMobile" clipPathUnits="objectBoundingBox">
      <path d="M0.06,0 H0.94 A0.06,0.06 0 0 1 1,0.06 V0.80 A0.08,0.08 0 0 1 0.92,0.88 H0.66 Q0.60,0.88 0.56,0.94 Q0.53,1 0.46,1 H0.06 A0.06,0.06 0 0 1 0,0.94 V0.06 A0.06,0.06 0 0 1 0.06,0 Z" />
    </clipPath>
    <clipPath id="heroClipTablet" clipPathUnits="objectBoundingBox">
      <path d="M0.06,0 H0.94 A0.06,0.06 0 0 1 1,0.06 V0.79 A0.08,0.08 0 0 1 0.92,0.87 H0.62 Q0.56,0.87 0.52,0.93 Q0.49,1 0.42,1 H0.06 A0.06,0.06 0 0 1 0,0.94 V0.06 A0.06,0.06 0 0 1 0.06,0 Z" />
    </clipPath>
  </defs>
</svg>
<section class="hero" id="hero-section">
  <div class="hero-white-container">
    <div class="hero-content-card">
      <div class="hero-heading">
        <h1 style="font-family:Manrope,sans-serif;font-size:16px;font-weight:400;line-height:normal;color:#020303;margin:0;display:flex;align-items:center;gap:12px;padding:3px 0">
          <svg class="diamond-icon" width="16" height="17" viewBox="0 0 16 17" fill="none"><path d="M8.00004 0.5L16.0001 8.50004L8.00004 16.5001L0 8.50004L8.00004 0.5Z" fill="#020303"/></svg>
          {t(locale, 'develoCore.clone.hero.eyebrow')}
        </h1>
        <h2 class="hero-title-main">{t(locale, 'develoCore.clone.hero.title')}</h2>
      </div>
      <div class="hero-buttons">
        <a class="btn btn-primary" href="#what-we-do-section">{t(locale, 'develoCore.clone.hero.whatWeDo')} <svg width="16" height="16" viewBox="0 0 16 16" fill="none" style="flex-shrink:0"><path d="M4 12L12 4" stroke="#fff" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M5.5 4H12V10.5" stroke="#fff" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
        <a class="btn btn-secondary" href={getLocalizedPath(locale, '/contact')}>{t(locale, 'develoCore.clone.hero.bookCall')} <span class="btn-book-arrow"><svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M4 12L12 4" stroke="#020303" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M5.5 4H12V10.5" stroke="#020303" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></span></a>
      </div>
    </div>
  </div>
  <div class="hero-wrapper">
    <div class="video-section">
      <div class="video-placeholder">
        <video autoplay muted loop playsinline width="1280" height="720">
          <source src="/videos/head-video.mp4" type="video/mp4" />
        </video>
      </div>
    </div>
  </div>
</section>

<!-- ═══ 4. WHAT WE DO ═══ -->
<section class="what-we-do" id="what-we-do-section">
  <div class="what-we-do-container">
    <div class="what-we-do-left">
      <div class="small-title" style="margin-bottom:24px">
        <svg class="diamond-icon" width="16" height="17" viewBox="0 0 16 17" fill="none"><path d="M8.00004 0.5L16.0001 8.50004L8.00004 16.5001L0 8.50004L8.00004 0.5Z" fill="#020303"/></svg>
        {t(locale, 'develoCore.clone.wwd.label')}
      </div>
      <h2 class="wwd-heading">{t(locale, 'develoCore.clone.wwd.heading')}</h2>
      <div class="wwd-services">
        <div class="wwd-service-item" data-index="0">
          <button class="wwd-service-header" aria-expanded="false">
            <h3>{t(locale, 'develoCore.clone.wwd.item1.title')}<span class="wwd-hover-arrow"><svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M4 12L12 4" stroke="#020303" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M5.5 4H12V10.5" stroke="#020303" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></span></h3>
          </button>
          <div class="wwd-service-body">
            <p>{t(locale, 'develoCore.clone.wwd.item1.desc')}</p>
            <a class="wwd-service-cta" href={getLocalizedPath(locale, '/services/find-a-technology-partner')}>{t(locale, 'develoCore.clone.wwd.item1.cta')} <svg class="wwd-cta-arrow" width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M3 11L11 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M4.5 3H11v6.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
          </div>
        </div>
        <div class="wwd-service-item" data-index="1">
          <button class="wwd-service-header" aria-expanded="false">
            <h3>{t(locale, 'develoCore.clone.wwd.item2.title')}<span class="wwd-hover-arrow"><svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M4 12L12 4" stroke="#020303" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M5.5 4H12V10.5" stroke="#020303" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></span></h3>
          </button>
          <div class="wwd-service-body">
            <p>{t(locale, 'develoCore.clone.wwd.item2.desc')}</p>
            <a class="wwd-service-cta" href={getLocalizedPath(locale, '/services/oem-odm')}>{t(locale, 'develoCore.clone.wwd.item2.cta')} <svg class="wwd-cta-arrow" width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M3 11L11 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M4.5 3H11v6.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
          </div>
        </div>
        <div class="wwd-service-item" data-index="2">
          <button class="wwd-service-header" aria-expanded="false">
            <h3>{t(locale, 'develoCore.clone.wwd.item3.title')}<span class="wwd-hover-arrow"><svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M4 12L12 4" stroke="#020303" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M5.5 4H12V10.5" stroke="#020303" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></span></h3>
          </button>
          <div class="wwd-service-body">
            <p>{t(locale, 'develoCore.clone.wwd.item3.desc')}</p>
            <a class="wwd-service-cta" href={getLocalizedPath(locale, '/services/private-label')}>{t(locale, 'develoCore.clone.wwd.item3.cta')} <svg class="wwd-cta-arrow" width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M3 11L11 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M4.5 3H11v6.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
          </div>
        </div>
        <div class="wwd-service-item" data-index="3">
          <button class="wwd-service-header" aria-expanded="false">
            <h3>{t(locale, 'develoCore.clone.wwd.item4.title')}<span class="wwd-hover-arrow"><svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M4 12L12 4" stroke="#020303" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M5.5 4H12V10.5" stroke="#020303" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></span></h3>
          </button>
          <div class="wwd-service-body">
            <p>{t(locale, 'develoCore.clone.wwd.item4.desc')}</p>
            <a class="wwd-service-cta" href={getLocalizedPath(locale, '/services/build-a-new-ipl')}>{t(locale, 'develoCore.clone.wwd.item4.cta')} <svg class="wwd-cta-arrow" width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M3 11L11 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M4.5 3H11v6.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
          </div>
        </div>
      </div>
      <a class="btn btn-primary" href={getLocalizedPath(locale, '/services')} style="align-self:flex-start;margin-top:24px">{t(locale, 'develoCore.clone.wwd.viewAllServices')} <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M4 12L12 4" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/><path d="M5.5 4H12V10.5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
    </div>
    <div class="what-we-do-right">
      <div class="wwd-visuals" aria-live="polite">
        <div class="wwd-visual active" data-index="0">
          <img src="/images/client/client-witness-ku2-cosmetics-brand.webp" alt={t(locale, 'develoCore.clone.wwd.alt1')} loading="lazy" />
        </div>
        <div class="wwd-visual" data-index="1">
          <img src="/images/client/client-witness-lux-skin-brand.webp" alt={t(locale, 'develoCore.clone.wwd.alt2')} loading="lazy" />
        </div>
        <div class="wwd-visual" data-index="2">
          <img src="/images/client/client-witness-mandyskin-brand.webp" alt={t(locale, 'develoCore.clone.wwd.alt3')} loading="lazy" />
        </div>
        <div class="wwd-visual" data-index="3">
          <img src="/images/client/client-witness-roseskinco-brand.webp" alt={t(locale, 'develoCore.clone.wwd.alt4')} loading="lazy" />
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ═══ PRODUCT SHOWCASE ═══ -->
<section class="product-showcase" id="product-showcase-section">
  <div class="product-showcase-container">
    <div class="product-showcase-header">
      <div class="small-title" style="margin-bottom:20px">
        <svg class="diamond-icon" width="16" height="17" viewBox="0 0 16 17" fill="none"><path d="M8.00004 0.5L16.0001 8.50004L8.00004 16.5001L0 8.50004L8.00004 0.5Z" fill="#020303"/></svg>
        {t(locale, 'develoCore.clone.showcase.label')}
      </div>
      <h2 class="product-showcase-heading">{t(locale, 'develoCore.clone.showcase.heading')}</h2>
      <p class="product-showcase-desc">{t(locale, 'develoCore.clone.showcase.desc')}</p>
    </div>
    <div class="product-carousel-wrapper">
      <div class="product-carousel-viewport">
        <div class="product-carousel-track" id="product-carousel-track">
          <a class="product-card-item" href={getLocalizedPath(locale, '/products/lumi-2')}>
            <div class="product-card-img"><img src="/images/products/lumi-2/lumi-2-images (1).jpg" alt="Lumi 2" loading="lazy" /></div>
            <div class="product-card-info"><h3 class="product-card-name">Lumi 2</h3><p class="product-card-tagline">{t(locale, 'develoCore.clone.showcase.lumi2Tagline')}</p></div>
          </a>
          <a class="product-card-item" href={getLocalizedPath(locale, '/products/venus')}>
            <div class="product-card-img"><img src="/images/products/Venus/purple-venus-sapphire-ipl.webp" alt="Venus" loading="lazy" /></div>
            <div class="product-card-info"><h3 class="product-card-name">Venus</h3><p class="product-card-tagline">{t(locale, 'develoCore.clone.showcase.venusTagline')}</p></div>
          </a>
          <a class="product-card-item" href={getLocalizedPath(locale, '/products/lumi')}>
            <div class="product-card-img"><img src="/images/products/lumi/RoseSkinCo-Lumi-IPL-Hair-Removal-Handset-white-Gold_jpg.webp" alt="Lumi" loading="lazy" /></div>
            <div class="product-card-info"><h3 class="product-card-name">Lumi</h3><p class="product-card-tagline">{t(locale, 'develoCore.clone.showcase.lumiTagline')}</p></div>
          </a>
          <a class="product-card-item" href={getLocalizedPath(locale, '/products/helix')}>
            <div class="product-card-img"><img src="/images/products/Helix/helix-ipl-front-view.jpg" alt="Helix" loading="lazy" /></div>
            <div class="product-card-info"><h3 class="product-card-name">Helix</h3><p class="product-card-tagline">{t(locale, 'develoCore.clone.showcase.helixTagline')}</p></div>
          </a>
          <a class="product-card-item" href={getLocalizedPath(locale, '/products/themis')}>
            <div class="product-card-img"><img src="/images/products/Themis/golden-luxury-front-view.jpg" alt="Themis" loading="lazy" /></div>
            <div class="product-card-info"><h3 class="product-card-name">Themis</h3><p class="product-card-tagline">{t(locale, 'develoCore.clone.showcase.themisTagline')}</p></div>
          </a>
          <a class="product-card-item" href={getLocalizedPath(locale, '/products/emerald')}>
            <div class="product-card-img"><img src="/images/products/Emerald/emerald%20ipl%20white%20color.webp" alt="Emerald" loading="lazy" /></div>
            <div class="product-card-info"><h3 class="product-card-name">Emerald</h3><p class="product-card-tagline">{t(locale, 'develoCore.clone.showcase.emeraldTagline')}</p></div>
          </a>
          <a class="product-card-item" href={getLocalizedPath(locale, '/products/alpha')}>
            <div class="product-card-img"><img src="/images/products/Alpha/alpha-ipl-device-front-view.jpg" alt="Alpha" loading="lazy" /></div>
            <div class="product-card-info"><h3 class="product-card-name">Alpha</h3><p class="product-card-tagline">{t(locale, 'develoCore.clone.showcase.alphaTagline')}</p></div>
          </a>
          <a class="product-card-item" href={getLocalizedPath(locale, '/products/hebe')}>
            <div class="product-card-img"><img src="/images/products/Hebe/hebe%20ipl%20hair%20removal%20white%20color.webp" alt="Hebe" loading="lazy" /></div>
            <div class="product-card-info"><h3 class="product-card-name">Hebe</h3><p class="product-card-tagline">{t(locale, 'develoCore.clone.showcase.hebeTagline')}</p></div>
          </a>
        </div>
      </div>
      <div class="product-carousel-nav">
        <button id="prev-product-card" aria-label={t(locale, 'develoCore.clone.common.previous')}><svg viewBox="0 0 24 24" fill="none"><path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
        <button id="next-product-card" aria-label={t(locale, 'develoCore.clone.common.next')}><svg viewBox="0 0 24 24" fill="none"><path d="M9 18l6-6-6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
      </div>
    </div>
  </div>
</section>

<!-- ═══ 5. OUR CLIENTS ═══ -->
<section class="our-clients">
  <div class="our-clients-container">
    <div class="our-clients-left">
      <h2 class="our-clients-heading">{t(locale, 'develoCore.clone.clients.heading')}</h2>
      <p class="our-clients-sub">{t(locale, 'develoCore.clone.clients.sub')}</p>
    </div>
    <div class="our-clients-logos">
      <img src="/images/logos/costco-logo.svg" alt="Costco" loading="lazy" />
      <img src="/images/logos/roseskin-logo.svg" alt="RoseSkinCo" loading="lazy" />
      <img src="/images/logos/KU-2%20logo.svg" alt="KU-2 Cosmetics" loading="lazy" />
      <img src="/images/logos/happyskin-logo.webp" alt="HappySkinCo" loading="lazy" />
    </div>
  </div>
</section>

<!-- ═══ 6. STAT CARDS ═══ -->
<section class="stat-cards">
  <div class="stat-cards-container">
    <div class="small-title" style="margin-bottom:24px">
      <svg class="diamond-icon" width="16" height="17" viewBox="0 0 16 17" fill="none"><path d="M8.00004 0.5L16.0001 8.50004L8.00004 16.5001L0 8.50004L8.00004 0.5Z" fill="#020303"/></svg>
      {t(locale, 'develoCore.clone.statcards.label')}
    </div>
    <div class="stat-cards-header">
      <h2 class="stat-cards-heading">{t(locale, 'develoCore.clone.statcards.heading')}</h2>
      <div class="stat-cards-desc-col">
        <p class="stat-cards-desc">{t(locale, 'develoCore.clone.statcards.desc')}</p>
        <div class="stat-cards-actions">
          <a class="stat-cards-cta" href={getLocalizedPath(locale, '/products')}>{t(locale, 'develoCore.clone.statcards.exploreProducts')} <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M4 12L12 4" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/><path d="M5.5 4H12V10.5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
        </div>
      </div>
    </div>
    <div class="stat-cards-grid" id="stat-cards-grid">
      <div class="stat-card" style="background:#35292b">
        <div class="stat-number">500K+</div>
        <div class="stat-label">{t(locale, 'develoCore.clone.statcards.card1.label')}</div>
        <a class="stat-card-cta" href={getLocalizedPath(locale, '/products')}>{t(locale, 'develoCore.clone.statcards.card1.cta')}</a>
      </div>
      <div class="stat-card" style="background:#020303">

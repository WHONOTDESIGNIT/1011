}
@media(max-width:767px){
  .stat-cards-container{padding:0 var(--pad-24);gap:0}
  .stat-cards-grid{grid-template-columns:1fr}
  .stat-cards-heading{font-size:28px;line-height:34px}
}

/* ═══ QUALITY & CERTIFICATIONS ═══ */
.quality-certs{width:100%;background:#fff;padding:60px 0}

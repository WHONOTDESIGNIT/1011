.quality-cert-badge-label{font-family:Manrope,sans-serif;font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:.1em;color:var(--blue)}
.quality-cert-badge-value{font-family:Syne,sans-serif;font-size:24px;font-weight:400;line-height:30px;color:var(--black)}
.quality-certs-cta{display:inline-flex;align-items:center;gap:6px;font-family:Manrope,sans-serif;font-size:16px;font-weight:400;color:#fff;background:var(--blue);padding:12px 20px;border-radius:100px;transition:all .2s;text-decoration:none;margin-top:24px}
.quality-certs-cta:hover{background:#374151;gap:12px}

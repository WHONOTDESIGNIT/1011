/* ═══ 7. EXPERTISE ═══ */
.expertise{width:100%;margin:0;padding:0;background:var(--black)}
.expertise-container{max-width:var(--max-w);margin:0 auto;display:grid;grid-template-columns:minmax(0,1fr) minmax(420px,600px);column-gap:40px;row-gap:24px;padding:240px 100px}

---
// Develo Design Clone — exact CSS from getComputedStyle() extraction
import { t } from '../lib/i18n';
import { getLocalizedPath } from '../lib/breadcrumbs';
import SiteHeader from '../components/SiteHeader.astro';
const locale = Astro.currentLocale ?? 'en';
---

<!doctype html>
<html lang={locale}>
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<script is:inline>
  // 语言偏好持久化：读取用户选定的语言（localStorage），
  // 若当前 URL 语言与偏好不一致，立即重定向到偏好语言对应页面（支持 en/tr/ar）
  (function () {
    var KEY = 'ishine_lang';
    try {
      var stored = localStorage.getItem(KEY);
      if (!stored) return;
      var LANGS = ['tr', 'ro', 'ar', 'es', 'fr', 'ru', 'he', 'pt-BR', 'nl', 'pl', 'ja', 'ko'];
      var path = window.location.pathname;
      var cur = 'en';
      for (var i = 0; i < LANGS.length; i++) {
        if (path === '/' + LANGS[i] || path.indexOf('/' + LANGS[i] + '/') === 0) {
          cur = LANGS[i];
          break;
        }
      }
      if (stored === cur) return;
      var stripped = path;
      for (var j = 0; j < LANGS.length; j++) {
        stripped = stripped.replace(new RegExp('^/' + LANGS[j] + '/?'), '');
      }
      if (stored === 'en') {
        stripped = stripped.replace(/\/+$/, '');
        if (stripped === '' || stripped === '/') stripped = '/';
        if (stripped !== path) window.location.replace(stripped);
      } else {
        var target = '/' + stored + (stripped === '' || stripped === '/' ? '' : stripped);
        target = target.replace(/\/+$/, '');
        if (target === '') target = '/' + stored;
        if (target !== path) window.location.replace(target);
      }
    } catch (e) { /* 隐私模式等场景忽略 */ }
  })();
</script>
<link rel="icon" type="image/png" href="/images/logos/ishine%20favicon.png" />
<title>{t(locale, 'develoCore.clone.meta.title')}</title>
<meta name="description" content={t(locale, 'develoCore.clone.meta.description')} />

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=Syne:wght@400;700&display=swap" rel="stylesheet" />

<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --blue:#563cfa;
  --blue-100:#c6bff8;
  --blue-50:#edebfc;
  --black:#020303;
  --white:#fff;
  --grey-50:#f9fafb;
  --grey-100:#f3f4f6;
  --grey-200:#e5e7eb;
  --grey-700:#374151;
  --pad-100:100px;
  --pad-40:40px;
  --pad-24:24px;
  --nav-top:66px;
  --nav-h:70px;
  --max-w:1536px;
}
@media(max-width:767px){
  :root{--nav-h:56px;--pad-100:var(--pad-24)}
}
html{scroll-behavior:smooth;overflow-x:hidden}
body{font-family:Manrope,-apple-system,Roboto,Helvetica,sans-serif;font-size:16px;font-weight:400;color:#000;background:#fff;overflow-x:hidden;-webkit-font-smoothing:antialiased}
img{max-width:100%;height:auto;display:block}
a{text-decoration:none;color:inherit}

/* ═══ GLOBAL BACKGROUND GRADIENT ═══ */
.gradient-bg{position:fixed;top:0;left:0;width:100%;height:100%;z-index:-1;pointer-events:none;
  background:radial-gradient(ellipse at 20% 30%,rgba(0,56,255,.09) 0%,transparent 45%),
    radial-gradient(ellipse at 70% 50%,rgba(55,127,255,.08) 0%,transparent 45%),
    radial-gradient(ellipse at 15% 70%,rgba(127,48,255,.09) 0%,transparent 45%),
    radial-gradient(ellipse at 80% 80%,rgba(242,80,110,.08) 0%,transparent 45%)}
.overflow-x-hidden{overflow-x:hidden}

/* ═══ Diamond icon ═══ */
.diamond-icon{display:flex;align-items:center;justify-content:center;flex-shrink:0}

/* ═══ Arrow 45° ═══ */
.arrow-45{display:inline-block;transform:rotate(-45deg)}

/* ═══ 1. TRUST BAR ═══ */
.trust-bar{position:fixed;top:0;left:0;right:0;z-index:100;height:60px;display:flex;align-items:center;justify-content:center;background:transparent;pointer-events:none;transition:opacity .1s ease,transform .1s ease;will-change:opacity,transform}
.trust-bar.trust-bar-hidden{opacity:0;transform:translateY(-100%);pointer-events:none}
.trust-bar-inner{display:flex;align-items:center}
.trust-slide{display:flex;align-items:center;justify-content:center;gap:8px;padding:12px 24px;background:transparent;transition:opacity .2s ease}
.trust-slide[aria-hidden="true"]{display:none}
.trust-slide[aria-hidden="false"]{display:flex}
.trust-icon{flex-shrink:0}
.trust-text{font-family:Manrope,sans-serif;font-size:16px;font-weight:400;color:#020303;line-height:25px}
@media(max-width:768px){.trust-slide{padding:10px 16px}.trust-text{font-size:14px;line-height:21px}}

/* ═══ 2. HEADER / NAV ═══ */
.site-header{position:fixed;top:66px;left:50%;transform:translate(-50%);width:calc(100% - 48px);max-width:1400px;z-index:110;transition:top .1s ease;will-change:top;--header-nav-safe-gap:8px}
.site-header.site-header-top-hidden{top:0}
.header-inner{position:relative;display:flex;align-items:center;justify-content:flex-start;height:70px;padding:0 24px 0 40px;background:#fff;border-radius:40px;box-shadow:0 10px 24px rgba(2,3,3,.06);gap:0}
.header-logo{display:flex;align-items:center;flex:0 0 auto;height:calc(100% - 12px);max-width:100%;margin-right:0;min-width:0}
.header-logo img{display:block;width:auto;height:100%;max-width:100%;object-fit:contain}
.header-main-nav{display:flex;align-items:center;justify-content:flex-end;gap:38px;flex:0 0 auto;min-width:max-content;margin-left:auto;opacity:1;visibility:visible;pointer-events:auto;transition:opacity .2s ease,visibility 0s 0s}
.header-nav{display:flex;align-items:center;gap:8px;flex:0 0 auto}
.nav-item{display:flex;align-items:center;gap:4px;padding:12px 16px;font-family:Manrope,sans-serif;font-size:16px;font-weight:400;color:#020303;line-height:25px;background:transparent;cursor:pointer;border-radius:8px;transition:background .2s;white-space:nowrap;text-decoration:none}
.nav-item:hover{background:rgba(0,0,0,.04)}

/* Header CTA */
.header-cta{display:flex;align-items:center;gap:12px;margin-left:0;flex:0 0 auto}
.btn-cta{display:inline-flex;align-items:center;justify-content:center;gap:6px;padding:12px 20px;background:var(--blue);color:#fff;font-family:Manrope,sans-serif;font-size:16px;font-weight:400;line-height:1;border-radius:100px;border:none;cursor:pointer;white-space:nowrap;transition:all .25s}
.btn-cta:hover{gap:12px;background:#374151}
.btn-cta svg{width:16px;height:16px;display:block;flex-shrink:0}

/* Nav collapse button */
.nav-collapse-btn{position:absolute;top:50%;right:24px;transform:translateY(-50%);display:flex;align-items:center;justify-content:center;width:40px;height:40px;min-width:40px;min-height:40px;max-width:40px;max-height:40px;border-radius:100px;background:var(--blue);border:none;cursor:pointer;opacity:0;visibility:hidden;pointer-events:none;transition:opacity .2s ease,visibility 0s .2s,background .2s ease}
.nav-collapse-btn svg{width:20px;height:20px}
.site-header.header-menu-only .header-main-nav{opacity:0;visibility:hidden;pointer-events:none;transition:opacity .18s ease,visibility 0s .18s}
.site-header.header-menu-only .nav-collapse-btn{opacity:1;visibility:visible;pointer-events:auto;transition:opacity .2s ease,visibility 0s 0s,background .2s ease}

@media(max-width:767px){
}
@media(max-width:698px){
  .site-header{top:66px;width:calc(100% - 32px)}
  .header-inner{height:56px;padding:0 24px 0 32px;border-radius:40px}
}

/* ═══ Mega Dropdown ═══ */
.nav-dropdown-wrapper{position:relative}
.nav-has-dropdown{gap:6px}
.nav-dropdown-chevron{width:12px;height:7px;transition:transform .25s ease;flex-shrink:0}
.nav-dropdown-wrapper:hover .nav-dropdown-chevron{transform:rotate(180deg)}
.mega-dropdown{position:absolute;top:calc(100% + 12px);left:50%;transform:translateX(-50%) translateY(4px);min-width:640px;background:#fff;border-radius:20px;box-shadow:0 20px 40px rgba(2,3,3,.15);opacity:0;visibility:hidden;pointer-events:none;z-index:120;transition:opacity .2s ease,transform .25s ease,visibility 0s .25s}
.nav-dropdown-wrapper:hover .mega-dropdown,.mega-dropdown.open{opacity:1;visibility:visible;pointer-events:auto;transform:translateX(-50%) translateY(0);transition:opacity .2s ease,transform .25s ease,visibility 0s 0s}
.mega-inner{display:flex;gap:60px;padding:36px 40px}
.mega-left{flex:1;display:flex;flex-direction:column}
.mega-link-group{display:flex;flex-direction:column;gap:4px}
.mega-link{display:flex;flex-direction:column;gap:4px;padding:10px 14px;border-radius:10px;text-decoration:none;transition:background .15s;position:relative}
.mega-link:hover{background:rgba(0,0,0,.04)}
.mega-link-title{font-family:Manrope,sans-serif;font-size:18px;font-weight:500;line-height:26px;color:#020303}
.mega-link-desc{font-family:Manrope,sans-serif;font-size:14px;font-weight:400;line-height:21px;color:#6b7280}
.mega-link.has-plus{flex-direction:row;align-items:center;justify-content:space-between}
.mega-link.has-plus .mega-link-title,.mega-link.has-plus .mega-link-desc{display:block}
.mega-link.has-plus>div{display:flex;flex-direction:column;gap:4px}
.mega-plus{font-family:Manrope,sans-serif;font-size:20px;font-weight:400;color:#020303;width:28px;height:28px;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.mega-right{flex-shrink:0;width:260px}
.mega-card{background:var(--grey-50);border-radius:14px;padding:22px;display:flex;flex-direction:column;gap:12px}
.mega-card-heading{font-family:Syne,sans-serif;font-size:21px;font-weight:400;line-height:27px;color:#020303;margin:0}
.mega-card-desc{font-family:Manrope,sans-serif;font-size:14px;font-weight:400;line-height:21px;color:#6b7280;margin:0}
.mega-card-btn{display:inline-flex;align-items:center;gap:6px;font-family:Manrope,sans-serif;font-size:16px;font-weight:400;color:var(--blue);padding:10px 18px;border-radius:100px;background:transparent;transition:all .2s;align-self:flex-start;text-decoration:none}
.mega-card-btn:hover{background:var(--blue);color:#fff;gap:12px}

/* Two-column link grid (Products dropdown) */
.mega-left--cols2{display:grid;grid-template-columns:1fr 1fr;gap:4px 20px;align-content:start}
.mega-left--cols2 .mega-link{padding:10px 12px}

/* Products dropdown: wider panel, product series + components zone + feature card */
.mega-dropdown--wide{min-width:800px;left:0;transform:translateY(4px)}
.nav-dropdown-wrapper:hover .mega-dropdown--wide,.mega-dropdown--wide.open{transform:translateY(0)}
@media(max-width:1279px){.mega-dropdown--wide{min-width:720px}}
@media(max-width:1099px){.mega-dropdown--wide{min-width:640px}}
.mega-inner--products{gap:0;padding:24px 24px 24px 28px}
.mega-left--products{flex:1;display:flex;flex-direction:column;gap:14px;min-width:0}
.mega-products-grid{display:grid;grid-template-columns:1fr 1fr;gap:6px 14px;align-content:start;min-width:0}
.mega-product-card{display:flex;align-items:center;gap:12px;padding:10px 12px;border-radius:10px;text-decoration:none;transition:background .15s;min-width:0}
.mega-product-card:hover{background:rgba(0,0,0,.04)}
.mega-product-info{display:flex;flex-direction:column;gap:2px;min-width:0;flex:1}
.mega-product-model{font-family:Manrope,sans-serif;font-size:16px;font-weight:500;line-height:24px;color:#020303;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.mega-product-tagline{font-family:Manrope,sans-serif;font-size:13px;font-weight:400;line-height:19px;color:#6b7280;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.mega-product-img{width:60px;height:60px;object-fit:cover;border-radius:10px;flex-shrink:0;background:var(--grey-100)}
.mega-divider-h{height:1px;background:var(--grey-200);margin:0}
.mega-components-heading{font-family:Syne,sans-serif;font-size:13px;font-weight:400;color:#6b7280;letter-spacing:.5px;margin:0 0 8px}
.mega-components-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}
.mega-component-card{display:flex;flex-direction:column;align-items:center;gap:6px;padding:8px;border-radius:10px;text-decoration:none;transition:background .15s;min-width:0}
.mega-component-card:hover{background:rgba(0,0,0,.04)}
.mega-component-img{width:44px;height:44px;object-fit:cover;border-radius:8px;background:var(--grey-100)}
.mega-component-name{font-family:Manrope,sans-serif;font-size:12px;font-weight:500;line-height:16px;color:#020303;text-align:center}
.mega-divider{width:1px;align-self:stretch;background:var(--grey-200);margin:0 24px}
.mega-products-card-img{width:100%;height:150px;object-fit:cover;border-radius:10px;background:var(--grey-100)}

/* Compact link list (Services dropdown right column) */
.mega-services{display:flex;flex-direction:column;gap:2px}
.mega-services-heading{font-family:Syne,sans-serif;font-size:13px;font-weight:400;color:#6b7280;text-transform:uppercase;letter-spacing:.5px;padding:0 14px 8px}
.mega-services-link{display:block;padding:7px 14px;border-radius:10px;font-family:Manrope,sans-serif;font-size:15px;font-weight:400;color:#020303;text-decoration:none;transition:background .15s,color .15s}
.mega-services-link:hover{background:rgba(0,0,0,.04);color:var(--blue)}

@media(max-width:959px){.mega-dropdown{display:none !important}}

/* Header symbols hidden while preserving layout */
.site-header .nav-dropdown-chevron,
.site-header .mega-card-btn svg,
.mobile-menu-panel .mobile-menu-toggle-chevron,
.mobile-menu-panel .mobile-menu-link svg{visibility:hidden}
.site-header .mega-plus{color:transparent}

/* Mobile menu panel */
.nav-collapse-btn.open{background:#374151}
.mobile-menu-overlay{position:fixed;inset:0;background:rgba(74,98,211,.1);opacity:0;visibility:hidden;pointer-events:none;z-index:108;transition:opacity .2s ease,visibility 0s .2s}
.mobile-menu-overlay.open{opacity:1;visibility:visible;pointer-events:auto;transition:opacity .2s ease,visibility 0s 0s}
.mobile-menu-panel{position:fixed;top:148px;left:50%;transform:translateX(-50%) translateY(-8px);width:calc(100% - 48px);max-width:520px;background:#fff;border-radius:20px;box-shadow:0 20px 40px rgba(2,3,3,.15);padding:20px;display:flex;flex-direction:column;gap:8px;opacity:0;visibility:hidden;pointer-events:none;z-index:115;transition:opacity .2s ease,transform .25s ease,visibility 0s .25s}
.mobile-menu-panel.open{opacity:1;visibility:visible;pointer-events:auto;transform:translateX(-50%) translateY(0);transition:opacity .2s ease,transform .25s ease,visibility 0s 0s}
.mobile-menu-panel{max-height:calc(100vh - 160px);overflow-y:auto}
.mobile-menu-group{display:flex;flex-direction:column;border-bottom:1px solid #e5e7eb}
.mobile-menu-group:last-of-type{border-bottom:none}
.mobile-menu-toggle,.mobile-menu-link{width:100%;display:flex;align-items:center;justify-content:space-between;gap:12px;padding:14px 12px;background:transparent;border:none;border-radius:10px;text-decoration:none;font-family:Manrope,sans-serif;font-size:18px;font-weight:400;line-height:26px;color:#020303;text-align:left;cursor:pointer}
.mobile-menu-toggle:hover,.mobile-menu-link:hover{background:rgba(0,0,0,.04)}
.mobile-menu-toggle-chevron{width:12px;height:7px;flex-shrink:0;transition:transform .25s ease}
.mobile-menu-group.open .mobile-menu-toggle-chevron{transform:rotate(180deg)}
.mobile-submenu{max-height:0;overflow:hidden;display:flex;flex-direction:column;gap:4px;transition:max-height .3s ease,padding-bottom .3s ease}
.mobile-menu-group.open .mobile-submenu{max-height:560px;padding-bottom:12px}
.mobile-submenu-link{display:flex;flex-direction:column;gap:4px;padding:10px 12px 10px 24px;border-radius:10px;text-decoration:none}
.mobile-submenu-link:hover{background:rgba(0,0,0,.04)}
.mobile-submenu-title{font-family:Manrope,sans-serif;font-size:16px;font-weight:500;line-height:24px;color:#020303}
.mobile-submenu-desc{font-family:Manrope,sans-serif;font-size:13px;font-weight:400;line-height:19px;color:#6b7280}
.mobile-menu-cta{margin-top:8px}
.mobile-menu-cta .btn-cta{width:100%;justify-content:center}
@media(max-width:698px){.mobile-menu-panel{top:130px;width:calc(100% - 32px);padding:18px}}

/* ═══ 3. HERO ═══ */
.hero{position:relative;z-index:1;padding:141px 0 24px;overflow:visible;--hero-header-width:1400px;--hero-container-width:700px;--hero-container-left:calc(50vw - var(--hero-container-width));--hero-title-scale-threshold-factor:2.2;--hero-tablet-lock-width:700px;--hero-tablet-progress:0;--hero-video-overlap:0px}
.hero-wrapper{position:relative;z-index:2;display:flex;flex-direction:column;align-items:center;gap:0;width:100%;max-width:1280px;margin:0 auto}
.hero-white-container{position:relative;width:var(--hero-container-width);max-width:var(--hero-container-width);min-width:280px;margin-top:0;margin-left:var(--hero-container-left);z-index:3;overflow:visible;filter:drop-shadow(0 24px 48px rgba(2,3,3,.16));transition:width .32s ease,max-width .32s ease,margin-left .32s ease,filter .32s ease}
.hero-white-container::before{content:"";position:absolute;inset:0;background:#fff;z-index:0}
.hero-content-card{position:relative;z-index:4;padding:40px 40px 34px;display:flex;flex-direction:column;gap:24px;animation:fadeIn .8s ease-out forwards}
@keyframes fadeIn{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:translateY(0)}}
.hero.hero-layout-desktop .hero-white-container{clip-path:url(#heroClipPc)}
.hero.hero-layout-tablet .hero-white-container{clip-path:url(#heroClipTablet);filter:drop-shadow(0 18px 36px rgba(2,3,3,.14))}
.hero.hero-layout-mobile .hero-white-container{clip-path:url(#heroClipMobile);filter:drop-shadow(0 18px 36px rgba(2,3,3,.14))}

/* Shape SVGs */
.hero-shape{position:absolute;inset:0;width:100%;height:100%;pointer-events:none}
.hero-shape path{fill:#fff}
.hero-shape-desktop{display:block}
.hero-shape-mobile{display:none}
.hero-shape-compact{display:none}

/* Tablet & PC: side-by-side layout — white container left, video right */
@media(min-width:768px){
  .hero{display:flex;flex-direction:row;align-items:flex-start;padding-left:var(--pad-40);padding-right:var(--pad-40);gap:20px}
  .hero-white-container{margin-left:0 !important;flex-shrink:0;width:420px;max-width:420px}
  .hero-wrapper{flex:1 1 0;min-width:0;max-width:none;margin:0}
  .hero-wrapper .video-section{margin-top:0;max-width:80%;margin-left:auto;margin-right:auto}
}
@media(min-width:1280px){
  .hero{width:calc(100% - 48px);max-width:1400px;margin-left:auto;margin-right:auto;padding-left:0;padding-right:0;gap:32px}
  .hero-white-container{width:700px;max-width:700px}
  .hero-wrapper{flex:1 1 0;max-width:none}
}


.hero-content{position:relative;z-index:1;padding:32px}

/* Small title */
.small-title-wrapper{margin-bottom:0}
.small-title{display:flex;align-items:center;gap:12px;padding:3px 0;font-family:Manrope,sans-serif;font-size:18px;font-weight:400;color:#020303;line-height:26px}
.small-title .diamond-icon{width:16px;height:17px}
.small-title-inner{font-family:Syne,sans-serif;font-size:21px;font-weight:400;line-height:27px;letter-spacing:-.21px;color:#020303}

/* Hero heading */
.hero-heading{margin-bottom:0;display:flex;flex-direction:column;gap:16px}
.hero-heading h1{font-family:Syne,sans-serif;font-size:62px;font-weight:400;line-height:68px;letter-spacing:-.61px;color:#020303;margin:0}
.hero-title-main{font-family:Syne,sans-serif;font-size:54px;font-weight:400;line-height:60px;letter-spacing:-.54px;color:#020303;margin:0;transition:font-size .2s ease,line-height .2s ease,letter-spacing .2s ease}
.hero.hero-title-compact .hero-title-main{font-size:52px;line-height:58px;letter-spacing:-.52px}
@media(max-width:767px){.hero-heading h1{font-size:38px;line-height:44px;letter-spacing:-.37px}}

/* Buttons */
.hero-buttons{display:flex;gap:12px;flex-wrap:wrap;padding-top:0}
.btn{display:inline-flex;align-items:center;gap:6px;font-family:Manrope,sans-serif;font-size:16px;font-weight:400;border-radius:100px;transition:all .25s;white-space:nowrap;line-height:16px;cursor:pointer;text-decoration:none}
.btn:hover{gap:12px}
.btn-primary{background:var(--blue);color:#fff;padding:12px 20px;border:none}
.btn-primary:hover{background:#374151;color:#fff}
.btn-secondary{background:transparent;color:#020303;padding:11px 20px;border:1px solid #020303}
.btn-secondary:hover{border-color:#020303;background:#e5e5e5}
.btn-book-arrow{display:inline-block;width:0;overflow:hidden;transition:width .25s ease;flex-shrink:0}
.btn-secondary:hover .btn-book-arrow{width:16px}

/* Video */
.video-section{position:relative;z-index:2;width:100%;max-width:960px;margin-top:calc(var(--hero-video-overlap) * -1)}
.video-placeholder{position:relative;width:100%;overflow:hidden;border-radius:20px;background:#e5e7eb}
.video-placeholder video{display:block;width:100%;height:auto;object-fit:cover;border-radius:20px}

@media(max-width:1279px){
  .hero-white-container{min-width:320px}
}
@media(max-width:959px){
  .hero{padding:141px var(--pad-24) 24px}
  .hero-white-container{margin-top:0}
  .hero-content-card{padding:28px 24px 24px;gap:20px}
  .hero-buttons{flex-direction:column;align-items:flex-start}
}
@media(max-width:698px){
  .hero{padding:127px var(--pad-24) 24px}
}
@media(max-width:767px){
  .hero-white-container{min-width:0}
  .hero-title-main,.hero.hero-title-compact .hero-title-main{font-size:36px;line-height:42px;letter-spacing:-.36px}
}

/* ═══ 4. WHAT WE DO ═══ */
.what-we-do{position:relative;contain:content}
.what-we-do::before{content:"";position:absolute;inset:0 50%;margin-left:-50vw;margin-right:-50vw;background:#fff;z-index:0}
.what-we-do-container{position:relative;z-index:1;display:flex;width:100%;max-width:var(--max-w);margin:0 auto;padding:60px var(--pad-100);gap:40px;align-items:flex-start}
.what-we-do-left{width:50%;display:flex;flex-direction:column}
.what-we-do-right{width:50%;display:flex;align-items:center;justify-content:center;position:sticky;top:136px;height:fit-content}
.wwd-visuals{position:relative;width:100%;aspect-ratio:1/1;overflow:hidden;border-radius:16px}
.wwd-visual{position:absolute;inset:0;opacity:0;transition:opacity .35s ease;pointer-events:none}
.wwd-visual.active{opacity:1}
.wwd-visual img{width:100%;height:100%;object-fit:cover;display:block}

.wwd-heading{font-family:Syne,sans-serif;font-size:48px;font-weight:400;line-height:52px;letter-spacing:-.48px;color:#020303;margin:0 0 24px}
@media(max-width:767px){.wwd-heading{font-size:36px;line-height:42px;letter-spacing:-.36px}}

/* Service List (collapsible with auto-rotate) */
.wwd-services{display:flex;flex-direction:column;gap:0}
.wwd-service-item{border-bottom:none}
.wwd-service-header{display:flex;align-items:center;justify-content:flex-start;width:100%;padding:12px 0;background:transparent;border:none;cursor:pointer;text-align:left;gap:0}
.wwd-service-header h3{font-family:Syne,sans-serif;font-size:21px;font-weight:400;line-height:27px;color:#020303;display:inline-flex;align-items:center;position:relative;padding-right:0;padding-bottom:4px;border-bottom:1px solid var(--black);transition:padding-right .3s ease}
/* Arrow above extended underline */
.wwd-hover-arrow{position:absolute;top:50%;transform:translateY(-50%);right:0;width:16px;height:16px;opacity:0;transition:opacity .3s ease;pointer-events:none}
.wwd-hover-arrow svg{width:16px;height:16px;display:block}
/* Hover state (not open) */
.wwd-service-item:not(.open) .wwd-service-header:hover h3{padding-right:2em}
.wwd-service-item:not(.open) .wwd-service-header:hover .wwd-hover-arrow{opacity:1}
/* Open state */
.wwd-service-item.open .wwd-service-header h3{padding-right:5em}
.wwd-service-item.open .wwd-hover-arrow{opacity:1}
.wwd-service-body{max-height:0;overflow:hidden;transition:max-height .4s ease}
.wwd-service-item.open .wwd-service-body{max-height:200px}
.wwd-service-body p{font-family:Manrope,sans-serif;font-size:16px;font-weight:400;line-height:25px;color:#020303;padding-bottom:8px}
.wwd-service-cta{display:inline-flex;align-items:center;gap:4px;font-family:Manrope,sans-serif;font-size:14px;font-weight:400;line-height:21px;color:#020303;padding-bottom:12px;text-decoration:none;transition:color .2s}
.wwd-service-item.open .wwd-service-cta{text-decoration:underline;text-underline-offset:3px}
.wwd-service-cta:hover{color:var(--blue)}
.wwd-cta-arrow{width:14px;height:14px;flex-shrink:0;opacity:0;transition:opacity .2s ease}
.wwd-service-cta:hover .wwd-cta-arrow{opacity:1}

@media(max-width:959px){
  .what-we-do-container{flex-direction:column;padding:60px var(--pad-40);gap:32px}
  .what-we-do-left,.what-we-do-right{width:100%}
  .what-we-do-right{position:static}
}
@media(max-width:767px){
  .what-we-do-container{padding:40px var(--pad-24)}
}

/* ═══ PRODUCT SHOWCASE ═══ */
.product-showcase{width:100%;background:#fff;padding:60px 0;overflow:hidden}
.product-showcase-container{max-width:var(--max-w);margin:0 auto;padding:0 var(--pad-100)}
.product-showcase-header{display:flex;flex-direction:column;align-items:center;text-align:center;margin-bottom:40px}
.product-showcase-heading{font-family:Syne,sans-serif;font-size:48px;font-weight:400;line-height:52px;color:var(--black);margin:0 0 12px}
.product-showcase-desc{font-family:Manrope,sans-serif;font-size:16px;font-weight:400;line-height:25px;color:#6b7280;max-width:600px;margin:0}
.product-carousel-wrapper{position:relative}
.product-carousel-viewport{overflow:hidden;margin:0 -16px;padding:0 16px}
.product-carousel-track{display:flex;gap:20px;transition:transform .3s ease-out}
.product-card-item{flex:0 0 calc((100% - 60px) / 4);min-width:0;border-radius:16px;border:1px solid var(--grey-200);background:#fff;overflow:hidden;transition:transform .2s ease,box-shadow .2s ease;display:block;text-decoration:none}
.product-card-item:hover{transform:translateY(-4px);box-shadow:0 12px 32px rgba(0,0,0,.08)}
.product-card-img{width:100%;aspect-ratio:4/5;overflow:hidden;background:var(--grey-100)}
.product-card-img img{width:100%;height:100%;object-fit:cover;display:block;transition:opacity .25s ease}
.product-card-info{padding:16px}
.product-card-name{font-family:Syne,sans-serif;font-size:21px;font-weight:400;line-height:27px;color:var(--black);margin:0}
.product-card-tagline{font-family:Manrope,sans-serif;font-size:14px;font-weight:400;line-height:21px;color:#6b7280;margin:4px 0 0}
.product-carousel-nav{display:flex;align-items:center;justify-content:center;gap:12px;margin-top:32px}
.product-carousel-nav button{width:44px;height:44px;display:flex;align-items:center;justify-content:center;border-radius:100px;border:1px solid var(--black);background:transparent;cursor:pointer;transition:all .2s}
.product-carousel-nav button:hover{background:var(--black);color:#fff}
.product-carousel-nav button:disabled{opacity:.3;cursor:default}
.product-carousel-nav button:disabled:hover{background:transparent;color:inherit}
.product-carousel-nav button svg{width:20px;height:20px}
@media(max-width:1279px){.product-showcase-container{padding:0 var(--pad-40)}.product-card-item{flex:0 0 calc((100% - 40px) / 3)}}
@media(max-width:959px){.product-showcase-heading{font-size:36px;line-height:42px}.product-card-item{flex:0 0 calc((100% - 20px) / 2)}}
@media(max-width:767px){.product-showcase-container{padding:0 var(--pad-24)}.product-showcase-heading{font-size:28px;line-height:34px}.product-card-item{flex:0 0 80%}.product-carousel-track{gap:16px}}

/* ═══ 5. OUR CLIENTS ═══ */
.our-clients{background:var(--black);display:flex;justify-content:center;padding:0}
.our-clients-container{display:flex;flex-direction:row;gap:40px;width:100%;max-width:var(--max-w);margin:0 auto;padding:72px var(--pad-100)}
.our-clients-left{flex:0 0 auto}
.our-clients-heading{font-family:Syne,sans-serif;font-size:32px;font-weight:400;line-height:38px;color:#fff;margin:0}
.our-clients-sub{font-family:Manrope,sans-serif;font-size:16px;font-weight:400;line-height:25px;color:#fff;margin:12px 0 0}
.our-clients-logos{flex:1;display:flex;flex-wrap:wrap;align-items:center;gap:32px;justify-content:flex-end}
.our-clients-logos img{height:36px;width:auto;object-fit:contain;opacity:1;transition:opacity .2s}
.our-clients-logos img:hover{opacity:.8}
@media(max-width:959px){
  .our-clients-container{flex-direction:column;padding:40px var(--pad-40)}
  .our-clients-logos{justify-content:flex-start}
}
@media(max-width:767px){
  .our-clients-container{padding:32px var(--pad-24)}
  .our-clients-heading{font-size:24px;line-height:30px}
  .our-clients-logos img{height:28px}
  .our-clients-logos{gap:24px}
}

/* ═══ 6. STAT CARDS ═══ */
.stat-cards{width:100%;background:#fff;padding:40px 0}
.stat-cards-container{max-width:var(--max-w);margin:0 auto;padding:0 var(--pad-100);display:flex;flex-direction:column;gap:0}
.stat-cards-header{display:grid;grid-template-columns:minmax(0,1fr) minmax(420px,600px);align-items:flex-start;gap:40px}
.stat-cards-heading{font-family:Syne,sans-serif;font-size:48px;font-weight:400;line-height:52px;color:var(--black);max-width:550px;margin:0;flex-shrink:0}
.stat-cards-desc-col{display:flex;flex-direction:column;align-items:flex-start;gap:24px;max-width:600px}
.stat-cards-desc{font-family:Manrope,sans-serif;font-size:18px;font-weight:400;line-height:28px;color:var(--black);max-width:600px;margin:0}
.stat-cards-cta{display:inline-flex;align-items:center;gap:6px;font-family:Manrope,sans-serif;font-size:16px;font-weight:400;color:#fff;background:var(--blue);padding:12px 20px;border:1px solid var(--blue);border-radius:100px;transition:all .2s}
.stat-cards-cta:hover{background:#374151;border-color:#374151;color:#fff;gap:12px}
.stat-cards-actions{display:flex;align-items:center;gap:20px;flex-wrap:wrap}
.stat-cards-arrows-row{display:flex;align-items:center;justify-content:flex-end;gap:12px;margin-top:24px}
.stat-cards-arrow{width:48px;height:48px;border-radius:100px;border:1px solid var(--grey-200);background:#fff;color:var(--black);display:flex;align-items:center;justify-content:center;cursor:pointer;transition:background .2s,border-color .2s,color .2s;flex-shrink:0}
.stat-cards-arrow:hover{background:var(--blue);border-color:var(--blue);color:#fff}
.stat-cards-arrow:disabled{opacity:.35;pointer-events:none}
.stat-cards-arrow svg{display:block;flex-shrink:0}
.stat-cards-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;margin-top:60px}
.stat-card{border-radius:16px;padding:24px;display:flex;flex-direction:column;gap:8px}
.stat-number{font-family:Syne,sans-serif;font-size:48px;font-weight:400;line-height:52px;color:#fff}
.stat-label{font-family:Manrope,sans-serif;font-size:14px;font-weight:400;line-height:21px;color:rgba(255,255,255,.7)}
.stat-card-cta{font-family:Manrope,sans-serif;font-size:14px;font-weight:400;color:rgba(255,255,255,.8);line-height:21px;margin-top:4px}
@media(min-width:1280px){
  .stat-cards-grid{display:flex;gap:20px;overflow:hidden;padding-bottom:8px;transition:transform .5s cubic-bezier(.22,.61,.36,1);will-change:transform}
  .stat-card{flex:0 0 calc((100% - 20px)/1.25);min-height:640px;aspect-ratio:1.645/1;justify-content:space-between;padding:40px}
  .stat-number{font-size:64px;line-height:68px}
  .stat-label{font-size:18px;line-height:26px;max-width:80%}
  .stat-card-cta{font-size:16px;line-height:24px}
}
@media(max-width:1279px){.stat-cards-container{padding:0 var(--pad-40)}.stat-cards-arrows-row{display:none}}
@media(max-width:959px){
  .stat-cards-grid{grid-template-columns:repeat(2,1fr)}
  .stat-cards-heading{font-size:36px;line-height:42px}

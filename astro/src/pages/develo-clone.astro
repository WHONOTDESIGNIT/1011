<script>
(function(){
  // Hero white container follows a two-stage responsive transition:
  // desktop -> centered tablet lock -> left-aligned mobile.
  var hero = document.getElementById('hero-section');
  var header = document.getElementById('site-header');
  var heroContainer = hero ? hero.querySelector('.hero-white-container') : null;
  function clamp(value, min, max) {
    return Math.min(max, Math.max(min, value));
  }
  function updateHeroContainerLayout() {
    if (!hero || !header || !heroContainer) return;
    var viewportWidth = window.innerWidth;
    var headerWidth = header.getBoundingClientRect().width;
    var heroPaddingLeft = parseFloat(getComputedStyle(hero).getPropertyValue('padding-left')) || 0;
    var desktopContainerWidth = 700;
    var desktopCenteredBreakpoint = 1400;
    var tabletTriggerHeaderWidth = 699;
    var mobileBreakpoint = 698;
    var mobileSidePadding = 24;
    var availableMobileWidth = Math.max(viewportWidth - (mobileSidePadding * 2), 280);
    var containerWidth = desktopContainerWidth;
    var containerLeft = viewportWidth >= desktopCenteredBreakpoint
      ? (viewportWidth / 2) - desktopContainerWidth
      : ((viewportWidth - desktopContainerWidth) / 2) - heroPaddingLeft;
    var heroLayoutMode = 'desktop';

    if (viewportWidth <= mobileBreakpoint) {
      heroLayoutMode = 'mobile';
      containerWidth = Math.min(availableMobileWidth, tabletTriggerHeaderWidth);
      containerLeft = Math.max(((viewportWidth - containerWidth) / 2) - heroPaddingLeft, 0);
    } else if (headerWidth <= tabletTriggerHeaderWidth) {
      heroLayoutMode = 'tablet';
      containerWidth = headerWidth;
      containerLeft = ((viewportWidth - containerWidth) / 2) - heroPaddingLeft;
    }

    hero.style.setProperty('--hero-header-width', headerWidth + 'px');
    hero.style.setProperty('--hero-container-width', Math.round(containerWidth) + 'px');
    hero.style.setProperty('--hero-container-left', Math.round(containerLeft) + 'px');
    hero.style.setProperty('--hero-tablet-lock-width', tabletTriggerHeaderWidth + 'px');
    hero.style.setProperty('--hero-tablet-progress', heroLayoutMode === 'mobile' ? '1' : heroLayoutMode === 'tablet' ? '0.5' : '0');
    hero.classList.remove('hero-layout-desktop', 'hero-layout-tablet', 'hero-layout-mobile');
    hero.classList.add('hero-layout-' + heroLayoutMode);

    var scaleReferenceWidth = heroLayoutMode === 'desktop' ? desktopContainerWidth : containerWidth;
    var scaleThreshold = scaleReferenceWidth * parseFloat(getComputedStyle(hero).getPropertyValue('--hero-title-scale-threshold-factor'));
    var shouldCompactTitle = viewportWidth > mobileBreakpoint && headerWidth <= tabletTriggerHeaderWidth && viewportWidth < scaleThreshold;
    hero.classList.toggle('hero-title-compact', shouldCompactTitle);
  }

  updateHeroContainerLayout();
  window.addEventListener('resize', updateHeroContainerLayout);
  window.addEventListener('layout:header-metrics', updateHeroContainerLayout);

  // What We Do — auto-rotate expand (starts with item 0 open)
  var serviceItems = document.querySelectorAll('.wwd-service-item');
  var autoTimer = null;
  var autoIndex = 1; // next item to open
  var serviceVisuals = document.querySelectorAll('.wwd-visual');

  function expandItem(el) {
    serviceItems.forEach(function(it) {
      it.classList.remove('open');
      it.querySelector('.wwd-service-header').setAttribute('aria-expanded', 'false');
    });
    el.classList.add('open');
    el.querySelector('.wwd-service-header').setAttribute('aria-expanded', 'true');
    var idx = Array.prototype.indexOf.call(serviceItems, el);
    serviceVisuals.forEach(function(visual) {
      visual.classList.toggle('active', Number(visual.getAttribute('data-index')) === idx);
    });
    return idx;
  }

  function startAutoRotate(startIndex) {
    if (typeof startIndex !== 'undefined') autoIndex = startIndex;
    if (autoTimer) clearInterval(autoTimer);
    autoTimer = setInterval(function() {
      expandItem(serviceItems[autoIndex]);
      autoIndex = (autoIndex + 1) % serviceItems.length;
    }, 6000);
  }

  // Show first item immediately, then start rotation
  expandItem(serviceItems[0]);
  startAutoRotate(1);

  serviceItems.forEach(function(item) {
    var header = item.querySelector('.wwd-service-header');
    header.addEventListener('click', function() {
      var idx = expandItem(item);
      startAutoRotate((idx + 1) % serviceItems.length);
    });
  });
})();
</script>
<script>
(function() {
  // Product showcase carousel
  var track = document.getElementById('product-carousel-track');
  var prevBtn = document.getElementById('prev-product-card');
  var nextBtn = document.getElementById('next-product-card');
  if (track && prevBtn && nextBtn) {
    var scrollPos = 0;
    function getCardWidth() {
      var cards = track.querySelectorAll('.product-card-item');
      if (cards.length < 2) return 300;
      // Exact step = measured distance between two adjacent cards (card + gap),
      // read from real layout offsets so zoom/scaling/sub-pixel rounding cannot
      // drift the slide and leave the next card only partially visible.
      return cards[1].offsetLeft - cards[0].offsetLeft;
    }
    function getMaxScroll() {
      // The viewport has 16px side padding; without adding it back the last card
      // stays clipped at the right edge and can never be scrolled fully into view.
      var viewport = track.parentElement;
      return track.scrollWidth - viewport.clientWidth + parseInt(getComputedStyle(viewport).paddingLeft, 10);
    }
    function updateButtons() {
      prevBtn.disabled = scrollPos <= 1;
      nextBtn.disabled = scrollPos >= getMaxScroll() - 1;
    }
    prevBtn.addEventListener('click', function() {
      scrollPos = Math.max(0, scrollPos - getCardWidth());
      track.style.transform = 'translateX(' + (-scrollPos) + 'px)';
      updateButtons();
    });
    nextBtn.addEventListener('click', function() {
      scrollPos = Math.min(getMaxScroll(), scrollPos + getCardWidth());
      track.style.transform = 'translateX(' + (-scrollPos) + 'px)';
      updateButtons();
    });
    window.addEventListener('resize', function() {
      scrollPos = Math.min(scrollPos, getMaxScroll());
      track.style.transform = 'translateX(' + (-scrollPos) + 'px)';
      updateButtons();
    });
    updateButtons();
  }

  // Stat cards slider — arrow-controlled (left/right buttons), no swipe/scroll
  var statGrid = document.getElementById('stat-cards-grid');
  var statPrevBtn = document.getElementById('prev-stat-card');
  var statNextBtn = document.getElementById('next-stat-card');
  if (statGrid && statPrevBtn && statNextBtn) {
    var statIndex = 0;
    var statBusy = false;
    var statMq = window.matchMedia('(min-width:1280px)');
    function statCards() {
      return Array.prototype.slice.call(statGrid.querySelectorAll('.stat-card'));
    }
    // Exact one-card step = measured distance between two adjacent cards (card + gap),
    // read from real layout offsets so zoom/scaling/sub-pixel rounding cannot drift
    // the slide and leave the next card only partially visible.
    function statCardWidth() {
      var cards = statCards();
      if (cards.length < 2) return 300;
      return Math.max(1, cards[1].offsetLeft - cards[0].offsetLeft);
    }
    function statMaxIndex() {
      return Math.max(0, statCards().length - 1);
    }
    function statApply() {
      var active = statMq.matches;
      if (active) {
        statIndex = Math.min(statIndex, statMaxIndex());
        var cards = statCards();
        var w = statCardWidth();
        // Snap so the target card sits exactly at the container's left edge.
        var delta = cards[statIndex] ? cards[statIndex].offsetLeft - cards[0].offsetLeft : statIndex * w;
        statGrid.style.transform = 'translateX(' + (-delta) + 'px)';
      } else {
        statIndex = 0;
        statGrid.style.transform = '';
      }
      statPrevBtn.disabled = !active || statIndex <= 0;
      statNextBtn.disabled = !active || statIndex >= statMaxIndex();
    }
    function statStep(dir) {
      if (statBusy) return; // ignore clicks while a transition is running
      var active = statMq.matches;
      if (!active) return;
      statIndex = Math.max(0, Math.min(statMaxIndex(), statIndex + dir));
      statBusy = true;
      var release = function() {
        statGrid.removeEventListener('transitionend', release);
        statGrid.removeEventListener('transitioncancel', release);
        clearTimeout(releaseTimer);
        statBusy = false;
        statApply();
      };
      // Fallback so the click lock can never get stuck if a transition is interrupted.
      var releaseTimer = setTimeout(release, 700);
      statGrid.addEventListener('transitionend', release);
      statGrid.addEventListener('transitioncancel', release);
      statApply();
    }
    statPrevBtn.addEventListener('click', function() { statStep(-1); });
    statNextBtn.addEventListener('click', function() { statStep(1); });
    window.addEventListener('resize', function() { statBusy = false; statApply(); });
    statApply();
  }
})();
</script>
</body>
</html>

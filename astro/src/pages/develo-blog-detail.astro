          <p>{t(locale, 'develoContent.blogDetail.body.tip1Para2')}</p>

          <h3>{t(locale, 'develoContent.blogDetail.body.tip2Title')}</h3>
          <p>{t(locale, 'develoContent.blogDetail.body.tip2Para1')}</p>
          <p>{t(locale, 'develoContent.blogDetail.body.tip2Para2')}</p>

          <h3>{t(locale, 'develoContent.blogDetail.body.tip3Title')}</h3>
          <p>{t(locale, 'develoContent.blogDetail.body.tip3Para1Before')} <a href="https://www.develodesign.co.uk/blog/our-strategic-partnership-with-hypernode-for-superior-magento-performance" target="_blank" rel="noopener">Hypernode</a>{t(locale, 'develoContent.blogDetail.body.tip3Para1After')}</p>
          <p>{t(locale, 'develoContent.blogDetail.body.tip3Para2')}</p>

          <h3>{t(locale, 'develoContent.blogDetail.body.tip4Title')}</h3>
          <p>{t(locale, 'develoContent.blogDetail.body.tip4Para1')}</p>
          <p>{t(locale, 'develoContent.blogDetail.body.tip4Para2Before')} <a href="https://www.cloudflare.com/en-gb/" target="_blank" rel="noopener">Cloudflare</a> {t(locale, 'develoContent.blogDetail.body.tip4Para2After')}</p>

          <h3>{t(locale, 'develoContent.blogDetail.body.tip5Title')}</h3>
          <p>{t(locale, 'develoContent.blogDetail.body.tip5Para')}</p>

          <h3>{t(locale, 'develoContent.blogDetail.body.tip6Title')}</h3>
          <p>{t(locale, 'develoContent.blogDetail.body.tip6Para1')}</p>
          <p>{t(locale, 'develoContent.blogDetail.body.tip6Para2Before')} <a href="https://github.com/yireo/Yireo_Webp2" target="_blank" rel="noopener">Yireo Webp2</a> {t(locale, 'develoContent.blogDetail.body.tip6Para2After')}</p>

          <h3>{t(locale, 'develoContent.blogDetail.body.tip7Title')}</h3>

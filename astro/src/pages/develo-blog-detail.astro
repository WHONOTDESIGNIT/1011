            <li><strong>{t(locale, 'develoContent.blogDetail.body.bonusItem1Strong')}</strong> {t(locale, 'develoContent.blogDetail.body.bonusItem1Before')} <a href="https://www.develodesign.co.uk/services/hyva-themes" target="_blank" rel="noopener">Magento 2 Hyva Theme</a> {t(locale, 'develoContent.blogDetail.body.bonusItem1After')}</li>
            <li><strong>{t(locale, 'develoContent.blogDetail.body.bonusItem2Strong')}</strong> {t(locale, 'develoContent.blogDetail.body.bonusItem2Before')} <a href="https://gtmetrix.com/" target="_blank" rel="noopener">GTmetrix</a>{t(locale, 'develoContent.blogDetail.body.bonusItem2Middle')} <a href="https://pagespeed.web.dev/" target="_blank" rel="noopener">PageSpeed Insights</a>{t(locale, 'develoContent.blogDetail.body.bonusItem2Middle')} <a href="https://www.webpagetest.org/" target="_blank" rel="noopener">WebPageTest</a>{t(locale, 'develoContent.blogDetail.body.bonusItem2After')}</li>

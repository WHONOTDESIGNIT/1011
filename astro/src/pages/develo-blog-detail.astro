          <p>{t(locale, 'develoContent.blogDetail.body.tip7Para2')}</p>

          <h3>{t(locale, 'develoContent.blogDetail.body.tip8Title')}</h3>
          <p>{t(locale, 'develoContent.blogDetail.body.tip8Para')}</p>

          <h2>{t(locale, 'develoContent.blogDetail.body.bonusTitle')}</h2>

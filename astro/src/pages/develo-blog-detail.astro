          <div class="article-meta-top">
            <span>{t(locale, 'develoContent.blogDetail.author')}</span>
            <span>{t(locale, 'develoContent.blogDetail.date')}</span>
            <span class="article-read-time">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.5"/><path d="M12 6v6l4 2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              {t(locale, 'develoContent.blogDetail.readTime')}
            </span>
          </div>
        </header>



        <div class="article-body">
          <p>{t(locale, 'develoContent.blogDetail.body.para1Before')} <a href="https://www.shopify.com/in/blog/website-load-time-statistics" target="_blank" rel="noopener">53% of visitors leave mobile sites</a> {t(locale, 'develoContent.blogDetail.body.para1After')}</p>

          <p>{t(locale, 'develoContent.blogDetail.body.para2')}</p>

          <h2>{t(locale, 'develoContent.blogDetail.body.section1Title')}</h2>
          <p>{t(locale, 'develoContent.blogDetail.body.section1ParaBefore')} <a href="https://pagespeed.web.dev/" target="_blank" rel="noopener">PageSpeed Insights</a> {t(locale, 'develoContent.blogDetail.body.section1ParaMiddle')} <a href="https://gtmetrix.com/" target="_blank" rel="noopener">GTmetrix</a>{t(locale, 'develoContent.blogDetail.body.section1ParaAfter')}</p>

          <h2>{t(locale, 'develoContent.blogDetail.body.section2Title')}</h2>

          <h3>{t(locale, 'develoContent.blogDetail.body.tip1Title')}</h3>

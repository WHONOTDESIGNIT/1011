          <p class="article-updated">{t(locale, 'develoContent.blogDetail.updated')}</p>
        </div>

        <!-- Share -->
        <div class="article-share">
          <span class="article-share-label">{t(locale, 'develoContent.blogDetail.share.label')}</span>
          <a class="article-share-link" href="#" aria-label={t(locale, 'develoContent.blogDetail.share.twitter')}>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" fill="currentColor"/></svg>
          </a>
          <a class="article-share-link" href="#" aria-label={t(locale, 'develoContent.blogDetail.share.linkedin')}>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" fill="currentColor"/></svg>
          </a>
          <a class="article-share-link" href="#" aria-label={t(locale, 'develoContent.blogDetail.share.facebook')}>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" fill="currentColor"/></svg>
          </a>
        </div>

        <!-- CTA Banner -->
        <div class="article-cta">
          <p class="article-cta-text">{t(locale, 'develoContent.blogDetail.cta.text')}</p>
          <a class="btn-cta" href={getLocalizedPath(locale, '/contact')}>{t(locale, 'develoContent.blogDetail.cta.button')} <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M7 17L17 7M17 7H7M17 7V17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
        </div>
      </div>

      <!-- Author Sidebar -->
      <aside class="author-sidebar">
        <div class="author-card">
          <div class="author-avatar">
            <span class="author-avatar-inner">BW</span>
          </div>
          <div class="author-info">
            <span class="author-name">Bethany Wood</span>
            <span class="author-role">{t(locale, 'develoContent.blogDetail.authorRole')}</span>
          </div>
          <p class="author-bio">{t(locale, 'develoContent.blogDetail.authorBio')}</p>

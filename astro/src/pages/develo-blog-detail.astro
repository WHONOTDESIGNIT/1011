﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿﻿---
// Develo Design Blog Detail Clone — exact CSS from Playwright getComputedStyle()
// Path: /blog/8-tips-to-optimise-magento-speed-and-performance
import { t } from '../lib/i18n';
import { getLocalizedPath } from '../lib/breadcrumbs';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';

const locale = Astro.currentLocale ?? 'en';
---
<!doctype html>
<html lang={locale} dir={locale === 'ar' || locale === 'he' || locale === 'fa' ? 'rtl' : 'ltr'}>
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<script is:inline>
  // 语言偏好持久化：读取用户选定的语言（localStorage），
  // 若当前 URL 语言与偏好不一致，立即重定向到偏好语言对应页面（支持 en/tr/ar）
  (function () {
    var KEY = 'ishine_lang';
    try {
      var stored = localStorage.getItem(KEY);
      if (!stored) return;
      var LANGS = ['tr', 'ro', 'ar', 'es', 'fr', 'ru', 'he', 'fa', 'el', 'pt-BR', 'nl', 'id', 'th', 'pl', 'ja', 'ko'];
      var path = window.location.pathname;
      var cur = 'en';
      for (var i = 0; i < LANGS.length; i++) {
        if (path === '/' + LANGS[i] || path.indexOf('/' + LANGS[i] + '/') === 0) {
          cur = LANGS[i];
          break;
        }
      }
      if (stored === cur) return;
      var stripped = path;
      for (var j = 0; j < LANGS.length; j++) {
        stripped = stripped.replace(new RegExp('^/' + LANGS[j] + '/?'), '');
      }
      if (stored === 'en') {
        stripped = stripped.replace(/\/+$/, '');
        if (stripped === '' || stripped === '/') stripped = '/';
        if (stripped !== path) window.location.replace(stripped);
      } else {
        var target = '/' + stored + (stripped === '' || stripped === '/' ? '' : stripped);
        target = target.replace(/\/+$/, '');
        if (target === '') target = '/' + stored;
        if (target !== path) window.location.replace(target);
      }
    } catch (e) { /* 隐私模式等场景忽略 */ }
  })();
</script>
<title>{t(locale, 'develoContent.blogDetail.pageTitle')}</title>
<meta name="description" content={t(locale, 'develoContent.blogDetail.pageDescription')} />

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=Syne:wght@400;700&display=swap" rel="stylesheet" />

<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{--blue:#563cfa;--black:#020303;--white:#fff;--grey-50:#f9fafb;--grey-100:#f3f4f6;--grey-200:#e5e7eb;--grey-400:#9ca3af;--grey-500:#6b7280;--grey-text:#4b5563;--max-w:1536px;--pad-100:100px}
html{scroll-behavior:smooth;overflow-x:hidden}
body{font-family:Manrope,-apple-system,Roboto,Helvetica,sans-serif;font-size:16px;font-weight:400;color:#000;background:#fff;overflow-x:hidden;-webkit-font-smoothing:antialiased}
a{text-decoration:none;color:inherit}
img{max-width:100%;height:auto;display:block}

/* ═══ SHARED: Trust Bar ═══ */
.trust-bar{position:fixed;top:0;left:0;right:0;z-index:100;height:60px;display:flex;align-items:center;justify-content:center;background:transparent}
.trust-bar-inner{display:flex;align-items:center}
.trust-slide{display:flex;align-items:center;justify-content:center;gap:8px;padding:12px 24px}
.trust-slide[aria-hidden="true"]{display:none}
.trust-slide[aria-hidden="false"]{display:flex}
.trust-text{font-family:Manrope,sans-serif;font-size:16px;font-weight:400;color:#020303;line-height:25px}

/* ═══ SHARED: Header ═══ */
.site-header{position:fixed;top:66px;left:50%;transform:translate(-50%);width:calc(100% - 48px);max-width:1400px;z-index:110}
.header-inner{display:flex;align-items:center;justify-content:space-between;height:70px;padding:0 24px 0 40px;background:rgba(255,255,255,.9);border-radius:40px;box-shadow:0 10px 24px rgba(2,3,3,.06);gap:40px}
.header-logo{display:flex;align-items:center;flex-shrink:0}
.header-nav{display:flex;align-items:center;gap:8px}
.nav-item{position:relative;display:flex;align-items:center;gap:4px;padding:12px 16px;font-family:Manrope,sans-serif;font-size:16px;font-weight:400;color:#020303;line-height:25px;border:none;background:transparent;cursor:pointer;border-radius:8px;transition:background .2s;white-space:nowrap}
.nav-item:hover{background:rgba(0,0,0,.04)}
.nav-arrow{width:16px;height:16px;flex-shrink:0;transition:transform .2s}
.header-cta{display:flex;align-items:center;gap:12px}
.btn-cta{display:inline-flex;align-items:center;justify-content:center;gap:6px;padding:12px 20px;background:var(--blue);color:#fff;font-family:Manrope,sans-serif;font-size:16px;font-weight:400;line-height:16px;border-radius:100px;border:none;cursor:pointer;white-space:nowrap;transition:all .2s;text-decoration:none}
.btn-cta:hover{gap:16px;background:#374151}
.desktop-nav{display:flex}
@media(max-width:959px){.desktop-nav{display:none}.header-cta .btn-cta{display:none}}
@media(max-width:767px){.site-header{top:66px;width:calc(100% - 32px)}.header-inner{height:56px;padding:0 24px 0 32px}}

/* ═══ BLOG DETAIL SPECIFIC ═══ */
.page-main{margin-top:136px;padding-bottom:80px}

/* ═══ Article Layout ═══ */
.article-page{width:100%;max-width:var(--max-w);margin:0 auto;padding:0 var(--pad-100)}
.article-grid{display:grid;grid-template-columns:1fr 300px;gap:80px;align-items:start}

/* ═══ Breadcrumb ═══ */
.article-breadcrumb{display:flex;align-items:center;gap:8px;margin-bottom:40px;font-family:Manrope,sans-serif;font-size:14px;font-weight:400;color:var(--grey-500);line-height:21px}
.article-breadcrumb a{color:var(--grey-500);transition:color .2s}
.article-breadcrumb a:hover{color:var(--blue)}
.breadcrumb-sep{color:var(--grey-400)}

/* ═══ Article Header ═══ */
.article-header{display:flex;flex-direction:column;gap:16px;margin-bottom:32px}
.article-category{display:inline-block;font-family:Manrope,sans-serif;font-size:12px;font-weight:600;color:var(--blue);text-transform:uppercase;letter-spacing:.5px;padding:4px 12px;border:1px solid var(--grey-400);border-radius:100px;width:fit-content}
.article-header h1{font-family:Syne,sans-serif;font-size:42px;font-weight:400;line-height:50px;letter-spacing:-.41px;color:var(--black);margin:0}
.article-desc{font-family:Manrope,sans-serif;font-size:18px;font-weight:400;line-height:28px;color:var(--grey-text);max-width:620px}
.article-meta-top{display:flex;align-items:center;gap:16px;font-family:Manrope,sans-serif;font-size:14px;color:var(--grey-500);line-height:21px}
.article-read-time{display:inline-flex;align-items:center;gap:6px}
.article-read-time svg{flex-shrink:0}

/* ═══ Article Body ═══ */
.article-body{font-family:Manrope,sans-serif;font-size:17px;font-weight:400;line-height:28px;color:var(--black)}
.article-body p{margin-bottom:24px}
.article-body h2{font-family:Syne,sans-serif;font-size:24px;font-weight:400;line-height:32px;color:var(--black);margin:40px 0 16px}
.article-body h3{font-family:Syne,sans-serif;font-size:20px;font-weight:400;line-height:28px;color:var(--black);margin:32px 0 12px}
.article-body a{color:var(--blue);text-decoration:underline;text-underline-offset:2px;transition:color .2s}
.article-body a:hover{color:#374151}
.article-body ol,.article-body ul{padding-left:24px;margin-bottom:24px}
.article-body li{margin-bottom:8px}
.article-body strong{font-weight:600}

/* ═══ Code / Inline highlight ═══ */
.article-body em{font-style:italic}

/* ═══ Last Updated ═══ */
.article-updated{margin-top:40px;padding-top:24px;border-top:1px solid var(--grey-200);font-family:Manrope,sans-serif;font-size:14px;color:var(--grey-500);line-height:21px;font-style:italic}

/* ═══ Author Sidebar ═══ */
.author-sidebar{position:sticky;top:156px;display:flex;flex-direction:column}
.author-card{display:flex;flex-direction:column;gap:16px;padding:24px;background:var(--grey-50);border-radius:16px;border:1px solid var(--grey-200)}
.author-avatar{width:64px;height:64px;border-radius:50%;background:var(--grey-200);display:flex;align-items:center;justify-content:center;overflow:hidden}
.author-avatar-inner{font-family:Syne,sans-serif;font-size:24px;font-weight:700;color:var(--grey-500)}
.author-info{display:flex;flex-direction:column;gap:4px}
.author-name{font-family:Syne,sans-serif;font-size:17px;font-weight:400;line-height:22px;color:var(--black)}
.author-role{font-family:Manrope,sans-serif;font-size:13px;font-weight:400;color:var(--grey-500);line-height:19px}
.author-bio{font-family:Manrope,sans-serif;font-size:13px;font-weight:400;line-height:20px;color:var(--grey-text)}
.author-company{font-family:Manrope,sans-serif;font-size:12px;font-weight:500;color:var(--grey-500);line-height:18px;padding-top:8px;border-top:1px solid var(--grey-200)}

/* ═══ Share Section ═══ */
.article-share{margin-top:48px;padding-top:24px;border-top:1px solid var(--grey-200);display:flex;align-items:center;gap:12px}
.article-share-label{font-family:Manrope,sans-serif;font-size:14px;font-weight:600;color:var(--black)}
.article-share-link{display:flex;align-items:center;justify-content:center;width:36px;height:36px;border-radius:50%;border:1px solid var(--grey-200);color:var(--grey-500);transition:all .2s}
.article-share-link:hover{border-color:var(--blue);color:var(--blue)}

/* ═══ CTA Banner ═══ */
.article-cta{margin-top:60px;padding:40px;background:var(--black);border-radius:20px;display:flex;align-items:center;justify-content:space-between;gap:24px}
.article-cta-text{font-family:Syne,sans-serif;font-size:24px;font-weight:400;line-height:32px;color:var(--white);max-width:460px}
.article-cta .btn-cta{flex-shrink:0}

/* ═══ FOOTER ═══ */
.site-footer{background:var(--black);color:#fff;width:100vw;position:relative;left:50%;right:50%;margin-left:-50vw;margin-right:-50vw;padding:120px 0;margin-top:80px}
.footer-container{padding:0 var(--pad-100);max-width:var(--max-w);margin:0 auto}
.footer-grid{display:grid;grid-template-columns:1.5fr 1fr 1fr 1fr;gap:60px;margin-bottom:60px}
.footer-brand p{font-family:Manrope,sans-serif;font-size:16px;font-weight:400;line-height:25px;color:rgba(255,255,255,.6);margin-top:16px;max-width:280px}
.footer-col h4{font-family:Manrope,sans-serif;font-size:16px;font-weight:600;color:#fff;line-height:25px;margin-bottom:16px}
.footer-col a{display:block;font-family:Manrope,sans-serif;font-size:14px;font-weight:400;color:rgba(255,255,255,.6);line-height:21px;padding:6px 0;transition:color .2s}
.footer-col a:hover{color:#fff}
.footer-bottom{display:flex;align-items:center;justify-content:space-between;padding-top:24px;border-top:1px solid rgba(255,255,255,.1)}
.footer-bottom span{font-family:Manrope,sans-serif;font-size:14px;font-weight:400;color:rgba(255,255,255,.5);line-height:21px}

/* ═══ RESPONSIVE ═══ */
@media(max-width:1279px){
  .article-page{padding:0 40px}
  .article-grid{grid-template-columns:1fr;gap:40px}
  .author-sidebar{position:static}
}
@media(max-width:767px){
  .article-page{padding:0 24px}
  .article-header h1{font-size:30px;line-height:38px;letter-spacing:-.29px}
  .article-desc{font-size:16px;line-height:26px}
  .article-body{font-size:16px;line-height:26px}
  .article-body h2{font-size:21px;line-height:28px}
  .article-body h3{font-size:18px;line-height:26px}
  .article-cta{flex-direction:column;text-align:center;padding:32px 24px}
  .article-cta-text{font-size:20px;line-height:28px}
  .site-footer{padding:60px 0}
  .footer-container{padding:0 24px}
  .footer-grid{grid-template-columns:1fr;gap:32px}
  .footer-bottom{flex-direction:column;gap:12px;text-align:center}
}
</style>
</head>
<body>

<SiteHeader />

<!-- ═══ ARTICLE CONTENT ═══ -->
<main class="page-main">
  <article class="article-page">
    <!-- Breadcrumb -->
    <nav class="article-breadcrumb" aria-label={t(locale, 'develoContent.blogDetail.breadcrumb.ariaLabel')}>
      <a href={getLocalizedPath(locale, '/blog')}>{t(locale, 'develoContent.blogDetail.breadcrumb.blog')}</a>
      <span class="breadcrumb-sep">/</span>
      <span>{t(locale, 'develoContent.blogDetail.title')}</span>
    </nav>

    <div class="article-grid">
      <!-- Main Content Column -->
      <div class="article-content">
        <header class="article-header">
          <span class="article-category">{t(locale, 'develoContent.blogDetail.category')}</span>
          <h1>{t(locale, 'develoContent.blogDetail.title')}</h1>

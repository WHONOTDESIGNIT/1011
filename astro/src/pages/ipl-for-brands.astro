---
// /ipl-for-brands — IPL Devices for Brands, Creators & Retail
//
// 【2026-09-11 起：由「英文单语页」改为真多语言页】
// 此前本页是英文单语营销页：内容恒为英文、lang 恒为 en、canonical 指向英文规范
// URL、hreflang 只声明 en + x-default（刻意不做伪翻译声明）。
//
// 现 auxPages.iplForBrands.* 已在 21 个语种全部补齐，21 个语种各自渲染自己的文案，
// 因此原先「内容恒为英文」的前提不再成立，元数据必须同步改为按语种自指，否则：
//   - canonical 指向英文 → 21 个已翻译页面全部被 Google 折叠到英文页，翻译白做；
//   - lang 恒为 en → 德语页用 lang=en，且 ar/fa/he 的 dir 会算成 ltr，
//     阿拉伯语/希伯来语/波斯语正文将以 LTR 排版（可见的功能性错误）。
// 处理方式与 /careers 一致：canonical 自指 + hreflang 交给 SeoHead 生成完整
// 23 条语言组（21 语种 + en + x-default）。
//
// 站内 CTA 仍按当前 URL 语种本地化（/tr/ipl-for-brands 内链跳 /tr/...）。
// 序号/图片 src/内链 href 等结构信息保留在组件内（不进 message）。
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLocalizedPath } from '../lib/breadcrumbs';
import { t } from '../lib/i18n';

const locale = Astro.currentLocale ?? 'en';
const loc = (p: string) => getLocalizedPath(locale, p);
const gm = (leaf: string) => t(locale, `auxPages.iplForBrands.${leaf}`);

const siteBaseUrl = (
  Astro.site?.toString()
  ?? process.env.URL
  ?? process.env.DEPLOY_PRIME_URL
  ?? process.env.SITE_URL
  ?? 'https://iplmanufacturer.com'
).replace(/\/$/, '');
const canonicalUrl = `${siteBaseUrl}${getLocalizedPath(locale, '/ipl-for-brands')}`;

const pageTitle = gm('pageTitle');
const pageDescription = gm('pageDescription');

// 集合型 message 以 "0"…"n" 为键，此处在组件内展开为有序数组
const R = (n: number) => Array.from({ length: n }, (_, i) => i);

const heroTrust = R(4).map((i) => [gm(`hero.trust.${i}.head`), gm(`hero.trust.${i}.sub`)]);

const scenarios = R(5).map((i) => ({
  num: String(i + 1).padStart(2, '0'),
  channel: gm(`scenarios.cards.${i}.channel`),
  title: gm(`scenarios.cards.${i}.title`),
  body: gm(`scenarios.cards.${i}.body`),
  tag: gm(`scenarios.cards.${i}.tag`),
  href: [loc('/services/private-label'), loc('/services/dropshipping'), loc('/services/dropshipping'), loc('/services/private-label'), loc('/catalogue')][i],
  hrefLabel: gm(`scenarios.cards.${i}.hrefLabel`),
}));

const selectionRows = R(5).map((i) => ({
  scenario: gm(`selection.rows.${i}.scenario`),
  value: gm(`selection.rows.${i}.value`),
  start: gm(`selection.rows.${i}.start`),
  caveat: gm(`selection.rows.${i}.caveat`),
}));

const honestLimits = R(5).map((i) => [gm(`limits.items.${i}.who`), gm(`limits.items.${i}.note`)]);

const brandPaths = R(3).map((i) => ({
  title: gm(`branding.cards.${i}.title`),
  body: gm(`branding.cards.${i}.body`),
  href: [loc('/services/private-label'), loc('/services/logo-printing'), loc('/services/oem-odm')][i],
  cta: gm(`branding.cards.${i}.cta`),
}));

const deRiskSteps = R(4).map((i) => ({
  idx: String(i + 1).padStart(2, '0'),
  title: gm(`derisk.steps.${i}.title`),
  body: gm(`derisk.steps.${i}.body`),
}));

const factoryResources = R(2).map((i) => ({
  src: [
    '/images/blog/blog-06-quality-control-in-ipl-manufacturing-best-practices.webp',
    '/images/blog/blog-02-oem-vs-odm-choosing-the-right-manufacturing-model.webp',
  ][i],
  href: [
    loc('/blog/06-quality-control-in-ipl-manufacturing-best-practices'),
    loc('/blog/02-oem-vs-odm-choosing-the-right-manufacturing-model'),
  ][i],
  title: gm(`factory.cards.${i}.title`),
  body: gm(`factory.cards.${i}.body`),
  cta: gm(`factory.cards.${i}.cta`),
}));

const complianceBadges = R(4).map((i) => [gm(`compliance.badges.${i}.title`), gm(`compliance.badges.${i}.body`)]);

const brandShowcase = R(2).map((i) => ({
  src: [
    '/images/components/brand-build-cyberpunk-1.webp',
    '/images/components/brand-build-cyberpunk-2.webp',
  ][i],
  title: gm(`showcase.images.${i}.title`),
  body: gm(`showcase.images.${i}.body`),
  alt: gm(`showcase.images.${i}.alt`),
}));

const complianceDocs = R(6).map((i) => gm(`compliance.docs.${i}`));

const specVariables = R(5).map((i) => [gm(`spec.vars.${i}.name`), gm(`spec.vars.${i}.body`)]);

const comparisonRows = R(7).map((i) => [
  gm(`compare.rows.${i}.property`),
  gm(`compare.rows.${i}.ipl`),
  gm(`compare.rows.${i}.laser`),
  gm(`compare.rows.${i}.shave`),
]);

const techTools = R(3).map((i) => ({
  label: gm(`tools.cards.${i}.label`),
  title: gm(`tools.cards.${i}.title`),
  body: gm(`tools.cards.${i}.body`),
  href: [loc('/catalogue'), loc('/products'), loc('/services/private-label')][i],
  cta: gm(`tools.cards.${i}.cta`),
}));

// 每个 FAQ 的关联链接 = message 标签（faq.links.*）+ 组件内 href
const faqLinkRefs = [
  [{ labelKey: 'faq.links.noMoq', href: loc('/services/no-moq') }],
  [
    { labelKey: 'faq.links.privateLabel', href: loc('/services/private-label') },
    { labelKey: 'faq.links.oemOdm', href: loc('/services/oem-odm') },
  ],
  [{ labelKey: 'faq.links.fdaGuide', href: loc('/blog/14-fda-cleared-ipl-device-manufacturer-guide') }],
  [{ labelKey: 'faq.links.skinTones', href: loc('/blog/25-ipl-hair-removal-safe-skin-types-fitzpatrick') }],
  [
    { labelKey: 'faq.links.whiteLabel', href: loc('/services/private-label') },
    { labelKey: 'faq.links.odm', href: loc('/services/oem-odm') },
  ],
  [{ labelKey: 'faq.links.uglyTruth', href: loc('/blog/ugly-truth-ipl-manufacturers-energy-adapter-fda') }],
  [{ labelKey: 'faq.links.quote', href: loc('/contact') }],
];

const faqs = R(7).map((i) => ({
  q: gm(`faq.items.${i}.q`),
  a: gm(`faq.items.${i}.a`),
  links: faqLinkRefs[i].map((l) => ({ label: t(locale, `auxPages.iplForBrands.${l.labelKey}`), href: l.href })),
}));

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': `${canonicalUrl}#faq`,
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<BaseLayout
  title={pageTitle}
  lang={locale}
  description={pageDescription}
  canonical={canonicalUrl}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
  </Fragment>

  <div class="space-y-36">
    {/* ═══ 1. Hero ═══ */}
    <section class="relative w-screen left-1/2 -translate-x-1/2 bg-white border-b border-neutral-200/70">
      <div class="mx-auto max-w-6xl px-6 py-16 md:py-20">
        <div class="inline-flex items-center gap-2 rounded-full border border-violet-200 bg-violet-50 px-4 py-1.5 text-xs font-bold uppercase tracking-[0.18em] text-violet-700">
          {gm('hero.pill')}
        </div>
        <h1 class="mt-6 max-w-4xl text-4xl font-bold tracking-tight text-ink-900 md:text-5xl lg:text-6xl">
          {gm('hero.title')}
          <span class="mt-4 block text-2xl font-semibold leading-snug text-neutral-500 md:text-3xl">
            {gm('hero.sub')}
          </span>
        </h1>
        <p class="mt-6 max-w-3xl text-lg leading-relaxed text-neutral-700 md:text-xl md:leading-relaxed">
          {gm('hero.lede')}
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a class="rounded-2xl bg-ink-900 px-6 py-3 text-sm font-semibold text-white transition hover:bg-neutral-800" href={loc('/contact')}>
            {gm('hero.ctaPrimary')}
          </a>
          <a class="rounded-2xl border border-neutral-300 bg-white px-6 py-3 text-sm font-semibold text-ink-900 transition hover:border-neutral-400 hover:bg-neutral-50" href="#scenarios">
            {gm('hero.ctaSecondary')}
          </a>
        </div>
        <ul class="mt-10 grid grid-cols-2 gap-3 md:grid-cols-4">
          {heroTrust.map(([head, sub]) => (
            <li class="rounded-2xl border border-neutral-200 bg-neutral-50 px-4 py-3.5">
              <div class="text-sm font-bold text-ink-900 md:text-base">{head}</div>
              <div class="mt-0.5 text-xs text-neutral-600">{sub}</div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    {/* ═══ 2. The Channel Problem ═══ */}
    <section class="mx-auto max-w-6xl px-6">
      <div class="mx-auto max-w-4xl">
        <div class="text-sm font-semibold uppercase tracking-[0.22em] text-violet-700">{gm('problem.eyebrow')}</div>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-ink-900 md:text-4xl">{gm('problem.title')}</h2>
        <p class="mt-6 text-lg leading-relaxed text-neutral-700 md:text-xl md:leading-relaxed">
          {gm('problem.lede')}
        </p>
        <p class="mt-5 text-base leading-relaxed text-neutral-700 md:text-lg md:leading-relaxed">
          {gm('problem.para2Lead')}<em>{gm('problem.para2Em')}</em>{gm('problem.para2Tail')}
        </p>
        <div class="mt-8 rounded-[1.75rem] border border-ink-900/10 bg-ink-900 p-7 md:p-8">
          <p class="text-lg font-medium leading-relaxed text-white md:text-xl md:leading-relaxed">
            {gm('problem.quote')}
          </p>
        </div>
        <p class="mt-6 text-base leading-relaxed text-neutral-700 md:text-lg md:leading-relaxed">
          {gm('problem.outroP1')}<a class="font-semibold text-violet-700 underline decoration-violet-200 underline-offset-4 transition hover:decoration-violet-600" href={loc('/catalogue')}>{gm('problem.outroCatLabel')}</a>{gm('problem.outroP2')}<a class="font-semibold text-violet-700 underline decoration-violet-200 underline-offset-4 transition hover:decoration-violet-600" href={loc('/contact')}>{gm('problem.outroTeamLabel')}</a>{gm('problem.outroP3')}
        </p>
      </div>
    </section>

    {/* ═══ 3. Five Buyer Scenarios ═══ */}
    <section id="scenarios" class="mx-auto max-w-6xl space-y-12 px-6 scroll-mt-28">
      <div class="mx-auto max-w-4xl">
        <div class="text-sm font-semibold uppercase tracking-[0.22em] text-violet-700">{gm('scenarios.eyebrow')}</div>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-ink-900 md:text-4xl">{gm('scenarios.title')}</h2>
      </div>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {scenarios.map((card) => (
          <article class="flex flex-col rounded-[1.75rem] border border-neutral-200 bg-white p-7 shadow-sm">
            <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-violet-100 text-sm font-bold text-violet-700">{card.num}</div>
            <div class="mt-4 text-xs font-bold uppercase tracking-[0.16em] text-slate-500">{card.channel}</div>
            <h3 class="mt-2 text-xl font-semibold text-ink-900">{card.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-neutral-700">{card.body}</p>
            <div class="mt-auto pt-5">
              <div class="inline-flex rounded-full bg-neutral-100 px-3 py-1.5 text-xs font-semibold text-neutral-700">{card.tag}</div>
              <div class="mt-3">
                <a class="text-sm font-semibold text-violet-700 transition hover:text-violet-900" href={card.href}>
                  {card.hrefLabel} →
                </a>
              </div>
            </div>
          </article>
        ))}
        <article class="flex flex-col justify-center rounded-[1.75rem] border border-violet-200 bg-violet-50/70 p-7">
          <h3 class="text-xl font-semibold text-ink-900 md:text-2xl">{gm('scenarios.helpTitle')}</h3>
          <p class="mt-3 text-sm leading-relaxed text-neutral-700">
            {gm('scenarios.helpBody')}
          </p>
          <div class="mt-6">
            <a class="inline-flex rounded-2xl bg-ink-900 px-5 py-3 text-sm font-semibold text-white transition hover:bg-neutral-800" href={loc('/contact')}>
              {gm('scenarios.helpCta')}
            </a>
          </div>
        </article>
      </div>
    </section>

    {/* ═══ 4. Selection Reference Table ═══ */}
    <section class="mx-auto max-w-6xl px-6">
      <div class="mx-auto max-w-4xl">
        <div class="text-sm font-semibold uppercase tracking-[0.22em] text-violet-700">{gm('selection.eyebrow')}</div>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-ink-900 md:text-4xl">{gm('selection.title')}</h2>
      </div>
      <div class="mt-8 overflow-x-auto rounded-2xl border border-neutral-200 bg-white shadow-sm">
        <table class="w-full min-w-[720px] border-collapse text-sm">
          <thead>
            <tr class="bg-neutral-50">
              <th class="px-5 py-3.5 text-left text-xs font-bold uppercase tracking-[0.08em] text-neutral-500">{gm('selection.thScenario')}</th>
              <th class="px-5 py-3.5 text-left text-xs font-bold uppercase tracking-[0.08em] text-neutral-500">{gm('selection.thValue')}</th>
              <th class="px-5 py-3.5 text-left text-xs font-bold uppercase tracking-[0.08em] text-neutral-500">{gm('selection.thStart')}</th>
              <th class="px-5 py-3.5 text-left text-xs font-bold uppercase tracking-[0.08em] text-neutral-500">{gm('selection.thCaveat')}</th>
            </tr>
          </thead>
          <tbody>
            {selectionRows.map((row) => (
              <tr class="border-t border-neutral-100 align-top">
                <td class="px-5 py-4 font-semibold text-ink-900">{row.scenario}</td>
                <td class="px-5 py-4 text-neutral-700">{row.value}</td>
                <td class="px-5 py-4 text-neutral-700">{row.start}</td>
                <td class="px-5 py-4 text-neutral-700">{row.caveat}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    {/* ═══ 5. Why IPL Wins + The Honest Limits ═══ */}
    <section class="mx-auto max-w-6xl px-6">
      <div class="grid items-start gap-6 lg:grid-cols-2">
        <div class="rounded-[1.75rem] border border-neutral-200 bg-white p-7 shadow-sm md:p-8">
          <div class="text-sm font-semibold uppercase tracking-[0.22em] text-violet-700">{gm('why.eyebrow')}</div>
          <h3 class="mt-3 text-2xl font-semibold text-ink-900">{gm('why.title')}</h3>
          <p class="mt-4 text-base leading-relaxed text-neutral-700">
            {gm('why.body')}
          </p>
        </div>
        <div class="rounded-[1.75rem] border border-amber-200/70 bg-amber-50/60 p-7 shadow-sm md:p-8">
          <div class="text-sm font-semibold uppercase tracking-[0.22em] text-amber-700">{gm('limits.eyebrow')}</div>
          <h3 class="mt-3 text-2xl font-semibold text-ink-900">{gm('limits.title')}</h3>
          <p class="mt-3 text-sm leading-relaxed text-neutral-700">{gm('limits.intro')}</p>
          <ul class="mt-5 space-y-3 text-sm leading-relaxed text-neutral-700">
            {honestLimits.map(([who, note]) => (
              <li class="border-t border-amber-200/50 pt-3">
                <span class="font-semibold text-ink-900">{who}</span> — {note}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    {/* ═══ 6. Advanced Branding Solutions — Choose, Brand, or Build ═══ */}
    <section class="mx-auto max-w-6xl space-y-12 px-6">
      <div class="mx-auto max-w-4xl">
        <div class="text-sm font-semibold uppercase tracking-[0.22em] text-violet-700">{gm('branding.eyebrow')}</div>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-ink-900 md:text-4xl">{gm('branding.title')}</h2>
        <p class="mt-5 text-lg leading-relaxed text-neutral-700 md:text-xl md:leading-relaxed">
          {gm('branding.lede')}
        </p>
      </div>
      <div class="grid gap-6 md:grid-cols-3">
        {brandPaths.map((card) => (
          <article class="flex flex-col rounded-[1.75rem] border border-neutral-200 bg-white p-7 shadow-sm">
            <h3 class="text-xl font-semibold text-ink-900 md:text-2xl">{card.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-neutral-700">{card.body}</p>
            <div class="mt-auto pt-6">
              <a class="inline-flex items-center gap-2 rounded-2xl bg-ink-900 px-5 py-3 text-sm font-semibold text-white transition hover:bg-neutral-800" href={card.href}>
                {card.cta}
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>

    {/* ═══ 6b. Brand-Build Showcase ═══ */}
    <section class="mx-auto max-w-6xl space-y-12 px-6">
      <div class="mx-auto max-w-3xl text-center">
        <div class="text-sm font-semibold uppercase tracking-[0.22em] text-violet-700">{gm('showcase.eyebrow')}</div>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-ink-900 md:text-4xl">{gm('showcase.title')}</h2>
        <p class="mt-5 text-lg leading-relaxed text-neutral-700 md:text-xl md:leading-relaxed">
          {gm('showcase.lede')}
        </p>
      </div>
      <div class="mx-auto grid max-w-5xl gap-6 md:grid-cols-2">
        {brandShowcase.map((item) => (
          <figure class="group flex flex-col overflow-hidden rounded-[1.75rem] border border-neutral-200 bg-white shadow-sm">
            <div class="relative aspect-square overflow-hidden bg-neutral-100">
              <img class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]" src={item.src} alt={item.alt} loading="lazy" decoding="async" />
            </div>
            <figcaption class="flex flex-1 flex-col p-7">
              <h3 class="text-xl font-semibold text-ink-900 md:text-2xl">{item.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-neutral-700">{item.body}</p>
            </figcaption>
          </figure>
        ))}
      </div>
    </section>

    {/* ═══ 7. De-risking: Sample-to-Production ═══ */}
    <section class="mx-auto max-w-6xl space-y-10 px-6">
      <div class="mx-auto max-w-4xl">
        <div class="text-sm font-semibold uppercase tracking-[0.22em] text-violet-700">{gm('derisk.eyebrow')}</div>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-ink-900 md:text-4xl">{gm('derisk.title')}</h2>
        <p class="mt-6 text-base leading-relaxed text-neutral-700 md:text-lg md:leading-relaxed">
          {gm('derisk.bodyLead')}<strong class="text-ink-900">{gm('derisk.bodyStrong1')}</strong>{gm('derisk.bodyMid')}<strong class="text-ink-900">{gm('derisk.bodyStrong2')}</strong>{gm('derisk.bodyTail')}
        </p>
      </div>
      <div class="mx-auto max-w-4xl space-y-0 rounded-[1.75rem] border border-neutral-200 bg-white p-7 shadow-sm md:p-10">
        {deRiskSteps.map((step) => (
          <div class="flex gap-5 border-t border-neutral-100 py-6 first:border-t-0 md:gap-7">
            <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-ink-900 text-sm font-bold text-white">{step.idx}</div>
            <div>
              <h3 class="text-lg font-semibold text-ink-900 md:text-xl">{step.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-neutral-700 md:text-base">{step.body}</p>
            </div>
          </div>
        ))}
      </div>
      <div class="mx-auto max-w-4xl rounded-2xl border border-amber-300/60 border-l-4 border-l-amber-500 bg-amber-50 p-6 md:p-7">
        <h3 class="text-base font-bold text-amber-900">{gm('derisk.advisoryTitle')}</h3>
        <p class="mt-2 text-sm leading-relaxed text-neutral-700">
          {gm('derisk.advisoryBody')}
        </p>
      </div>
      <div class="mx-auto max-w-4xl">
        <a class="inline-flex items-center gap-2 rounded-2xl bg-ink-900 px-6 py-3 text-sm font-semibold text-white transition hover:bg-neutral-800" href={loc('/contact')}>
          {gm('derisk.cta')}
        </a>
      </div>
    </section>

    {/* ═══ 8. Inside the Factory ═══ */}
    <section class="mx-auto max-w-6xl space-y-12 px-6">
      <div class="mx-auto max-w-3xl text-center">
        <div class="text-sm font-semibold uppercase tracking-[0.22em] text-violet-700">{gm('factory.eyebrow')}</div>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-ink-900 md:text-4xl">{gm('factory.title')}</h2>
        <p class="mt-5 text-lg leading-relaxed text-neutral-700 md:text-xl md:leading-relaxed">
          {gm('factory.lede')}
        </p>
      </div>
      <div class="mx-auto grid max-w-5xl gap-6 md:grid-cols-2">
        {factoryResources.map((scene) => (
          <a class="group flex flex-col overflow-hidden rounded-[1.75rem] border border-neutral-200 bg-white shadow-sm transition hover:shadow-md" href={scene.href}>
            <div class="relative aspect-[16/10] overflow-hidden bg-neutral-100">
              <img class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]" src={scene.src} alt={scene.title} loading="lazy" decoding="async" />
            </div>
            <div class="flex flex-1 flex-col p-7">
              <h3 class="text-xl font-semibold text-ink-900 md:text-2xl">{scene.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-neutral-700">{scene.body}</p>
              <div class="mt-auto pt-6 text-sm font-semibold text-ink-900 transition group-hover:text-violet-700">
                {scene.cta} →
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>

    {/* ═══ 9. Compliance & Safety ═══ */}
    <section class="mx-auto max-w-6xl space-y-10 px-6">
      <div class="mx-auto max-w-4xl">
        <div class="text-sm font-semibold uppercase tracking-[0.22em] text-violet-700">{gm('compliance.eyebrow')}</div>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-ink-900 md:text-4xl">{gm('compliance.title')}</h2>
        <p class="mt-5 text-lg leading-relaxed text-neutral-700">
          {gm('compliance.standards')}
        </p>
        <p class="mt-4 text-base leading-relaxed text-neutral-700">
          {gm('compliance.body')}
        </p>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {complianceBadges.map(([title, body]) => (
          <div class="rounded-2xl border border-neutral-200 bg-white p-6 shadow-sm">
            <h3 class="text-sm font-bold text-ink-900">{title}</h3>
            <p class="mt-2 text-xs leading-relaxed text-neutral-700">{body}</p>
          </div>
        ))}
      </div>
      <div class="mx-auto grid max-w-5xl gap-6 lg:grid-cols-2">
        <article class="rounded-[1.75rem] border border-neutral-200 bg-white p-7 shadow-sm">
          <h3 class="text-lg font-semibold text-ink-900 md:text-xl">{gm('compliance.panelVerifyTitle')}</h3>
          <p class="mt-3 text-sm leading-relaxed text-neutral-700">
            {gm('compliance.panelVerifyBody')}
          </p>
        </article>
        <article class="rounded-[1.75rem] border border-neutral-200 bg-white p-7 shadow-sm">
          <h3 class="text-lg font-semibold text-ink-900 md:text-xl">{gm('compliance.panelDocsTitle')}</h3>
          <ul class="mt-3 grid gap-2 text-sm text-neutral-700 sm:grid-cols-2">
            {complianceDocs.map((doc) => (
              <li class="flex items-start gap-2">
                <span class="mt-1.5 h-2 w-2 shrink-0 rounded-2xl bg-violet-500" />
                <span>{doc}</span>
              </li>
            ))}
          </ul>
        </article>
      </div>
      <div class="mx-auto max-w-5xl rounded-2xl border border-violet-200 border-l-4 border-l-violet-600 bg-violet-50 p-6 md:p-7">
        <h3 class="text-base font-bold text-violet-900">{gm('compliance.pointTitle')}</h3>
        <p class="mt-2 text-sm leading-relaxed text-neutral-700">
          {gm('compliance.pointBodyPre')}<a class="font-semibold text-violet-700 underline decoration-violet-200 underline-offset-4 transition hover:decoration-violet-600" href={loc('/ipl-hair-removal-is-safe')}>{gm('compliance.pointLinkLabel')}</a>{gm('compliance.pointBodyPost')}
        </p>
      </div>
    </section>

    {/* ═══ 10. Custom Spec — 5-Variable Envelope ═══ */}
    <section class="mx-auto max-w-6xl space-y-10 px-6">
      <div class="mx-auto max-w-4xl">
        <div class="text-sm font-semibold uppercase tracking-[0.22em] text-violet-700">{gm('spec.eyebrow')}</div>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-ink-900 md:text-4xl">{gm('spec.title')}</h2>
        <p class="mt-5 text-lg leading-relaxed text-neutral-700">
          {gm('spec.lede')}
        </p>
      </div>
      <div class="mx-auto grid max-w-5xl gap-6 md:grid-cols-2 lg:grid-cols-3">
        {specVariables.map(([name, body]) => (
          <article class="rounded-[1.75rem] border border-neutral-200 bg-white p-7 shadow-sm">
            <h3 class="text-sm font-bold uppercase tracking-[0.14em] text-violet-700">{name}</h3>
            <p class="mt-3 text-sm leading-relaxed text-neutral-700">{body}</p>
          </article>
        ))}
      </div>
      <div class="mx-auto max-w-4xl rounded-2xl border border-violet-200 border-l-4 border-l-violet-600 bg-violet-50 p-6 md:p-7">
        <h3 class="text-base font-bold text-violet-900">{gm('spec.advisoryTitle')}</h3>
        <p class="mt-2 text-sm leading-relaxed text-neutral-700">
          {gm('spec.advisoryBody')}
        </p>
      </div>
      <div class="mx-auto max-w-4xl space-y-4">
        <p class="text-base leading-relaxed text-neutral-700">
          {gm('spec.body')}
        </p>
        <p class="text-sm text-neutral-500">{gm('spec.byline')}</p>
        <a class="inline-flex items-center gap-2 rounded-2xl bg-ink-900 px-6 py-3 text-sm font-semibold text-white transition hover:bg-neutral-800" href={loc('/contact')}>
          {gm('spec.cta')}
        </a>
      </div>
    </section>

    {/* ═══ 11. IPL vs Alternatives ═══ */}
    <section class="mx-auto max-w-6xl space-y-10 px-6">
      <div class="mx-auto max-w-4xl">
        <div class="text-sm font-semibold uppercase tracking-[0.22em] text-violet-700">{gm('compare.eyebrow')}</div>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-ink-900 md:text-4xl">{gm('compare.title')}</h2>
        <p class="mt-5 text-base leading-relaxed text-neutral-700 md:text-lg md:leading-relaxed">
          {gm('compare.lede')}
        </p>
      </div>
      <div class="overflow-x-auto rounded-2xl border border-neutral-200 bg-white shadow-sm">
        <table class="w-full min-w-[720px] border-collapse text-sm">
          <thead>
            <tr class="bg-neutral-50">
              <th class="px-5 py-3.5 text-left text-xs font-bold uppercase tracking-[0.08em] text-neutral-500">{gm('compare.thProperty')}</th>
              <th class="px-5 py-3.5 text-left text-xs font-bold uppercase tracking-[0.08em] text-neutral-500">{gm('compare.thIpl')}</th>
              <th class="px-5 py-3.5 text-left text-xs font-bold uppercase tracking-[0.08em] text-neutral-500">{gm('compare.thLaser')}</th>
              <th class="px-5 py-3.5 text-left text-xs font-bold uppercase tracking-[0.08em] text-neutral-500">{gm('compare.thShave')}</th>
            </tr>
          </thead>
          <tbody>
            {comparisonRows.map((row) => (
              <tr class="border-t border-neutral-100 align-top">
                <td class="px-5 py-4 font-semibold text-ink-900">{row[0]}</td>
                <td class="px-5 py-4 text-neutral-700">{row[1]}</td>
                <td class="px-5 py-4 text-neutral-700">{row[2]}</td>
                <td class="px-5 py-4 text-neutral-700">{row[3]}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class="mx-auto grid max-w-5xl gap-6 md:grid-cols-2">
        <article class="rounded-[1.75rem] border border-neutral-200 bg-white p-7 shadow-sm">
          <h3 class="text-base font-bold uppercase tracking-[0.14em] text-violet-700">{gm('compare.regulTitle')}</h3>
          <p class="mt-3 text-sm leading-relaxed text-neutral-700">
            {gm('compare.regulBody')}
          </p>
          <blockquote class="mt-5 border-l-4 border-violet-300 pl-4 text-base italic leading-relaxed text-ink-900">
            {gm('compare.quote')}
            <cite class="mt-2 block text-sm not-italic text-neutral-500">{gm('compare.quoteCite')}</cite>
          </blockquote>
        </article>
        <article class="rounded-[1.75rem] border border-neutral-200 bg-white p-7 shadow-sm">
          <h3 class="text-base font-bold uppercase tracking-[0.14em] text-violet-700">{gm('compare.lifeTitle')}</h3>
          <p class="mt-3 text-sm leading-relaxed text-neutral-700">
            {gm('compare.lifeBody')}
          </p>
        </article>
      </div>
      <div class="mx-auto max-w-4xl rounded-2xl border border-amber-300/60 border-l-4 border-l-amber-500 bg-amber-50 p-6 md:p-7">
        <h3 class="text-base font-bold text-amber-900">{gm('compare.limitTitle')}</h3>
        <p class="mt-2 text-sm leading-relaxed text-neutral-700">
          {gm('compare.limitBody')}
        </p>
      </div>
      <div class="mx-auto max-w-4xl">
        <a class="inline-flex items-center gap-2 rounded-2xl border border-neutral-300 bg-white px-6 py-3 text-sm font-semibold text-ink-900 transition hover:border-neutral-400 hover:bg-neutral-50" href={loc('/blog/30-ipl-vs-laser-which-is-safer')}>
          {gm('compare.cta')}
        </a>
      </div>
    </section>

    {/* ═══ 12. Technical Selectors & Blueprints ═══ */}
    <section class="mx-auto max-w-6xl space-y-12 px-6">
      <div class="mx-auto max-w-3xl text-center">
        <div class="text-sm font-semibold uppercase tracking-[0.22em] text-violet-700">{gm('tools.eyebrow')}</div>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-ink-900 md:text-4xl">{gm('tools.title')}</h2>
      </div>
      <div class="mx-auto grid max-w-6xl gap-6 md:grid-cols-2 lg:grid-cols-3">
        {techTools.map((tool) => (
          <article class="flex flex-col rounded-[1.75rem] border border-neutral-200 bg-white p-7 shadow-sm">
            <div class="text-xs font-bold uppercase tracking-[0.2em] text-neutral-400">{tool.label}</div>
            <h3 class="mt-3 text-2xl font-semibold text-ink-900">{tool.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-neutral-700">{tool.body}</p>
            <div class="mt-auto pt-6">
              <a class="inline-flex items-center gap-2 rounded-2xl bg-ink-900 px-5 py-3 text-sm font-semibold text-white transition hover:bg-neutral-800" href={tool.href}>
                {tool.cta}
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>

    {/* ═══ 13. FAQ ═══ */}
    <section class="mx-auto max-w-6xl px-6">
      <div class="mx-auto max-w-4xl">
        <div class="mx-auto max-w-3xl text-center">
          <div class="text-sm font-semibold uppercase tracking-[0.22em] text-violet-700">{gm('faq.eyebrow')}</div>
          <h2 class="mt-3 text-3xl font-bold tracking-tight text-ink-900 md:text-4xl">{gm('faq.title')}</h2>
        </div>
        <div class="mt-10 grid max-w-4xl gap-4">
          {faqs.map((item) => (
            <details class="group rounded-[1.5rem] border border-neutral-200 bg-white p-6 shadow-sm">
              <summary class="cursor-pointer list-none text-lg font-semibold text-ink-900">
                <div class="flex items-start justify-between gap-4">
                  <span>{item.q}</span>
                  <span class="mt-1 text-slate-500 transition group-open:rotate-45">+</span>
                </div>
              </summary>
              <div class="mt-4 space-y-4 text-sm leading-relaxed text-neutral-700">
                <p>{item.a}</p>
                <div class="flex flex-wrap gap-3">
                  {item.links.map((link) => (
                    <a class="inline-flex items-center rounded-2xl border border-neutral-200 bg-white px-4 py-2 text-sm font-semibold text-ink-900 transition hover:border-neutral-300 hover:bg-neutral-50" href={link.href}>
                      {link.label}
                    </a>
                  ))}
                </div>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    {/* ═══ 14. Final CTA ═══ */}
    <section class="relative w-screen left-1/2 -translate-x-1/2 bg-ink-900">
      <div class="mx-auto max-w-6xl px-6 py-16 text-center md:py-20">
        <div class="text-sm font-semibold uppercase tracking-[0.22em] text-violet-300">{gm('ctaFinal.eyebrow')}</div>
        <h2 class="mx-auto mt-4 max-w-3xl text-3xl font-bold tracking-tight text-white md:text-4xl">
          {gm('ctaFinal.title')}
        </h2>
        <p class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-neutral-300">
          {gm('ctaFinal.body')}
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <a class="rounded-2xl bg-white px-6 py-3 text-sm font-semibold text-ink-900 transition hover:bg-neutral-200" href={loc('/contact')}>
            {gm('ctaFinal.ctaPrimary')}
          </a>
          <a class="rounded-2xl border border-white/30 bg-white/10 px-6 py-3 text-sm font-semibold text-white transition hover:bg-white/20" href={loc('/catalogue')}>
            {gm('ctaFinal.ctaSecondary')}
          </a>
        </div>
        <p class="mt-8 text-xs tracking-wide text-neutral-400">
          {gm('ctaFinal.foot')}
        </p>
      </div>
    </section>
  </div>
</BaseLayout>

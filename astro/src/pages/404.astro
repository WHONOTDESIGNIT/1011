---
import BaseLayout from '../layouts/BaseLayout.astro';

const locale = Astro.currentLocale ?? 'en';
const homeHref = locale === 'en' ? '/' : `/${locale}/`;
---
<BaseLayout title="404 · Page Not Found" lang={locale} description="Page not found" showCornerMarkers={false}>
  <meta slot="head" name="robots" content="noindex, nofollow" />
  <main class="not-found">
    <p class="not-found-code">404</p>
    <h1>Page Not Found</h1>
    <p>The page you are looking for doesn&rsquo;t exist or has been moved.</p>
    <a class="not-found-btn" href={homeHref}>Back to Home</a>
  </main>
</BaseLayout>

<style>
  .not-found {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 60vh;
    text-align: center;
    gap: 0.75rem;
  }
  .not-found-code {
    font-family: 'Syne', sans-serif;
    font-size: 6rem;
    font-weight: 700;
    color: #0ea5e9;
    margin: 0;
    line-height: 1;
  }
  .not-found h1 {
    font-size: 1.5rem;
    margin: 0;
  }
  .not-found p {
    color: #64748b;
    margin: 0;
  }
  .not-found-btn {
    display: inline-block;
    margin-top: 0.75rem;
    padding: 0.6rem 1.4rem;
    border-radius: 9999px;
    background: #0ea5e9;
    color: #fff;
    text-decoration: none;
    font-weight: 600;
  }
  .not-found-btn:hover {
    background: #0284c7;
  }
</style>

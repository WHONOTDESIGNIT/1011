---
// Develo Design — Work（复刻 https://www.develodesign.co.uk/work）
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { t } from '../lib/i18n';
import { getLocalizedPath } from '../lib/breadcrumbs';

const locale = Astro.currentLocale ?? 'en';

const workItems = [
  { name: 'Daylesford Organic', year: '2025', description: t(locale, 'develoSocial.workPage.workItems.daylesford.description'), img: 'https://www.develodesign.co.uk/cf-builder-proxy/api/v1/image/assets%2F199e88006d9347f1a6444c6834fba481%2Faa68bef8c8a84256a8700998b962d80b?format=webp&width=800', href: 'https://www.develodesign.co.uk/work/daylesford' },
  { name: 'BrandAlley', year: '2024', description: t(locale, 'develoSocial.workPage.workItems.brandalley.description'), img: 'https://www.develodesign.co.uk/cf-builder-proxy/api/v1/image/assets%2F199e88006d9347f1a6444c6834fba481%2Fed691d05fe8e444eaf02bcffb619e0c2?format=webp&width=800', href: 'https://www.develodesign.co.uk/work/brandalley' },
  { name: 'Teague Chokes', year: '2023', description: t(locale, 'develoSocial.workPage.workItems.teague.description'), img: 'https://www.develodesign.co.uk/cf-builder-proxy/api/v1/image/assets%2F199e88006d9347f1a6444c6834fba481%2F38e55448e40647979e5687a4aed3b341?format=webp&width=800', href: 'https://www.develodesign.co.uk/work/teague' },
  { name: 'DTE', year: '2022', description: t(locale, 'develoSocial.workPage.workItems.dte.description'), img: 'https://www.develodesign.co.uk/cf-builder-proxy/api/v1/image/assets%2F199e88006d9347f1a6444c6834fba481%2F659315f9fd444a7980621476b3bbcdb5?format=webp&width=800', href: 'https://www.develodesign.co.uk/work/dte' },
  { name: 'Bamford', year: '2025', description: t(locale, 'develoSocial.workPage.workItems.bamford.description'), img: 'https://www.develodesign.co.uk/cf-builder-proxy/api/v1/image/assets%2F199e88006d9347f1a6444c6834fba481%2Fb3c4bf6fe66848ee9731b26829e24590?format=webp&width=800', href: 'https://www.develodesign.co.uk/work/bamford' },
  { name: 'Currys', year: '2024', description: t(locale, 'develoSocial.workPage.workItems.currys.description'), img: 'https://www.develodesign.co.uk/cf-builder-proxy/api/v1/image/assets%2F199e88006d9347f1a6444c6834fba481%2F64292034934e476494349e6d55eebf6b?format=webp&width=800', href: 'https://www.develodesign.co.uk/work/currys' },
  { name: 'HowSafe', year: '2024', description: t(locale, 'develoSocial.workPage.workItems.howsafe.description'), img: 'https://www.develodesign.co.uk/cf-builder-proxy/api/v1/image/assets%2F199e88006d9347f1a6444c6834fba481%2F1e38d41526e04901bccd00f38014e709?format=webp&width=800', href: 'https://www.develodesign.co.uk/work/howsafe' },
  { name: 'Leon Paul', year: '2023', description: t(locale, 'develoSocial.workPage.workItems.leonpaul.description'), img: 'https://www.develodesign.co.uk/cf-builder-proxy/api/v1/image/assets%2F199e88006d9347f1a6444c6834fba481%2F323c4962bee64617a4ca6b0c2265a3f3?format=webp&width=800', href: 'https://www.develodesign.co.uk/work/leonpaul' }
];
const leftColumn = workItems.slice(0, 4);
const rightColumn = workItems.slice(4);
---
<!doctype html>
<html lang={locale}>
<head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<script is:inline>
  // 语言偏好持久化：读取用户选定的语言（localStorage），
  // 若当前 URL 语言与偏好不一致，立即重定向到偏好语言对应页面（支持 en/tr/ar）
  (function () {
    var KEY = 'ishine_lang';
    try {
      var stored = localStorage.getItem(KEY);
      if (!stored) return;
      var LANGS = ['tr', 'ro', 'ar', 'es', 'fr', 'ru', 'he', 'pt-BR', 'nl', 'pl', 'ja', 'ko'];
      var path = window.location.pathname;
      var cur = 'en';
      for (var i = 0; i < LANGS.length; i++) {
        if (path === '/' + LANGS[i] || path.indexOf('/' + LANGS[i] + '/') === 0) {
          cur = LANGS[i];
          break;
        }
      }
      if (stored === cur) return;
      var stripped = path;
      for (var j = 0; j < LANGS.length; j++) {
        stripped = stripped.replace(new RegExp('^/' + LANGS[j] + '/?'), '');
      }
      if (stored === 'en') {
        stripped = stripped.replace(/\/+$/, '');
        if (stripped === '' || stripped === '/') stripped = '/';
        if (stripped !== path) window.location.replace(stripped);
      } else {
        var target = '/' + stored + (stripped === '' || stripped === '/' ? '' : stripped);
        target = target.replace(/\/+$/, '');
        if (target === '') target = '/' + stored;
        if (target !== path) window.location.replace(target);
      }
    } catch (e) { /* 隐私模式等场景忽略 */ }
  })();
</script>
<title>{t(locale, 'develoSocial.workPage.pageTitle')}</title>
<meta name="description" content={t(locale, 'develoSocial.workPage.pageDescription')} />
<link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=Syne:wght@400;700&display=swap" rel="stylesheet" />
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{--blue:#563cfa;--black:#020303;--white:#fff;--grey-500:#6b7280;--max-w:1536px;--pad-100:100px}
html{scroll-behavior:smooth;overflow-x:hidden}
body{font-family:Manrope,-apple-system,Roboto,Helvetica,sans-serif;font-size:16px;font-weight:400;color:#000;background:#fff;overflow-x:hidden;-webkit-font-smoothing:antialiased}
a{text-decoration:none;color:inherit}img{max-width:100%;height:auto;display:block}

.page-main{margin-top:148px;position:relative;z-index:1}
.our-work-content{max-width:var(--max-w);margin:0 auto;padding:40px var(--pad-100) 0}

/* ═══ HERO ═══ */
.small-title{display:flex;align-items:center;gap:12px;padding:3px 12px;font-family:Manrope,sans-serif;font-size:16px;font-weight:400;color:#020303;line-height:normal}
.asterisk-icon{flex-shrink:0}
.heading{font-family:Syne,sans-serif;font-size:38px;font-weight:400;line-height:44px;letter-spacing:-.37px;color:#020303;margin:0}
.sub-heading{font-family:Manrope,sans-serif;font-size:18px;font-weight:400;line-height:26px;color:#020303;margin:0}
.button-group{display:flex;padding:18px 0 0}
.primary-button{display:inline-flex;align-items:center;gap:6px;padding:12px 20px;background:var(--blue);color:#fff;font-family:Manrope,sans-serif;font-size:16px;font-weight:400;line-height:16px;border-radius:100px;border:none;cursor:pointer;white-space:nowrap;transition:all .2s}
.primary-button:hover{gap:16px}
.primary-button svg{width:16px;height:16px;display:block;flex-shrink:0}
.desktop-header{display:flex;flex-direction:column;gap:8px;padding:80px 0}
.mobile-tablet-header{display:none}

/* ═══ PORTFOLIO GRID ═══ */
.portfolio-grid{display:flex;gap:40px}
.portfolio-column{flex:1 1 0%;display:flex;flex-direction:column;gap:80px;min-width:0}
.portfolio-card{display:flex;flex-direction:column;text-decoration:none;color:inherit}
.card-image{display:block;overflow:hidden;border-radius:12px;aspect-ratio:1/1}
.card-image img{width:100%;height:100%;object-fit:cover;display:block;transition:opacity .2s}
.portfolio-card:hover .card-image img{opacity:.92}
.card-title{display:flex;flex-direction:column;align-items:flex-start;gap:4px;padding:16px 12px 4px}
.year-title-row{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.year-wrapper{display:flex;align-items:center;gap:8px}
.year{font-family:Manrope,sans-serif;font-size:14px;font-weight:400;line-height:21px;color:#020303}
.title{font-family:Syne,sans-serif;font-size:21px;font-weight:400;line-height:27px;color:#020303;margin:0}
.description{font-family:Manrope,sans-serif;font-size:14px;font-weight:400;line-height:21px;color:#374151;padding:0 12px}

/* ═══ 底部 CTA（黑底，参考原站 footer） ═══ */
.footer-cta-section{background:var(--black);padding:120px 0 0}
.footer-container{max-width:var(--max-w);margin:0 auto;padding:0 var(--pad-100)}
.footer-cta{display:flex;flex-direction:column;align-items:flex-start;gap:8px}
.footer-heading{font-family:Syne,sans-serif;font-size:38px;font-weight:400;line-height:44px;color:#fff;margin:0}
.footer-description{font-family:Manrope,sans-serif;font-size:16px;font-weight:400;line-height:25px;color:#fff;margin:0}
.footer-button{display:inline-flex;align-items:center;gap:6px;margin-top:24px;padding:12px 20px;background:var(--blue);color:#fff;font-family:Manrope,sans-serif;font-size:16px;font-weight:400;line-height:16px;border-radius:100px;border:none;cursor:pointer;white-space:nowrap;transition:all .2s}
.footer-button:hover{gap:16px}
.footer-button svg{width:16px;height:16px;display:block;flex-shrink:0}

/* ═══ 平板（≤1023px）：单列网格，hero 移至顶部 ═══ */
@media(max-width:1023px){
  .our-work-content{padding:40px 40px 0}
  .portfolio-grid{flex-direction:column;gap:60px}
  .portfolio-column{display:contents}
  .desktop-header{display:none}
  .mobile-tablet-header{display:flex;flex-direction:column;gap:8px;padding:0 0 40px}
}
/* ═══ 移动（≤767px） ═══ */
@media(max-width:767px){
  .page-main{margin-top:134px}
  .our-work-content{padding:0 24px}
  .mobile-tablet-header .heading{font-size:32px;line-height:38px;letter-spacing:-.33px}
  .mobile-tablet-header .sub-heading{font-size:16px;line-height:24px}
  .footer-container{padding:0 24px}
  .footer-heading{font-size:26px;line-height:34px}
}
</style>
</head>
<body>

<SiteHeader />

<main class="page-main">

  <div class="our-work-content">

    <!-- ═══ HERO（平板 / 移动端显示） ═══ -->
    <div class="our-work-header mobile-tablet-header">
      <div class="small-title">
        <svg class="asterisk-icon" width="16" height="16" viewBox="0 0 24 24" fill="none"><path fill-rule="evenodd" clip-rule="evenodd" d="M14.4 0H9.6V6.20588L5.21178 1.81766L1.81766 5.21177L6.2059 9.6H0V14.4H6.20588L1.81766 18.7882L5.21178 22.1824L9.6 17.7941V24H14.4V17.7941L18.7883 22.1824L22.1824 18.7883L17.7941 14.4H24V9.6H17.7941L22.1824 5.21177L18.7883 1.81765L14.4 6.20588V0Z" fill="#0F1518"/></svg>
        {t(locale, 'develoSocial.workPage.hero.smallTitle')}
      </div>
      <h1 class="heading">{t(locale, 'develoSocial.workPage.hero.heading')}</h1>
      <p class="sub-heading">{t(locale, 'develoSocial.workPage.hero.description')}</p>
      <div class="button-group"><a class="primary-button" href={getLocalizedPath(locale, '/services')}>{t(locale, 'develoSocial.workPage.hero.allServicesCta')} <svg viewBox="0 0 16 16" fill="none"><path d="M4 12L12 4" stroke="white" stroke-linecap="round" stroke-linejoin="round"/><path d="M5.5 4H12V10.5" stroke="white" stroke-linecap="round" stroke-linejoin="round"/></svg></a></div>
    </div>

    <!-- ═══ 案例网格 ═══ -->
    <div class="portfolio-grid">
      <div class="portfolio-column left-column">
        {leftColumn.map((item) => (
          <a class="portfolio-card" href={item.href} target="_blank" rel="noopener">
            <span class="card-image"><img src={item.img} alt={item.name} loading="lazy" /></span>
            <span class="card-title">
              <span class="year-title-row">
                <span class="year-wrapper">
                  <svg width="8" height="9" viewBox="0 0 8 9" fill="none"><path fill-rule="evenodd" clip-rule="evenodd" d="M0 4.5C0 2.29086 1.79086 0.5 4 0.5C6.20914 0.5 8 2.29086 8 4.5C8 6.70914 6.20914 8.5 4 8.5C1.79086 8.5 0 6.70914 0 4.5Z" fill="#020303"/></svg>
                  <span class="year">{item.year}</span>
                </span>
                <h3 class="title">{item.name}</h3>
              </span>
            </span>
            <span class="description">{item.description}</span>
          </a>
        ))}
      </div>
      <div class="portfolio-column right-column">
        <!-- ═══ HERO（桌面端显示，位于右列首部） ═══ -->
        <div class="our-work-header desktop-header">
          <div class="small-title">
            <svg class="asterisk-icon" width="16" height="16" viewBox="0 0 24 24" fill="none"><path fill-rule="evenodd" clip-rule="evenodd" d="M14.4 0H9.6V6.20588L5.21178 1.81766L1.81766 5.21177L6.2059 9.6H0V14.4H6.20588L1.81766 18.7882L5.21178 22.1824L9.6 17.7941V24H14.4V17.7941L18.7883 22.1824L22.1824 18.7883L17.7941 14.4H24V9.6H17.7941L22.1824 5.21177L18.7883 1.81765L14.4 6.20588V0Z" fill="#0F1518"/></svg>
            {t(locale, 'develoSocial.workPage.hero.smallTitle')}
          </div>
          <h1 class="heading">{t(locale, 'develoSocial.workPage.hero.heading')}</h1>
          <p class="sub-heading">{t(locale, 'develoSocial.workPage.hero.description')}</p>
          <div class="button-group"><a class="primary-button" href={getLocalizedPath(locale, '/services')}>{t(locale, 'develoSocial.workPage.hero.allServicesCta')} <svg viewBox="0 0 16 16" fill="none"><path d="M4 12L12 4" stroke="white" stroke-linecap="round" stroke-linejoin="round"/><path d="M5.5 4H12V10.5" stroke="white" stroke-linecap="round" stroke-linejoin="round"/></svg></a></div>
        </div>
        {rightColumn.map((item) => (
          <a class="portfolio-card" href={item.href} target="_blank" rel="noopener">
            <span class="card-image"><img src={item.img} alt={item.name} loading="lazy" /></span>
            <span class="card-title">
              <span class="year-title-row">
                <span class="year-wrapper">
                  <svg width="8" height="9" viewBox="0 0 8 9" fill="none"><path fill-rule="evenodd" clip-rule="evenodd" d="M0 4.5C0 2.29086 1.79086 0.5 4 0.5C6.20914 0.5 8 2.29086 8 4.5C8 6.70914 6.20914 8.5 4 8.5C1.79086 8.5 0 6.70914 0 4.5Z" fill="#020303"/></svg>
                  <span class="year">{item.year}</span>
                </span>
                <h3 class="title">{item.name}</h3>
              </span>
            </span>
            <span class="description">{item.description}</span>
          </a>
        ))}
      </div>
    </div>

  </div>

</main>

<!-- ═══ 底部 CTA ═══ -->
<section class="footer-cta-section">
  <div class="footer-container">
    <div class="footer-cta">
      <h2 class="footer-heading">{t(locale, 'develoSocial.workPage.cta.heading')}</h2>
      <p class="footer-description">{t(locale, 'develoSocial.workPage.cta.description')}</p>
      <a class="footer-button" href={getLocalizedPath(locale, '/contact')}>{t(locale, 'develoSocial.workPage.cta.getInTouch')} <svg viewBox="0 0 16 16" fill="none"><path d="M4 12L12 4" stroke="white" stroke-linecap="round" stroke-linejoin="round"/><path d="M5.5 4H12V10.5" stroke="white" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
    </div>
  </div>
</section>

<SiteFooter />

</body>
</html>

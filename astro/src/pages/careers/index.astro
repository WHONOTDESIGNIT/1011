---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t } from '../../lib/i18n';
import { getLocalizedPath, buildBreadcrumbs } from '../../lib/breadcrumbs';

const locale = Astro.currentLocale ?? 'en';

function resolveBaseUrl() {
  return (process.env.URL ?? process.env.DEPLOY_PRIME_URL ?? process.env.SITE_URL ?? 'https://iplmanufacturer.com').replace(/\/$/, '');
}

const pageTitle = t(locale, 'careersPage.meta.title');
const pageDescription = t(locale, 'careersPage.meta.description');

// ── canonical / hreflang 策略（2026-09-10 新建） ──────────────────────────────
// 招聘页首期只提供英文正文：其余 21 个语种经 t() 自动回退到 en（见 lib/i18n.ts），
// 即 /tr/careers、/ja/careers … 渲染的都是同一份英文内容。
// 因此：
//   1) canonical 固定指向英文规范 URL —— 让 Google 把这些重复体归并到 /careers，
//      而不是 22 个语种各自收录同一篇英文（那样会形成跨语种重复内容）；
//   2) hreflang 只声明 en（SeoHead 会自动补 x-default）—— 不做“伪翻译声明”。
// 这与 ipl-for-brands.astro 的既有做法一致（该页注释即写「不做伪翻译声明」）。
// 三处连带效果，均为预期：
//   - generate-sitemap.mjs 的 canonical === 自身 URL 校验 → 只有 /careers 进 sitemap，
//     /<locale>/careers 被正确排除；
//   - 站点链接规范保持「无尾斜杠」，与 astro.config 的 trailingSlash:'never' 一致。
// 【待办】补齐 22 语种文案后，把 canonical 换成
//   `${resolveBaseUrl()}${getLocalizedPath(locale, '/careers')}`
// 并删掉下面的 hreflangs 覆盖（回到 SeoHead 按路径自动生成 22 语种 + x-default）。
const canonical = `${resolveBaseUrl()}/careers`;

const breadcrumbs = buildBreadcrumbs(locale, [
  { label: t(locale, 'common.home'), path: '/' },
  { label: t(locale, 'homepage.mega.about.careers.title') },
]);

// 文案键按序号批量取，便于后续增删条目
const cultureItems = [1, 2, 3, 4].map((n) => ({
  title: t(locale, `careersPage.culture.item${n}.title`),
  description: t(locale, `careersPage.culture.item${n}.description`),
}));
const roleItems = [1, 2, 3, 4, 5, 6, 7, 8].map((n) => t(locale, `careersPage.roles.item${n}`));
const processSteps = [1, 2, 3, 4].map((n) => ({
  title: t(locale, `careersPage.process.step${n}.title`),
  description: t(locale, `careersPage.process.step${n}.description`),
}));

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbs.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.label,
    item: item.href ? `${resolveBaseUrl()}${item.href}` : canonical,
  })),
};

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: pageTitle,
  description: pageDescription,
  url: canonical,
  inLanguage: 'en',
};
---

<BaseLayout
  title={pageTitle}
  lang={locale}
  description={pageDescription}
  canonical={canonical}
  hreflangs={[{ locale: 'en', href: canonical }]}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(webPageSchema)} />
  </Fragment>

  <style is:inline>
    /* ═══ iShine Careers — 与 about/index.astro 同一视觉体系 ═══ */
    .careers-page{background:var(--color-white);color:var(--color-ink);font-family:Manrope,-apple-system,Roboto,Helvetica,sans-serif;-webkit-font-smoothing:antialiased}
    .careers-page a{text-decoration:none;color:inherit}
    .content-area{max-width:var(--max-w-page,1843px);padding-left:0;padding-right:0}
    @media(max-width:1279px){.content-area{max-width:100%}}

    /* Hero */
    .careers-hero{width:100%;max-width:var(--max-w-page,1843px);margin:0 auto 24px;padding:0 100px}
    .careers-hero-inner{display:flex;flex-direction:column;gap:8px}
    .careers-hero-label{display:flex;align-items:center;gap:12px;padding:3px 12px;margin-bottom:16px}
    .careers-hero-label svg{flex-shrink:0}
    .careers-hero-label span{font-family:Manrope,sans-serif;font-size:18px;font-weight:400;color:var(--color-ink);line-height:26px}
    .careers-hero h1{font-family:Syne,sans-serif;font-size:62px;font-weight:400;line-height:68px;letter-spacing:-.61px;color:var(--color-ink);margin:0;max-width:900px}
    .careers-hero-desc{font-family:Manrope,sans-serif;font-size:20px;font-weight:400;line-height:30px;color:var(--color-gray-600);max-width:660px;margin:0}

    /* 通用 section 容器 */
    .careers-section{width:100%;max-width:var(--max-w-page,1843px);margin:0 auto;padding:0 100px 100px}
    .careers-section-header{margin-bottom:40px}
    .careers-section-header h2{font-family:Syne,sans-serif;font-size:32px;font-weight:400;line-height:38px;color:var(--color-ink);margin:0}
    .careers-section-header p{font-family:Manrope,sans-serif;font-size:15px;font-weight:400;line-height:23px;color:var(--color-gray-600);max-width:560px;margin:8px 0 0}

    /* What we build（左文） */
    .careers-about{width:100%;max-width:var(--max-w-page,1843px);margin:0 auto;padding:0 100px 100px}
    .careers-about h2{font-family:Syne,sans-serif;font-size:32px;font-weight:400;line-height:38px;color:var(--color-ink);margin:0}
    .careers-about p{font-family:Manrope,sans-serif;font-size:15px;font-weight:400;line-height:23px;color:var(--color-gray-600);max-width:820px;margin:20px 0 0}

    /* Culture（grey-50 底，四卡） */
    .careers-culture{background:var(--color-gray-50);padding:60px 0 80px;margin-bottom:100px}
    .careers-culture-container{width:100%;max-width:var(--max-w-page,1843px);margin:0 auto;padding:0 100px}
    .careers-grid-4{display:grid;grid-template-columns:repeat(4,1fr);gap:24px}
    .careers-card{background:var(--color-white);border:1px solid var(--color-gray-200);border-radius:16px;padding:24px;transition:transform .2s}
    .careers-card:hover{transform:translateY(-4px)}
    .careers-card h3{font-family:Syne,sans-serif;font-size:18px;font-weight:400;line-height:26px;color:var(--color-ink);margin:0;transition:color .2s}
    .careers-card:hover h3{color:var(--color-primary)}
    .careers-card p{font-family:Manrope,sans-serif;font-size:15px;font-weight:400;line-height:23px;color:var(--color-gray-600);margin:8px 0 0}

    /* Functions we hire for（两列清单） */
    .careers-roles-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16px 32px}
    .careers-role{display:flex;gap:12px;padding:16px 0;border-top:1px solid var(--color-gray-200)}
    .careers-role-num{font-family:Syne,sans-serif;font-size:14px;font-weight:400;line-height:22px;color:var(--color-primary);flex-shrink:0;min-width:22px}
    .careers-role-text{font-family:Manrope,sans-serif;font-size:15px;font-weight:400;line-height:22px;color:var(--color-gray-600);margin:0}

    /* How we hire（四步） */
    .careers-process{background:var(--color-gray-50);padding:60px 0 80px;margin-bottom:100px}
    .careers-process-container{width:100%;max-width:var(--max-w-page,1843px);margin:0 auto;padding:0 100px}
    .careers-steps{display:grid;grid-template-columns:repeat(4,1fr);gap:24px}
    .careers-step{background:var(--color-white);border:1px solid var(--color-gray-200);border-radius:16px;padding:24px}
    .careers-step-num{font-family:Syne,sans-serif;font-size:14px;font-weight:400;color:var(--color-primary);margin-bottom:12px}
    .careers-step h3{font-family:Syne,sans-serif;font-size:18px;font-weight:400;line-height:26px;color:var(--color-ink);margin:0}
    .careers-step p{font-family:Manrope,sans-serif;font-size:15px;font-weight:400;line-height:23px;color:var(--color-gray-600);margin:8px 0 0}

    /* Apply CTA（黑底） */
    .careers-apply{background:var(--color-ink);padding:80px 0}
    .careers-apply-container{width:100%;max-width:var(--max-w-page,1843px);margin:0 auto;padding:0 100px;display:flex;flex-direction:column;align-items:flex-start;gap:12px}
    .careers-apply h2{font-family:Syne,sans-serif;font-size:32px;font-weight:400;line-height:38px;color:#fff;margin:0}
    .careers-apply p{font-family:Manrope,sans-serif;font-size:16px;font-weight:400;line-height:25px;color:rgba(255,255,255,.82);max-width:720px;margin:0}
    .careers-apply-cta{display:inline-flex;align-items:center;gap:6px;margin-top:16px;padding:12px 20px;background:var(--color-primary);color:#fff;font-family:Manrope,sans-serif;font-size:16px;font-weight:400;line-height:16px;border-radius:100px;transition:gap .2s}
    .careers-apply-cta:hover{gap:16px}
    .careers-apply-cta svg{width:16px;height:16px;display:block;flex-shrink:0}
    .careers-apply-cta + .careers-apply-cta{background:transparent;border:1px solid rgba(255,255,255,.3)}

    @media(max-width:1279px){
      .careers-hero{padding:0 40px}
      .careers-section,.careers-about{padding:0 40px 80px}
      .careers-culture-container,.careers-process-container{padding:0 40px}
      .careers-grid-4,.careers-steps{grid-template-columns:repeat(2,1fr)}
      .careers-roles-grid{grid-template-columns:1fr}
      .careers-apply-container{padding:0 40px}
      .careers-culture,.careers-process{margin-bottom:80px}
    }
    @media(max-width:767px){
      .careers-hero{padding:0 24px}
      .careers-hero h1{font-size:38px;line-height:44px;letter-spacing:-.37px}
      .careers-hero-desc{font-size:16px;line-height:25px}
      .careers-section,.careers-about{padding:0 24px 60px}
      .careers-culture-container,.careers-process-container{padding:0 24px}
      .careers-grid-4,.careers-steps{grid-template-columns:1fr}
      .careers-section-header h2,.careers-about h2,.careers-apply h2{font-size:24px;line-height:31px}
      .careers-culture,.careers-process{padding:40px 0 60px;margin-bottom:60px}
      .careers-apply{padding:60px 0}
      .careers-apply-container{padding:0 24px}
    }
  </style>

  <div class="careers-page">
    <!-- ═══ HERO ═══ -->
    <header class="careers-hero">
      <div class="careers-hero-inner">
        <div class="careers-hero-label">
          <svg width="16" height="17" viewBox="0 0 16 17" fill="none"><g clip-path="url(#careersHeroShape)"><path d="M2.16 16.4999C0.7733 14.3158 0 11.465 0 8.49995C0 5.53493 0.7733 2.68405 2.16 0.5V16.4999Z" fill="#020303"/><path d="M16 16.5C13.8783 16.5 11.8434 15.6572 10.3431 14.1569C8.84286 12.6566 8 10.6217 8 8.50001C8 6.37827 8.84285 4.34344 10.3431 2.84314C11.8434 1.34284 13.8783 0.5 16 0.5V16.5Z" fill="#020303"/></g><defs><clipPath id="careersHeroShape"><rect fill="#fff" width="16" height="17"/></clipPath></defs></svg>
          <span>{t(locale, 'careersPage.hero.label')}</span>
        </div>
        <h1>{t(locale, 'careersPage.hero.heading')}</h1>
        <p class="careers-hero-desc">{t(locale, 'careersPage.hero.description')}</p>
      </div>
    </header>

    <!-- ═══ WHAT WE BUILD ═══ -->
    <section class="careers-about">
      <h2>{t(locale, 'careersPage.about.title')}</h2>
      <p>{t(locale, 'careersPage.about.body1')}</p>
      <p>{t(locale, 'careersPage.about.body2')}</p>
    </section>

    <!-- ═══ CULTURE ═══ -->
    <section class="careers-culture">
      <div class="careers-culture-container">
        <div class="careers-section-header">
          <h2>{t(locale, 'careersPage.culture.title')}</h2>
          <p>{t(locale, 'careersPage.culture.subtitle')}</p>
        </div>
        <div class="careers-grid-4">
          {cultureItems.map((item) => (
            <div class="careers-card">
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══ FUNCTIONS WE HIRE FOR ═══ -->
    <section class="careers-section">
      <div class="careers-section-header">
        <h2>{t(locale, 'careersPage.roles.title')}</h2>
        <p>{t(locale, 'careersPage.roles.subtitle')}</p>
      </div>
      <div class="careers-roles-grid">
        {roleItems.map((role, index) => (
          <div class="careers-role">
            <span class="careers-role-num">{String(index + 1).padStart(2, '0')}</span>
            <p class="careers-role-text">{role}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- ═══ HOW WE HIRE ═══ -->
    <section class="careers-process">
      <div class="careers-process-container">
        <div class="careers-section-header">
          <h2>{t(locale, 'careersPage.process.title')}</h2>
          <p>{t(locale, 'careersPage.process.subtitle')}</p>
        </div>
        <div class="careers-steps">
          {processSteps.map((step, index) => (
            <div class="careers-step">
              <div class="careers-step-num">Step {index + 1}</div>
              <h3>{step.title}</h3>
              <p>{step.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══ APPLY CTA ═══ -->
    <section class="careers-apply">
      <div class="careers-apply-container">
        <h2>{t(locale, 'careersPage.apply.title')}</h2>
        <p>{t(locale, 'careersPage.apply.body')}</p>
        <a class="careers-apply-cta" href={getLocalizedPath(locale, '/contact')}>
          {t(locale, 'careersPage.apply.cta')}
          <svg viewBox="0 0 16 16" fill="none"><path d="M4 12L12 4" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/><path d="M5.5 4H12V10.5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <a class="careers-apply-cta" href="mailto:service@ishineco.com?subject=Application%20%E2%80%94%20iShine%20careers">
          service@ishineco.com
          <svg viewBox="0 0 16 16" fill="none"><path d="M4 12L12 4" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/><path d="M5.5 4H12V10.5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
    </section>
  </div>
</BaseLayout>

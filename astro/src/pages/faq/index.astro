  <div class="space-y-48">
    <section class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-neutral-50 via-white to-sky-50 px-8 py-12 shadow-sm md:px-10 lg:px-12 lg:py-16">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,_rgba(56,189,248,0.12),_transparent_28%),radial-gradient(circle_at_bottom_left,_rgba(168,85,247,0.10),_transparent_30%)]" />
      <div class="relative grid gap-10 lg:grid-cols-[1.05fr_0.95fr] lg:items-center">
        <div>
          <Breadcrumb items={breadcrumbs} locale={locale} />
          <div class="mt-8 max-w-3xl">
            <div class="text-sm font-semibold uppercase tracking-[0.22em] text-sky-700">{t(locale, 'auxPages.faq.hero.smallTitle')}</div>
            <h1 class="mt-3 text-4xl font-bold text-ink-900 md:text-5xl">
              {t(locale, 'auxPages.faq.hero.heading')}
            </h1>
            <p class="mt-5 text-lg leading-relaxed text-neutral-700">
              {t(locale, 'auxPages.faq.hero.description')}
            </p>
          </div>
          <div class="mt-8 flex flex-wrap gap-3">
            {supportLinks.map((link) => (
              <a
                class={link.style === 'primary'
                  ? 'rounded-2xl bg-ink-900 px-5 py-3 text-sm font-semibold text-white transition hover:bg-neutral-800'
                  : 'rounded-2xl border border-neutral-300 bg-white px-5 py-3 text-sm font-semibold text-ink-900 transition hover:border-neutral-400 hover:bg-neutral-50'}
                href={link.href}
              >
                {link.label}
              </a>
            ))}
          </div>
        </div>

        <div class="grid gap-4 sm:grid-cols-3 lg:grid-cols-1">
          {decisionCards.map((card) => (
            <div class="rounded-[1.5rem] border border-neutral-200 bg-white p-6 shadow-sm">
              <div class="text-sm font-semibold uppercase tracking-[0.18em] text-slate-500">{card.label}</div>
              <h2 class="mt-3 text-2xl font-semibold text-ink-900">{card.title}</h2>
              <p class="mt-3 text-sm leading-relaxed text-neutral-700">{card.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="grid gap-6 lg:grid-cols-[0.8fr_1.2fr]">
      <div class="rounded-[1.75rem] border border-neutral-200 bg-white p-7 shadow-sm">
        <div class="text-sm font-semibold uppercase tracking-[0.22em] text-violet-700">{t(locale, 'auxPages.faq.quickNav.title')}</div>
        <h2 class="mt-3 text-2xl font-bold text-ink-900">{t(locale, 'auxPages.faq.quickNav.heading')}</h2>
        <p class="mt-3 text-neutral-700">
          {t(locale, 'auxPages.faq.quickNav.description')}
        </p>
      </div>
      <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
        {faqCategories.map((category) => (
          <a
            class="group rounded-[1.5rem] border border-neutral-200 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:border-neutral-300 hover:shadow-lg"
            href={`#${category.id}`}
          >
            <div class="flex items-center justify-between gap-4">
              <div class="text-sm font-semibold uppercase tracking-[0.18em] text-slate-500">{t(locale, 'auxPages.faq.categoryLabel')}</div>
              <div class="rounded-2xl bg-neutral-100 px-3 py-1 text-sm font-medium text-neutral-700">
                {category.faqs.length} {t(locale, 'auxPages.faq.qsSuffix')}
              </div>
            </div>
            <h3 class="mt-4 text-xl font-semibold text-ink-900 group-hover:text-violet-700">{category.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-neutral-700">{category.description}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="rounded-2xl bg-slate-950 px-8 py-12 text-white shadow-2xl md:px-10">
      <div class="grid gap-6 lg:grid-cols-3">
        <div class="rounded-[1.5rem] border border-white/10 bg-white/8 p-6 backdrop-blur">
          <div class="text-sm font-semibold uppercase tracking-[0.18em] text-sky-300">{t(locale, 'auxPages.faq.faqTypes.manufacturing.title')}</div>
          <p class="mt-3 text-sm leading-relaxed text-neutral-200">
            {t(locale, 'auxPages.faq.faqTypes.manufacturing.description')}
          </p>
        </div>
        <div class="rounded-[1.5rem] border border-white/10 bg-white/8 p-6 backdrop-blur">
          <div class="text-sm font-semibold uppercase tracking-[0.18em] text-sky-300">{t(locale, 'auxPages.faq.faqTypes.commercial.title')}</div>
          <p class="mt-3 text-sm leading-relaxed text-neutral-200">
            {t(locale, 'auxPages.faq.faqTypes.commercial.description')}
          </p>
        </div>
        <div class="rounded-[1.5rem] border border-white/10 bg-white/8 p-6 backdrop-blur">
          <div class="text-sm font-semibold uppercase tracking-[0.18em] text-sky-300">{t(locale, 'auxPages.faq.faqTypes.product.title')}</div>
          <p class="mt-3 text-sm leading-relaxed text-neutral-200">
            {t(locale, 'auxPages.faq.faqTypes.product.description')}
          </p>
        </div>
      </div>
    </section>

    {faqCategories.map((category) => (
      <section id={category.id} class="scroll-mt-24 rounded-2xl border border-neutral-200 bg-white p-8 shadow-sm md:p-10">
        <div class="flex flex-col gap-4 border-b border-neutral-200 pb-6 md:flex-row md:items-end md:justify-between">
          <div class="max-w-3xl">
            <div class="text-sm font-semibold uppercase tracking-[0.22em] text-violet-700">{t(locale, 'auxPages.faq.faqCategoryLabel')}</div>
            <h2 class="mt-3 text-3xl font-bold text-ink-900">{category.title}</h2>
            <p class="mt-4 text-lg leading-relaxed text-neutral-700">{category.description}</p>
            {category.relatedLinks && category.relatedLinks.length > 0 ? (
              <div class="mt-6 flex flex-wrap gap-2">
                {category.relatedLinks.map((link) => (
                  <a
                    class="rounded-2xl bg-white px-4 py-2 text-sm font-semibold text-ink-900 shadow-sm ring-1 ring-neutral-200 transition hover:bg-neutral-50"
                    href={link.href}
                  >
                    {link.label}
                  </a>
                ))}
              </div>
            ) : null}
          </div>
          <div class="rounded-2xl bg-neutral-100 px-4 py-2 text-sm font-medium text-neutral-700">
            {category.faqs.length} {t(locale, 'auxPages.faq.answersSuffix')}
          </div>
        </div>

        <div class="mt-8 grid gap-4">
          {category.faqs.map((faq) => (
            <details class="group rounded-[1.5rem] border border-neutral-200 bg-neutral-50/70 p-6 transition open:border-neutral-300 open:bg-white">
              <summary class="flex cursor-pointer list-none items-start justify-between gap-4 text-left">
                <span class="text-lg font-semibold text-ink-900">{faq.question}</span>
                <span class="mt-1 inline-flex h-7 w-7 flex-shrink-0 items-center justify-center rounded-2xl bg-white text-slate-500 shadow-sm transition group-open:rotate-45 group-open:text-ink-900">
                  +
                </span>
              </summary>
              <p class="mt-4 max-w-4xl text-sm leading-7 text-neutral-700">{faq.answer}</p>
              {faq.links && faq.links.length > 0 ? (
                <div class="mt-4 flex flex-wrap gap-2">
                  {faq.links.map((link) => (
                    <a
                      class="rounded-2xl border border-neutral-200 bg-white px-4 py-2 text-sm font-semibold text-ink-900 transition hover:border-neutral-300 hover:bg-neutral-50"
                      href={link.href}
                    >
                      {link.label}
                    </a>
                  ))}
                </div>
              ) : null}
            </details>
          ))}
        </div>
      </section>
    ))}

    <section class="rounded-2xl bg-gradient-to-r from-ink-900 to-neutral-800 px-8 py-14 text-white shadow-2xl">
      <div class="mx-auto max-w-4xl text-center">
        <div class="text-sm font-semibold uppercase tracking-[0.22em] text-neutral-300">{t(locale, 'auxPages.faq.cta.smallTitle')}</div>
        <h2 class="mt-3 text-3xl font-bold md:text-4xl">
          {t(locale, 'auxPages.faq.cta.heading')}
        </h2>
        <p class="mx-auto mt-4 max-w-3xl text-lg text-neutral-200">
          {t(locale, 'auxPages.faq.cta.description')}
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <a class="rounded-2xl bg-white px-5 py-3 text-sm font-semibold text-ink-900 transition hover:bg-neutral-100" href={getLocalizedPath(locale, '/contact')}>
            {t(locale, 'auxPages.faq.cta.contactTeam')}
          </a>
          <a class="rounded-2xl border border-white/20 px-5 py-3 text-sm font-semibold text-white transition hover:bg-white/10" href={getLocalizedPath(locale, '/products')}>
            {t(locale, 'auxPages.faq.cta.viewProducts')}
          </a>
          <a class="rounded-2xl border border-white/20 px-5 py-3 text-sm font-semibold text-white transition hover:bg-white/10" href={getLocalizedPath(locale, '/services')}>
            {t(locale, 'auxPages.faq.cta.learnServices')}
          </a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

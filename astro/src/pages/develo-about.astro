﻿﻿﻿﻿﻿﻿﻿﻿---
// Develo Design About Us Clone — exact CSS from Playwright getComputedStyle()
// Path: /about-us
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>About Our Magento Agency in Birmingham | Develo</title>
<meta name="description" content="A Birmingham eCommerce Team Built on Craft, Curiosity &amp; Long-Term Partnerships. We're a small but mighty team of developers, designers, and growth specialists." />

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=Syne:wght@400;700&display=swap" rel="stylesheet" />

<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{--blue:#563cfa;--black:#020303;--white:#fff;--grey-50:#f9fafb;--grey-100:#f3f4f6;--grey-200:#e5e7eb;--grey-400:#9ca3af;--grey-500:#6b7280;--grey-text:#4b5563;--max-w:1536px;--pad-100:100px}
html{scroll-behavior:smooth;overflow-x:hidden}
body{font-family:Manrope,-apple-system,Roboto,Helvetica,sans-serif;font-size:16px;font-weight:400;color:#000;background:#fff;overflow-x:hidden;-webkit-font-smoothing:antialiased}
a{text-decoration:none;color:inherit}
img{max-width:100%;height:auto;display:block}

/* ═══ SHARED: Trust Bar ═══ */
.trust-bar{position:fixed;top:0;left:0;right:0;z-index:100;height:60px;display:flex;align-items:center;justify-content:center;background:transparent}
.trust-bar-inner{display:flex;align-items:center}
.trust-slide{display:flex;align-items:center;justify-content:center;gap:8px;padding:12px 24px}
.trust-slide[aria-hidden="true"]{display:none}
.trust-slide[aria-hidden="false"]{display:flex}
.trust-text{font-family:Manrope,sans-serif;font-size:16px;font-weight:400;color:#020303;line-height:25px}

/* ═══ 2. HEADER / NAV ═══ */
.site-header{position:fixed;top:66px;left:50%;transform:translate(-50%);width:calc(100% - 48px);max-width:1400px;z-index:110;transition:top .3s ease;will-change:top}
.header-inner{display:flex;align-items:center;justify-content:flex-start;height:70px;padding:0 24px 0 40px;background:rgba(255,255,255,.9);border-radius:40px;box-shadow:0 10px 24px rgba(2,3,3,.06);gap:0}
.header-logo{display:flex;align-items:center;flex-shrink:0;margin-right:502px}
.header-logo svg{display:block}
.header-nav{display:flex;align-items:center;gap:8px}
.nav-item{display:flex;align-items:center;gap:4px;padding:12px 16px;font-family:Manrope,sans-serif;font-size:16px;font-weight:400;color:#020303;line-height:25px;background:transparent;cursor:pointer;border-radius:8px;transition:background .2s;white-space:nowrap;text-decoration:none}
.nav-item:hover{background:rgba(0,0,0,.04)}

/* Desktop nav visibility */
.desktop-nav{display:flex}
@media(max-width:959px){.desktop-nav{display:none}}

/* Header CTA */
.header-cta{display:flex;align-items:center;gap:12px;margin-left:auto;margin-right:38px}
.btn-cta{display:inline-flex;align-items:center;justify-content:center;gap:6px;padding:12px 20px;background:var(--blue);color:#fff;font-family:Manrope,sans-serif;font-size:16px;font-weight:400;line-height:16px;border-radius:100px;border:none;cursor:pointer;white-space:nowrap;transition:all .25s}
.btn-cta:hover{gap:12px;background:#374151}
.btn-cta svg{width:16px;height:16px}
@media(max-width:959px){.header-cta .btn-cta{display:none}}

/* Nav collapse button */
.nav-collapse-btn{display:none;align-items:center;justify-content:center;width:40px;height:40px;border-radius:100px;background:var(--blue);border:none;cursor:pointer;margin-left:auto;margin-right:38px}
.nav-collapse-btn svg{width:20px;height:20px}
.nav-collapsed .desktop-nav,.nav-collapsed .header-cta{display:none}
@media(max-width:959px){.desktop-nav{display:none !important}.header-cta{display:none !important}.nav-collapse-btn{display:flex !important}}

@media(max-width:767px){
  .site-header{top:66px;width:calc(100% - 32px)}
  .header-inner{height:56px;padding:0 24px 0 32px;border-radius:40px}
}

/* ═══ Mega Dropdown ═══ */
.nav-dropdown-wrapper{position:relative}
.nav-has-dropdown{gap:6px}
.nav-dropdown-chevron{width:12px;height:7px;transition:transform .25s ease;flex-shrink:0}
.nav-dropdown-wrapper:hover .nav-dropdown-chevron{transform:rotate(180deg)}
.mega-dropdown{position:absolute;top:calc(100% + 12px);left:50%;transform:translateX(-50%) translateY(4px);min-width:640px;background:#fff;border-radius:20px;box-shadow:0 20px 40px rgba(2,3,3,.15);opacity:0;visibility:hidden;pointer-events:none;z-index:120;transition:opacity .2s ease,transform .25s ease,visibility 0s .25s}
.nav-dropdown-wrapper:hover .mega-dropdown,.mega-dropdown.open{opacity:1;visibility:visible;pointer-events:auto;transform:translateX(-50%) translateY(0);transition:opacity .2s ease,transform .25s ease,visibility 0s 0s}
.mega-inner{display:flex;gap:60px;padding:36px 40px}
.mega-left{flex:1;display:flex;flex-direction:column}
.mega-link-group{display:flex;flex-direction:column;gap:4px}
.mega-link{display:flex;flex-direction:column;gap:4px;padding:10px 14px;border-radius:10px;text-decoration:none;transition:background .15s;position:relative}
.mega-link:hover{background:rgba(0,0,0,.04)}
.mega-link-title{font-family:Manrope,sans-serif;font-size:18px;font-weight:500;line-height:26px;color:#020303}
.mega-link-desc{font-family:Manrope,sans-serif;font-size:14px;font-weight:400;line-height:21px;color:#6b7280}
.mega-link.has-plus{flex-direction:row;align-items:center;justify-content:space-between}
.mega-link.has-plus .mega-link-title,.mega-link.has-plus .mega-link-desc{display:block}
.mega-link.has-plus>div{display:flex;flex-direction:column;gap:4px}
.mega-plus{font-family:Manrope,sans-serif;font-size:20px;font-weight:400;color:#020303;width:28px;height:28px;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.mega-right{flex-shrink:0;width:260px}
.mega-card{background:var(--grey-50);border-radius:14px;padding:22px;display:flex;flex-direction:column;gap:12px}
.mega-card-heading{font-family:Syne,sans-serif;font-size:21px;font-weight:400;line-height:27px;color:#020303;margin:0}
.mega-card-desc{font-family:Manrope,sans-serif;font-size:14px;font-weight:400;line-height:21px;color:#6b7280;margin:0}
.mega-card-btn{display:inline-flex;align-items:center;gap:6px;font-family:Manrope,sans-serif;font-size:16px;font-weight:400;color:var(--blue);padding:10px 18px;border-radius:100px;background:transparent;transition:all .2s;align-self:flex-start;text-decoration:none}
.mega-card-btn:hover{background:var(--blue);color:#fff;gap:12px}
@media(max-width:959px){.mega-dropdown{display:none !important}}
/* Mobile menu panel */
.nav-collapse-btn.open{background:#374151}
.mobile-menu-overlay{position:fixed;inset:0;background:rgba(74,98,211,.1);opacity:0;visibility:hidden;pointer-events:none;z-index:108;transition:opacity .2s ease,visibility 0s .2s}
.mobile-menu-overlay.open{opacity:1;visibility:visible;pointer-events:auto;transition:opacity .2s ease,visibility 0s 0s}
.mobile-menu-panel{position:fixed;top:148px;left:50%;transform:translateX(-50%) translateY(-8px);width:calc(100% - 48px);max-width:520px;background:#fff;border-radius:20px;box-shadow:0 20px 40px rgba(2,3,3,.15);padding:20px;display:none;flex-direction:column;gap:8px;opacity:0;visibility:hidden;pointer-events:none;z-index:115;transition:opacity .2s ease,transform .25s ease,visibility 0s .25s}
.mobile-menu-panel.open{opacity:1;visibility:visible;pointer-events:auto;transform:translateX(-50%) translateY(0);transition:opacity .2s ease,transform .25s ease,visibility 0s 0s}
.mobile-menu-group{display:flex;flex-direction:column;border-bottom:1px solid #e5e7eb}
.mobile-menu-group:last-of-type{border-bottom:none}
.mobile-menu-toggle,.mobile-menu-link{width:100%;display:flex;align-items:center;justify-content:space-between;gap:12px;padding:14px 12px;background:transparent;border:none;border-radius:10px;text-decoration:none;font-family:Manrope,sans-serif;font-size:18px;font-weight:400;line-height:26px;color:#020303;text-align:left;cursor:pointer}
.mobile-menu-toggle:hover,.mobile-menu-link:hover{background:rgba(0,0,0,.04)}
.mobile-menu-toggle-chevron{width:12px;height:7px;flex-shrink:0;transition:transform .25s ease}
.mobile-menu-group.open .mobile-menu-toggle-chevron{transform:rotate(180deg)}
.mobile-submenu{max-height:0;overflow:hidden;display:flex;flex-direction:column;gap:4px;transition:max-height .3s ease,padding-bottom .3s ease}
.mobile-menu-group.open .mobile-submenu{max-height:480px;padding-bottom:12px}
.mobile-submenu-link{display:flex;flex-direction:column;gap:4px;padding:10px 12px 10px 24px;border-radius:10px;text-decoration:none}
.mobile-submenu-link:hover{background:rgba(0,0,0,.04)}
.mobile-submenu-title{font-family:Manrope,sans-serif;font-size:16px;font-weight:500;line-height:24px;color:#020303}
.mobile-submenu-desc{font-family:Manrope,sans-serif;font-size:13px;font-weight:400;line-height:19px;color:#6b7280}
.mobile-menu-cta{margin-top:8px}
.mobile-menu-cta .btn-cta{width:100%;justify-content:center}
@media(max-width:959px){.mobile-menu-panel{display:flex}}
@media(max-width:767px){.mobile-menu-panel{top:130px;width:calc(100% - 32px);padding:18px}}



/* ═══ PAGE MAIN ═══ */
.page-main{margin-top:136px}

/* ═══ HERO ═══ */
.about-hero{width:100%;max-width:var(--max-w);margin:0 auto 80px;padding:0 var(--pad-100)}
.about-hero-inner{display:flex;flex-direction:column;gap:16px;max-width:720px}
.about-hero h1{font-family:Syne,sans-serif;font-size:52px;font-weight:400;line-height:60px;letter-spacing:-.51px;color:var(--black);margin:0}
.about-hero-subtitle{font-family:Manrope,sans-serif;font-size:20px;font-weight:400;line-height:30px;color:var(--grey-text)}

/* ═══ JOURNEY ═══ */
.journey-section{padding:0 0 100px}
.journey-container{width:100%;max-width:var(--max-w);margin:0 auto;padding:0 var(--pad-100)}
.journey-grid{display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:center}
.journey-text{display:flex;flex-direction:column;gap:20px}
.journey-text h2{font-family:Syne,sans-serif;font-size:16px;font-weight:400;line-height:22px;color:var(--grey-500);text-transform:uppercase;letter-spacing:.5px;margin:0}
.journey-text h3{font-family:Syne,sans-serif;font-size:32px;font-weight:400;line-height:40px;color:var(--black);margin:0}
.journey-text p{font-family:Manrope,sans-serif;font-size:17px;font-weight:400;line-height:28px;color:var(--grey-text)}
.journey-image{width:100%;min-height:400px;border-radius:20px;background:var(--grey-200);display:flex;align-items:center;justify-content:center;overflow:hidden}
.journey-image-placeholder{font-family:Syne,sans-serif;font-size:18px;color:var(--grey-400);text-align:center;padding:40px}

/* ═══ VALUES ═══ */
.values-section{background:var(--black);color:#fff;padding:100px 0}
.values-container{width:100%;max-width:var(--max-w);margin:0 auto;padding:0 var(--pad-100)}
.values-header{display:flex;flex-direction:column;gap:8px;margin-bottom:60px}
.values-header h2{font-family:Syne,sans-serif;font-size:16px;font-weight:400;line-height:22px;color:rgba(255,255,255,.5);text-transform:uppercase;letter-spacing:.5px;margin:0}
.values-header h3{font-family:Syne,sans-serif;font-size:32px;font-weight:400;line-height:40px;color:#fff;margin:0}
.values-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:32px}
.value-card{display:flex;flex-direction:column;gap:12px;padding:32px 24px;border:1px solid rgba(255,255,255,.15);border-radius:16px;transition:border-color .2s}
.value-card:hover{border-color:rgba(255,255,255,.4)}
.value-card h4{font-family:Syne,sans-serif;font-size:21px;font-weight:400;line-height:28px;color:#fff;margin:0}
.value-card p{font-family:Manrope,sans-serif;font-size:15px;font-weight:400;line-height:23px;color:rgba(255,255,255,.6)}

/* ═══ TESTIMONIALS ═══ */
.testimonials-section{padding:100px 0}
.testimonials-container{width:100%;max-width:var(--max-w);margin:0 auto;padding:0 var(--pad-100)}
.testimonials-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:32px}
.testimonial-card{display:flex;flex-direction:column;gap:16px;padding:32px;border:1px solid var(--grey-200);border-radius:16px;transition:border-color .2s}
.testimonial-card:hover{border-color:var(--grey-400)}
.testimonial-quote{font-family:Manrope,sans-serif;font-size:16px;font-weight:400;line-height:25px;color:var(--black)}
.testimonial-quote::before{content:'\201C';font-family:Syne,sans-serif;font-size:48px;color:var(--blue);display:block;line-height:1;margin-bottom:8px}
.testimonial-author{font-family:Manrope,sans-serif;font-size:14px;font-weight:600;color:var(--black);line-height:21px}
.testimonial-role{font-family:Manrope,sans-serif;font-size:13px;font-weight:400;color:var(--grey-500);line-height:19px}
.testimonial-link{display:inline-flex;align-items:center;gap:4px;font-family:Manrope,sans-serif;font-size:14px;font-weight:500;color:var(--blue);transition:color .2s;margin-top:4px}
.testimonial-link:hover{color:#374151}
.testimonial-pagination{display:flex;align-items:center;justify-content:center;gap:12px;margin-top:32px;font-family:Manrope,sans-serif;font-size:14px;color:var(--grey-500)}

/* ═══ TEAM ═══ */
.team-section{padding:100px 0;background:var(--grey-50)}
.team-container{width:100%;max-width:var(--max-w);margin:0 auto;padding:0 var(--pad-100)}
.team-inner{display:flex;align-items:center;gap:80px}
.team-content{flex:1;display:flex;flex-direction:column;gap:16px}
.team-content h2{font-family:Syne,sans-serif;font-size:16px;font-weight:400;line-height:22px;color:var(--grey-500);text-transform:uppercase;letter-spacing:.5px;margin:0}
.team-content h3{font-family:Syne,sans-serif;font-size:32px;font-weight:400;line-height:40px;color:var(--black);margin:0}
.team-content p{font-family:Manrope,sans-serif;font-size:17px;font-weight:400;line-height:28px;color:var(--grey-text)}
.team-visual{flex:1;min-height:350px;border-radius:20px;background:var(--grey-200);display:flex;align-items:center;justify-content:center}

/* ═══ CTA SERVICES ═══ */
.cta-section{padding:100px 0}
.cta-container{width:100%;max-width:var(--max-w);margin:0 auto;padding:0 var(--pad-100)}
.cta-header{margin-bottom:40px}
.cta-header h2{font-family:Syne,sans-serif;font-size:16px;font-weight:400;line-height:22px;color:var(--grey-500);text-transform:uppercase;letter-spacing:.5px;margin:0 0 8px}
.cta-header h3{font-family:Syne,sans-serif;font-size:32px;font-weight:400;line-height:40px;color:var(--black);margin:0}
.cta-links{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-bottom:32px}
.cta-link-card{display:flex;align-items:center;gap:12px;padding:20px 24px;border:1px solid var(--grey-200);border-radius:12px;font-family:Manrope,sans-serif;font-size:15px;font-weight:400;color:var(--black);transition:all .2s}
.cta-link-card:hover{border-color:var(--blue);color:var(--blue)}
.cta-link-arrow{flex-shrink:0;opacity:0;transition:opacity .2s;color:var(--blue)}
.cta-link-card:hover .cta-link-arrow{opacity:1}

/* ═══ BLOG INSIGHTS ═══ */
.insights-section{padding:0 0 100px}
.insights-container{width:100%;max-width:var(--max-w);margin:0 auto;padding:0 var(--pad-100)}
.insights-header{display:flex;align-items:flex-end;justify-content:space-between;margin-bottom:32px}
.insights-header-left{display:flex;flex-direction:column;gap:8px}
.insights-header-left h2{font-family:Syne,sans-serif;font-size:16px;font-weight:400;line-height:22px;color:var(--grey-500);text-transform:uppercase;letter-spacing:.5px;margin:0}
.insights-header-left h3{font-family:Syne,sans-serif;font-size:32px;font-weight:400;line-height:40px;color:var(--black);margin:0}
.insights-header p{font-family:Manrope,sans-serif;font-size:15px;font-weight:400;line-height:23px;color:var(--grey-text);max-width:500px}
.insights-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
.insight-card{display:flex;flex-direction:column;gap:12px;padding:24px;border:1px solid var(--grey-200);border-radius:16px;transition:all .2s}
.insight-card:hover{border-color:var(--grey-400);transform:translateY(-2px)}
.insight-card h4{font-family:Syne,sans-serif;font-size:18px;font-weight:400;line-height:26px;color:var(--black);margin:0;transition:color .2s}
.insight-card:hover h4{color:var(--blue)}
.insight-card p{font-family:Manrope,sans-serif;font-size:14px;font-weight:400;line-height:21px;color:var(--grey-500)}
.insight-card .card-arrow{display:inline-flex;align-items:center;gap:4px;font-family:Manrope,sans-serif;font-size:14px;font-weight:500;color:var(--blue)}

/* ═══ RESPONSIVE ═══ */
@media(max-width:1279px){
  .about-hero{padding:0 40px}
  .journey-container,.values-container,.testimonials-container,.team-container,.cta-container,.insights-container{padding:0 40px}
  .values-grid{grid-template-columns:repeat(2,1fr)}
  .cta-links{grid-template-columns:repeat(2,1fr)}
  .insights-grid{grid-template-columns:repeat(2,1fr)}
}
@media(max-width:959px){
  .journey-grid{grid-template-columns:1fr}
  .team-inner{flex-direction:column;gap:40px}
}
@media(max-width:767px){
  .about-hero{padding:0 24px;margin-bottom:60px}
  .about-hero h1{font-size:36px;line-height:44px;letter-spacing:-.35px}
  .about-hero-subtitle{font-size:16px;line-height:26px}
  .journey-container,.values-container,.testimonials-container,.team-container,.cta-container,.insights-container{padding:0 24px}
  .values-grid{grid-template-columns:1fr}
  .values-section,.testimonials-section,.team-section,.cta-section{padding:60px 0}
  .testimonials-grid{grid-template-columns:1fr}
  .cta-links{grid-template-columns:1fr}
  .insights-header{flex-direction:column;align-items:flex-start;gap:16px}
  .insights-grid{grid-template-columns:1fr}
}
</style>
</head>
<body>

<SiteHeader />

<main class="page-main">

  <!-- ═══ HERO ═══ -->
  <section class="about-hero">
    <div class="about-hero-inner">
      <h1>About Our Magento Agency in Birmingham</h1>
      <p class="about-hero-subtitle">A Birmingham eCommerce Team Built on Craft, Curiosity &amp; Long-Term Partnerships. We're a small but mighty team of developers, designers, and growth specialists who care about building seamless eCommerce experiences.</p>
    </div>
  </section>

  <!-- ═══ JOURNEY ═══ -->
  <section class="journey-section">
    <div class="journey-container">
      <div class="journey-grid">
        <div class="journey-text">
          <h2>Our Story</h2>
          <h3>How our eCommerce journey began</h3>
          <p>Develo started as a passion for building websites and has grown into a specialist eCommerce agency focused on Magento, Adobe Commerce, and Hyva. From a two-person setup to a close-knit team, we combine creativity and technical expertise to support sustainable eCommerce growth.</p>
        </div>
        <div class="journey-image">
          <div class="journey-image-placeholder">Develo Team Photo</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ VALUES ═══ -->
  <section class="values-section">
    <div class="values-container">
      <div class="values-header">
        <h2>Our core values</h2>
        <h3>What drives us every day</h3>
      </div>
      <div class="values-grid">
        <div class="value-card">
          <h4>Transparency</h4>
          <p>We're honest, straightforward, and easy to work with. Clear communication builds trust, and trust builds long-term relationships.</p>
        </div>
        <div class="value-card">
          <h4>Collaboration</h4>
          <p>We work with you, not just for you. Your goals shape every decision, and your success is the benchmark for ours.</p>
        </div>
        <div class="value-card">
          <h4>Flexibility</h4>
          <p>eCommerce changes quickly, and so do customer expectations. We adapt fast, stay proactive, and work hard to keep your store evolving long after it's launched.</p>
        </div>
        <div class="value-card">
          <h4>Curiosity</h4>
          <p>We're always keen on exploring new ideas and testing new tools and technology. That curiosity keeps our work innovative and helps us deliver modern, high-performing Magento and eCommerce solutions.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ TESTIMONIALS ═══ -->
  <section class="testimonials-section">
    <div class="testimonials-container">
      <div class="testimonials-grid">
        <div class="testimonial-card">
          <p class="testimonial-quote">I am continually impressed by the results you produced! Your unique perspective, expertise and dedication played a crucial role in our project success.</p>
          <div><span class="testimonial-author">Dominika Miler-Zydek</span><br/><span class="testimonial-role">IT Project Manager</span></div>
          <a class="testimonial-link" href="/work/currys">See case study <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M7 17L17 7M17 7H7M17 7V17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
        </div>

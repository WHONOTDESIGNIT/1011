---
// Develo Design — About / Testimonials（复刻 https://www.develodesign.co.uk/about/testimonials，hero 交互参考首页 testimonial 轮播）
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { t } from '../lib/i18n';
import { getLocalizedPath } from '../lib/breadcrumbs';

const locale = Astro.currentLocale ?? 'en';
---
<!doctype html>
<html lang={locale}>
<head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<script is:inline>
  // 语言偏好持久化：读取用户选定的语言（localStorage），
  // 若当前 URL 语言与偏好不一致，立即重定向到偏好语言对应页面（支持 en/tr/ar）
  (function () {
    var KEY = 'ishine_lang';
    try {
      var stored = localStorage.getItem(KEY);
      if (!stored) return;
      var LANGS = ['tr', 'ar', 'es', 'fr', 'ru', 'he', 'pt-BR', 'nl'];
      var path = window.location.pathname;
      var cur = 'en';
      for (var i = 0; i < LANGS.length; i++) {
        if (path === '/' + LANGS[i] || path.indexOf('/' + LANGS[i] + '/') === 0) {
          cur = LANGS[i];
          break;
        }
      }
      if (stored === cur) return;
      var stripped = path;
      for (var j = 0; j < LANGS.length; j++) {
        stripped = stripped.replace(new RegExp('^/' + LANGS[j] + '/?'), '');
      }
      if (stored === 'en') {
        stripped = stripped.replace(/\/+$/, '');
        if (stripped === '' || stripped === '/') stripped = '/';
        if (stripped !== path) window.location.replace(stripped);
      } else {
        var target = '/' + stored + (stripped === '' || stripped === '/' ? '' : stripped);
        target = target.replace(/\/+$/, '');
        if (target === '') target = '/' + stored;
        if (target !== path) window.location.replace(target);
      }
    } catch (e) { /* 隐私模式等场景忽略 */ }
  })();
</script>
<title>Testimonials &amp; Reviews | Develo Design</title>
<meta name="description" content="What Our Clients Say. Read testimonials and reviews from brands who trust Develo for Magento, Adobe Commerce and Hyva development." />
<link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=Syne:wght@400;700&display=swap" rel="stylesheet" />
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{--blue:#563cfa;--black:#020303;--white:#fff;--grey-50:#f9fafb;--grey-100:#f3f4f6;--grey-200:#e5e7eb;--grey-400:#9ca3af;--grey-500:#6b7280;--grey-text:#4b5563;--max-w:1536px;--pad-100:100px}
html{scroll-behavior:smooth;overflow-x:hidden}
body{font-family:Manrope,-apple-system,Roboto,Helvetica,sans-serif;font-size:16px;font-weight:400;color:#000;background:#fff;overflow-x:hidden;-webkit-font-smoothing:antialiased}
a{text-decoration:none;color:inherit}img{max-width:100%;height:auto;display:block}

/* ═══ 首页同款全页渐变背景 ═══ */
.gradient-bg{position:fixed;top:0;left:0;width:100%;height:100%;z-index:-1;pointer-events:none;
  background:radial-gradient(ellipse at 20% 30%,rgba(0,56,255,.09) 0%,transparent 45%),
    radial-gradient(ellipse at 70% 50%,rgba(55,127,255,.08) 0%,transparent 45%),
    radial-gradient(ellipse at 15% 70%,rgba(127,48,255,.09) 0%,transparent 45%),
    radial-gradient(ellipse at 80% 80%,rgba(242,80,110,.08) 0%,transparent 45%)}

/* ═══ 首页同款小标题（钻石图标 + 黑色文字） ═══ */
.diamond-icon{display:flex;align-items:center;justify-content:center;flex-shrink:0}
.small-title{display:flex;align-items:center;gap:12px;padding:3px 0;font-family:Manrope,sans-serif;font-size:18px;font-weight:400;color:#020303;line-height:26px}
.small-title .diamond-icon{width:16px;height:17px}

/* ═══ Trust Bar & Header ═══ */
.trust-bar{position:fixed;top:0;left:0;right:0;z-index:100;height:60px;display:flex;align-items:center;justify-content:center;background:transparent}
.trust-bar-inner{display:flex;align-items:center}
.trust-slide{display:flex;align-items:center;justify-content:center;gap:8px;padding:12px 24px}
.trust-slide[aria-hidden="true"]{display:none}.trust-slide[aria-hidden="false"]{display:flex}
.trust-text{font-family:Manrope,sans-serif;font-size:16px;font-weight:400;color:#020303;line-height:25px}
.site-header{position:fixed;top:66px;left:50%;transform:translate(-50%);width:calc(100% - 48px);max-width:1400px;z-index:110}
.header-inner{display:flex;align-items:center;justify-content:space-between;height:70px;padding:0 24px 0 40px;background:rgba(255,255,255,.9);border-radius:40px;box-shadow:0 10px 24px rgba(2,3,3,.06);gap:40px}
.header-logo{display:flex;align-items:center;flex-shrink:0}
.header-nav{display:flex;align-items:center;gap:8px}
.nav-item{display:flex;align-items:center;gap:4px;padding:12px 16px;font-family:Manrope,sans-serif;font-size:16px;font-weight:400;color:#020303;line-height:25px;background:transparent;border:none;cursor:pointer;border-radius:8px;transition:background .2s;white-space:nowrap}
.nav-item:hover{background:rgba(0,0,0,.04)}
.header-cta{display:flex;align-items:center;gap:12px}
.btn-primary{display:inline-flex;align-items:center;justify-content:center;gap:6px;padding:12px 20px;background:var(--blue);color:#fff;font-family:Manrope,sans-serif;font-size:16px;font-weight:400;line-height:16px;border-radius:100px;border:none;cursor:pointer;white-space:nowrap;transition:all .2s;text-decoration:none}
.btn-primary:hover{gap:16px;background:#374151}
.btn-outline{display:inline-flex;align-items:center;justify-content:center;gap:6px;padding:12px 20px;background:transparent;color:var(--black);font-family:Manrope,sans-serif;font-size:16px;font-weight:400;line-height:16px;border-radius:100px;border:1px solid var(--black);cursor:pointer;white-space:nowrap;transition:all .2s;text-decoration:none}
.btn-outline:hover{background:var(--black);color:#fff}
.desktop-nav{display:flex}
@media(max-width:959px){.desktop-nav{display:none}.header-cta .btn-primary{display:none}}
@media(max-width:767px){.site-header{top:66px;width:calc(100% - 32px)}.header-inner{height:56px;padding:0 24px 0 32px}}

.page-main{margin-top:136px;position:relative;z-index:1}
.section-container{max-width:var(--max-w);margin:0 auto;padding:0 var(--pad-100)}

/* ═══ HERO（渐变背景 + 单卡轮播，布局参考首页 testimonial） ═══ */
.hero-section{padding:48px 0 0}
.hero-title{font-family:Syne,sans-serif;font-size:44px;font-weight:400;line-height:52px;letter-spacing:-.43px;color:var(--black);margin:0 0 8px}
.testimonials-container{position:relative;display:flex;align-items:flex-start;width:100%;max-width:var(--max-w);margin:0 auto;padding:40px 0 124px;gap:60px}
.testimonial-main{flex:1;display:flex;flex-direction:column;position:relative}
.testimonial-quote-icon{position:absolute;right:184px;bottom:24px;margin-bottom:0}
.testimonial-quote{font-family:Syne,sans-serif;font-size:24px;font-weight:400;line-height:30px;color:var(--black);margin-bottom:24px;max-width:900px}
.testimonial-author{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.testimonial-author-name{font-family:Manrope,sans-serif;font-size:16px;font-weight:600;color:var(--black);line-height:25px}
.testimonial-author-role{font-family:Manrope,sans-serif;font-size:14px;font-weight:400;color:#6b7280;line-height:21px}
.testimonial-cta{display:inline-flex;align-items:center;gap:6px;font-family:Manrope,sans-serif;font-size:16px;font-weight:400;color:var(--blue);margin-top:24px;transition:gap .2s}
.testimonial-cta:hover{gap:12px}
.testimonial-nav{display:flex;gap:12px;align-items:center;flex-shrink:0;position:absolute;right:0;bottom:40px}
.testimonial-nav button{width:48px;height:48px;display:flex;align-items:center;justify-content:center;border-radius:100px;border:1px solid var(--black);background:transparent;cursor:pointer;transition:all .2s}
.testimonial-nav button:hover{background:var(--black);color:#fff}
.testimonial-nav button svg{width:24px;height:24px}
.testimonials-pagination{display:flex;align-items:center;position:absolute;left:0;bottom:52px;font-family:Manrope,sans-serif;font-size:14px;color:var(--grey-500)}
@keyframes testimonialFade{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}
.testimonial-main.testimonial-fade .testimonial-quote,.testimonial-main.testimonial-fade .testimonial-author,.testimonial-main.testimonial-fade .testimonial-cta{animation:testimonialFade .35s ease}

/* ═══ REVIEWS（背景 #f9fafb + 钻石图标，全元素水平居中） ═══ */
.reviews-section{background:#f9fafb;padding:80px 0}
.reviews-section .section-container{display:flex;flex-direction:column;align-items:center;text-align:center}
.reviews-heading{font-family:Syne,sans-serif;font-size:32px;font-weight:400;line-height:40px;color:var(--black);margin:0 0 16px}
.reviews-desc{font-family:Manrope,sans-serif;font-size:17px;font-weight:400;line-height:28px;color:var(--grey-text);max-width:520px;margin:0 0 40px}
.reviews-cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px;width:100%;max-width:720px}
.review-card{display:flex;flex-direction:column;align-items:center;gap:12px;padding:28px 32px;background:#fff;border:1px solid var(--grey-200);border-radius:16px;transition:border-color .2s;text-align:center}
.review-card:hover{border-color:var(--grey-400)}
.review-stars{display:flex;gap:2px;color:#f59e0b;font-size:20px}
.review-score{font-family:Syne,sans-serif;font-size:24px;font-weight:400;color:var(--black);line-height:32px}
.review-meta{font-family:Manrope,sans-serif;font-size:14px;font-weight:400;color:var(--grey-500);line-height:21px}
.review-link{display:inline-flex;align-items:center;gap:4px;font-family:Manrope,sans-serif;font-size:14px;font-weight:500;color:var(--blue);margin-top:4px}

/* ═══ BLOG ═══ */
.blog-section{padding:80px 0}
.blog-header{display:flex;align-items:flex-end;justify-content:space-between;margin-bottom:32px;flex-wrap:wrap;gap:16px}
.blog-header h2{font-family:Syne,sans-serif;font-size:32px;font-weight:400;line-height:40px;color:var(--black);margin:0}
.blog-header p{font-family:Manrope,sans-serif;font-size:16px;font-weight:400;line-height:25px;color:var(--grey-text);max-width:460px}
.blog-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
.blog-card{display:flex;flex-direction:column;gap:12px;padding:24px;border:1px solid var(--grey-200);border-radius:16px;transition:all .2s}
.blog-card:hover{border-color:var(--grey-400);transform:translateY(-2px)}
.blog-card h3{font-family:Syne,sans-serif;font-size:18px;font-weight:400;line-height:26px;color:var(--black);margin:0;transition:color .2s}
.blog-card:hover h3{color:var(--blue)}

@media(max-width:1279px){
  .section-container{padding:0 40px}
  .testimonials-container{gap:24px}
  .testimonial-quote-icon{right:124px}
  .testimonial-nav{right:0}
  .blog-grid{grid-template-columns:repeat(2,1fr)}
}
@media(max-width:959px){.reviews-cards{grid-template-columns:1fr}}
@media(max-width:767px){
  .section-container{padding:0 24px}
  .hero-title{font-size:34px;line-height:42px;letter-spacing:-.33px}
  .testimonials-container{padding:32px 0 140px}
  .testimonial-quote{font-size:20px;line-height:26px}
  .testimonial-quote-icon{right:108px;bottom:24px}
  .testimonial-nav{right:0;bottom:36px}
  .testimonials-pagination{left:0;bottom:52px}
  .reviews-heading,.blog-header h2{font-size:26px;line-height:34px}
  .blog-grid{grid-template-columns:1fr}
}
</style>
</head>
<body>

<div class="gradient-bg"></div>

<SiteHeader />

<main class="page-main">

  <!-- ═══ HERO：渐变背景 + 单卡 testimonial 轮播 ═══ -->
  <section class="hero-section">
    <div class="section-container">
      <div class="small-title" style="margin-bottom:24px">
        <svg class="diamond-icon" width="16" height="17" viewBox="0 0 16 17" fill="none"><path d="M8.00004 0.5L16.0001 8.50004L8.00004 16.5001L0 8.50004L8.00004 0.5Z" fill="#020303"/></svg>
        {t(locale, 'develoSocial.aboutTestimonialsPage.hero.label')}
      </div>
      <h1 class="hero-title">{t(locale, 'develoSocial.aboutTestimonialsPage.hero.heading')}</h1>
      <div class="testimonials-container">
        <div class="testimonial-main" id="testimonial-main">
          <div class="testimonial-quote-icon">
            <svg width="64" height="64" viewBox="0 0 64 64" fill="none"><path d="M16 32c0-8.837 7.163-16 16-16 0 0-4 4-4 12s4 12 12 12 12-4 12-12-4-12-12-12v-4c-17.673 0-32 14.327-32 32z" fill="rgba(86,60,250,.2)"/></svg>
          </div>
          <p class="testimonial-quote" id="testimonial-quote">{t(locale, 'develoSocial.aboutTestimonialsPage.hero.quote')}</p>
          <div class="testimonial-author" id="testimonial-author">
            <div>
              <span class="testimonial-author-name" id="testimonial-name">Dominika Miler-Zydek</span><br/>
              <span class="testimonial-author-role" id="testimonial-role">{t(locale, 'develoSocial.aboutTestimonialsPage.hero.role')}</span>
            </div>
          </div>
          <a class="testimonial-cta" id="testimonial-cta" href={getLocalizedPath(locale, '/work/currys')}>{t(locale, 'develoSocial.aboutTestimonialsPage.hero.seeCaseStudy')} <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M4 12L12 4" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/><path d="M5.5 4H12V10.5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
        </div>
        <div class="testimonial-nav">
          <button id="prev-testimonial" aria-label={t(locale, 'common.previous')}><svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
          <div class="testimonials-pagination"><span id="testimonial-pagination">1/10</span></div>
          <button id="next-testimonial" aria-label={t(locale, 'common.next')}><svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M9 18l6-6-6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ REVIEWS（背景 #f9fafb） ═══ -->
  <section class="reviews-section">
    <div class="section-container">
      <div class="small-title" style="margin-bottom:20px">
        <svg class="diamond-icon" width="16" height="17" viewBox="0 0 16 17" fill="none"><path d="M8.00004 0.5L16.0001 8.50004L8.00004 16.5001L0 8.50004L8.00004 0.5Z" fill="#020303"/></svg>
        {t(locale, 'develoSocial.aboutTestimonialsPage.reviews.label')}
      </div>
      <h2 class="reviews-heading">{t(locale, 'develoSocial.aboutTestimonialsPage.reviews.heading')}</h2>
      <p class="reviews-desc">{t(locale, 'develoSocial.aboutTestimonialsPage.reviews.description')}</p>
      <div class="reviews-cards">
        <div class="review-card">
          <div class="review-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
          <span class="review-score">{t(locale, 'develoSocial.aboutTestimonialsPage.reviews.google.score')}</span>
          <span class="review-meta">{t(locale, 'develoSocial.aboutTestimonialsPage.reviews.google.meta')}</span>
          <a class="review-link" href="https://www.google.com/search?q=develo+design+reviews" target="_blank" rel="noopener">{t(locale, 'develoSocial.aboutTestimonialsPage.reviews.google.cta')} <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M7 17L17 7M17 7H7M17 7V17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
        </div>
        <div class="review-card">
          <div class="review-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
          <span class="review-score">{t(locale, 'develoSocial.aboutTestimonialsPage.reviews.clutch.score')}</span>
          <span class="review-meta">{t(locale, 'develoSocial.aboutTestimonialsPage.reviews.clutch.meta')}</span>
          <a class="review-link" href="https://clutch.co/profile/develo-design" target="_blank" rel="noopener">{t(locale, 'develoSocial.aboutTestimonialsPage.reviews.clutch.cta')} <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M7 17L17 7M17 7H7M17 7V17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ BLOG ═══ -->
  <section class="blog-section">
    <div class="section-container">
      <div class="blog-header">
        <div>
          <p style="font-family:Manrope,sans-serif;font-size:14px;font-weight:600;color:var(--blue);text-transform:uppercase;letter-spacing:.5px;margin-bottom:8px">{t(locale, 'develoSocial.aboutTestimonialsPage.blog.label')}</p>
          <h2>{t(locale, 'develoSocial.aboutTestimonialsPage.blog.heading')}</h2>
        </div>
        <p>{t(locale, 'develoSocial.aboutTestimonialsPage.blog.description')}</p>
      </div>
      <div class="blog-grid">
        <a class="blog-card" href={getLocalizedPath(locale, '/blog/shopify-vape-restrictions-uk-merchants')}><h3>{t(locale, 'develoSocial.aboutTestimonialsPage.blog.card1')}</h3></a>
        <a class="blog-card" href={getLocalizedPath(locale, '/blog/luke-collymore-elected-to-mage-os-board')}><h3>{t(locale, 'develoSocial.aboutTestimonialsPage.blog.card2')}</h3></a>
        <a class="blog-card" href={getLocalizedPath(locale, '/blog/develo-campus-to-commerce-university-of-birmingham')}><h3>{t(locale, 'develoSocial.aboutTestimonialsPage.blog.card3')}</h3></a>
      </div>
      <div style="margin-top:24px"><a class="btn-outline" href={getLocalizedPath(locale, '/blog')}>{t(locale, 'develoSocial.aboutTestimonialsPage.blog.viewBlog')}</a></div>
    </div>
  </section>

</main>

<!-- ═══ Footer ═══ -->
<style>.sf{background:#020303;color:#fff;width:100vw;position:relative;left:50%;right:50%;margin-left:-50vw;margin-right:-50vw;padding:120px 0;margin-top:0}.fc{max-width:1536px;margin:0 auto;padding:0 100px}.fg{display:grid;grid-template-columns:1.5fr 1fr 1fr 1fr;gap:60px;margin-bottom:60px}.fb p{font-family:Manrope,sans-serif;font-size:16px;font-weight:400;line-height:25px;color:rgba(255,255,255,.6);margin-top:16px;max-width:280px}.fch4{font-family:Manrope,sans-serif;font-size:16px;font-weight:600;color:#fff;line-height:25px;margin-bottom:16px}.fca{display:block;font-family:Manrope,sans-serif;font-size:14px;font-weight:400;color:rgba(255,255,255,.6);line-height:21px;padding:6px 0;transition:color .2s}.fca:hover{color:#fff}.fbot{display:flex;align-items:center;justify-content:space-between;padding-top:24px;border-top:1px solid rgba(255,255,255,.1)}.fbot span{font-family:Manrope,sans-serif;font-size:14px;font-weight:400;color:rgba(255,255,255,.5);line-height:21px}@media(max-width:767px){.fc{padding:0 24px}.sf{padding:60px 0}.fg{grid-template-columns:1fr;gap:32px}.fbot{flex-direction:column;gap:12px;text-align:center}}</style>
<SiteFooter />

<script>
  (function () {
    var testimonials = [
      { quote: "I am continually impressed by the results you produced! Your unique perspective, expertise and dedication played a crucial role in our project success.", name: "Dominika Miler-Zydek", role: "IT Project Manager", cta: { href: "/work/currys" } },
      { quote: "We were impressed with their knowledge of the Hyva theme and their efficiency in implementing it. Communication was great throughout the process and we are happy with the outcome and the impact this has had on our site speed.", name: "Alice Sorby", role: "Digital & eCommerce Director, Bamford Collection", cta: { href: "/work/daylesford" } },
      { quote: "Develo has truly become an extension of our team, consistently bringing proactive advice and innovative solutions that align perfectly with our objectives.", name: "Pippa Silva", role: "Project Manager", cta: { href: "/work/brandalley" } },
      { quote: "Feels like Develo is an extension of our internal team", name: "Alice Sorby", role: "Digital & eCommerce Director, Bamford Collection", cta: { href: "/work/bamford" } },
      { quote: "We stock and sell some unusual products that require a lot of custom development. We've always been able to get what we want, no matter how complex it seemed.", name: "Riley Beament", role: "Director of eCommerce", cta: { href: "/work/leonpaul" } },
      { quote: "Develo implemented the punchout2go module into our Magento installation with absolute precision. The integration was clean, fully compliant with our ERP procurement workflows, and performance has been rock solid. Data mapping, authentication, and order sync all worked exactly as required. Highly competent team who clearly know Magento and PunchOut inside out.", name: "John Spencer", role: "Dynamic Technologies Europe", cta: null },
      { quote: "Develo has meticulous attention to detail, coupled with a technically sound scope of work and supporting SoW, showcased their commitment to excellence. We value our partnership and would gladly choose to work with them again for future endeavours.", name: "Ben Hawes", role: "Antiblanks", cta: null },
      { quote: "The team's knowledge and experience with Magento is invaluable. The website's speed and UX improved significantly, with page elements loading efficiently. The team was great at communicating different stages of the project and was always on hand when needed.", name: "Gemma Edwards", role: "Marketing Manager, Pure Theatre", cta: null },
      { quote: "Really enjoyed working with the team this year - Luke Collymore and the team genuinely know their stuff and always deliver. Excited for what we've got lined up together", name: "Cris Brookes", role: "Digital Growth Manager, Costcutters", cta: null },
      { quote: "A highly organised and professional company with a robust team. Their proactive approach has significantly enhanced our site over the past few months, and I look forward to continuing our work together.", name: "Clark Howe", role: "Managing Director, Howsafe", cta: null }
    ];
    var index = 0;
    var mainEl = document.getElementById('testimonial-main');
    var quoteEl = document.getElementById('testimonial-quote');
    var nameEl = document.getElementById('testimonial-name');
    var roleEl = document.getElementById('testimonial-role');
    var ctaEl = document.getElementById('testimonial-cta');
    var pageEl = document.getElementById('testimonial-pagination');
    if (!mainEl || !quoteEl || !nameEl || !roleEl || !ctaEl || !pageEl) return;

    function show(i) {
      index = (i + testimonials.length) % testimonials.length;
      var t = testimonials[index];
      quoteEl.textContent = '"' + t.quote + '"';
      nameEl.textContent = t.name;
      roleEl.textContent = t.role;
      if (t.cta) {
        ctaEl.href = t.cta.href;
        ctaEl.hidden = false;
      } else {
        ctaEl.hidden = true;
      }
      pageEl.textContent = (index + 1) + '/' + testimonials.length;
      mainEl.classList.remove('testimonial-fade');
      void mainEl.offsetWidth;
      mainEl.classList.add('testimonial-fade');
    }

    document.getElementById('prev-testimonial').addEventListener('click', function () { show(index - 1); });
    document.getElementById('next-testimonial').addEventListener('click', function () { show(index + 1); });
  })();
</script>
</body>
</html>

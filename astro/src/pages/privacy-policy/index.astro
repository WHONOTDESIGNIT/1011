---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { t } from '../../lib/i18n';
import { buildBreadcrumbs } from '../../lib/breadcrumbs';

const locale = Astro.currentLocale ?? 'en';

function resolveBaseUrl() {
  return (process.env.URL ?? process.env.DEPLOY_PRIME_URL ?? process.env.SITE_URL ?? 'https://iplmanufacturer.com').replace(/\/$/, '');
}

const pageTitle = t(locale, 'auxPages.privacy.pageTitle');
const pageDescription = t(locale, 'auxPages.privacy.pageDescription');
const canonical = `${resolveBaseUrl()}/privacy-policy`;

const company = {
  name: 'SHENZHEN ISHINE TECHNOLOGY COMPANY LIMITED',
  vat: '91440300MA5GW6335H',
  receiver: 'CHAOHUI AN',
  addressLine1: "401 Room, 5 Building, No.27, Makan Road, Xi'li Street",
  addressLine2: 'Shenzhen, Guangdong, China',
  postCode: '518071',
  phone: '086-13823508753',
  email: 'service@ishineco.com',
  website: 'https://iplmanufacturer.com/',
};

const breadcrumbs = buildBreadcrumbs(locale, [
  { label: t(locale, 'common.home'), path: '/' },
  { label: pageTitle },
]);

const toc = [
  ['info-we-collect', 'infoWeCollect'],
  ['how-we-process', 'howWeProcess'],
  ['legal-bases', 'legalBases'],
  ['share', 'share'],
  ['retention', 'retention'],
  ['security', 'security'],
  ['minors', 'minors'],
  ['privacy-rights', 'privacyRights'],
  ['dnt', 'dnt'],
  ['california', 'california'],
  ['updates', 'updates'],
  ['contact', 'contact'],
  ['review-delete', 'reviewDelete'],
].map(([id, key]) => ({
  id,
  label: t(locale, `auxPages.privacy.sections.${key}.title`).toUpperCase(),
}));
---

<BaseLayout title={pageTitle} lang={locale} description={pageDescription} canonical={canonical} stickyNav={false}>
  <div class="mx-auto max-w-5xl px-6 py-12">
    <div class="space-y-10">
      <header class="space-y-6">
        <Breadcrumb items={breadcrumbs} variant="dark" locale={locale} />
        <div class="space-y-3">
          <p class="text-sm font-semibold uppercase tracking-[0.22em] text-slate-500">{t(locale, 'auxPages.privacy.privacyNotice')}</p>
          <h1 class="text-4xl font-bold text-slate-950 md:text-5xl">{t(locale, 'auxPages.privacy.pageTitle')}</h1>
          <p class="max-w-3xl text-lg leading-relaxed text-neutral-600">
            {t(locale, 'auxPages.privacy.lastUpdated')}
          </p>
        </div>
      </header>

      <section class="rounded-2xl border border-neutral-200 bg-white p-8 shadow-sm">
        <h2 class="text-sm font-semibold uppercase tracking-[0.22em] text-neutral-600">{t(locale, 'auxPages.privacy.summary.title')}</h2>
        <p class="mt-4 text-neutral-700">
          {t(locale, 'auxPages.privacy.summary.intro')}
        </p>
        <div class="mt-6 grid gap-4 rounded-2xl bg-neutral-50 p-6 text-sm text-neutral-700">
          <p>
            <span class="font-semibold">{t(locale, 'auxPages.privacy.summary.q1')}</span>
            {t(locale, 'auxPages.privacy.summary.a1').replace('{companyName}', company.name)}
          </p>
          <p>
            <span class="font-semibold">{t(locale, 'auxPages.privacy.summary.q2')}</span>
            {t(locale, 'auxPages.privacy.summary.a2')}
          </p>
          <p>
            <span class="font-semibold">{t(locale, 'auxPages.privacy.summary.q3')}</span>
            {t(locale, 'auxPages.privacy.summary.a3')}
          </p>
          <p>
            <span class="font-semibold">{t(locale, 'auxPages.privacy.summary.q4')}</span>
            {t(locale, 'auxPages.privacy.summary.a4')}
          </p>
          <p>
            <span class="font-semibold">{t(locale, 'auxPages.privacy.summary.q5')}</span>
            {t(locale, 'auxPages.privacy.summary.a5')}
          </p>
          <p>
            <span class="font-semibold">{t(locale, 'auxPages.privacy.summary.q6')}</span>
            {t(locale, 'auxPages.privacy.summary.a6')}
          </p>
          <p>
            <span class="font-semibold">{t(locale, 'auxPages.privacy.summary.q7')}</span>
            {t(locale, 'auxPages.privacy.summary.a7')}
          </p>
          <p>
            <span class="font-semibold">{t(locale, 'auxPages.privacy.summary.q8')}</span>
            {t(locale, 'auxPages.privacy.summary.a8')}
          </p>
        </div>
      </section>

      <section class="rounded-2xl border border-neutral-200 bg-white p-8 shadow-sm">
        <h2 class="text-2xl font-bold text-ink-900">{t(locale, 'auxPages.privacy.privacyNotice')}</h2>
        <p class="mt-4 text-neutral-700">
          {t(locale, 'auxPages.privacy.noticeIntro1').replace('{companyName}', company.name)}
        </p>
        <ul class="mt-4 list-disc space-y-2 pl-6 text-neutral-700">
          <li>
            {t(locale, 'auxPages.privacy.noticeList1Before')} <a class="text-sky-700 underline" href={company.website}>{company.website}</a>{t(locale, 'auxPages.privacy.noticeList1After')}
          </li>
          <li>{t(locale, 'auxPages.privacy.noticeList2')}</li>
        </ul>
        <p class="mt-4 text-neutral-700">
          {t(locale, 'auxPages.privacy.noticeIntro2Before')} <a class="text-sky-700 underline" href={`mailto:${company.email}`}>{company.email}</a> {t(locale, 'auxPages.privacy.noticeIntro2Mid')} <a class="text-sky-700 underline" href={`tel:+${company.phone.replaceAll('-', '')}`}>{company.phone}</a>.
        </p>
      </section>

      <section class="rounded-2xl border border-neutral-200 bg-white p-8 shadow-sm">
        <h2 class="text-2xl font-bold text-ink-900">{t(locale, 'auxPages.privacy.tableOfContents')}</h2>
        <ol class="mt-6 list-decimal space-y-2 pl-6 text-neutral-700">
          {toc.map((item) => (
            <li><a class="text-sky-700 underline" href={`#${item.id}`}>{item.label}</a></li>
          ))}
        </ol>
      </section>

      <section class="space-y-10">
        <section id="info-we-collect" class="rounded-2xl border border-neutral-200 bg-white p-8 shadow-sm">
          <h2 class="text-2xl font-bold text-ink-900">{t(locale, 'auxPages.privacy.sections.infoWeCollect.title')}</h2>

          <h3 class="mt-6 text-lg font-semibold text-ink-900">{t(locale, 'auxPages.privacy.sections.infoWeCollect.discloseTitle')}</h3>
          <p class="mt-3 text-neutral-700"><span class="font-semibold">{t(locale, 'auxPages.privacy.inShort')}</span> {t(locale, 'auxPages.privacy.sections.infoWeCollect.discloseInShort')}</p>
          <p class="mt-4 text-neutral-700">
            {t(locale, 'auxPages.privacy.sections.infoWeCollect.discloseBody1')}
          </p>
          <p class="mt-4 text-neutral-700">
            <span class="font-semibold">{t(locale, 'auxPages.privacy.sections.infoWeCollect.discloseSubtitle')}</span>
            {t(locale, 'auxPages.privacy.sections.infoWeCollect.discloseBody2')}
          </p>
          <ul class="mt-3 list-disc space-y-2 pl-6 text-neutral-700">
            <li>{t(locale, 'auxPages.privacy.sections.infoWeCollect.discloseList1')}</li>
            <li>{t(locale, 'auxPages.privacy.sections.infoWeCollect.discloseList2')}</li>
            <li>{t(locale, 'auxPages.privacy.sections.infoWeCollect.discloseList3')}</li>
            <li>{t(locale, 'auxPages.privacy.sections.infoWeCollect.discloseList4')}</li>
            <li>{t(locale, 'auxPages.privacy.sections.infoWeCollect.discloseList5')}</li>
          </ul>
          <p class="mt-4 text-neutral-700"><span class="font-semibold">{t(locale, 'auxPages.privacy.sections.infoWeCollect.sensitiveSubtitle')}</span> {t(locale, 'auxPages.privacy.sections.infoWeCollect.sensitiveText')}</p>
          <p class="mt-4 text-neutral-700">
            {t(locale, 'auxPages.privacy.sections.infoWeCollect.discloseBody3')}
          </p>

          <h3 class="mt-8 text-lg font-semibold text-ink-900">{t(locale, 'auxPages.privacy.sections.infoWeCollect.autoTitle')}</h3>
          <p class="mt-3 text-neutral-700"><span class="font-semibold">{t(locale, 'auxPages.privacy.inShort')}</span> {t(locale, 'auxPages.privacy.sections.infoWeCollect.autoInShort')}</p>
          <p class="mt-4 text-neutral-700">
            {t(locale, 'auxPages.privacy.sections.infoWeCollect.autoBody1')}
          </p>
          <p class="mt-4 text-neutral-700">{t(locale, 'auxPages.privacy.sections.infoWeCollect.autoBody2')}</p>
          <ul class="mt-3 list-disc space-y-2 pl-6 text-neutral-700">
            <li><span class="font-semibold">{t(locale, 'auxPages.privacy.sections.infoWeCollect.autoList1Title')}</span>{t(locale, 'auxPages.privacy.sections.infoWeCollect.autoList1Text')}</li>
            <li><span class="font-semibold">{t(locale, 'auxPages.privacy.sections.infoWeCollect.autoList2Title')}</span>{t(locale, 'auxPages.privacy.sections.infoWeCollect.autoList2Text')}</li>
            <li><span class="font-semibold">{t(locale, 'auxPages.privacy.sections.infoWeCollect.autoList3Title')}</span>{t(locale, 'auxPages.privacy.sections.infoWeCollect.autoList3Text')}</li>
          </ul>
        </section>

        <section id="how-we-process" class="rounded-2xl border border-neutral-200 bg-white p-8 shadow-sm">
          <h2 class="text-2xl font-bold text-ink-900">{t(locale, 'auxPages.privacy.sections.howWeProcess.title')}</h2>
          <p class="mt-3 text-neutral-700"><span class="font-semibold">{t(locale, 'auxPages.privacy.inShort')}</span> {t(locale, 'auxPages.privacy.sections.howWeProcess.inShort')}</p>
          <p class="mt-4 text-neutral-700">
            {t(locale, 'auxPages.privacy.sections.howWeProcess.body1')}
          </p>
          <ul class="mt-4 list-disc space-y-2 pl-6 text-neutral-700">
            <li>{t(locale, 'auxPages.privacy.sections.howWeProcess.list1')}</li>
            <li>{t(locale, 'auxPages.privacy.sections.howWeProcess.list2')}</li>
            <li>{t(locale, 'auxPages.privacy.sections.howWeProcess.list3')}</li>
            <li>{t(locale, 'auxPages.privacy.sections.howWeProcess.list4')}</li>
            <li>{t(locale, 'auxPages.privacy.sections.howWeProcess.list5')}</li>
            <li>{t(locale, 'auxPages.privacy.sections.howWeProcess.list6')}</li>
            <li>{t(locale, 'auxPages.privacy.sections.howWeProcess.list7')}</li>
          </ul>
        </section>

        <section id="legal-bases" class="rounded-2xl border border-neutral-200 bg-white p-8 shadow-sm">
          <h2 class="text-2xl font-bold text-ink-900">{t(locale, 'auxPages.privacy.sections.legalBases.title')}</h2>
          <p class="mt-3 text-neutral-700"><span class="font-semibold">{t(locale, 'auxPages.privacy.inShort')}</span> {t(locale, 'auxPages.privacy.sections.legalBases.inShort')}</p>
          <p class="mt-4 text-neutral-700">
            {t(locale, 'auxPages.privacy.sections.legalBases.body1')}
          </p>
          <ul class="mt-4 list-disc space-y-2 pl-6 text-neutral-700">
            <li><span class="font-semibold">{t(locale, 'auxPages.privacy.sections.legalBases.list1Title')}</span>{t(locale, 'auxPages.privacy.sections.legalBases.list1Text')}</li>
            <li><span class="font-semibold">{t(locale, 'auxPages.privacy.sections.legalBases.list2Title')}</span>{t(locale, 'auxPages.privacy.sections.legalBases.list2Text')}</li>
            <li><span class="font-semibold">{t(locale, 'auxPages.privacy.sections.legalBases.list3Title')}</span>{t(locale, 'auxPages.privacy.sections.legalBases.list3Text')}</li>
            <li><span class="font-semibold">{t(locale, 'auxPages.privacy.sections.legalBases.list4Title')}</span>{t(locale, 'auxPages.privacy.sections.legalBases.list4Text')}</li>
          </ul>
          <p class="mt-4 text-neutral-700">
            {t(locale, 'auxPages.privacy.sections.legalBases.body2')}
          </p>
        </section>

        <section id="share" class="rounded-2xl border border-neutral-200 bg-white p-8 shadow-sm">
          <h2 class="text-2xl font-bold text-ink-900">{t(locale, 'auxPages.privacy.sections.share.title')}</h2>
          <p class="mt-3 text-neutral-700"><span class="font-semibold">{t(locale, 'auxPages.privacy.inShort')}</span> {t(locale, 'auxPages.privacy.sections.share.inShort')}</p>
          <p class="mt-4 text-neutral-700">{t(locale, 'auxPages.privacy.sections.share.body1')}</p>
          <ul class="mt-4 list-disc space-y-2 pl-6 text-neutral-700">
            <li><span class="font-semibold">{t(locale, 'auxPages.privacy.sections.share.list1Title')}</span>{t(locale, 'auxPages.privacy.sections.share.list1Text')}</li>
          </ul>
        </section>

        <section id="retention" class="rounded-2xl border border-neutral-200 bg-white p-8 shadow-sm">
          <h2 class="text-2xl font-bold text-ink-900">{t(locale, 'auxPages.privacy.sections.retention.title')}</h2>
          <p class="mt-3 text-neutral-700"><span class="font-semibold">{t(locale, 'auxPages.privacy.inShort')}</span> {t(locale, 'auxPages.privacy.sections.retention.inShort')}</p>
          <p class="mt-4 text-neutral-700">
            {t(locale, 'auxPages.privacy.sections.retention.body1')}
          </p>
          <p class="mt-4 text-neutral-700">
            {t(locale, 'auxPages.privacy.sections.retention.body2')}
          </p>
        </section>

        <section id="security" class="rounded-2xl border border-neutral-200 bg-white p-8 shadow-sm">
          <h2 class="text-2xl font-bold text-ink-900">{t(locale, 'auxPages.privacy.sections.security.title')}</h2>
          <p class="mt-3 text-neutral-700"><span class="font-semibold">{t(locale, 'auxPages.privacy.inShort')}</span> {t(locale, 'auxPages.privacy.sections.security.inShort')}</p>
          <p class="mt-4 text-neutral-700">
            {t(locale, 'auxPages.privacy.sections.security.body1')}
          </p>
        </section>

        <section id="minors" class="rounded-2xl border border-neutral-200 bg-white p-8 shadow-sm">
          <h2 class="text-2xl font-bold text-ink-900">{t(locale, 'auxPages.privacy.sections.minors.title')}</h2>
          <p class="mt-3 text-neutral-700"><span class="font-semibold">{t(locale, 'auxPages.privacy.inShort')}</span> {t(locale, 'auxPages.privacy.sections.minors.inShort')}</p>
          <p class="mt-4 text-neutral-700">
            {t(locale, 'auxPages.privacy.sections.minors.bodyBefore')} <a class="text-sky-700 underline" href={`mailto:${company.email}`}>{company.email}</a>.
          </p>
        </section>

        <section id="privacy-rights" class="rounded-2xl border border-neutral-200 bg-white p-8 shadow-sm">
          <h2 class="text-2xl font-bold text-ink-900">{t(locale, 'auxPages.privacy.sections.privacyRights.title')}</h2>
          <p class="mt-3 text-neutral-700"><span class="font-semibold">{t(locale, 'auxPages.privacy.inShort')}</span> {t(locale, 'auxPages.privacy.sections.privacyRights.inShort')}</p>
          <p class="mt-4 text-neutral-700">
            {t(locale, 'auxPages.privacy.sections.privacyRights.body1')}
          </p>
          <p class="mt-4 text-neutral-700">
            {t(locale, 'auxPages.privacy.sections.privacyRights.body2')}
          </p>
          <p class="mt-4 text-neutral-700">
            {t(locale, 'auxPages.privacy.sections.privacyRights.body3')}
          </p>
          <p class="mt-4 text-neutral-700">
            {t(locale, 'auxPages.privacy.sections.privacyRights.body4')}
          </p>
        </section>

        <section id="dnt" class="rounded-2xl border border-neutral-200 bg-white p-8 shadow-sm">
          <h2 class="text-2xl font-bold text-ink-900">{t(locale, 'auxPages.privacy.sections.dnt.title')}</h2>
          <p class="mt-4 text-neutral-700">
            {t(locale, 'auxPages.privacy.sections.dnt.body1')}
          </p>
        </section>

        <section id="california" class="rounded-2xl border border-neutral-200 bg-white p-8 shadow-sm">
          <h2 class="text-2xl font-bold text-ink-900">{t(locale, 'auxPages.privacy.sections.california.title')}</h2>
          <p class="mt-3 text-neutral-700"><span class="font-semibold">{t(locale, 'auxPages.privacy.inShort')}</span> {t(locale, 'auxPages.privacy.sections.california.inShort')}</p>
          <p class="mt-4 text-neutral-700">
            {t(locale, 'auxPages.privacy.sections.california.body1')}
          </p>
          <p class="mt-4 text-neutral-700">
            {t(locale, 'auxPages.privacy.sections.california.body2').replace('{companyName}', company.name)}
          </p>
          <p class="mt-4 text-neutral-700">
            {t(locale, 'auxPages.privacy.sections.california.body3')}
          </p>
        </section>

        <section id="updates" class="rounded-2xl border border-neutral-200 bg-white p-8 shadow-sm">
          <h2 class="text-2xl font-bold text-ink-900">{t(locale, 'auxPages.privacy.sections.updates.title')}</h2>
          <p class="mt-3 text-neutral-700"><span class="font-semibold">{t(locale, 'auxPages.privacy.inShort')}</span> {t(locale, 'auxPages.privacy.sections.updates.inShort')}</p>
          <p class="mt-4 text-neutral-700">
            {t(locale, 'auxPages.privacy.sections.updates.body1')}
          </p>
        </section>

        <section id="contact" class="rounded-2xl border border-neutral-200 bg-white p-8 shadow-sm">
          <h2 class="text-2xl font-bold text-ink-900">{t(locale, 'auxPages.privacy.sections.contact.title')}</h2>
          <p class="mt-4 text-neutral-700">
            {t(locale, 'auxPages.privacy.contactIntroBefore')} <a class="text-sky-700 underline" href={`mailto:${company.email}`}>{company.email}</a>{t(locale, 'auxPages.privacy.contactIntroBetween')} <a class="text-sky-700 underline" href={`tel:+${company.phone.replaceAll('-', '')}`}>{company.phone}</a>{t(locale, 'auxPages.privacy.contactIntroAfter')}
          </p>

          <div class="mt-6 rounded-2xl border border-neutral-200 bg-neutral-50 p-6 text-sm text-neutral-700">
            <p class="font-semibold text-ink-900">{company.name}</p>
            <p>{t(locale, 'auxPages.privacy.vatLabel')} {company.vat}</p>
            <p>{t(locale, 'auxPages.privacy.receiverLabel')} {company.receiver}</p>
            <p>{company.addressLine1}</p>
            <p>{company.addressLine2}</p>
            <p>{t(locale, 'auxPages.privacy.postCodeLabel')} {company.postCode}</p>
            <p>{t(locale, 'auxPages.privacy.phoneLabel')} {company.phone}</p>
          </div>
        </section>

        <section id="review-delete" class="rounded-2xl border border-neutral-200 bg-white p-8 shadow-sm">
          <h2 class="text-2xl font-bold text-ink-900">{t(locale, 'auxPages.privacy.sections.reviewDelete.title')}</h2>
          <p class="mt-4 text-neutral-700">
            {t(locale, 'auxPages.privacy.sections.reviewDelete.body1')}
          </p>
        </section>
      </section>
    </div>
  </div>
</BaseLayout>

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── 安全加固新增（2026-09-14，配合 Netlify Functions 的访问控制）────────────────
# 图片上传 / 清单 / 删除三个函数的访问密钥。请求头 `X-Function-Secret` 必须等于该值。
# 未设置 ⇒ 三个函数一律返回 503（fail closed）。
# 注意：这三个端点已无浏览器 UI（/upload、/admin 页面已删除），只给你自己的脚本/curl 使用，
# 因此密钥不会进前端包。请在 Netlify 站点设置里创建同名环境变量（作用域：Functions）。
FUNCTION_SECRET=use-a-long-random-string

# 聊天端点（R3）：
#   CHAT_ENABLED=true        才允许调用；不设置或非 true ⇒ 直接 404（该功能尚未完成，默认关闭）
#   CHAT_SESSION_SECRET      会话令牌的 HMAC 签名密钥；未设置 ⇒ 503
# 会话 id 与令牌都由服务端签发，读取/续写历史必须带上匹配的令牌。
CHAT_ENABLED=false
CHAT_SESSION_SECRET=use-another-long-random-string

# 投票去重（R7）时对客户端 IP 做 HMAC 的密钥（不存原始 IP）。
# 不设置时会回退用 FUNCTION_SECRET，两者都没有则使用固定盐。
VOTE_HASH_SECRET=optional-dedicated-string

# ops/seo 环境与配置模板
#
# 复制为本地配置，或直接 export 这些变量。
# 本文件是**模板**，可以入库；真实值一律不入库（见 .gitignore）。
#
# 缺变量时脚本应**显式报错**，不要静默用一个猜出来的默认值——
# 静默回落会让脚本在错误目录上跑出"看起来正常"的结果。

# ── 路径类 ─────────────────────────────────────────────────────────────
# 站点仓库根目录（含 site-urls.txt、astro/）
DSH_REPO_ROOT=/path/to/1011-repo

# 本工作区根目录（含运维脚本与 .wx-bridge/）
DSH_WORKSPACE=/path/to/workspace

# 运行时解释器。脚本要用到 Node 与 Python 时从此读取，
# 不要写死解释器绝对路径——换机器/换运行时版本即失效。
DSH_NODE=/path/to/node
DSH_PYTHON=/path/to/python

# GSC 覆盖率工作簿（Bing/GSC 收录核验结果写入此处）
DSH_COVERAGE_XLSX=/path/to/Coverage-Valid.xlsx

# 浏览器自动化使用的持久化 profile 目录
DSH_BROWSER_PROFILE=/path/to/browser-profile

# ── 凭据类（本文件只写键名；真实值放在被 .gitignore 排除的文件里）──────
# 1) seo_email_smtp.py 读取同目录 seo_smtp_config.json：
#      {
#        "smtp_host":      "smtp.example.com",
#        "smtp_port":      465,
#        "smtp_user":      "sender@example.com",
#        "smtp_auth_code": "<授权码 / 应用专用密码>",
#        "mail_to":        "recipient@example.com",
#        "mail_from_name": "SEO Bot"
#      }
#    脚本以 cfg['smtp_auth_code'] 直接下标读取，**没有 fallback 默认值**：
#    配置缺失会立刻 KeyError（刻意如此，避免静默回落到硬编码凭据）。
DSH_SMTP_CONFIG=./seo_smtp_config.json

# 2) Bing Webmaster API key。脚本先从同目录 bing_api_key.txt 读，
#    找不到再读此环境变量。
#    获取位置：Bing Webmaster Tools → 设置 → API 访问。
BING_WEBMASTER_API_KEY=

# 3) IndexNow key。脚本先从同目录 indexnow_key.txt 读。
#    站点根目录须能访问到 {key}.txt 才能通过引擎校验。
INDEXNOW_KEY=

# ── 节流类 ─────────────────────────────────────────────────────────────
# Bing 逐 URL 查询有 host 级每日额度，超出即被拒；实测额度稳定后据此调整。
BING_DAILY_LIMIT=10

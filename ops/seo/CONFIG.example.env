# ops/seo 环境与配置模板
#
# 复制为本地配置，或直接 export 这些变量。
# 本文件是**模板**，可以入库；真实值一律不入库（见 .gitignore）。
#
# 缺变量时脚本应**显式报错**，不要静默用一个猜出来的默认值——
# 静默回落会让脚本在错误目录上跑出"看起来正常"的结果。

# ── 路径类 ─────────────────────────────────────────────────────────────
# 站点仓库根目录。**当前为预留**：seo_daily.py 的输入来自脚本同级的 plans/，
# 尚未真正读这个变量；需要直接读仓库 site-urls.txt 的批处理工具（bing_verify.py
# 等）迁入后会用到。现在设为必需是为了避免那批工具迁入时再改一次配置——
# 缺失时会以 exit 2 报出变量名与用途，不会静默出错。
DSH_REPO_ROOT=/path/to/1011-repo

# 应用目录 = .wx-bridge 目录本身（含 plans/、spool/、凭据文件）。
# 注意：不是它的父目录。seo_daily.py / seo_email_smtp.py / medium_daily.py
# 都按"这个变量下面就是 plans/"来使用。
DSH_WORKSPACE=/path/to/.wx-bridge

# 平铺数据目录：直接放着 _bing_*.jsonl / _gsc_*.json 等结果文件的那个目录。
# 默认等于 DSH_WORKSPACE；单独可配是为了让测试环境与真实工作区隔离
# （冒烟测试就是用不同取值来验证写入确实被改道了）。
DSH_DATA_DIR=/path/to/.wx-bridge

# 第三方本地模块目录：wx_driver.py 与 boot311.py 所在处（seo_daily 的
# site_index_check、seo_weekly_audit 的 real_browser_site_check 需要）。
# 默认等于 DSH_WORKSPACE。这些模块尚未迁入仓库，故与脚本目录分开。
# 注意它们依赖 pywin32（win32api），需要用装了 pywin32 的解释器运行。
DSH_APP_DIR=/path/to/.wx-bridge

# 运行时解释器。脚本要用到 Node 与 Python 时从此读取，
# 不要写死解释器绝对路径——换机器/换运行时版本即失效。
DSH_NODE=/path/to/node
DSH_PYTHON=/path/to/python

# GSC 覆盖率工作簿：写入目标与读取来源分开配（合并脚本会两者都用）。
DSH_COVERAGE_XLSX=/path/to/Coverage-Valid.xlsx
DSH_COVERAGE_BAK=/path/to/Coverage-Valid.原始备份.xlsx

# 浏览器自动化（GSC 逐 URL 检查，gsc_run.mjs 用）
DSH_BROWSER_PROFILE=/path/to/browser-profile/User Data
DSH_SHOT_DIR=/path/to/gsc-shots

# ── 凭据类（本文件只写键名；真实值放在被 .gitignore 排除的文件里）──────
# 1) seo_email_smtp.py 读取同目录 seo_smtp_config.json：
#      {
#        "smtp_host":      "smtp.example.com",
#        "smtp_port":      465,
#        "smtp_user":      "sender@example.com",
#        "smtp_auth_code": "<授权码 / 应用专用密码>",
#        "mail_to":        "recipient@example.com",
#        "mail_from_name": "SEO Bot"
#      }
#    脚本以 cfg['smtp_auth_code'] 直接下标读取，**没有 fallback 默认值**：
#    配置缺失会立刻 KeyError（刻意如此，避免静默回落到硬编码凭据）。
DSH_SMTP_CONFIG=./seo_smtp_config.json

# 2) Bing Webmaster API key。脚本先从同目录 bing_api_key.txt 读，
#    找不到再读此环境变量。
#    获取位置：Bing Webmaster Tools → 设置 → API 访问。
BING_WEBMASTER_API_KEY=

# 3) IndexNow key。脚本先从同目录 indexnow_key.txt 读。
#    站点根目录须能访问到 {key}.txt 才能通过引擎校验。
INDEXNOW_KEY=

# ── 节流类 ─────────────────────────────────────────────────────────────
# Bing 逐 URL 查询有 host 级每日额度，超出即被拒；实测额度稳定后据此调整。
BING_DAILY_LIMIT=10

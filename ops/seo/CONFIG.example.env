# ops/seo 环境与配置模板
#
# 用法：复制为 .env.example 之外的实际配置，或直接 export 这些变量。
# 本文件是**模板**，可以入库；真实值一律不入库（见 .gitignore）。
#
# 为什么需要这份模板：
#   这些脚本原先写死了 `C:\Users\<用户名>\...` 这类本机绝对路径。
#   那样不仅泄漏个人路径，更要命的是**换机器就跑不起来**——
#   从备份里拷出来也会因为路径不存在而失败。改成"环境变量 + 配置模板"后
#   才真正可恢复。缺变量时脚本应显式报错，而不是静默用一个错误的默认值。

# ── 路径类（8 个脚本里的本机路径改为引用这些变量）────────────────────────
# 站点仓库根目录（含 site-urls.txt、astro/）
DSH_REPO_ROOT=D:/1011-main/1011-main/1011-main

# 本工作区根目录（含 _gsc_*.py、_gsc_*.mjs、.wx-bridge/）
DSH_WORKSPACE=D:/001-IPL资料库-说明书-证书/MD-PRODUCTS-INFOS

# 运行时解释器（原先是 C:\Users\<user>\.dsh\dsh-runtimes\... 的绝对路径）
DSH_NODE=D:/path/to/node.exe
DSH_PYTHON=D:/path/to/python.exe

# GSC 覆盖率工作簿（原先是 C:\Users\<user>\Downloads\https___...Coverage-Valid-*.xlsx）
DSH_COVERAGE_XLSX=D:/path/to/Coverage-Valid.xlsx

# 浏览器自动化用的持久化 profile 目录（原先写死 C:\Users\<user>\dsh-gsc-profile）
DSH_BROWSER_PROFILE=D:/path/to/browser-profile

# ── 凭据类（只写键名，真实值放在同目录的被忽略文件里）──────────────────────
# 1) seo_email_smtp.py 读取同目录 seo_smtp_config.json，键名如下：
#      {
#        "smtp_host":      "smtp.example.com",
#        "smtp_port":      465,
#        "smtp_user":      "sender@example.com",
#        "smtp_auth_code": "<授权码/应用专用密码>",
#        "mail_to":        "recipient@example.com",
#        "mail_from_name": "SEO Bot"
#      }
#    注意：脚本用 cfg['smtp_auth_code'] 直接下标读取，**没有 fallback 默认值**，
#    所以配置缺失会立刻 KeyError 报错（这是刻意的：避免静默回落到硬编码凭据）。
DSH_SMTP_CONFIG=./seo_smtp_config.json

# 2) Bing Webmaster API key（bing_daily_batch.py 先从 bing_api_key.txt 读，
#    找不到再读环境变量）。获取位置：Bing Webmaster Tools → 设置 → API 访问。
BING_WEBMASTER_API_KEY=

# 3) IndexNow key（seo_daily.py 先从同目录 indexnow_key.txt 读）。
#    站点根目录必须能访问到 {key}.txt 才能通过校验。
INDEXNOW_KEY=

# ── 可选：调度与节流 ────────────────────────────────────────────────────
# Bing GetUrlInfo 有 host 级每日配额（超出返回 ThrottleHost），
# 故按天小额度累积；实测值稳定后据此调整。
BING_DAILY_LIMIT=10

# Google Search Console 的网址检查（浏览器 UI 路径）另有每日配额，
# 每日 07:25 任务会在命中配额后自行停止。

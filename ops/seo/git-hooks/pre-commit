#!/bin/sh
# ops/seo/git-hooks/pre-commit
#
# Blocks a commit that introduces machine-specific paths, credential-shaped
# strings, contact details or private addresses. The rule set lives in
# clean_check.py (see its header for what each rule means); this hook only wires
# it into git.
#
# Install once per clone:
#     git config core.hooksPath ops/seo/git-hooks
#
# Only STAGED files are checked, deliberately. Scanning the whole tree on every
# commit is slow enough that people start adding --no-verify, and a rule everyone
# bypasses is worse than no rule. The hook is versioned here rather than left in
# .git/hooks precisely so it survives a fresh clone and can be reviewed.
#
# Bypass (use sparingly, and prefer fixing the finding):
#     git commit --no-verify

set -e

# Find the interpreter: environment override, then PATH, then a common fallback.
PY="${DSH_PYTHON:-}"
if [ -z "$PY" ] || [ ! -x "$PY" ]; then
  if command -v python3 >/dev/null 2>&1; then
    PY=python3
  elif command -v python >/dev/null 2>&1; then
    PY=python
  fi
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"
CHECK="$REPO_ROOT/ops/seo/clean_check.py"

# If the checker is missing there is nothing to enforce; do not block the commit.
if [ ! -f "$CHECK" ]; then
  exit 0
fi

if [ -z "$PY" ]; then
  echo "pre-commit: no python found; skipping clean_check (set DSH_PYTHON to enforce)" >&2
  exit 0
fi

cd "$REPO_ROOT"
if ! "$PY" "$CHECK" --staged; then
  echo ""
  echo "pre-commit: blocked by clean_check.py (see findings above)."
  echo "  Fix the finding, or bypass with: git commit --no-verify"
  exit 1
fi

exit 0
